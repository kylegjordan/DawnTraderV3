      "Bash(chown:*)",
      "Bash(date:*)",
      "Bash(sleep:*)",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(jq:*)",
      "Bash(tr:*)",
      "Bash(cut:*)",
      "Bash(sort:*)",
      "Bash(uniq:*)",
      "Bash(xargs:*)",
      "Bash(npm:*)",
      "Bash(npx:*)",
      "Bash(node:*)",
      "Bash(tsc:*)",
      "Bash(tsx:*)",
      "Bash(python:*)",
      "Bash(python3:*)",
      "Bash(pip:*)",
      "Bash(pip3:*)",
      "Bash(uuidgen:*)",
      "Bash(zip:*)",
      "Bash(unzip:*)",
      "Bash(tar:*)",
      "Bash(diff:*)",
      "Bash(true:*)",
      "Bash(false:*)",
      "Bash(:)",
      "Bash(for:*)",
      "Bash(do:*)",
      "Bash(done:*)",
      "Bash(if:*)",
      "Bash(then:*)",
      "Bash(fi:*)",
      "Bash(while:*)",
      "Bash(powershell.exe:*)",
      "Bash(cmd.exe:*)",
      "Read(*)",
      "Read(//tmp/**)",
      "Read(//var/log/**)",
      "Read(//home/**)",
      "Read(//etc/**)",
      "Read(//root/**)",
      "Read(//mnt/**)",
      "Write(*)",
      "Edit(*)",
      "WebSearch",
      "WebFetch",
      "mcp__Claude_in_Chrome__tabs_context_mcp",
      "mcp__Claude_in_Chrome__browser_batch",
      "mcp__Claude_in_Chrome__computer",
      "mcp__Claude_in_Chrome__navigate",
      "mcp__Claude_in_Chrome__read_page",
      "mcp__Claude_in_Chrome__get_page_text",
      "mcp__Claude_in_Chrome__form_input"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean -fd:*)",
      "Bash(git branch -D:*)",
      "Bash(rm -rf /:*)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~:*)",
      "Bash(rm -rf ~/*)",
      "Bash(sudo:*)",
      "Bash(format:*)",
      "Bash(mkfs:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-governed-read.mjs\"" }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|compact",
        "hooks": [
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/session-reminder.mjs\"" }
        ]
      }
    ]
  }
}
