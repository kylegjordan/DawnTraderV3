#!/usr/bin/env python3
"""langston-rules-install - install Langston's rules file from a REVIEWED commit. Root only, on Helsinki.

    langston-rules-install <full-40-char-sha> [--dry-run]

B-LANGSTON-CLAUDEMD-RESIDUAL (Langston's ruling, 2026-10-20): his auto-loaded rules file /home/langston/CLAUDE.md
changes ONLY by installing a reviewed commit. The repo copy is comms-infra/langston/LANGSTON_CLAUDE.md (not named
CLAUDE.md: the governance checker treats every file of that name as housekeeping, so an untagged edit would pass).

⛔ THE BACKUP MIRROR IS LANGSTON-WRITABLE (objects, refs and config) AND IS TREATED AS UNTRUSTED INPUT.
   r1 B-1: its branch ref could be moved, so the head comes from GitHub (`git ls-remote`, as root).
   r2 B-3 (Langston, measured on git 2.43.0): a LOOSE TREE object overwritten at its genuine id is NOT checked by
   `git rev-parse <sha>:<path>`, so a forged tree could name any blob and the blob would then re-hash to itself.
   ⇒ every object on the path commit -> tree -> tree -> tree -> blob is read with `git cat-file <type>` and
   RE-HASHED HERE; a mismatch refuses (exit 5).
   r3 B-4 (Langston, 2026-10-21): the same is true of COMMIT objects. r3 said "commit ancestry is walked by git, which
   verifies commit objects on read" - false for a loose commit overwritten at its id, so a forged parent line could
   make `git merge-base --is-ancestor` admit an unreviewed commit. ⇒ ancestry is walked HERE (`verified_ancestor`):
   breadth-first from GitHub's head through `parent` lines, EVERY commit re-hashed on the way, bounded by
   WALK_LIMIT commits (beyond it: refuse, exit 4 - install a more recent reviewed commit). No git ancestry command
   is used. Once the repository is private, the ls-remote needs a root-held credential or it refuses.

What it does, in order, or refuses:
  1. the sha is 40 hex and reachable from GitHub's migration/aws-supabase head through commits that each re-hash to
     their id (`verified_ancestor`, at most WALK_LIMIT commits back; the head object present in the mirror);
  2. the blob is reached by the verified walk (`verified_blob`) - the same function the size watch uses;
  3. the live file is read WITHOUT following a link; it is reported as absent / a link / not regular / a regular file
     with owner, mode and immutable flag;
  4. if content, root:root 0644, the immutable flag AND the install record all hold, nothing is done;
  5. otherwise: the previous regular file is kept in /root/langston-rules-backup/<sha256>.md; the new bytes are staged
     in that root-only dir, set root:root 0644 on the open file, fsynced; the target's flag cleared, the staged file
     renamed over it (same filesystem; follows nothing), and the flag set again IN A FINALLY;
  6. the record is written to /root/langston-rules-backup/INSTALLED and /etc/langston/rules-installed (root:root 0644).
     A record that fails to write after a good install says so: re-running is safe and rewrites it.

⛔ NO INPUT FROM LANGSTON'S SIDE: no path, ref or content argument beyond the sha the ROOT operator passes, and his
   object store is never trusted for content. A rule that must land now: he asks a CC session in the channel, which
   commits and installs it (the hotfix path if urgent) - never parked in his MEMORY.md.
Exit codes: 0 installed / already installed / dry run · 2 bad input · 3 not root · 4 sha not on GitHub's branch,
GitHub unreadable, an object missing, a single-object mirror read (`git -C <mirror> ...`) that timed out, or the
batch reader stopping mid-object (its reads carry NO time limit - the walk is bounded by WALK_LIMIT objects, not
by time) · 5 an object does not
hash to its id · 6 write or protect failed, including a flag command that timed out (the message says whether the
live file was replaced).
"""
import hashlib, json, os, re, stat, subprocess, sys, tempfile, time

MIRROR = os.environ.get("LRI_MIRROR", "/srv/dawntrader-backup.git")
UPSTREAM = os.environ.get("LRI_UPSTREAM", "https://github.com/kylegjordan/DawnTraderV3.git")
BRANCH = "migration/aws-supabase"
REPO_PATH = "comms-infra/langston/LANGSTON_CLAUDE.md"
TARGET = os.environ.get("LRI_TARGET", "/home/langston/CLAUDE.md")
BACKUP_DIR = os.environ.get("LRI_BACKUP", "/root/langston-rules-backup")
PUBLIC_RECORD = os.environ.get("LRI_PUBLIC_RECORD", "/etc/langston/rules-installed")
USE_IMMUTABLE = os.environ.get("LRI_NO_IMMUTABLE") != "1"
# The ancestry walk's bound. The branch held 13,670 commits on 2026-11-05; a reviewed sha is normally recent, so
# the bound is generous - it exists so a forged parent cycle or a huge fan-out cannot run without end.
WALK_LIMIT = int(os.environ.get("LRI_WALK_LIMIT", "20000"))
# Every external command's time limit, in seconds. Settable only so the tests can make a stalled `chattr` time out
# without a two-minute wait; the root operator has no reason to change it.
TOOL_TIMEOUT = int(os.environ.get("LRI_TOOL_TIMEOUT", "120"))


class Refused(Exception):
    def __init__(self, code, msg):
        Exception.__init__(self, msg)
        self.code = code


class ToolTimeout(OSError):
    """An external command ran past its limit. An OSError on purpose (Langston, part-1 r5 record item 1): a
    `subprocess.TimeoutExpired` is NOT one, so a `chattr` that hung inside the install's `finally` escaped the
    `except OSError` and the operator lost the 'WAS replaced - check its flag' message, exiting 1 (undocumented)."""


def run(cmd, binary=False, timeout=None, cwd=None, env=None):
    limit = TOOL_TIMEOUT if timeout is None else timeout
    try:
        r = subprocess.run(cmd, capture_output=True, timeout=limit, cwd=cwd, env=env)
    except subprocess.TimeoutExpired:
        raise ToolTimeout("%s timed out after %d s" % (" ".join(cmd[:4]), limit))
    out = r.stdout if binary else r.stdout.decode("utf-8", "replace").strip()
    return r.returncode, out, r.stderr.decode("utf-8", "replace").strip()


def git(mirror, *args, binary=False):
    try:
        return run(["git", "-C", mirror] + list(args), binary=binary)
    except ToolTimeout as e:                       # a stalled mirror read is a documented refusal, never a traceback
        raise Refused(4, "reading the mirror timed out (%s)" % e)


def github_head(upstream=None):
    # ⛔ B-5 (Langston r4, measured on git 2.43.0): with no cwd, `git ls-remote` reads the config of whatever repository
    #    git discovers by walking up from root's current directory, so a planted `.git` carrying
    #    `url.<x>.insteadOf = https://github.com/` would re-point the ANCHOR, and every re-hash after it would pass.
    #    cwd="/" leaves nothing to discover. GIT_TERMINAL_PROMPT=0 and the timeout catch make a missing credential (once
    #    the repository is private) a documented refusal, exit 4, not a 60 s hang and a traceback.
    env = dict(os.environ, GIT_TERMINAL_PROMPT="0")
    try:
        rc, out, err = run(["git", "ls-remote", upstream or UPSTREAM, "refs/heads/" + BRANCH], timeout=60, cwd="/",
                           env=env)
    except ToolTimeout:
        raise Refused(4, "reading %s's head from %s timed out (60 s)" % (BRANCH, upstream or UPSTREAM))
    head = out.split()[0] if rc == 0 and out else ""
    if not re.fullmatch(r"[0-9a-f]{40}", head):
        raise Refused(4, "cannot read %s's head from %s (%s)" % (BRANCH, upstream or UPSTREAM, err or out or "empty"))
    return head


def read_verified(mirror, oid, kind):
    rc, data, err = git(mirror, "cat-file", kind, oid, binary=True)
    if rc != 0:
        raise Refused(4, "the mirror cannot serve %s %s (%s)" % (kind, oid[:12], err[:120]))
    got = hashlib.sha1(b"%s %d\0" % (kind.encode(), len(data)) + data).hexdigest()
    if got != oid:
        raise Refused(5, "%s %s in the mirror re-hashes to %s - its object is not what GitHub served" %
                      (kind, oid[:12], got[:12]))
    return data


class BatchReader:
    """One `git cat-file --batch` process, every object RE-HASHED here (the same check as read_verified), so a walk
    of thousands of commits costs one process, not thousands."""

    def __init__(self, mirror):
        self.p = subprocess.Popen(["git", "-C", mirror, "cat-file", "--batch"], stdin=subprocess.PIPE,
                                  stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)

    def read(self, oid, kind):
        try:
            self.p.stdin.write(oid.encode() + b"\n")
            self.p.stdin.flush()
        except OSError as e:                         # git died (BrokenPipeError is an OSError): refuse, never trace
            raise Refused(4, "the mirror's object reader stopped (%s) while asking for %s" % (e, oid[:12]))
        header = self.p.stdout.readline().split()
        if len(header) != 3:
            raise Refused(4, "the mirror cannot serve %s %s (%s)" % (kind, oid[:12], b" ".join(header).decode()))
        typ, size = header[1].decode(), int(header[2])
        data = self.p.stdout.read(size)
        if len(data) != size:
            # Langston, part-1 r5 record item 2: a reader that died mid-object returns SHORT, and the re-hash below
            # would then blame the mirror for a forgery (exit 5). A short read is the reader stopping: exit 4.
            raise Refused(4, "the mirror's object reader stopped mid-object at %s (%d of %d bytes)" %
                          (oid[:12], len(data), size))
        self.p.stdout.read(1)                                  # the newline after each object
        if typ != kind:
            raise Refused(5, "%s in the mirror is a %s, not a %s" % (oid[:12], typ, kind))
        got = hashlib.sha1(b"%s %d\0" % (kind.encode(), len(data)) + data).hexdigest()
        if got != oid:
            raise Refused(5, "%s %s in the mirror re-hashes to %s - its object is not what GitHub served" %
                          (kind, oid[:12], got[:12]))
        return data

    def close(self):
        try:
            self.p.stdin.close()
            self.p.wait(timeout=30)
        except Exception:
            self.p.kill()


def commit_parents(data):
    """The parent ids from a commit's header (the lines before the first blank line)."""
    out = []
    for line in data.split(b"\n"):
        if not line:
            break
        if line.startswith(b"parent "):
            out.append(line[7:].decode().strip())
    return out


def verified_ancestor(mirror, sha, head, limit=None):
    """True iff `sha` is reachable from `head` through commits that each re-hash to their id (Langston r3 B-4).
    False if the walk ends without reaching it; Refused(4) past `limit` commits; Refused(5) on a forged commit."""
    limit = WALK_LIMIT if limit is None else limit
    reader = BatchReader(mirror)
    seen, queue = set(), [head]
    try:
        while queue:
            c = queue.pop(0)
            if c in seen:
                continue
            seen.add(c)
            if c == sha:
                return True
            if len(seen) > limit:
                raise Refused(4, "walked %d commits back from %s without reaching %s - refused; install a more "
                                 "recent reviewed commit" % (limit, head[:12], sha[:12]))
            queue.extend(commit_parents(reader.read(c, "commit")))
        return False
    finally:
        reader.close()


def tree_entry(tree, name):
    i = 0
    while i < len(tree):
        sp = tree.index(b" ", i)
        nul = tree.index(b"\0", sp)
        if tree[sp + 1:nul] == name:
            return tree[i:sp], tree[nul + 1:nul + 21].hex()
        i = nul + 21
    return None


def verified_blob(mirror, commit, path=REPO_PATH):
    """(blob id, bytes) for <commit>:<path>, every object on the path re-hashed here (Langston r2 B-3)."""
    c = read_verified(mirror, commit, "commit")
    first = c.split(b"\n", 1)[0]
    if not first.startswith(b"tree "):
        raise Refused(4, "commit %s has no tree line" % commit[:12])
    tid = first[5:].decode()
    parts = path.split("/")
    for d in parts[:-1]:
        e = tree_entry(read_verified(mirror, tid, "tree"), d.encode())
        if not e or e[0] != b"40000":
            raise Refused(4, "%s has no directory %s on %s" % (commit[:12], d, path))
        tid = e[1]
    e = tree_entry(read_verified(mirror, tid, "tree"), parts[-1].encode())
    if not e or e[0] not in (b"100644", b"100755"):
        raise Refused(4, "%s has no file %s" % (commit[:12], path))
    return e[1], read_verified(mirror, e[1], "blob")


def immutable(path):
    try:
        rc, out, _e = run(["lsattr", "-d", path])
    except OSError:
        # unknown: never reported as protected. OSError, not only ToolTimeout (Langston part 2a, item 1): a missing or
        # non-executable lsattr raises FileNotFoundError / PermissionError, and live_state() calls this OUTSIDE the
        # install's try, so the operator got a traceback and exit 1 instead of INSTALLED and a documented code.
        return None
    if rc != 0 or not out:
        return None
    return "i" in out.split()[0]


def set_immutable(path, on):
    rc, _o, err = run(["chattr", "+i" if on else "-i", path])
    if rc != 0:
        raise OSError("chattr %s %s failed: %s" % ("+i" if on else "-i", path, err))


def live_state():
    """(bytes or None, description, is_regular_root_0644, immutable)"""
    try:
        fd = os.open(TARGET, os.O_RDONLY | os.O_NOFOLLOW)
    except FileNotFoundError:
        return None, "absent", False, None
    except OSError as e:
        if os.path.islink(TARGET):
            return None, "a symbolic link (not followed, not backed up)", False, None
        raise Refused(6, "cannot open %s (%s)" % (TARGET, e))
    try:
        st = os.fstat(fd)
        if not stat.S_ISREG(st.st_mode):
            return None, "not a regular file (mode %o)" % st.st_mode, False, None
        chunks = []
        while True:
            chunk = os.read(fd, 1 << 20)
            if not chunk:
                break
            chunks.append(chunk)
    finally:
        os.close(fd)
    ok = st.st_uid == 0 and st.st_gid == 0 and stat.S_IMODE(st.st_mode) == 0o644
    imm = immutable(TARGET)
    return b"".join(chunks), "a regular file, owner %d:%d mode %o, immutable %s" % (
        st.st_uid, st.st_gid, stat.S_IMODE(st.st_mode), imm), ok, imm


def record_matches(new_sha):
    try:
        with open(os.path.join(BACKUP_DIR, "INSTALLED"), encoding="utf-8") as fh:
            a = json.load(fh)
        with open(PUBLIC_RECORD, encoding="utf-8") as fh:
            b = json.load(fh)
        return a.get("sha256") == new_sha and b.get("sha256") == new_sha
    except Exception:
        return False


def write_record(sha, new_sha, blob_id):
    rec = json.dumps({"installed_at": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()), "commit": sha,
                      "path": REPO_PATH, "blob": blob_id, "sha256": new_sha, "target": TARGET}) + "\n"
    for path, mode in ((os.path.join(BACKUP_DIR, "INSTALLED"), 0o600), (PUBLIC_RECORD, 0o644)):
        os.makedirs(os.path.dirname(path), exist_ok=True)
        fd, tmp = tempfile.mkstemp(prefix=".rules-installed-", dir=os.path.dirname(path))
        with os.fdopen(fd, "w", encoding="utf-8") as fh:
            fh.write(rec)
            fh.flush()
            os.fchown(fh.fileno(), 0, 0)
            os.fchmod(fh.fileno(), mode)
            os.fsync(fh.fileno())
        os.replace(tmp, path)


def install(argv):
    args = [a for a in argv if a != "--dry-run"]
    dry = "--dry-run" in argv
    if os.geteuid() != 0:
        raise Refused(3, "run as root")
    if len(args) != 1 or not re.fullmatch(r"[0-9a-f]{40}", args[0]):
        raise Refused(2, "usage: langston-rules-install <full-40-char-sha> [--dry-run]")
    sha = args[0]
    head = github_head()
    rc, _o, err = git(MIRROR, "cat-file", "-e", head + "^{commit}")
    if rc != 0:
        raise Refused(4, "the mirror does not yet hold GitHub's head %s - wait for its sync and re-run" % head[:12])
    if not verified_ancestor(MIRROR, sha, head):
        raise Refused(4, "%s is not reachable from GitHub's %s head %s through verified commits" %
                      (sha, BRANCH, head[:12]))
    blob_id, data = verified_blob(MIRROR, sha)
    old, desc, ok, imm = live_state()
    new_sha = hashlib.sha256(data).hexdigest()
    print("live %s: %s" % (TARGET, desc))
    print("install %s (%d B) from %s, GitHub head %s, every object on the path re-hashed" %
          (new_sha[:12], len(data), sha[:12], head[:12]))
    if old == data and ok and (imm or not USE_IMMUTABLE) and record_matches(new_sha):
        print("already installed - content, root:root 0644, protection and the record all hold")
        return 0
    if old == data:
        print("content matches but owner/mode/protection/record do not - re-installing to fix them")
    if dry:
        print("DRY RUN - nothing written")
        return 0
    replaced = False
    try:
        os.makedirs(BACKUP_DIR, mode=0o700, exist_ok=True)
        os.chmod(BACKUP_DIR, 0o700)
        if old is not None:
            bpath = os.path.join(BACKUP_DIR, hashlib.sha256(old).hexdigest() + ".md")
            if not os.path.exists(bpath):
                fd = os.open(bpath, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
                with os.fdopen(fd, "wb") as fh:
                    fh.write(old)
                    fh.flush()
                    os.fsync(fh.fileno())
            print("previous version kept at %s" % bpath)
        fd, tmp = tempfile.mkstemp(prefix="stage-", dir=BACKUP_DIR)
        try:
            with os.fdopen(fd, "wb") as fh:
                fh.write(data)
                fh.flush()
                os.fchown(fh.fileno(), 0, 0)
                os.fchmod(fh.fileno(), 0o644)
                os.fsync(fh.fileno())
            try:
                if USE_IMMUTABLE and os.path.lexists(TARGET) and not os.path.islink(TARGET) and immutable(TARGET):
                    set_immutable(TARGET, False)
                os.replace(tmp, TARGET)
                replaced = True
            finally:
                if USE_IMMUTABLE and os.path.exists(TARGET) and not os.path.islink(TARGET):
                    set_immutable(TARGET, True)
        finally:
            if os.path.lexists(tmp):
                os.unlink(tmp)
    except OSError as e:
        raise Refused(6, "write or protect failed (%s: %s); the live file %s" % (
            type(e).__name__, e, "WAS replaced - check its flag" if replaced else "was NOT replaced"))
    try:
        write_record(sha, new_sha, blob_id)
    except OSError as e:
        raise Refused(6, "INSTALLED, but the record could not be written (%s: %s) - re-run the same command: it is "
                         "safe and rewrites the record; until then the size watch will report a mismatch" % (
                             type(e).__name__, e))
    back, desc, ok, imm = live_state()
    good = back == data and ok and (imm or not USE_IMMUTABLE)
    print("INSTALLED: %s now %s, sha256 %s" % (TARGET, desc, hashlib.sha256(back or b"").hexdigest()[:12]))
    return 0 if good else 6


def main(argv):
    try:
        return install(argv)
    except Refused as r:
        print("REFUSED: " + str(r))
        return r.code


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
