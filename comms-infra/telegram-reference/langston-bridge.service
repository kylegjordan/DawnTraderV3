[Unit]
Description=Langston Telegram bridge (Claude Code via custom polling)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=langston
Group=langston
WorkingDirectory=/home/langston
Environment="HOME=/home/langston"
Environment="PATH=/usr/local/bin:/usr/bin:/bin"
ExecStart=/usr/bin/python3 /usr/local/bin/langston-bridge.py
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
