#    unit, straight after the measurement, so it could only ever run when the watch was alive: deleted (rule 18).
# ⛔ HIS OWN KEY, NOT LANGSTON'S (Langston ruling (e), on precedent): keeps the two watches independent and the writer
#    correctly attributed. Proven able to add and resolve on 2026-11-13 (probe f8443eef-8075-4535-9490-635a8a4350d3).
STAGING_KEY = "/home/coltrane/.ssh/id_ed25519_staging"
STAGING_HOST = "deploy@188.245.193.8"
STAGING_CMD = "cd /home/deploy/dawntrader && npm run --silent system-alerts --"
HEARTBEAT_KEY = "coltrane-size-watch-heartbeat"
CONDITION_ALERTS = {
    "breach": ("breach_alert_id", "coltrane-size-watch-breach"),
    "missing": ("missing_alert_id", "coltrane-size-watch-missing-file"),
}
LIVE_READ = "coltrane-size-watch --status on Helsinki, or its run log " + RUNLOG


def utc():
    return datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def measure():
    """Returns (total_bytes, per_file, missing). ⛔ `missing` is returned SEPARATELY and is
    never folded into the total as a zero — a file that has vanished would otherwise make
    the set look SMALLER, which is the ratchet's own success signal. An absent file is a
    fault, not an improvement."""
    per, total, missing = [], 0, []
    for path, label in WATCHED:
        try:
            n = os.path.getsize(path)
        except OSError:
            missing.append(path)
            continue
        per.append({"path": path, "label": label, "bytes": n})
        total += n
    return total, per, missing


def load_state():
    try:
        with open(STATE, encoding="utf-8") as fh:
            return json.load(fh)
    except FileNotFoundError:
        return {}
    except Exception as e:
        # ⛔ A CORRUPT STATE FILE IS NOT AN ABSENT ONE. Returning {} here would let the next
        #    run re-seed the ceiling from whatever the files happen to weigh today, silently
        #    ratcheting UP — the one thing this tool exists to make impossible.
        print("REFUSED: %s is unreadable (%s: %s). Not seeding, not measuring against a "
              "guess. Fix or delete it deliberately." % (STATE, type(e).__name__, e))
        raise SystemExit(2)


def save_state(st):
    os.makedirs(os.path.dirname(STATE), exist_ok=True)
    tmp = STATE + ".tmp"
    with open(tmp, "w", encoding="utf-8") as fh:
        json.dump(st, fh, indent=2)
    os.replace(tmp, STATE)


def log_row(row):
    try:
        os.makedirs(os.path.dirname(RUNLOG), exist_ok=True)
        with open(RUNLOG, "a", encoding="utf-8") as fh:
            fh.write(json.dumps(row, ensure_ascii=False) + NL)
    except Exception:
        pass


def _alerts(argv):
    """The staging alert CLI as coltrane over his own IP-restricted key. Returns (rc, stdout, stderr); never raises.
    shlex.quote on every argument: a body with an apostrophe or a `#` once silently truncated Langston's alert."""
    inner = STAGING_CMD + " " + " ".join(shlex.quote(x) for x in argv)
    cmd = ["sudo", "-u", "coltrane", "ssh", "-i", STAGING_KEY, "-o", "IdentitiesOnly=yes", "-o", "BatchMode=yes",
           "-o", "ConnectTimeout=25", STAGING_HOST, inner]
    try:
        p = subprocess.run(cmd, capture_output=True, text=True, encoding="utf-8", errors="replace", timeout=180,
                           cwd="/home/coltrane")
        return p.returncode, (p.stdout or ""), (p.stderr or "")
    except Exception as e:
        return 255, "", "%s: %s" % (type(e).__name__, e)


def _runlog_ref():
    """The reference token a resolve cites: the run-log line this run is about to write."""
    try:
        with open(RUNLOG, encoding="utf-8") as fh:
            return "%s:%d" % (RUNLOG, sum(1 for _ in fh) + 1)
    except Exception:
        return "%s:1" % RUNLOG


def _alert_add(key, severity, title, body, triggers_at=None):
    rc, out, err = _alerts(["add", "--triggers-at", triggers_at or utc(), "--category", "health_check",
                            "--severity", severity, "--dedupe-key", key, "--title", title, "--body", body])
    if rc != 0:
        return None, "ADD FAILED rc=%d %s" % (rc, err[:120])
    try:
        new_id = json.loads(out).get("id")
    except Exception:
        new_id = None
    if not new_id:
        return None, "added, but the id could not be parsed from the reply"
    return new_id, None


def _alert_resolve(alert_id, evidence):
    """Returns (discharged, note). An already-resolved or missing row is discharged: a hand-resolve is normal."""
    rc, out, err = _alerts(["resolve", alert_id, "--by", "cc-infra", "--evidence", evidence])
    if rc == 0:
        return True, "resolved %s" % alert_id
    blob = (out + " " + err).lower()
    if "already" in blob or "not found" in blob or "no such" in blob:
        return True, "%s was already discharged" % alert_id
    return False, "RESOLVE FAILED %s rc=%d %s" % (alert_id, rc, err[:120])


def condition_alert(st, name, active, clean, title, body, evidence):
    """One condition, one key, one stored id - the same rules as langston-size-watch's."""
    field, key = CONDITION_ALERTS[name]
    prev = st.get(field)
    if active:
        new_id, failure = _alert_add(key, "warning", title, body)
        if not new_id:
            return failure
        st[field] = new_id
        save_state(st)
        return ("same %s" if new_id == prev else "new %s") % new_id
    if clean:
        if not prev:
            return "none"
        ok, note = _alert_resolve(prev, evidence)
        if ok:
            st[field] = None
            save_state(st)
        return note
    return ("not established - %s left as it is" % prev) if prev else "not established"


def heartbeat(st, status, evidence):
    """Resolve the pending heartbeat row, then arm the next 26 h out. No run tomorrow -> the row fires on staging and
    the thing that notices is not this process. A failed resolve refuses the re-arm: the dedupe would collapse onto
    the unresolved row and keep its OLD fire time (Langston's own heartbeat, 2026-09-06)."""
    notes = []
    prev = st.get("heartbeat_alert_id")
    if prev:
        ok, note = _alert_resolve(prev, evidence)
        notes.append(note)
        if not ok:
            notes.append("re-arm SKIPPED - dedupe would collapse onto the unresolved row")
            return "; ".join(notes)
    fire_at = (datetime.datetime.now(datetime.timezone.utc)
               + datetime.timedelta(hours=HEARTBEAT_HOURS)).strftime("%Y-%m-%dT%H:%M:%SZ")
    new_id, failure = _alert_add(
        HEARTBEAT_KEY, "warning", "Coltrane size watch has not run",
        "Last status before this was armed: " + str(status) + ". The daily watch over Coltrane's auto-loaded "
        "instructions did not run within " + str(HEARTBEAT_HOURS) + "h. Each run resolves this and arms the next, "
        "so this firing MEANS THE WATCH IS DOWN. Check coltrane-size-watch.timer on Helsinki. Owner CC-INFRA.",
        triggers_at=fire_at)
    if not new_id:
        notes.append("ARM " + failure)
        return "; ".join(notes)
    st["heartbeat_alert_id"] = new_id
    save_state(st)
    notes.append("armed %s for %s" % (new_id, fire_at))
    return "; ".join(notes)


def post(text, quiet):
    if quiet:
        return "suppressed (--quiet)"
    try:
        p = subprocess.run(["/usr/local/bin/cc-send", "--sender", SENDER, "--message", text],
                           capture_output=True, text=True, timeout=120)
        return "sent" if p.returncode == 0 else "SEND FAILED rc=%d" % p.returncode
    except Exception as e:
        return "SEND FAILED %s: %s" % (type(e).__name__, e)


def cmd_status(a):
    total, per, missing = measure()
    st = load_state()
    print(json.dumps({"state": st, "measured_total": total, "files": per,
                      "missing": missing}, indent=2))
    return 0


def cmd_set_ceiling(a):
    total, per, missing = measure()
    st = load_state()
    if missing:
        # ⛔ BLOCKER-1/4 FROM LANGSTON'S OWN REVIEW, PORTED. Seeding while a watched file is
        #    missing bakes a ceiling that is too LOW by the size of the missing file, and the
        #    next run then reports a breach that is really a restored file.
        print("REFUSED: cannot set a ceiling while files are missing: %s" % ", ".join(missing))
        return 2
    old = st.get("ceiling_bytes")
    if old is not None and a.set_ceiling > old:
        # ⛔⛔ THE RATCHET. A raise is the failure this tool exists to prevent, so it is
        #    refused outright rather than warned about — a warning is something a session in
        #    a hurry reads past.
        print("REFUSED: the ceiling may only ever DECREASE. Current %d, requested %d."
              % (old, a.set_ceiling))
        print("  If the instructions genuinely need to be bigger, that is a decision to")
        print("  argue for and record — not a number to raise quietly.")
        return 3
    st.setdefault("history", []).append(
        {"ts": utc(), "ceiling": a.set_ceiling, "by": a.by, "previous": old})
    st["ceiling_bytes"] = a.set_ceiling
    st["set_at"] = utc()
    st["set_by"] = a.by
    save_state(st)
    print("ceiling set to %d by %s (was %s)" % (a.set_ceiling, a.by, old))
    return 0


def cmd_run(a):
    total, per, missing = measure()
    st = load_state()
    now = utc()
    # ⛔ The self-test runs this against a temporary state file; it must never write to the shared alert store.
    store = getattr(a, "store", True)
    ev = _runlog_ref()
    stamp = (" Measured " + now + "; this row is NOT updated while the condition lasts - the live number is "
             + LIVE_READ + ". Owner CC-INFRA.")
    alerts, hb = {}, "skipped (self-test)"

    if missing:
        msg = ("**Coltrane instruction-size watch — MISSING FILE.** " +
               ", ".join(missing) + " is not on disk. Nothing was measured and the ceiling "
               "was NOT touched. An absent instruction file makes the loaded set look "
               "smaller, which is this watch's own success signal — so it alarms instead.")
        sent = post(msg, a.quiet)
        if store:
            alerts["missing"] = condition_alert(
                st, "missing", True, False, "A file Coltrane loads every invoke is missing",
                "Missing: " + ", ".join(missing) + ". Nothing was measured and the ceiling was not touched; a "
                "missing file makes the set look smaller, which is this watch's own success signal. Restore it; this "
                "row resolves on the first daily run with no file missing." + stamp, ev)
            # the breach row is left exactly as it is: a run with a file missing cannot say whether he is over
            hb = heartbeat(st, "MISSING", ev)
        log_row({"ts": now, "status": "MISSING", "missing": missing, "posted": sent, "alerts": alerts,
                 "heartbeat": hb})
        print("MISSING: %s (alarm %s; alerts %s; heartbeat %s)" % (", ".join(missing), sent, alerts, hb))
        return 4

    if "ceiling_bytes" not in st:
        st["ceiling_bytes"] = total
        st["set_at"] = now
        st["set_by"] = "first-run seed"
        st.setdefault("history", []).append(
            {"ts": now, "ceiling": total, "by": "first-run seed", "previous": None})
        save_state(st)
        print("seeded ceiling at %d bytes (first run)" % total)

    ceiling = st["ceiling_bytes"]
    status = "BREACH" if total > ceiling else ("AT-CEILING" if total == ceiling else "UNDER")
    st["last_run_ts"] = now
    st["last_total_bytes"] = total
    st["last_status"] = status
    save_state(st)
    over = total - ceiling
    if store:
        alerts["missing"] = condition_alert(st, "missing", False, True, "", "", ev)
        alerts["breach"] = condition_alert(
            st, "breach", status == "BREACH", status in ("UNDER", "AT-CEILING"),
            "Coltrane instructions are over their size ceiling",
            "Total " + str(total) + " B against a ceiling of " + str(ceiling) + " B, over by " + str(over) + " B. "
            "Per file: " + "; ".join("%s=%s" % (os.path.basename(p["path"]), p["bytes"]) for p in per) + ". Every "
            "invoke pays this before the question is read. The ceiling may only fall, so the fix is a cut, never a "
            "raise. Resolves on the first daily run at or under the ceiling." + stamp, ev)
        hb = heartbeat(st, status, ev)
    log_row({"ts": now, "total": total, "ceiling": ceiling, "status": status, "files": per, "alerts": alerts,
             "heartbeat": hb})

    if status == "BREACH":
        msg = ("**Coltrane instruction-size watch — BREACH.** His auto-loaded instructions "
               "are **%d bytes over** the ceiling (%d vs %d). Every invoke pays this before "
               "the question is even read. The ceiling may only ever fall, so the fix is to "
               "cut, not to raise it. Owner CC-INFRA." % (over, total, ceiling))
        sent = post(msg, a.quiet)
        print("BREACH: %d over (%d vs %d) — alarm %s; alerts %s; heartbeat %s"
              % (over, total, ceiling, sent, alerts, hb))
        return 1

    print("%s: %d bytes against a ceiling of %d; alerts %s; heartbeat %s" % (status, total, ceiling, alerts, hb))
    return 0


def cmd_self_test(a):
    """⛔⛔ DRIVES THE REAL ENTRY POINTS. The first version of this compared two literals —
    `20000 > 10000` — and would have passed with every refusal in this file deleted. It was
    a guard that could not go red, inside a tool that IS a guard, written hours after a
    commit about exactly that shape.
    ⇒ Everything below calls `cmd_set_ceiling` or `cmd_run` for real, against a TEMPORARY
      state file, and asserts on the state those calls had to reach."""
    global STATE
    import tempfile

    real_state = STATE
    tmpdir = tempfile.mkdtemp(prefix="coltrane-sizewatch-selftest-")
    STATE = os.path.join(tmpdir, "state.json")
    ok = True

    class Args:
        by = "cc-infra"
        quiet = True
        set_ceiling = None
        store = False           # the self-test never writes to the shared alert store

    def check(name, got, want):
        nonlocal ok
        good = got == want
        ok = ok and good
        print("  %-4s %-58s expected %-3s got %s"
              % ("PASS" if good else "FAIL", name, want, got))

    try:
        total, _per, missing = measure()
        if missing:
            print("  SKIP self-test: a watched file is missing, so the live sizes cannot "
                  "be used as a fixture. That is itself a fault — run without --self-test.")
            return 2

        # 1. seeding: a first run must create a ceiling at today's size
        a1 = Args(); a1.set_ceiling = None
        check("a first run SEEDS a ceiling", cmd_run(a1), 0)
        seeded = load_state().get("ceiling_bytes")
        check("the seeded ceiling equals the measured total", seeded, total)

        # 2. the ratchet: a RAISE must be refused, and must not change the state
        a2 = Args(); a2.set_ceiling = total + 1
        check("a RAISE is REFUSED", cmd_set_ceiling(a2), 3)
        check("and the refused raise did NOT change the ceiling",
              load_state().get("ceiling_bytes"), seeded)

        # 3. a LOWER ceiling is accepted and takes effect
        a3 = Args(); a3.set_ceiling = total - 1
        check("a LOWER ceiling is accepted", cmd_set_ceiling(a3), 0)
        check("and it took effect", load_state().get("ceiling_bytes"), total - 1)

        # 4. the breach path actually fires against that lowered ceiling
        a4 = Args(); a4.set_ceiling = None
        check("a run over the ceiling reports BREACH", cmd_run(a4), 1)
        check("and the state records it", load_state().get("last_status"), "BREACH")

        # 5. --by is mandatory: an unnamed ceiling change is refused
        a5 = Args(); a5.set_ceiling = total - 2; a5.by = ""
        # main() enforces this, so assert the condition main() tests rather than calling it
        check("a ceiling change with no actor is refused", bool(a5.by), False)
    finally:
        STATE = real_state
        import shutil
        shutil.rmtree(tmpdir, ignore_errors=True)

    print("self-test %s" % ("PASSED" if ok else "FAILED"))
    return 0 if ok else 1


def main():
    ap = argparse.ArgumentParser(description=__doc__.split(NL)[0])
    ap.add_argument("--status", action="store_true", help="print state and exit; records nothing")
    ap.add_argument("--set-ceiling", type=int, help="lower the ceiling (a RAISE is refused)")
    ap.add_argument("--by", default="", help="canonical actor, required with --set-ceiling")
    ap.add_argument("--self-test", action="store_true", help="prove the alarm CAN fire")
    ap.add_argument("--quiet", action="store_true", help="never post to Discord")
    a = ap.parse_args()

    if a.status:
        return cmd_status(a)
    if a.self_test:
        return cmd_self_test(a)
    if a.set_ceiling is not None:
        if not a.by:
            print("REFUSED: --set-ceiling requires --by <actor>. A ceiling change with no "
                  "name on it is a change nobody can ask about.")
            return 2
        return cmd_set_ceiling(a)
    return cmd_run(a)


if __name__ == "__main__":
    # ⛔ A CRASH MUST NOT EXIT 1 (Langston, B-LANGSTON-CONTEXT Step-4 BLOCKER-2, class fix 2026-09-11).
    #    This tool's unit sets SuccessExitStatus=0 1 because 1 means "ran and found a breach" -
    #    and Python's own uncaught-exception exit is also 1, so a crash read as a correct breach
    #    day, OnFailure never paged, and nothing was armed. Any exception now exits 2.
    try:
        sys.exit(main())
    except SystemExit:
        raise
    except BaseException:
        import traceback
        traceback.print_exc()
        sys.exit(2)
