#    and are not counted; this is the part WE control and the part that grew.
WATCHED = [
    (os.path.join(HOME, ".codex/AGENTS.md"), "Coltrane's instruction file (auto-loaded every invoke)"),
]
STATE = "/opt/coltrane-memory/ratchet-state.json"
RUNLOG = "/opt/coltrane-memory/size-watch.jsonl"
SENDER = "Infra Claude"
NL = chr(10)
HEARTBEAT_HOURS = 26          # the daily timer, plus slack

