#!/usr/bin/env python3
"""Remove only the 53 reviewed B-DB-HELPER-RETIRE live helpers.

Default mode is verification. Removal is root-only, manifest-driven, and happens
only after every path's bytes and metadata match. It never touches the app
checkout, the database, a process, a service, or a directory tree.
"""

import datetime
import grp
import hashlib
import json
import os
import pwd
import stat
import sys

# ── CONSTANTS (the test harness substitutes only this block) ──
MANIFEST = "/usr/local/share/dawntrader/b-db-helper-retire-manifest.json"
STATE_DIR = "/var/lib/dt-db-helper-retire"
TARGET_DIR = "/home/deploy"
EXPECTED_COUNT = 53
REVIEWED_REF = "3261801a157a66e1fdf36eae69b66b86893786a8"
ALLOWED_ACTORS = ("cc-infra", "codex-infra", "kyle")
REQUIRE_ROOT = True
# ── END CONSTANTS ──


class Refusal(Exception):
    pass


def load_manifest():
    with open(MANIFEST, encoding="utf-8") as fh:
        manifest = json.load(fh)
    if manifest.get("schema_version") != 1 or manifest.get("batch") != "B-DB-HELPER-RETIRE":
        raise Refusal("manifest identity/version differs")
    if manifest.get("reviewed_ref") != REVIEWED_REF:
        raise Refusal("manifest reviewed_ref differs")
    files = manifest.get("files")
    if not isinstance(files, list) or len(files) != EXPECTED_COUNT:
        raise Refusal("manifest file population differs")
    paths = [row.get("path") for row in files]
    if len(set(paths)) != EXPECTED_COUNT:
        raise Refusal("manifest paths are missing or duplicated")
    for row in files:
        path = row.get("path")
        if not isinstance(path, str) or os.path.dirname(path) != TARGET_DIR or os.path.basename(path) in ("", ".", ".."):
            raise Refusal("manifest contains a path outside the reviewed top-level /home/deploy set")
        if row.get("disposition") != "RETIRE" or row.get("source_batch") != "B-DB-HELPER-RETIRE":
            raise Refusal("manifest contains an unreviewed disposition/source")
        if not isinstance(row.get("sha256"), str) or len(row["sha256"]) != 64:
            raise Refusal("manifest contains an invalid SHA-256")
    return manifest


def digest_fd(fd):
    value = hashlib.sha256()
    os.lseek(fd, 0, os.SEEK_SET)
    while True:
        block = os.read(fd, 1024 * 1024)
        if not block:
            break
        value.update(block)
    return value.hexdigest()


def verify_row(row):
    path = row["path"]
    flags = os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0)
    try:
        fd = os.open(path, flags)
    except OSError as exc:
        raise Refusal("%s cannot be opened as a regular file: %s" % (path, exc)) from exc
    try:
        found = os.fstat(fd)
        if not stat.S_ISREG(found.st_mode):
            raise Refusal("%s is not a regular file" % path)
        expected_mode = int(row["mode"], 8)
        checks = {
            "bytes": (found.st_size, row["bytes"]),
            "mode": (stat.S_IMODE(found.st_mode), expected_mode),
            "owner": (pwd.getpwuid(found.st_uid).pw_name, row["owner"]),
            "group": (grp.getgrgid(found.st_gid).gr_name, row["group"]),
            "mtime_ns": (found.st_mtime_ns, int(row["mtime_ns"])),
            "sha256": (digest_fd(fd), row["sha256"]),
        }
        differences = [name for name, pair in checks.items() if pair[0] != pair[1]]
        if differences:
            raise Refusal("%s drifted in %s" % (path, ", ".join(differences)))
        return fd, found
    except Exception:
        os.close(fd)
        raise


def verify_all(manifest):
    verified = []
    try:
        for row in manifest["files"]:
            fd, found = verify_row(row)
            verified.append((row, fd, found))
        return verified
    except Exception:
        for _, fd, _ in verified:
            os.close(fd)
        raise


def close_all(verified):
    for _, fd, _ in verified:
        os.close(fd)


def state_path(name):
    return os.path.join(STATE_DIR, name)


def atomic_json(path, value):
    os.makedirs(STATE_DIR, mode=0o700, exist_ok=True)
    os.chmod(STATE_DIR, 0o700)
    pending = path + ".new"
    with open(pending, "w", encoding="utf-8") as fh:
        json.dump(value, fh, sort_keys=True)
        fh.write("\n")
        fh.flush()
        os.fsync(fh.fileno())
    os.chmod(pending, 0o600)
    os.replace(pending, path)
    directory_fd = os.open(STATE_DIR, os.O_RDONLY | getattr(os, "O_DIRECTORY", 0))
    try:
        os.fsync(directory_fd)
    finally:
        os.close(directory_fd)


def load_journal(manifest, actor):
    path = state_path("remove-journal.json")
    expected_paths = [row["path"] for row in manifest["files"]]
    if not os.path.exists(path):
        journal = {
            "schema_version": 1,
            "batch": "B-DB-HELPER-RETIRE",
            "reviewed_ref": REVIEWED_REF,
            "actor": actor,
            "status": "prepared",
            "prepared_at_utc": datetime.datetime.now(datetime.timezone.utc).isoformat(),
            "entries": [{"path": item, "state": "pending"} for item in expected_paths],
        }
        atomic_json(path, journal)
        return journal
    with open(path, encoding="utf-8") as fh:
        journal = json.load(fh)
    if journal.get("schema_version") != 1 or journal.get("batch") != "B-DB-HELPER-RETIRE" or journal.get("reviewed_ref") != REVIEWED_REF:
        raise Refusal("existing removal journal identity/version differs")
    if journal.get("actor") != actor:
        journal.setdefault("resume_actors", []).append({
            "actor": actor,
            "at_utc": datetime.datetime.now(datetime.timezone.utc).isoformat(),
        })
    entries = journal.get("entries")
    if not isinstance(entries, list) or [entry.get("path") for entry in entries] != expected_paths:
        raise Refusal("existing removal journal path population/order differs")
    if any(entry.get("state") not in ("pending", "removing", "removed") for entry in entries):
        raise Refusal("existing removal journal contains an invalid state")
    return journal


def persist_journal(journal):
    atomic_json(state_path("remove-journal.json"), journal)


def reconcile_journal(manifest, journal):
    changed = False
    for row, entry in zip(manifest["files"], journal["entries"]):
        exists = os.path.lexists(row["path"])
        if entry["state"] == "removed":
            if exists:
                raise Refusal("%s reappeared after a journaled removal" % row["path"])
            continue
        if entry["state"] == "removing" and not exists:
            entry["state"] = "removed"
            entry["reconciled_at_utc"] = datetime.datetime.now(datetime.timezone.utc).isoformat()
            changed = True
            continue
        fd, _ = verify_row(row)
        os.close(fd)
        if entry["state"] == "removing":
            entry["state"] = "pending"
            entry["reconciled_at_utc"] = datetime.datetime.now(datetime.timezone.utc).isoformat()
            changed = True
    if changed:
        persist_journal(journal)


def remove_all(manifest, actor):
    if REQUIRE_ROOT and os.geteuid() != 0:
        raise Refusal("--remove requires root")
    if actor not in ALLOWED_ACTORS:
        raise Refusal("--by must be an allowed actor")
    if os.path.exists(state_path("last-remove.json")):
        raise Refusal("removal already completed; use --status")
    if not os.path.exists(state_path("remove-journal.json")):
        verified = verify_all(manifest)
        close_all(verified)
    journal = load_journal(manifest, actor)
    reconcile_journal(manifest, journal)
    journal["status"] = "in_progress"
    persist_journal(journal)
    parent_fd = os.open(TARGET_DIR, os.O_RDONLY | getattr(os, "O_DIRECTORY", 0))
    try:
        for index, (row, entry) in enumerate(zip(manifest["files"], journal["entries"])):
            if entry["state"] == "removed":
                continue
            fd, before = verify_row(row)
            name = os.path.basename(row["path"])
            try:
                current = os.stat(name, dir_fd=parent_fd, follow_symlinks=False)
                if (current.st_dev, current.st_ino) != (before.st_dev, before.st_ino):
                    raise Refusal("%s changed identity before its removal transition" % row["path"])
                entry["state"] = "removing"
                entry["intent_at_utc"] = datetime.datetime.now(datetime.timezone.utc).isoformat()
                persist_journal(journal)
                # TEST_SEAM: before adjacent identity check and unlink
                current = os.stat(name, dir_fd=parent_fd, follow_symlinks=False)
                if (current.st_dev, current.st_ino) != (before.st_dev, before.st_ino):
                    raise Refusal("%s changed identity at its removal transition" % row["path"])
                # TEST_SEAM: before unlink
                os.unlink(name, dir_fd=parent_fd)
                os.fsync(parent_fd)
            finally:
                os.close(fd)
            entry["state"] = "removed"
            entry["removed_at_utc"] = datetime.datetime.now(datetime.timezone.utc).isoformat()
            persist_journal(journal)
    finally:
        os.close(parent_fd)
    journal["status"] = "complete"
    journal["completed_at_utc"] = datetime.datetime.now(datetime.timezone.utc).isoformat()
    persist_journal(journal)
    receipt = {
        "schema_version": 1,
        "batch": "B-DB-HELPER-RETIRE",
        "reviewed_ref": REVIEWED_REF,
        "actor": actor,
        "removed_count": EXPECTED_COUNT,
        "removed_paths": [row["path"] for row in manifest["files"]],
        "removed_at_utc": datetime.datetime.now(datetime.timezone.utc).isoformat(),
    }
    atomic_json(state_path("last-remove.json"), receipt)
    print("REMOVED %d exact reviewed helpers; no deploy or restart performed" % EXPECTED_COUNT)


def usage():
    raise Refusal("usage: dt-db-helper-retire [--verify | --remove --by <actor> | --status]")


def main(argv):
    if argv in ([], ["--verify"]):
        manifest = load_manifest()
        verified = verify_all(manifest)
        close_all(verified)
        print("VERIFIED %d exact reviewed helpers; no changes made" % EXPECTED_COUNT)
        return
    if argv == ["--status"]:
        path = state_path("last-remove.json")
        if not os.path.isfile(path):
            path = state_path("remove-journal.json")
        if not os.path.isfile(path):
            print("NOT REMOVED")
            return
        with open(path, encoding="utf-8") as fh:
            print(fh.read().strip())
        return
    if len(argv) == 3 and argv[0] == "--remove" and argv[1] == "--by":
        remove_all(load_manifest(), argv[2])
        return
    usage()


if __name__ == "__main__":
    try:
        main(sys.argv[1:])
    except (Refusal, OSError, KeyError, TypeError, ValueError) as exc:
        print("REFUSED: %s" % exc, file=sys.stderr)
        sys.exit(2)
