[Unit]
Description=Are the B-CREDENTIALS-PRIVATE-REPO files installed on this box the committed copies? (dt-install-drift)
Documentation=file:///usr/local/sbin/dt-install-drift
# OnFailure= comes from a per-box drop-in: staging pages through dt-unit-failure@ (a system
# alert), Helsinki through agent-unit-failure@ (the crew channel). The unit file is shared.

[Service]
Type=oneshot
# r3 S5: a run that cannot even start (a broken interpreter, a missing file) must not leave the LAST
# run's failure list for the paging unit to read. The script also rewrites it first thing.
ExecStartPre=/bin/rm -f /run/dt-install-drift.classes
ExecStart=/usr/local/sbin/dt-install-drift
TimeoutStartSec=1800
