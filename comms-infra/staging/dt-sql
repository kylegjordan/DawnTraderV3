#!/usr/bin/env python3
"""dt-sql — the ONE way a session or reviewer reads the staging database. It can never send a wrong password twice.

B-DB-READ-TOOL (Kyle KD-96, 2026-11-16; `#1259`). Scope `Scope Files/B_DB_READ_TOOL_SCOPE.md`, pre-audit and plan r2.
B-DB-READONLY-ROLE (Kyle KD-100, row 5a1): the login moved to the read-only role `dt_reader`, made by
/usr/local/bin/dt-sql-login. Scope `Scope Files/B_DB_READONLY_ROLE_SCOPE.md`, pre-audit and plan.

WHY IT EXISTS: on 2026-11-16 a reviewer's hand-built `psql` sent the password still URL-encoded (it carries a `%40`),
and libpq's default `sslmode=prefer` retried every failed login WITHOUT SSL — two wrong passwords per call (measured
against a local listener: prefer 2, require 1, disable 1). Supabase bans an address after two wrong passwords in a row;
the whole app lost its database for ~60 minutes.

USAGE (as root or deploy; as root it re-runs itself as deploy):
    dt-sql -c "<sql>"            one statement or a few, separated by ';'
    dt-sql -f <file>             a file of SQL
    dt-sql < file.sql            SQL on stdin
    dt-sql --csv ...             CSV output (default: unaligned, '|'-separated, tuples only)
    dt-sql --status              print the lock state and exit
    dt-sql --unlock --by <actor> clear a LOCKED state (after finding out why it locked)

EXIT CODES
    0  the query ran
    1  logged in, but the SQL failed (syntax, a read-only refusal from the server, a timeout): NOT a login problem
    2  REFUSED before any login attempt: by dt-sql's own rules (usage, or SQL that tries to switch read-only off), or by
       the login step before it connected (no reader file, a backslash in the SQL, sudo refused ...). Nothing is locked
    3  "Connection refused": the address may be BANNED — do not retry; no password was judged
    4  LOCKED: an earlier call failed its login, or ended without a result. `dt-sql --status` says which; unlock by hand
    5  BUSY: another dt-sql call is running right now (one at a time, never queued)
    6  TRANSPORT: the session failed its own TLS check, so the SQL did not run. NOT locked (no password was judged
       wrong, no ban risk); a critical alert is raised, and every call fails the same way until it is fixed
    (anything unexpected BEFORE an attempt exits 2, never 1: 1 means only "logged in, the SQL failed")

THE LOGIN IS NOT HERE (B-DB-READONLY-ROLE). dt-sql keeps the lock, the INTENT record and LOCKED; it reads no .env and
no password. It runs `sudo -n -u dtsql /usr/local/bin/dt-sql-login [--csv]` with the checked SQL on stdin. That
helper, as the locked account `dtsql`, reads /etc/dt-sql/reader.env (deploy cannot), refuses unless this call's lock
is held and its INTENT exists, and makes ONE psql attempt: `sslmode=verify-full` against the Supabase CA copy in
/etc/dt-sql, `hostaddr` pinned to one resolved address, `connect_timeout=15`, the password in its own environment
(never argv) — then checks IN THE SESSION that the connection is TLS before the SQL runs. Just before psql starts it
writes `dt-sql-login: ready` to stderr (dt-sql strips that line): no ready line means no attempt was made, so the
INTENT is removed and nothing locks. A call that reaches CALL_TIMEOUT_S ALWAYS locks `ambiguous`, ready line or not.

FAIL CLOSED (scope OBJ-3, Langston A-1/C-1/C-2): under an exclusive, NON-BLOCKING lock it writes an INTENT record
BEFORE the attempt and removes it only on a clean result (a run that logged in, a "Connection refused" before any
password was judged, a TLS-check refusal, or the login step refusing before it connected). A wrong password locks the
arm `credential` and raises a critical alert; anything it cannot classify — a timeout, a signal, an unparsed failure —
locks the arm `ambiguous`. A call killed mid-attempt leaves its INTENT behind, and the next call reads that as LOCKED
(`ambiguous`). Every later call refuses until --unlock.
⚠️ The guarantee is dt-sql's own: LOCKED is dt-sql's state, and the ban is per address, shared with the app, ~50
helper scripts and any hand-run psql. The `/usr/local/bin/psql` wrapper (same batch) refuses while LOCKED or INTENT
exists. /var/lib/dt-sql is 0755 (B-DB-READONLY-ROLE: the helper, as dtsql, must see the lock and the INTENT), so
every account's `[ -e ]` now sees in; log.jsonl is 0640.
Both arms raise an alert — `credential` critical, `ambiguous` warning — through `npm run system-alerts`, whose code
(`scripts/system-alerts.ts` -> `server/services/system-alerts.ts`) imports only fs/path/crypto and touches NO database,
so raising a page can never itself spend a login attempt.

READ-ONLY IS NOW A BOUNDARY (B-DB-READONLY-ROLE): `dt_reader` is NOSUPERUSER NOCREATEDB NOCREATEROLE NOREPLICATION
NOBYPASSRLS, granted pg_read_all_data and pg_monitor, with default_transaction_read_only on; the helper sets it again
in PGOPTIONS with a statement timeout, and SQL naming the read-only setting is still refused before connecting.
Two limits, stated: `deploy` can still read the app's WRITE login in .env, so this binds dt-sql, not the deploy
account; and row-level security makes 26 tables (16 in `auth`, 10 in `storage`) read as EMPTY to this role — an
empty result there is NOT an absence.
"""

import datetime
import fcntl
import json
import os
import pwd
import re
import signal
import subprocess
import sys

# ── CONSTANTS (the test harness substitutes ONLY this block) ──
STATE_DIR = "/var/lib/dt-sql"
LOGIN = ["/usr/bin/sudo", "-n", "-u", "dtsql", "/usr/local/bin/dt-sql-login"]   # the login step (B-DB-READONLY-ROLE)
RUN_AS = "deploy"
RUNUSER = "/usr/sbin/runuser"
CALL_TIMEOUT_S = 300
TERM_GRACE_S = 5                 # after a timeout's SIGTERM, how long the login step gets to stop psql before SIGKILL
APP_DIR = "/home/deploy/dawntrader"
# raising the alert: as deploy, a clean env, under `timeout -k` so a wedged npm/node dies with its whole group
ALERT_NPM = ["/usr/bin/timeout", "-k", "10", "120", "/usr/bin/env", "-i", "HOME=/home/deploy", "PATH=/usr/bin:/bin",
             "/usr/bin/npm", "--prefix", APP_DIR, "run", "-s", "system-alerts", "--"]
# ── END CONSTANTS ──

LOCK_FILE = os.path.join(STATE_DIR, "lock")
INTENT_FILE = os.path.join(STATE_DIR, "INTENT")
LOCKED_FILE = os.path.join(STATE_DIR, "LOCKED")
LOG_FILE = os.path.join(STATE_DIR, "log.jsonl")
# A local tuple, NOT read from server/services/system-alerts.ts's ALERT_ACTORS at run time (Langston §5.3): a
# root-installed tool resolving a list out of an unpinned repo copy trades a two-name divergence (cc-pm, coltrane)
# for a read site that can vanish. --by is unauthenticated free text: it is logged as by_claimed (the #447 class).
ACTORS = ("cc-a", "cc-b", "cc-c", "cc-infra", "cc-pm", "kyle", "langston", "coltrane")
READONLY_SWITCH = re.compile(r"transaction_read_only|default_transaction_read_only|\bread\s+write\b", re.IGNORECASE)
CREDENTIAL = re.compile(r"password authentication failed|no pg_hba\.conf entry", re.IGNORECASE)
REFUSED = re.compile(r"Connection refused", re.IGNORECASE)
READY = b"dt-sql-login: ready\n"
# The helper's in-session TLS check failed. Its 3-line prefix puts the check on stdin line 2 (the DO block), so the error
# reads `psql:<stdin>:2: ERROR:  dt-sql-transport: ...` with psql exit 3 (Langston C1, measured on staging 2026-11-22
# 13:39Z with the check inverted, through the installed dt-sql e56fb089; the passing check printed only `1`). The
# caller's SQL starts on line 4.
TRANSPORT_FAIL = re.compile(rb"^psql:<stdin>:2: ERROR:  dt-sql-transport: ", re.M)


def now():
    return datetime.datetime.now(datetime.timezone.utc).isoformat()


def caller():
    return os.environ.get("SUDO_USER") or os.environ.get("LOGNAME") or pwd.getpwuid(os.getuid()).pw_name


def log(event, **kw):
    try:
        # 0640 (Langston C4): the state dir is 0755 now, so the log's own mode is what keeps other accounts out
        with os.fdopen(os.open(LOG_FILE, os.O_WRONLY | os.O_APPEND | os.O_CREAT, 0o640), "a") as fh:
            fh.write(json.dumps(dict(kw, event=event, at=now(), caller=caller())) + "\n")
    except OSError:
        pass


def write_json(path, obj):
    tmp = path + ".tmp"
    with open(tmp, "w") as fh:
        json.dump(obj, fh)
        fh.flush()
        os.fsync(fh.fileno())
    os.replace(tmp, path)


def read_json(path):
    try:
        with open(path) as fh:
            return json.load(fh)
    except ValueError:
        return {"unreadable": True}


def lock_state(arm, reason, detail=""):
    write_json(LOCKED_FILE, {"arm": arm, "at": now(), "caller": caller(), "reason": reason, "detail": detail[:500]})
    try:
        os.remove(INTENT_FILE)
    except FileNotFoundError:
        pass
    log("locked", arm=arm, reason=reason)


LOCKED_TAIL = (" dt-sql is now LOCKED: it will make no further attempt, and the psql wrapper refuses too, until "
               "someone runs `dt-sql --unlock --by <actor>`. Before unlocking, find out why (a rotated reader password? "
               "an edited /etc/dt-sql/reader.env? the network?): a second wrong password from this address gets it "
               "banned by Supabase.")
ALERTS = {
    "credential": ("critical", "dt-sql-credential-locked", "dt-sql locked: the staging database refused its password",
                   "dt-sql made one login attempt to the staging database and it was REFUSED as a wrong password."
                   + LOCKED_TAIL),
    "ambiguous": ("warning", "dt-sql-ambiguous-locked", "dt-sql locked: a login attempt ended without a result",
                  "dt-sql made a login attempt that ended without a classifiable result (a timeout, a signal, or an "
                  "unexpected failure) — it may or may not have been judged a wrong password." + LOCKED_TAIL),
    "transport": ("critical", "dt-sql-transport", "dt-sql refused a session that was not verified TLS",
                  "dt-sql's login reached the staging database, but the session's own TLS check failed, so the SQL did "
                  "not run. dt-sql is NOT locked: no password was judged wrong, and this carries no ban risk. Every "
                  "call will fail the same way until it is fixed — check the CA file in /etc/dt-sql, the pinned "
                  "address, and anything proxying the connection."),
}


def alert(arm, detail):
    """A page for each arm (Langston §5.1: an ambiguous lock takes the only sanctioned read path away from every
    session, so it may not be silent). Best-effort: any LOCKED state is already written. DB-free (see the docstring)."""
    severity, key, title, lead = ALERTS[arm]
    body = lead + "\n\npsql said: %s\n\nOwner: Infra Claude (CC-INFRA). Source: /usr/local/bin/dt-sql (B-DB-READ-TOOL, B-DB-READONLY-ROLE). Resolve with evidence, never ack." % detail[:400]
    argv = ALERT_NPM + ["add", "--triggers-at", datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
                        "--category", "health_check", "--severity", severity, "--dedupe-key", key,
                        "--title", title, "--body", body]
    try:
        r = subprocess.run(argv, capture_output=True, text=True, cwd=APP_DIR, timeout=150)
        log("alert", alert_rc=r.returncode)                 # npm's code — never read as dt-sql's exit
    except Exception as exc:                                       # noqa: BLE001 — the lock stands either way
        log("alert", error=str(exc)[:200])


def run_login(argv, stdin_data, env=None):
    """The login step (sudo -> dt-sql-login -> psql) in its own session. dt-sql passes no env, so the child gets
    os.environ as it is: the PG* strip lives in the helper, the one place a password is set. `env` exists for
    dt-sql-role-setup alone (B-DB-READONLY-ROLE F-6), whose app login runs psql directly and must hand it a stripped
    environment carrying the app password — the same function, so the same timeout and group-kill. On timeout, SIGTERM to the group FIRST — sudo relays it to
    the helper (the sender is outside the command's process group) and the helper stops psql; this account cannot
    SIGKILL the dtsql-owned helper or psql itself. After TERM_GRACE_S, SIGKILL whatever this account may kill.
    UNAUDITED: the relay is measured on staging at Step 6, not here."""
    with subprocess.Popen(argv, stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                          start_new_session=True, env=env) as proc:
        try:
            out, err = proc.communicate(input=stdin_data.encode(), timeout=CALL_TIMEOUT_S)
        except subprocess.TimeoutExpired:
            try:
                os.killpg(proc.pid, signal.SIGTERM)
            except (ProcessLookupError, PermissionError):
                pass
            try:
                proc.communicate(timeout=TERM_GRACE_S)
            except subprocess.TimeoutExpired:
                try:
                    os.killpg(proc.pid, signal.SIGKILL)
                except (ProcessLookupError, PermissionError):
                    proc.kill()
                proc.wait()
            return None, b"", b"dt-sql: timed out after %d s" % CALL_TIMEOUT_S
        return proc.returncode, out, err


def split_ready(err):
    """(ready, err without the ready line). Only the FIRST `dt-sql-login: ready` that starts a line counts — at the
    very start, or after a newline (sudo could print first); the line is removed, nothing else is."""
    if err.startswith(READY):
        return True, err[len(READY):]
    i = err.find(b"\n" + READY)
    if i < 0:
        return False, err
    return True, err[:i + 1] + err[i + 1 + len(READY):]


def classify(rc, err):
    """-> 'ok' | 'sql_error' | 'credential' | 'refused' | 'ambiguous'. psql exits 0 ok, 1 its own fatal error,
    2 a bad connection, 3 an error in the script — SQL always arrives through -f with ON_ERROR_STOP=1, so a SQL error
    AFTER login is 3 (measured; under -c it would be 1)."""
    text = err.decode("utf-8", "replace")
    if rc == 0:
        return "ok"
    if rc == 3:
        return "sql_error"
    if rc == 2 and CREDENTIAL.search(text):
        return "credential"
    if rc == 2 and REFUSED.search(text) and not CREDENTIAL.search(text):
        return "refused"
    return "ambiguous"


def status():
    if os.path.exists(LOCKED_FILE):
        print("LOCKED " + json.dumps(read_json(LOCKED_FILE)))
        return 4
    if os.path.exists(INTENT_FILE):
        print("INTENT left over (the next call will lock 'ambiguous'): " + json.dumps(read_json(INTENT_FILE)))
        return 4
    print("OK — not locked")
    return 0


def unlock(by):
    if by not in ACTORS:
        print("dt-sql: --by must be one of %s" % ", ".join(ACTORS), file=sys.stderr)
        return 2
    with open(LOCK_FILE, "a") as lf:
        try:
            fcntl.flock(lf, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            print("dt-sql: BUSY — a call is running; unlock after it ends", file=sys.stderr)
            return 5
        was = read_json(LOCKED_FILE) if os.path.exists(LOCKED_FILE) else None
        for p in (LOCKED_FILE, INTENT_FILE):
            try:
                os.remove(p)
            except FileNotFoundError:
                pass
        log("unlocked", by_claimed=by, was=was)
    print("dt-sql: unlocked by %s (was: %s)" % (by, json.dumps(was)))
    return 0


def piped_input_waiting():
    """True only if stdin ALREADY holds at least one byte. A PEEK, never a blocking read: `ssh box 'dt-sql -c ...'`
    leaves stdin open and empty, and a read there would hang until the client closed it."""
    import select
    try:
        if sys.stdin.isatty():
            return False
        ready, _, _ = select.select([sys.stdin], [], [], 0)
        return bool(ready) and os.read(sys.stdin.fileno(), 1) != b""
    except (OSError, ValueError):
        return False


def parse(args):
    opts = {"csv": False, "sql": None, "file": None, "status": False, "unlock": False, "by": None}
    i = 0
    while i < len(args):
        a = args[i]
        if a == "--csv":
            opts["csv"] = True
        elif a == "--status":
            opts["status"] = True
        elif a == "--unlock":
            opts["unlock"] = True
        elif a in ("--by", "-c", "-f") and i + 1 < len(args):
            key = {"--by": "by", "-c": "sql", "-f": "file"}[a]
            if opts[key] is not None:
                raise ValueError("%s given twice" % a)
            opts[key] = args[i + 1]
            i += 1
        else:
            raise ValueError("unknown or incomplete argument: %r" % a)
        i += 1
    if opts["sql"] is not None and opts["file"] is not None:
        # ⛔ D-1 (Langston Step 4): the read-only check inspected -c while psql executed -f. One input, always.
        raise ValueError("give the SQL ONE way: -c, -f, or stdin")
    return opts


def main(args):
    if os.geteuid() == 0 and RUN_AS and pwd.getpwnam(RUN_AS).pw_uid != 0:
        os.execv(RUNUSER, [RUNUSER, "-u", RUN_AS, "--", sys.executable, os.path.abspath(__file__)] + args)
    try:
        opts = parse(args)
    except ValueError as exc:
        print("dt-sql: %s\n%s" % (exc, __doc__.split("EXIT CODES")[0].split("USAGE")[1]), file=sys.stderr)
        return 2
    if opts["status"]:
        return status()
    if opts["unlock"]:
        return unlock(opts["by"])
    # ⛔ SQL ALWAYS GOES IN THROUGH `-f` (a file or stdin), NEVER `-c`: measured on staging, psql exits 1 for an ordinary
    #    SQL error under `-c` (a typo, a refused write, a statement timeout) but 3 under `-f` with ON_ERROR_STOP — and 1 is
    #    also psql's own fatal error, which must lock. With `-f`, 3 cleanly means "logged in, the SQL failed".
    if (opts["sql"] is not None or opts["file"] is not None) and piped_input_waiting():
        # the "ONE way" promise covers stdin too (Langston, Step-4 re-read note): never silently drop piped SQL
        print("dt-sql: give the SQL ONE way: -c, -f, or stdin (SQL was piped in AND given as an option)", file=sys.stderr)
        return 2
    if opts["sql"] is not None:
        if not opts["sql"].strip():
            print("dt-sql: no SQL given", file=sys.stderr)
            return 2
        sql = stdin_data = opts["sql"] if opts["sql"].rstrip().endswith(";") else opts["sql"] + ";"
    elif opts["file"] is not None:
        with open(opts["file"]) as fh:
            sql = stdin_data = fh.read()        # psql runs THESE bytes (via stdin), the ones just checked — not the path
    else:
        sql = stdin_data = sys.stdin.read()
    if not sql.strip():
        print("dt-sql: no SQL given", file=sys.stderr)
        return 2
    if READONLY_SWITCH.search(sql):
        print("dt-sql: REFUSED — this SQL names the read-only setting; dt-sql only reads (an accident guard, not a "
              "boundary)", file=sys.stderr)
        log("refused_readonly_sql", sql_head=sql.strip()[:160])     # the attempt is audited too (Langston Step 8 F-1)
        return 2
    return locked_attempt(LOGIN + (["--csv"] if opts["csv"] else []), stdin_data)   # the checked bytes (D-1)


def locked_attempt(argv, stdin_data, env=None, emit=None, direct=False):
    """ONE login attempt under dt-sql's whole fail-closed protocol: the non-blocking flock, the LOCKED and left-over
    INTENT checks, the INTENT written BEFORE the attempt, the timeout, the TLS-check reading, the classification, the
    lock arms and their alerts. Returns dt-sql's exit code (0-6, as the docstring's table).
    main passes the login step (LOGIN). dt-sql-role-setup (B-DB-READONLY-ROLE F-6) imports this file and calls this
    function for each of its own logins, so every login it makes takes the same protocol — one implementation, not a
    copy: `env` is the child's environment (its own stripped one carrying the app password), `emit(out, err)` receives
    the output instead of this process's stdout/stderr, and `direct=True` says argv is psql itself, which prints no
    ready line — so a non-zero exit is ALWAYS read as a real attempt (it locks), never as a refusal before one."""
    with open(LOCK_FILE, "a") as lf:
        try:
            fcntl.flock(lf, fcntl.LOCK_EX | fcntl.LOCK_NB)        # one at a time, NEVER queued (pre-audit P1d)
        except BlockingIOError:
            print("dt-sql: BUSY — another dt-sql call is running; try again when it ends", file=sys.stderr)
            return 5
        if os.path.exists(LOCKED_FILE):
            print("dt-sql: LOCKED %s — no attempt made. `dt-sql --status`; unlock by hand after finding the cause."
                  % json.dumps(read_json(LOCKED_FILE)), file=sys.stderr)
            return 4
        if os.path.exists(INTENT_FILE):
            prior = read_json(INTENT_FILE)
            lock_state("ambiguous", "a previous call ended without a result (killed, or the box restarted)",
                       json.dumps(prior))
            alert("ambiguous", "a previous call left its attempt unrecorded: %s" % json.dumps(prior))
            print("dt-sql: LOCKED (ambiguous) — a previous call left its attempt unrecorded: %s" % json.dumps(prior),
                  file=sys.stderr)
            return 4
        write_json(INTENT_FILE, {"at": now(), "caller": caller(), "pid": os.getpid()})   # BEFORE the attempt
        rc, out, err = run_login(argv, stdin_data, env)
        ready, err = split_ready(err)
        ready = ready or direct                      # psql run directly: there is no ready line, the attempt is real
        if emit is None:
            sys.stdout.buffer.write(out)
            sys.stderr.buffer.write(err)
        else:
            emit(out, err)
        if rc is None:
            kind = "ambiguous"                       # a timeout ALWAYS locks: the attempt may have been judged
        elif not ready and rc != 0:
            os.remove(INTENT_FILE)                   # no ready line: the login step refused before any attempt
            log("login_refused", login_rc=rc)
            print("dt-sql: the login step refused before connecting (rc %s) — no attempt was made; not locked" % rc,
                  file=sys.stderr)
            return 2
        elif rc == 3 and TRANSPORT_FAIL.search(err):
            os.remove(INTENT_FILE)                   # logged in, failed its own TLS check: not a login failure
            log("transport", psql_rc=rc)
            m = TRANSPORT_FAIL.search(err)
            alert("transport", err[m.start():].split(b"\n")[0].decode("utf-8", "replace"))
            print("dt-sql: TRANSPORT — the session failed its TLS check and the SQL did not run. Not locked; an alert "
                  "is raised.", file=sys.stderr)
            return 6
        else:
            kind = classify(rc, err)
        if kind in ("ok", "sql_error"):
            os.remove(INTENT_FILE)
            log(kind, psql_rc=rc)                              # psql's own code; the tool's exit is the "exit" line
            return 0 if kind == "ok" else 1
        if kind == "refused":
            os.remove(INTENT_FILE)
            log("refused", psql_rc=rc)
            print("dt-sql: Connection refused — the address may be BANNED. Do not retry; check Supabase's network bans.",
                  file=sys.stderr)
            return 3
        detail = err.decode("utf-8", "replace").strip().splitlines()[-1:] or [""]
        if kind == "credential":
            lock_state("credential", "the database refused the password", detail[0])
            alert("credential", detail[0])
        else:
            lock_state("ambiguous", "psql ended without a classifiable result (rc %s)" % rc, detail[0])
            alert("ambiguous", "rc %s: %s" % (rc, detail[0]))
        print("dt-sql: LOCKED (%s) — no further attempt until `dt-sql --unlock --by <actor>`" % kind, file=sys.stderr)
        return 4


def entry(args):
    """Exit 1 means ONLY "logged in, the SQL failed". An unexpected error or SystemExit before an attempt is 2
    (Langston rider); an INTENT already written is left in place, so the next call still locks 'ambiguous'."""
    try:
        code = main(args)
    except SystemExit as exc:
        if isinstance(exc.code, int) and exc.code != 1:      # 1 is published as "logged in, the SQL failed" only
            code = exc.code
        else:
            print(str(exc.code), file=sys.stderr)
            code = 2
    except Exception as exc:                                       # noqa: BLE001
        print("dt-sql: unexpected error before or around the attempt: %s: %s" % (type(exc).__name__, exc), file=sys.stderr)
        code = 2
    # ⛔ ONE "exit" line for EVERY call BY ROOT OR DEPLOY (another account cannot write the deploy-owned state dir or
    #    the 0640 log; log() swallows that — such a call also achieves nothing) — refusals, busy, locked, usage errors included — carrying the tool's real exit
    #    code (Langston Step 8 F-1/F-2: the log showed what ran but not what was attempted and blocked, and its psql
    #    rc 3 read as an exit code that is really 1). Reaches here only in the process that did the work (as root the
    #    first process execv's into deploy and never returns).
    log("exit", exit=code, mode=("status" if "--status" in args else "unlock" if "--unlock" in args else "query"))
    return code


if __name__ == "__main__":
    sys.exit(entry(sys.argv[1:]))
