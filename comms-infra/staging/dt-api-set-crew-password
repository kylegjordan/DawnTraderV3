#!/usr/bin/env python3
"""dt-api-set-crew-password — give the crew login a new password that only `dtapi` holds.

B-CREDENTIALS-PRIVATE-REPO OBJ-1 (#1023). Pre-audit §2.2 item 4 (r4), with Langston's
Step-2 conditions C2, C3, C4 and C7. Run BY HAND, as root, on staging:

    PGPASSFILE=/root/<run-only file> /usr/local/sbin/dt-api-set-crew-password

PGPASSFILE is a root-owned 0600 file holding ONE libpq line, host:port:db:user:password,
made for this run by the operator (the change list says how). The setter reads it and
REMOVES it on exit. ⛔ Neither this nor dt-api loads anything from /home/deploy.

WHAT IT DOES, in order — the numbers are the pre-audit's:
  budget  refuses unless the shared login ledger records NO loopback login in the last 900 s
  (0)     if a marker from an interrupted run exists: reconcile it, report, and STOP
  (1)     save a marker (old hash, old role) and a copy of the live env, both root 0600
  (1b)    write the new value to a temp env beside the real one, 0600 dtapi:dtapi
  (2)     COMMIT: password AND role='editor' for the crew row, asserting exactly 1 row and
          RETURNING role = 'editor' (a password-only write FAILS here — the mutation test)
  (3)     a fresh login with the new value: token issued after the start, user.role 'editor'
  (4)     THE COMMIT POINT: rename the temp env into place
  (5)     purge dt-api's token and negative cache, then release dt-api's lock
  (6)     `sudo -n -u dtapi dt-api GET /api/settings` must succeed — the path callers use
  (7)     delete the marker and the old-env copy, LAST

dt-api's lock is held from before (0) through (5). A failure before (4) restores the hash and
role from the marker; a failure at (5) or (6) restores the hash, role AND env together.
STATED RESIDUAL: between (2) and a restore the database holds the new hash while the live env
holds the old value — a non-atomic window, bounded by this run.

EXIT: 0 done (or reconciled) · 1 failed and restored · 2 refused, nothing touched ·
      3 an answer it could not use (a 5xx or timeout during reconcile) — nothing touched ·
      4 RESTORE FAILED — the marker is kept; the next run reconciles it; do not delete it
"""

import fcntl
import importlib.util
import json
import os
import pwd
import grp
import re
import secrets
import signal
import stat
import string
import subprocess
import sys
import time
from importlib.machinery import SourceFileLoader

# ── CONSTANTS (the test harness substitutes ONLY this block; it asserts the rest is identical) ──
DT_API_PATH = "/usr/local/bin/dt-api"
PSQL = "/usr/bin/psql"
DT_API_VERIFY = ["/usr/bin/sudo", "-n", "-u", "dtapi", "/usr/local/bin/dt-api", "GET", "/api/settings"]
SETTER_DIR = "/var/lib/dt-api-setter"
SETTER_LOCK = "/run/dt-api-setter.lock"
DTAPI_ACCOUNT = "dtapi"
EXPECT_ROOT = True
KILL_AFTER = None               # tests only: SIGKILL self after the named step
# ── END CONSTANTS ──

CREW_USER = "testuser123"       # the one row this touches; its SQL says so literally
NEW_ROLE = "editor"             # scope §2.1(6): same permissions as owner, never an owner pick
HASH_RE = re.compile(r"^\$2[aby]\$\d{2}\$[./A-Za-z0-9]{53}$")   # C2: the shape, not a pinned prefix
ROLE_RE = re.compile(r"^[a-z]{1,20}$")
MARKER = os.path.join(SETTER_DIR, "marker.json")
OLD_ENV = os.path.join(SETTER_DIR, "old-env")
LOCK_WAIT_S = 120               # the setter waits longer than a caller for dt-api's lock

# Load dt-api itself, so the ledger, the lock and the HTTP call are ONE implementation.
_spec = importlib.util.spec_from_loader("dt_api", SourceFileLoader("dt_api", DT_API_PATH))
D = importlib.util.module_from_spec(_spec)
_spec.loader.exec_module(D)
D.LOCK_TIMEOUT_S = LOCK_WAIT_S
TEMP_ENV = os.path.join(os.path.dirname(D.ENV_FILE), ".staging-api.env.new")

PHASES = ("saved", "temp-written", "committing", "verified", "renamed")


class Fail(Exception):
    pass


def say(msg):
    sys.stdout.write(msg.rstrip("\n") + "\n")
    sys.stdout.flush()


def refuse(code, msg):
    sys.stderr.write(msg.rstrip("\n") + "\n")
    raise SystemExit(code)


def hook(step):
    if KILL_AFTER == step:
        os.kill(os.getpid(), signal.SIGKILL)


# ───────────────────────────── PGPASSFILE and psql ─────────────────────────────

def _pgpass_fields(line):
    out, cur, i = [], [], 0
    while i < len(line):
        c = line[i]
        if c == "\\" and i + 1 < len(line):
            cur.append(line[i + 1])
            i += 2
            continue
        if c == ":":
            out.append("".join(cur))
            cur = []
        else:
            cur.append(c)
        i += 1
    out.append("".join(cur))
    return out


def pg_env():
    p = os.environ.get("PGPASSFILE", "")
    if not p:
        refuse(2, "REFUSED: set PGPASSFILE to a run-only root 0600 file holding ONE line "
                  "host:port:db:user:password (the change list shows how to make it).")
    if p.startswith("/home/"):
        refuse(2, "REFUSED: PGPASSFILE is under /home — the setter loads nothing from a home directory.")
    try:
        st = os.lstat(p)
    except FileNotFoundError:
        refuse(2, "REFUSED: PGPASSFILE %s does not exist." % p)
    if not stat.S_ISREG(st.st_mode) or (EXPECT_ROOT and st.st_uid != 0) or st.st_mode & 0o077:
        refuse(2, "REFUSED: PGPASSFILE must be a regular root-owned file with mode 0600.")
    with open(p, encoding="utf-8") as fh:
        lines = [ln.rstrip("\n") for ln in fh if ln.strip() and not ln.startswith("#")]
    if len(lines) != 1:
        refuse(2, "REFUSED: PGPASSFILE must hold exactly one line.")
    f = _pgpass_fields(lines[0])
    if len(f) != 5 or not all(f[:4]):
        refuse(2, "REFUSED: PGPASSFILE's line is not host:port:db:user:password.")
    return p, {"PATH": "/usr/bin:/bin", "PGPASSFILE": p, "PGHOST": f[0], "PGPORT": f[1],
               "PGDATABASE": f[2], "PGUSER": f[3], "PGSSLMODE": "require",
               "PGCONNECT_TIMEOUT": "15", "PGAPPNAME": "dt-api-set-crew-password"}


PGENV = None


def psql(sql):
    """Runs one script on stdin. The hash rides stdin, never argv."""
    r = subprocess.run([PSQL, "-X", "-q", "-At", "-v", "ON_ERROR_STOP=1", "-P", "pager=off"],
                       input=sql, env=PGENV, capture_output=True, text=True, timeout=90)
    if r.returncode != 0:
        raise Fail("psql exited %d: %s" % (r.returncode, r.stderr.strip()[:300]))
    return r.stdout


def read_state():
    out = psql("SELECT 'STATE', count(*), coalesce(min(role), ''), coalesce(min(password), '') "
               "FROM public.users WHERE username = '%s';\n" % CREW_USER)
    rows = [ln for ln in out.splitlines() if ln.startswith("STATE|")]
    if len(rows) != 1:
        raise Fail("could not read the crew row's state")
    _, n, role, pw = rows[0].split("|", 3)
    return int(n), role, pw


def write_row(new_hash, role):
    """One transaction: set password AND role, assert exactly one row RETURNING that role, else
    ROLLBACK. The values are checked against strict shapes before they reach SQL."""
    if not HASH_RE.match(new_hash) or not ROLE_RE.match(role):
        raise Fail("refusing to write a value that is not a bcrypt hash / a plain role")
    sql = (
        "BEGIN;\n"
        "WITH u AS (UPDATE public.users SET password = '%(h)s', role = '%(r)s', updated_at = now() "
        "WHERE username = '%(u)s' RETURNING role)\n"
        "SELECT count(*) AS n, coalesce(min(role), '') AS r, "
        "CASE WHEN count(*) = 1 AND min(role) = '%(r)s' THEN 'true' ELSE 'false' END AS ok FROM u \\gset\n"
        "\\if :ok\n"
        "COMMIT;\n"
        "\\echo RESULT|committed|:n|:r\n"
        "\\else\n"
        "ROLLBACK;\n"
        "\\echo RESULT|rolledback|:n|:r\n"
        "\\endif\n"
    ) % {"h": new_hash, "r": role, "u": CREW_USER}
    out = psql(sql)
    res = [ln for ln in out.splitlines() if ln.startswith("RESULT|")]
    if len(res) != 1:
        raise Fail("the write printed no RESULT line")
    _, verdict, n, r = res[0].split("|", 3)
    if verdict != "committed" or n != "1" or r != role:
        raise Fail("the write was ROLLED BACK: %s row(s), RETURNING role %r (wanted exactly 1 and %r)"
                   % (n, r, role))
    return n, r


# ───────────────────────────── env files and state ─────────────────────────────

def read_env_file(path):
    out = {}
    try:
        with open(path, encoding="utf-8") as fh:
            for ln in fh:
                ln = ln.strip()
                if ln and not ln.startswith("#") and "=" in ln:
                    k, v = ln.split("=", 1)
                    out[k.strip()] = v.strip()
    except FileNotFoundError:
        return None
    if not out.get("DT_API_USER") or not out.get("DT_API_PASS"):
        return None
    return out


def _ids():
    return pwd.getpwnam(DTAPI_ACCOUNT).pw_uid, grp.getgrnam(DTAPI_ACCOUNT).gr_gid


def write_env(path, value):
    uid, gid = _ids()
    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC | os.O_NOFOLLOW, 0o600)
    try:
        os.fchown(fd, uid, gid)
        os.fchmod(fd, 0o600)
        os.write(fd, ("DT_API_USER=%s\nDT_API_PASS=%s\n" % (CREW_USER, value)).encode())
        os.fsync(fd)
    finally:
        os.close(fd)


def fsync_dir(d):
    fd = os.open(d, os.O_RDONLY)
    try:
        os.fsync(fd)
    finally:
        os.close(fd)


def unlink_quiet(p):
    try:
        os.unlink(p)
    except FileNotFoundError:
        pass


def ensure_state():
    """dt-api runs as dtapi, so every shared file it must write stays dtapi-owned even when root
    creates it here. (The ledger is dtapi:dtapi 0600 — dt-api must append to it; root reads it.)"""
    uid, gid = _ids()
    if not os.path.isdir(D.STATE_DIR):
        refuse(2, "REFUSED: %s is missing — install dt-api first." % D.STATE_DIR)
    for p in (D.LEDGER, D.LOCK_FILE):
        fd = os.open(p, os.O_WRONLY | os.O_CREAT | os.O_APPEND | os.O_NOFOLLOW, 0o600)
        os.fchown(fd, uid, gid)
        os.close(fd)
    os.makedirs(SETTER_DIR, mode=0o700, exist_ok=True)
    os.chmod(SETTER_DIR, 0o700)


def write_marker(m):
    D._write_json(MARKER, m)          # root-owned 0600 (umask below)


def purge_cache():
    unlink_quiet(D.TOKEN_FILE)
    unlink_quiet(D.NEG_FILE)


# ───────────────────────────── logins (the loopback bucket, C3) ─────────────────────────────

def setter_login(env):
    """One login on the loopback bucket, recorded in the SHARED ledger as who=setter. Returns
    (status, headers, json)."""
    t = time.time()
    D._append(D.LEDGER, json.dumps({"ts": t, "who": "setter", "phase": "sent", "bucket": "loopback"}))
    st, h, b = D.app_request("POST", "/api/auth/login",
                             body={"username": env["DT_API_USER"], "password": env["DT_API_PASS"]},
                             timeout=D.LOGIN_TIMEOUT_S)
    D._append(D.LEDGER, json.dumps({"ts": time.time(), "who": "setter", "phase": "result",
                                    "status": st, "remaining": h.get("ratelimit-remaining"),
                                    "reset": h.get("ratelimit-reset"), "bucket": "loopback"}))
    return st, h, (D._json(b) or {})


def try_login(env):
    """ok | fail | none (no usable file) | unknown (a 5xx, a 429 or no answer — NOT an answer)."""
    if not env:
        return "none"
    st, _, _ = setter_login(env)
    if st == 200:
        return "ok"
    if st in (401, 404):
        return "fail"
    return "unknown"


# ───────────────────────────── restore ─────────────────────────────

def restore_db(m):
    n, r = write_row(m["old_hash"], m["old_role"])
    n2, role2, pw2 = read_state()
    if n2 != 1 or role2 != m["old_role"] or pw2 != m["old_hash"]:
        raise Fail("the re-read after the restore does not match the marker")
    say("restored: the crew row's hash and role are back to the marker's (role %s)" % role2)


def restore_env(m):
    if m.get("had_env"):
        uid, gid = _ids()
        with open(OLD_ENV, "rb") as fh:
            data = fh.read()
        tmp = D.ENV_FILE + ".restore"
        fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC | os.O_NOFOLLOW, 0o600)
        try:
            os.fchown(fd, uid, gid)
            os.write(fd, data)
            os.fsync(fd)
        finally:
            os.close(fd)
        os.replace(tmp, D.ENV_FILE)
    else:
        unlink_quiet(D.ENV_FILE)
    fsync_dir(os.path.dirname(D.ENV_FILE))
    say("restored: the live env is the pre-run one (%s)" % ("copied back" if m.get("had_env") else "absent, as before"))


def cleanup_run_files():
    unlink_quiet(TEMP_ENV)
    unlink_quiet(OLD_ENV)
    unlink_quiet(MARKER)


# ───────────────────────────── (0) reconcile ─────────────────────────────

def reconcile(m):
    phase = m.get("phase")
    say("(0) a marker from an interrupted run exists (phase %s, started %s)" % (phase, m.get("started")))
    if phase in ("saved", "temp-written"):
        cleanup_run_files()
        say("(0) the database was never written (the commit had not started): removed the marker "
            "and the temp env. The OLD value stands. Re-run to set a new one.")
        return 0
    live = try_login(read_env_file(D.ENV_FILE))
    if live == "unknown":
        refuse(3, "(0) the live env's login got no usable answer (a 5xx, a 429 or a timeout) — "
                  "touching nothing; retry later.")
    if live == "ok":
        cleanup_run_files()
        purge_cache()
        say("(0) the live env logs in: removed the marker and any temp env. Done.")
        return 0
    temp = try_login(read_env_file(TEMP_ENV))
    if temp == "unknown":
        refuse(3, "(0) the temp env's login got no usable answer — touching nothing; retry later.")
    if temp == "ok":
        os.replace(TEMP_ENV, D.ENV_FILE)
        fsync_dir(os.path.dirname(D.ENV_FILE))
        purge_cache()
        unlink_quiet(OLD_ENV)
        unlink_quiet(MARKER)
        say("(0) the temp env logs in: renamed it into place and removed the marker. The NEW value stands.")
        return 0
    # Neither logs in. If the row still holds the marker's hash and role, the commit never landed
    # (a kill mid-commit, before any env existed): nothing to restore, nothing to page.
    n, role_now, hash_now = read_state()
    if n == 1 and role_now == m["old_role"] and hash_now == m["old_hash"]:
        cleanup_run_files()
        purge_cache()
        say("(0) the row still holds the pre-run hash and role — the commit never landed. Removed "
            "the marker and the temp env. The OLD value stands.")
        return 0
    try:
        restore_db(m)
        restore_env(m)
        purge_cache()
        cleanup_run_files()
    except Exception as e:
        refuse(4, "RESTORE FAILED during (0): %s — the marker is KEPT at %s; do not delete it." % (e, MARKER))
    refuse(1, "(0) neither the live nor the temp env logs in. Restored the marker's hash, role and "
              "env. PAGE: Infra Claude must look — something outside this setter changed the crew row.")


# ───────────────────────────── the run ─────────────────────────────

def gen_value():
    """40 characters from [A-Za-z0-9] plus ONE '_': passes validatePasswordStrength
    (auth-service.ts:10-16 — an uppercase letter, a digit, a special from its set), is 41 bytes
    (under bcrypt's 72), and holds no quote or shell metacharacter."""
    alnum = string.ascii_letters + string.digits
    while True:
        body = [secrets.choice(alnum) for _ in range(40)]
        pos = secrets.randbelow(41)
        v = "".join(body[:pos]) + "_" + "".join(body[pos:])
        if re.search(r"[A-Z]", v) and re.search(r"\d", v):
            return v


def hash_value(v):
    import bcrypt                       # python3-bcrypt (Debian 3.2.2); ⛔ never bcryptjs from /home/deploy
    h = bcrypt.hashpw(v.encode(), bcrypt.gensalt(rounds=10)).decode()
    if not HASH_RE.match(h) or len(h) != 60:
        raise Fail("the hash does not have bcrypt's shape (C2)")
    if not bcrypt.checkpw(v.encode(), h.encode()):
        raise Fail("the hash does not verify locally")
    return h


def run():
    start = time.time()
    # ── the budget (C4: the window is FIXED per key, opening at its first hit; "no loopback login
    #    in the last 900 s" therefore means no window we opened is still running) ──
    recent = D.ledger_sent_since(start - D.WINDOW_S)
    if recent:
        last = max(e["ts"] for e in recent)
        refuse(2, "REFUSED: the ledger records a loopback login at %s; the fixed window it may have "
                  "opened ends by %s. Nothing touched; retry after then." % (D._iso(last), D._iso(last + D.WINDOW_S)))
    m = D._read_json(MARKER)
    if m:
        return reconcile(m)
    unlink_quiet(TEMP_ENV)             # a temp env with no marker is debris from nothing
    n, old_role, old_hash = read_state()
    if n != 1:
        refuse(2, "REFUSED: expected exactly one row for %s, found %d. Nothing touched." % (CREW_USER, n))
    if not HASH_RE.match(old_hash) or not ROLE_RE.match(old_role):
        refuse(2, "REFUSED: the crew row's current hash or role is not restorable. Nothing touched.")
    # (1) save
    had_env = os.path.exists(D.ENV_FILE)
    if had_env:
        with open(D.ENV_FILE, "rb") as fh:
            data = fh.read()
        fd = os.open(OLD_ENV, os.O_WRONLY | os.O_CREAT | os.O_TRUNC | os.O_NOFOLLOW, 0o600)
        os.write(fd, data)
        os.fsync(fd)
        os.close(fd)
    m = {"started": D._iso(start), "old_hash": old_hash, "old_role": old_role,
         "had_env": had_env, "phase": "saved"}
    write_marker(m)
    say("(1) saved the marker (old role %s) and %s" % (old_role, "a copy of the live env" if had_env else "noted: no live env yet"))
    hook("1")
    phase = "saved"
    try:
        # (1b)
        value = gen_value()
        write_env(TEMP_ENV, value)
        m["phase"] = phase = "temp-written"
        write_marker(m)
        say("(1b) wrote the new value to the temp env (0600 %s)" % DTAPI_ACCOUNT)
        hook("1b")
        # (2)
        new_hash = hash_value(value)
        m["phase"] = phase = "committing"
        write_marker(m)
        n2, r2 = write_row(new_hash, NEW_ROLE)
        say("(2) committed: %s row, RETURNING role %s" % (n2, r2))
        hook("2")
        # (3)
        st, h, j = setter_login({"DT_API_USER": CREW_USER, "DT_API_PASS": value})
        if st != 200:
            raise Fail("(3) the fresh login with the new value answered %s" % st)
        claims = D.jwt_claims(j.get("accessToken", ""))
        role_resp = (j.get("user") or {}).get("role")
        if not isinstance(claims.get("iat"), (int, float)) or claims["iat"] < int(start):
            raise Fail("(3) the token was not issued after this run started")
        if role_resp != NEW_ROLE or claims.get("role") != NEW_ROLE:
            raise Fail("(3) the login's user.role is %r and the token's role %r, not %r"
                       % (role_resp, claims.get("role"), NEW_ROLE))
        remaining, reset = h.get("ratelimit-remaining"), h.get("ratelimit-reset")
        m["phase"] = phase = "verified"
        write_marker(m)
        say("(3) a fresh login with the new value works: user.role %s; loopback bucket remaining %s, "
            "resets in %s s" % (role_resp, remaining, reset))
        # (4) THE COMMIT POINT
        os.replace(TEMP_ENV, D.ENV_FILE)
        fsync_dir(os.path.dirname(D.ENV_FILE))
        m["phase"] = phase = "renamed"
        write_marker(m)
        say("(4) the new value is live in %s" % D.ENV_FILE)
        hook("4")
        # (5)
        purge_cache()
        say("(5) purged dt-api's token and negative cache")
        DLOCK.__exit__(None, None, None)
        hook("5")
        # (6) — C4: the headers are authoritative; if our (3) emptied the bucket, wait it out
        if remaining == "0" and reset and reset.isdigit():
            wait = min(int(reset) + 2, D.WINDOW_S)
            say("(6) the loopback bucket is empty; waiting %d s for its window to reset" % wait)
            time.sleep(wait)
        r = subprocess.run(DT_API_VERIFY, capture_output=True, timeout=240)
        if r.returncode != 0:
            raise Fail("(6) dt-api GET /api/settings exited %d: %s"
                       % (r.returncode, r.stderr.decode("utf-8", "replace").strip()[:300]))
        say("(6) dt-api GET /api/settings returned 200 through sudo, as callers will use it")
        # (7)
        unlink_quiet(OLD_ENV)
        unlink_quiet(MARKER)
        say("(7) removed the marker and the old-env copy. DONE: the crew login is set, role %s." % NEW_ROLE)
        return 0
    except Exception as e:
        say("FAILED at phase %s: %s" % (phase, e))
        try:
            if phase in ("saved", "temp-written"):
                cleanup_run_files()
                say("nothing in the database was written; removed the temp env and the marker")
            elif phase in ("committing", "verified"):
                restore_db(m)
                cleanup_run_files()
            else:
                DLOCK.__enter__()                      # re-take before touching the env (pre-audit §2.2.4)
                restore_db(m)
                restore_env(m)
                purge_cache()
                cleanup_run_files()
        except Exception as e2:
            refuse(4, "RESTORE FAILED: %s — the marker is KEPT at %s; the next run reconciles it. "
                      "Do not delete it." % (e2, MARKER))
        refuse(1, "the setter FAILED and restored the previous state (see above).")


DLOCK = None


def main():
    global PGENV, DLOCK
    if EXPECT_ROOT and os.geteuid() != 0:
        refuse(2, "REFUSED: run as root.")
    os.umask(0o077)
    pgfile, PGENV = pg_env()
    try:
        sfd = os.open(SETTER_LOCK, os.O_RDWR | os.O_CREAT, 0o600)
        try:
            fcntl.flock(sfd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except OSError:
            refuse(2, "REFUSED: another setter run holds %s." % SETTER_LOCK)
        ensure_state()
        DLOCK = D.Lock()
        DLOCK.__enter__()
        try:
            return run()
        finally:
            DLOCK.__exit__(None, None, None)
    finally:
        unlink_quiet(pgfile)            # run-only: removed on exit, whatever happened


if __name__ == "__main__":
    sys.exit(main())
