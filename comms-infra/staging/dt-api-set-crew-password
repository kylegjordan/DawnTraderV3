class Fail(Exception):
    pass


class Interrupted(Exception):
    """SIGTERM / SIGINT, raised ONLY at a checkpoint before the commit point (fresh-reader r2)."""


INTERRUPTED = []


def _on_signal(signum, frame):
    # ⛔ NEVER raise from here. An exception that can fire between ANY two statements made the
    #    restore run after its own material was deleted (r2 BLOCKER). The flag is acted on at
    #    checkpoint() only — before the commit point; after it the run finishes.
    # ★ THE ESCAPE HATCH AFTER THE COMMIT POINT IS SIGKILL, AND IT IS SAFE (Langston, Gate 1-2): with
    #   the marker at `renamed` and the env renamed, the next run's reconcile finds the live env logs
    #   in and tidies up (exit 0). So an operator facing the (6) wait (up to 900 s) may `kill -9` it.
    INTERRUPTED.append(signum)


def checkpoint(where):
    if INTERRUPTED:
        raise Interrupted("signal %d, acted on before %s" % (INTERRUPTED[0], where))


def _emit(stream_name, line):
    stream = getattr(sys, stream_name)
    try:
        stream.write(line + "\n")
        stream.flush()
    except (OSError, ValueError):
        # a dropped ssh: never let a dead terminal turn a result into a traceback (r2 #6)
        setattr(sys, stream_name, open(os.devnull, "w"))


def _log(line):
    try:
        with open(RUN_LOG, "a", encoding="utf-8") as fh:
            fh.write("%s %s\n" % (time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()), line))
    except OSError:
        pass


def say(msg):
    """stdout AND the run log: an ssh that drops mid-run must neither lose the record nor, through
    a broken pipe, turn a good run into a failed one (r1 #6)."""
    line = msg.rstrip("\n")
    _log(line)
    _emit("stdout", line)


def refuse(code, msg):
    """Every outcome reaches the run log too (r2 #6)."""
    line = msg.rstrip("\n")
    _log("EXIT %d: %s" % (code, line))
    _emit("stderr", line)
    raise SystemExit(code)


def hook(step):
    if KILL_AFTER == step:
        os.kill(os.getpid(), signal.SIGKILL)


# ───────────────────────────── PGPASSFILE and psql ─────────────────────────────

def _pgpass_fields(line):
    out, cur, i = [], [], 0
    while i < len(line):
        c = line[i]
        if c == "\\" and i + 1 < len(line):
            cur.append(line[i + 1])
            i += 2
            continue
        if c == ":":
            out.append("".join(cur))
            cur = []
        else:
            cur.append(c)
        i += 1
    out.append("".join(cur))
    return out


def pg_env():
    p = os.environ.get("PGPASSFILE", "")
    if not p:
        refuse(2, "REFUSED: set PGPASSFILE to a run-only root 0600 file holding ONE line "
                  "host:port:db:user:password (the change list shows how to make it).")
    # r3: the check runs on the RESOLVED path — "/./home/x", "//home/x" or a link into /home
    #     passed a plain prefix test. A relative path is refused outright.
    if not os.path.isabs(p):
        refuse(2, "REFUSED: PGPASSFILE must be an absolute path.")
    if (os.path.realpath(p) + "/").startswith("/home/"):
        refuse(2, "REFUSED: PGPASSFILE resolves under /home — the setter loads nothing from a home directory.")
    # ⛔ A REFUSED file is NOT removed (r3, stated): the setter removes only a file it has accepted.
    #    A path that fails these checks may not be a run-only file at all (a key, a config).
    keep = " It was NOT removed: delete it yourself."
    try:
        st = os.lstat(p)
    except FileNotFoundError:
        refuse(2, "REFUSED: PGPASSFILE %s does not exist." % p)
    if not stat.S_ISREG(st.st_mode) or (EXPECT_ROOT and st.st_uid != 0) or st.st_mode & 0o077:
        refuse(2, "REFUSED: PGPASSFILE must be a regular root-owned file with mode 0600." + keep)
    with open(p, encoding="utf-8") as fh:
        lines = [ln.rstrip("\n") for ln in fh if ln.strip() and not ln.startswith("#")]
    if len(lines) != 1:
        refuse(2, "REFUSED: PGPASSFILE must hold exactly one line." + keep)
    f = _pgpass_fields(lines[0])
    if len(f) != 5 or not all(f[:4]):
        refuse(2, "REFUSED: PGPASSFILE's line is not host:port:db:user:password." + keep)
    return p, {"PATH": "/usr/bin:/bin", "PGPASSFILE": p, "PGHOST": f[0], "PGPORT": f[1],
               "PGDATABASE": f[2], "PGUSER": f[3], "PGSSLMODE": "require",
               "PGCONNECT_TIMEOUT": "15", "PGAPPNAME": "dt-api-set-crew-password"}


PGENV = None


HASH_ANY = re.compile(r"\$2[aby]\$\d{2}\$[./A-Za-z0-9]*")   # partial hashes too (r2 #10)


def _die_with_parent(parent):
    """psql must not outlive a killed setter: an orphan could COMMIT after the next run has
    already judged the state (fresh-reader r1 #3). PR_SET_PDEATHSIG = 1.
    r3: a parent that died between the fork and the prctl never delivers the signal, so the child
    checks it still has that parent AFTER arming it, and exits if not."""
    import ctypes
    ctypes.CDLL("libc.so.6", use_errno=True).prctl(1, signal.SIGKILL)
    if os.getppid() != parent:
        os._exit(1)


def psql(sql, appname=APPNAME):
    """Runs one script on stdin. The hash rides stdin, never argv, and never an error message."""
    env = dict(PGENV, PGAPPNAME=appname)
    parent = os.getpid()
    try:
        r = subprocess.run([PSQL, "-X", "-q", "-At", "-v", "ON_ERROR_STOP=1", "-P", "pager=off"],
                           input=sql, env=env, capture_output=True, text=True, timeout=90,
                           preexec_fn=lambda: _die_with_parent(parent), start_new_session=True)
    except (subprocess.TimeoutExpired, OSError) as e:
        raise Fail("psql did not complete: %s" % type(e).__name__)
    if r.returncode != 0:
        # only the error's first line: psql's LINE/context lines can quote the statement, hash included
        first = [ln for ln in r.stderr.splitlines() if ln.startswith(("ERROR", "FATAL", "psql:"))][:1]
        raise Fail("psql exited %d: %s" % (r.returncode, HASH_ANY.sub("<hash>", (first or ["(no error line)"])[0])[:200]))
    return r.stdout


def orphan_count():
    """How many sessions named like THIS setter are connected — an earlier run's psql still alive."""
    out = psql("SELECT 'ORPHANS', count(*) FROM pg_stat_activity WHERE application_name = '%s' "
               "AND pid <> pg_backend_pid();\n" % APPNAME, appname=APPNAME + "-check")
    rows = [ln for ln in out.splitlines() if ln.startswith("ORPHANS|")]
    if len(rows) != 1:
        raise Fail("could not count earlier setter sessions")
    return int(rows[0].split("|")[1])


def read_state():
    out = psql("SELECT 'STATE', count(*), coalesce(min(role), ''), coalesce(min(password), '') "
               "FROM public.users WHERE username = '%s';\n" % CREW_USER)
    rows = [ln for ln in out.splitlines() if ln.startswith("STATE|")]
    if len(rows) != 1:
        raise Fail("could not read the crew row's state")
    _, n, role, pw = rows[0].split("|", 3)
    return int(n), role, pw


def write_row(new_hash, role):
    """One transaction: set password AND role, assert exactly one row RETURNING that role, else
    ROLLBACK. The values are checked against strict shapes before they reach SQL."""
    if not HASH_RE.match(new_hash) or not ROLE_RE.match(role):
        raise Fail("refusing to write a value that is not a bcrypt hash / a plain role")
    sql = (
        "BEGIN;\n"
        "WITH u AS (UPDATE public.users SET password = '%(h)s', role = '%(r)s', updated_at = now() "
        "WHERE username = '%(u)s' RETURNING role)\n"
        "SELECT count(*) AS n, coalesce(min(role), '') AS r, "
        "CASE WHEN count(*) = 1 AND min(role) = '%(r)s' THEN 'true' ELSE 'false' END AS ok FROM u \\gset\n"
        "\\if :ok\n"
        "COMMIT;\n"
        "\\echo RESULT|committed|:n|:r\n"
        "\\else\n"
        "ROLLBACK;\n"
        "\\echo RESULT|rolledback|:n|:r\n"
        "\\endif\n"
    ) % {"h": new_hash, "r": role, "u": CREW_USER}
    out = psql(sql)
    res = [ln for ln in out.splitlines() if ln.startswith("RESULT|")]
    if len(res) != 1:
        raise Fail("the write printed no RESULT line")
    _, verdict, n, r = res[0].split("|", 3)
    if verdict != "committed" or n != "1" or r != role:
        raise Fail("the write was ROLLED BACK: %s row(s), RETURNING role %r (wanted exactly 1 and %r)"
                   % (n, r, role))
    return n, r


# ───────────────────────────── env files and state ─────────────────────────────

def read_env_file(path):
    out = {}
    try:
        with open(path, encoding="utf-8") as fh:
            for ln in fh:
                ln = ln.strip()
                if ln and not ln.startswith("#") and "=" in ln:
                    k, v = ln.split("=", 1)
                    out[k.strip()] = v.strip()
    except FileNotFoundError:
        return None
    if not out.get("DT_API_USER") or not out.get("DT_API_PASS"):
        return None
    return out


def foreign_user(env):
    """r3 S1: an env that names ANOTHER user is not this setter's — a login with it proves nothing
    about the crew row, and acting on that login once deleted the only copy of the new value."""
    return env is not None and env.get("DT_API_USER") != CREW_USER


def _ids():
    return pwd.getpwnam(DTAPI_ACCOUNT).pw_uid, grp.getgrnam(DTAPI_ACCOUNT).gr_gid


def write_env(path, value):
    uid, gid = _ids()
    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC | os.O_NOFOLLOW, 0o600)
    try:
        os.fchown(fd, uid, gid)
        os.fchmod(fd, 0o600)
        os.write(fd, ("DT_API_USER=%s\nDT_API_PASS=%s\n" % (CREW_USER, value)).encode())
        os.fsync(fd)
    finally:
        os.close(fd)


def fsync_dir(d):
    fd = os.open(d, os.O_RDONLY)
    try:
        os.fsync(fd)
    finally:
        os.close(fd)


def unlink_quiet(p):
    try:
        os.unlink(p)
    except FileNotFoundError:
        pass


def ensure_state():
    """dt-api runs as dtapi, so every shared file it must write stays dtapi-owned even when root
    creates it here. (The ledger is dtapi:dtapi 0600 — dt-api must append to it; root reads it.)"""
    uid, gid = _ids()
    if not os.path.isdir(D.STATE_DIR):
        refuse(2, "REFUSED: %s is missing — install dt-api first." % D.STATE_DIR)
    for p in (D.LEDGER, D.LOCK_FILE):
        fd = os.open(p, os.O_WRONLY | os.O_CREAT | os.O_APPEND | os.O_NOFOLLOW, 0o600)
        os.fchown(fd, uid, gid)
        os.close(fd)
    os.makedirs(SETTER_DIR, mode=0o700, exist_ok=True)
    os.chmod(SETTER_DIR, 0o700)


def write_marker(m):
    D._write_json(MARKER, m)          # root-owned 0600 (umask below)
    fsync_dir(SETTER_DIR)             # the phase must be on disk before the step it announces runs


def purge_cache(clear_page=False):
    """dt-api's token and negative cache — and, on a SUCCESS path only, a standing page: a page that
    sent someone to run the setter would otherwise block (6)'s own login. A restore keeps the page
    (r2: it puts the old value back, and the page may be exactly about that value)."""
    unlink_quiet(D.TOKEN_FILE)
    unlink_quiet(D.NEG_FILE)
    if clear_page:
        unlink_quiet(D.PAGE_FILE)


# ───────────────────────────── logins (the loopback bucket, C3) ─────────────────────────────

def setter_login(env):
    """One login on the loopback bucket, recorded in the SHARED ledger as who=setter. Returns
    (status, headers, json)."""
    t = time.time()
    D._append(D.LEDGER, json.dumps({"ts": t, "who": "setter", "phase": "sent", "bucket": "loopback"}))
    st, h, b = D.app_request("POST", "/api/auth/login",
                             body={"username": env["DT_API_USER"], "password": env["DT_API_PASS"]},
                             timeout=D.LOGIN_TIMEOUT_S)
    D._append(D.LEDGER, json.dumps({"ts": time.time(), "who": "setter", "phase": "result",
                                    "status": st, "remaining": h.get("ratelimit-remaining"),
                                    "reset": h.get("ratelimit-reset"), "bucket": "loopback"}))
    return st, h, D._obj(b)


def verdict(st, j):
    """ok (a 200 carrying a token dt-api could use) | fail (401/404: an ANSWER about the value) |
    unknown (a 5xx, a 429, no answer, or a 200 dt-api would page as malformed — NOT an answer)."""
    if st == 200:
        tok = j.get("accessToken")
        ok = isinstance(tok, str) and isinstance(D.jwt_claims(tok).get("exp"), (int, float))
        return "ok" if ok else "unknown"
    if st in (401, 404):
        return "fail"
    return "unknown"


def try_login(env):
    """ok | fail | unknown as verdict(), or none (no usable file)."""
    if not env:
        return "none"
    st, _, j = setter_login(env)
    return verdict(st, j)


# ───────────────────────────── restore ─────────────────────────────

def precheck_env_copy(m):
    """r3: a restore that puts the database back and THEN finds no env copy leaves the two halves
    disagreeing. Check the copy first, so a missing one fails before anything is written."""
    if m.get("had_env") and not os.path.isfile(OLD_ENV):
        raise Fail("the old-env copy %s is missing; the database was NOT restored" % OLD_ENV)


def restore_db(m):
    n, r = write_row(m["old_hash"], m["old_role"])
    n2, role2, pw2 = read_state()
    if n2 != 1 or role2 != m["old_role"] or pw2 != m["old_hash"]:
        raise Fail("the re-read after the restore does not match the marker")
    say("restored: the crew row's hash and role are back to the marker's (role %s)" % role2)


def restore_env(m):
    if m.get("had_env"):
        uid, gid = _ids()
        with open(OLD_ENV, "rb") as fh:
            data = fh.read()
        tmp = D.ENV_FILE + ".restore"
        fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC | os.O_NOFOLLOW, 0o600)
        try:
            os.fchown(fd, uid, gid)
            os.write(fd, data)
            os.fsync(fd)
        finally:
            os.close(fd)
        os.replace(tmp, D.ENV_FILE)
    else:
        unlink_quiet(D.ENV_FILE)
    fsync_dir(os.path.dirname(D.ENV_FILE))
    say("restored: the live env is the pre-run one (%s)" % ("copied back" if m.get("had_env") else "absent, as before"))


def cleanup_run_files():
    """Only ever called once the state is FINAL. The marker goes before the old-env copy: a kill in
    between must never leave a marker pointing at a copy that no longer exists (r2 #3)."""
    unlink_quiet(TEMP_ENV)
    unlink_quiet(D.ENV_FILE + ".restore")
    unlink_quiet(MARKER)
    fsync_dir(SETTER_DIR)
    unlink_quiet(OLD_ENV)


def durable_page(kind, detail):
    """A page that outlives this terminal: dt-api's page.json, which the daily drift check raises
    as a system alert and which stops dt-api logging in until a person clears it (r1 #11).
    RETURNS True only if the page reached disk — the callers word their text off it (Langston,
    Gate 1-2: the text used to claim "PAGE raised" when this had swallowed the write's error).
    Gate 1-1 FINDING-2, the same rule as dt-api's page_write(): a page.json that cannot be read is
    NEVER written over; this cause goes to page.json.unreadable.<pid> beside it. (The setter keeps
    its own write because the file must be owned by dtapi, which dt-api's _write_json cannot do.)"""
    uid, gid = _ids()
    standing = D.page_standing()
    unreadable = isinstance(standing, dict) and bool(standing.get("_unreadable"))
    target = ("%s.unreadable.%d" % (D.PAGE_FILE, os.getpid())) if unreadable else D.PAGE_FILE
    # r3: through dt-api's ONE merge rule — the first sticky cause is kept, never overwritten
    body = json.dumps(D.page_merge(None if unreadable else standing, kind, detail, True)).encode()
    tmp = "%s.setter.%d" % (D.PAGE_FILE, os.getpid())
    try:
        fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
        try:
            os.fchown(fd, uid, gid)
            view = memoryview(body)
            while view:                                # Gate 1-1: a short write must not leave a cut page
                n = os.write(fd, view)
                if n <= 0:
                    raise OSError(5, "a write to the page file made no progress")
                view = view[n:]
            os.fsync(fd)
        finally:
            os.close(fd)
        os.replace(tmp, target)
    except OSError as e:
        unlink_quiet(tmp)
        say("WARNING — the PAGE could NOT be written (%s). Tell Infra Claude: this cause is in this "
            "run's output only." % (e.strerror or e))
        return False
    if unreadable:
        say("NOTE — %s could not be read and was NOT written over; this page's cause is in %s"
            % (D.PAGE_FILE, target))
    return True


def page_said(ok):
    """The callers' wording, from durable_page()'s answer — never a claim it did not make good."""
    return "PAGE raised" if ok else "the PAGE could NOT be written (the WARNING above)"


# ───────────────────────────── (0) reconcile ─────────────────────────────

def reconcile(m):
    phase = m.get("phase")
    say("(0) a marker from an interrupted run exists (phase %s, started %s)" % (phase, m.get("started")))
    if phase not in PHASES:
        refuse(4, "(0) the marker names an unknown phase %r — a person must look; it is KEPT." % phase)
    if phase in ("saved", "temp-written"):
        # r2 #4: the phase says the commit had not started — CHECK the row, which costs no login,
        # rather than trusting a phase that a crash could have left behind a landed commit
        n, role_now, hash_now = read_state()
        if n == 1 and role_now == m["old_role"] and hash_now == m["old_hash"]:
            cleanup_run_files()
            say("(0) the database was never written (the row is the pre-run one): removed the marker "
                "and the temp env. The OLD value stands. Re-run to set a new one.")
            return 0
        # r3 S2: the "committing" phase is fsynced BEFORE the write, so in these phases a changed
        # row was changed by SOMEONE ELSE — restoring would undo their change. Page and stop.
        ok = durable_page("setter-row-changed", "an interrupted setter run (phase %s) found the crew row "
                          "changed by someone else; it touched nothing" % phase)
        refuse(4, "(0) the marker says this setter never wrote the row, but the row has changed — someone "
                  "else changed it. Touching nothing; %s; the marker is KEPT at %s." % (page_said(ok), MARKER))
    live_env = read_env_file(D.ENV_FILE)
    temp_env = read_env_file(TEMP_ENV)
    if foreign_user(live_env) or foreign_user(temp_env):
        refuse(4, "(0) an env file names a user other than %s — a login with it proves nothing about the "
                  "crew row. Touching nothing; the marker is KEPT at %s." % (CREW_USER, MARKER))
    live, rem = "none", None
    if live_env:
        st, h, j = setter_login(live_env)
        live = verdict(st, j)
        rem = h.get("ratelimit-remaining")
    if live == "unknown":
        refuse(3, "(0) the live env's login got no usable answer (a 5xx, a 429 or a timeout) — "
                  "touching nothing; retry later.")
    if live == "fail" and rem == "0":
        refuse(3, "(0) the live env's login failed and the loopback bucket is now empty — the temp "
                  "env's login would meet a 429. Touching nothing; retry after the window resets.")
    if live == "ok":
        cleanup_run_files()
        purge_cache(clear_page=True)
        say("(0) the live env logs in: removed the marker and any temp env. Done.")
        return 0
    temp = try_login(temp_env)
    if temp == "unknown":
        refuse(3, "(0) the temp env's login got no usable answer — touching nothing; retry later.")
    if temp == "ok":
        os.replace(TEMP_ENV, D.ENV_FILE)
        fsync_dir(os.path.dirname(D.ENV_FILE))
        cleanup_run_files()             # r3: marker BEFORE the old-env copy, as everywhere else
        purge_cache(clear_page=True)
        say("(0) the temp env logs in: renamed it into place and removed the marker. The NEW value stands.")
        return 0
    # Neither logs in. If the row still holds the marker's hash and role, the commit never landed
    # (a kill mid-commit, before any env existed): nothing to restore, nothing to page.
    n, role_now, hash_now = read_state()
    if n == 1 and role_now == m["old_role"] and hash_now == m["old_hash"]:
        # the row is the pre-run one (the commit never landed, or an earlier restore of the DB did).
        # ⛔ The ENV may still hold the NEW value (a restore killed between its DB and env halves,
        #    fresh-reader r1 #1), so it is restored too — from the copy this marker points at.
        try:
            restore_env(m)
        except Exception as e:
            refuse(4, "RESTORE FAILED during (0): %s — the marker is KEPT at %s; do not delete it." % (e, MARKER))
        cleanup_run_files()
        purge_cache()
        restored = read_env_file(D.ENV_FILE)
        if restored:
            # r2 #8: "the OLD value stands" is only true if that value actually logs in
            st, _, j = setter_login(restored)
            v = verdict(st, j)
            if v == "unknown":
                # r3 S3: a 429, a 5xx or no answer is NOT an answer about the value — no page (a sticky
                # page would block dt-api for a fault a retry fixes), exit 3
                refuse(3, "(0) restored the pre-run env; its check login got no usable answer (%s). No "
                          "page; check it with dt-api once the login bucket allows." % st)
            if v == "fail":
                ok = durable_page("setter-restored-env-refused", "the pre-run env was put back but its login "
                                  "answered %s — the crew login is not working; re-run the setter" % st)
                refuse(1, "(0) restored the pre-run env, but it does NOT log in (%s). %s; re-run "
                          "the setter once the login bucket allows." % (st, page_said(ok)))
            # r3 S5: the value that stands logs in, so a standing page is no longer true — clear it,
            # or dt-api stays blocked by a page about a login that now works
            purge_cache(clear_page=True)
        say("(0) the row holds the pre-run hash and role; the env is back to the pre-run one. Removed "
            "the marker and the temp env. The OLD value stands.")
        return 0
    try:
        precheck_env_copy(m)
        restore_db(m)
        restore_env(m)
        purge_cache()
        cleanup_run_files()
    except Exception as e:
        refuse(4, "RESTORE FAILED during (0): %s — the marker is KEPT at %s; do not delete it." % (e, MARKER))
    ok = durable_page("setter-restored", "an interrupted setter run found neither the live nor the temp "
                      "value accepted; it restored the pre-run hash, role and env")
    refuse(1, "(0) neither the live nor the temp env logs in. Restored the marker's hash, role and "
              "env. %s: Infra Claude must look — something outside this setter changed the crew row."
              % page_said(ok))


# ───────────────────────────── the run ─────────────────────────────

def gen_value():
    """40 characters from [A-Za-z0-9] plus ONE '_': passes validatePasswordStrength
    (auth-service.ts:10-16 — an uppercase letter, a digit, a special from its set), is 41 bytes
    (under bcrypt's 72), and holds no quote or shell metacharacter."""
    alnum = string.ascii_letters + string.digits
    while True:
        body = [secrets.choice(alnum) for _ in range(40)]
        pos = secrets.randbelow(41)
        v = "".join(body[:pos]) + "_" + "".join(body[pos:])
        if re.search(r"[A-Z]", v) and re.search(r"\d", v):
            return v


def hash_value(v):
    import bcrypt                       # python3-bcrypt (Debian 3.2.2); ⛔ never bcryptjs from /home/deploy
    h = bcrypt.hashpw(v.encode(), bcrypt.gensalt(rounds=10)).decode()
    if not HASH_RE.match(h) or len(h) != 60:
        raise Fail("the hash does not have bcrypt's shape (C2)")
    if not bcrypt.checkpw(v.encode(), h.encode()):
        raise Fail("the hash does not verify locally")
    return h


def run():
    start = time.time()
    # ── the budget (C4: the window is FIXED per key, opening at its first hit; "no loopback login
    #    in the last 900 s" therefore means no window we opened is still running) ──
    try:
        recent = D.ledger_sent_since(start - D.WINDOW_S)
    except SystemExit:
        refuse(3, "REFUSED: could not read dt-api's login ledger (the line above). Nothing touched.")
    if recent:
        last = max(e["ts"] for e in recent)
        refuse(2, "REFUSED: the ledger records a loopback login at %s; the fixed window it may have "
                  "opened ends by %s. Nothing touched; retry after then." % (D._iso(last), D._iso(last + D.WINDOW_S)))
    try:
        if orphan_count():
            refuse(2, "REFUSED: a psql session from an earlier setter run is still connected; it may "
                      "yet commit. Nothing touched; retry once it has gone.")
    except Fail as e:
        refuse(3, "REFUSED: could not check for earlier setter sessions: %s. Nothing touched." % e)
    if os.path.exists(MARKER):
        m = D._read_json(MARKER)
        if not isinstance(m, dict) or any(k not in m for k in MARKER_KEYS):
            refuse(4, "REFUSED: %s exists but cannot be read as a marker — an interrupted run's recovery "
                      "data. Nothing touched; a person must look." % MARKER)
        try:
            return reconcile(m)
        except Fail as e:
            refuse(4, "(0) could not finish reconciling: %s — the marker is KEPT at %s." % (e, MARKER))
    unlink_quiet(TEMP_ENV)             # a temp env with no marker is debris from nothing
    try:
        n, old_role, old_hash = read_state()
    except Fail as e:
        refuse(3, "REFUSED: could not read the crew row: %s. Nothing touched." % e)
    if n != 1:
        refuse(2, "REFUSED: expected exactly one row for %s, found %d. Nothing touched." % (CREW_USER, n))
    if not HASH_RE.match(old_hash) or not ROLE_RE.match(old_role):
        refuse(2, "REFUSED: the crew row's current hash or role is not restorable. Nothing touched.")
    if foreign_user(read_env_file(D.ENV_FILE)):
        refuse(2, "REFUSED: %s names a user other than %s — not this setter's file. Nothing touched."
               % (D.ENV_FILE, CREW_USER))
    # (1) save
    had_env = os.path.exists(D.ENV_FILE)
    if had_env:
        with open(D.ENV_FILE, "rb") as fh:
            data = fh.read()
        fd = os.open(OLD_ENV, os.O_WRONLY | os.O_CREAT | os.O_TRUNC | os.O_NOFOLLOW, 0o600)
        os.write(fd, data)
        os.fsync(fd)
        os.close(fd)
    m = {"started": D._iso(start), "old_hash": old_hash, "old_role": old_role,
         "had_env": had_env, "phase": "saved"}
    write_marker(m)
    say("(1) saved the marker (old role %s) and %s" % (old_role, "a copy of the live env" if had_env else "noted: no live env yet"))
    hook("1")
    phase = "saved"
    cleared = None
    try:
        checkpoint("(1b)")
        # (1b)
        value = gen_value()
        write_env(TEMP_ENV, value)
        fsync_dir(os.path.dirname(TEMP_ENV))          # r3: the temp env's entry is on disk too
        m["phase"] = phase = "temp-written"
        write_marker(m)
        say("(1b) wrote the new value to the temp env (0600 %s)" % DTAPI_ACCOUNT)
        hook("1b")
        checkpoint("(2)")
        # (2)
        new_hash = hash_value(value)
        m["phase"] = phase = "committing"
        write_marker(m)
        n2, r2 = write_row(new_hash, NEW_ROLE)
        say("(2) committed: %s row, RETURNING role %s" % (n2, r2))
        hook("2")
        checkpoint("(3)")
        # (3)
        st, h, j = setter_login({"DT_API_USER": CREW_USER, "DT_API_PASS": value})
        if st != 200:
            raise Fail("(3) the fresh login with the new value answered %s" % st)
        claims = D.jwt_claims(j.get("accessToken", ""))
        role_resp = j["user"].get("role") if isinstance(j.get("user"), dict) else None
        if not isinstance(claims.get("iat"), (int, float)) or claims["iat"] < int(start):
            raise Fail("(3) the token was not issued after this run started")
        if role_resp != NEW_ROLE or claims.get("role") != NEW_ROLE:
            raise Fail("(3) the login's user.role is %r and the token's role %r, not %r"
                       % (role_resp, claims.get("role"), NEW_ROLE))
        remaining, reset = h.get("ratelimit-remaining"), h.get("ratelimit-reset")
        m["phase"] = phase = "verified"
        write_marker(m)
        say("(3) a fresh login with the new value works: user.role %s; loopback bucket remaining %s, "
            "resets in %s s" % (role_resp, remaining, reset))
        checkpoint("(4)")               # the LAST point an interrupt is acted on; after (4) the run finishes
        # (4) THE COMMIT POINT — the phase moves BEFORE the rename (r2 #2): a failure at any instant
        #     from here restores the env too, and restoring an env that was not yet renamed is harmless
        phase = "renamed"
        os.replace(TEMP_ENV, D.ENV_FILE)
        fsync_dir(os.path.dirname(D.ENV_FILE))
        m["phase"] = "renamed"
        write_marker(m)
        say("(4) the new value is live in %s" % D.ENV_FILE)
        hook("4")
        # (5)
        cleared = D.page_standing()
        purge_cache(clear_page=True)
        say("(5) purged dt-api's token, its negative cache and any standing page")
        DLOCK.__exit__(None, None, None)
        hook("5")
        # (6) — C4: the headers are authoritative; if our (3) emptied the bucket, wait it out
        if remaining == "0" and reset and reset.isdigit():
            wait = min(int(reset), D.WINDOW_S) + 2       # r3: the margin survives the cap
            say("(6) the loopback bucket is empty; waiting %d s for its window to reset" % wait)
            time.sleep(wait)
        rc, err = run_verify()
        if rc != 0 or "HTTP 200 GET /api/settings" not in err:
            raise Fail("(6) dt-api GET /api/settings exited %s: %s" % (rc, err.strip()[:300]))
        say("(6) dt-api GET /api/settings returned 200 through sudo, as callers will use it")
    except Exception as e:
        say("FAILED at phase %s: %s" % (phase, HASH_ANY.sub("<hash>", str(e))))
        try:
            if phase in ("saved", "temp-written"):
                cleanup_run_files()
                say("nothing in the database was written; removed the temp env and the marker")
            elif phase in ("committing", "verified"):
                restore_db(m)
                cleanup_run_files()
            else:
                if DLOCK.fd is None:
                    DLOCK.__enter__()                  # re-take before touching the env (pre-audit §2.2.4)
                precheck_env_copy(m)
                restore_db(m)
                restore_env(m)
                purge_cache()
                cleanup_run_files()
                # r3 S4: (5) cleared the standing page before (6) failed; the restored value is the
                # pre-run one, so the page goes back up — with this failure added to it
                if cleared is not None:
                    uid, gid = _ids()
                    D._write_json(D.PAGE_FILE, cleared)
                    os.chown(D.PAGE_FILE, uid, gid)
                durable_page("setter-restored", "the setter's (6) check failed after the new value went "
                             "live; it restored the pre-run hash, role and env")
        except BaseException as e2:                    # SystemExit from a lock timeout included
            why = ("dt-api's lock could not be re-taken (exit %s)" % e2.code) if isinstance(e2, SystemExit) \
                else (HASH_ANY.sub("<hash>", str(e2)) or type(e2).__name__)
            refuse(4, "RESTORE FAILED: %s — the marker is KEPT at %s; the next run reconciles it. "
                      "Do not delete it." % (why, MARKER))
        if isinstance(e, Interrupted):
            refuse(3, "the setter was STOPPED by a signal at a checkpoint; the previous state is back (see above).")
        refuse(1, "the setter FAILED and restored the previous state (see above).")
    # (7) — OUTSIDE the restoring try (r2 BLOCKER): (6) has proved the new value, so nothing from
    #      here may restore it. The marker goes first; a kill between the two unlinks is harmless.
    try:
        unlink_quiet(MARKER)
        fsync_dir(SETTER_DIR)
        unlink_quiet(OLD_ENV)
    except OSError as e:
        # r3: (6) has PROVED the new value; a tidy-up error is not a failure. A marker left behind is
        # reconciled harmlessly by the next run (the live env logs in -> removed).
        say("(7) WARNING: could not remove the marker or the old-env copy (%s); the next run tidies "
            "them. DONE: the crew login is set, role %s." % (e.strerror, NEW_ROLE))
        return 0
    say("(7) removed the marker and the old-env copy. DONE: the crew login is set, role %s." % NEW_ROLE)
    return 0


def run_verify():
    """(6) in its own process group, killed as a GROUP on timeout: a timed-out sudo must not leave
    dt-api running on, holding the lock or writing a page after the setter has moved on (r2 #12)."""
    p = subprocess.Popen(DT_API_VERIFY, stdout=subprocess.PIPE, stderr=subprocess.PIPE, start_new_session=True)
    try:
        _, err = p.communicate(timeout=420)
    except subprocess.TimeoutExpired:
        for sig in (signal.SIGTERM, signal.SIGKILL):
            try:
                os.killpg(p.pid, sig)
            except ProcessLookupError:
                break
            try:
                p.wait(timeout=10)
                break
            except subprocess.TimeoutExpired:
                continue
        return "timeout", ""
    return p.returncode, err.decode("utf-8", "replace")


DLOCK = None


def main():
    global PGENV, DLOCK
    if EXPECT_ROOT and os.geteuid() != 0:
        refuse(2, "REFUSED: run as root.")
    os.umask(0o077)
    signal.signal(signal.SIGHUP, signal.SIG_IGN)       # an ssh that drops must not kill a run mid-change
    signal.signal(signal.SIGTERM, _on_signal)
    signal.signal(signal.SIGINT, _on_signal)
    pgfile, PGENV = pg_env()
    try:
        sfd = os.open(SETTER_LOCK, os.O_RDWR | os.O_CREAT, 0o600)
    except OSError as e:
        # Langston, Gate 1-2: this sat outside every refuse(), so it exited 1 with a traceback — and
        # 1 is reserved for "failed and restored". Nothing has been touched yet: exit 3. The accepted
        # PGPASSFILE is NOT removed, for the same reason as the lock-held case below (r1 #5).
        refuse(3, "REFUSED: could not open the setter's lock %s (%s). Nothing touched. The PGPASSFILE "
                  "was NOT removed." % (SETTER_LOCK, e.strerror or e))
    try:
        fcntl.flock(sfd, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        # ⛔ NOT removing the PGPASSFILE here: it may be the running setter's (r1 #5)
        refuse(2, "REFUSED: another setter run holds %s. Its run log: %s" % (SETTER_LOCK, RUN_LOG))
    try:
        try:
            ensure_state()
        except (OSError, KeyError) as e:
            # r3: an uncaught error here exited 1 — which this contract reserves for "failed and restored"
            refuse(3, "REFUSED: could not prepare the state files (%s: %s). Nothing touched."
                   % (type(e).__name__, e))
        DLOCK = D.Lock()
        try:
            DLOCK.__enter__()
        except SystemExit:
            refuse(3, "REFUSED: could not take dt-api's lock within %d s (the line above is dt-api's) — "
                      "a call or a mint is running. Nothing touched." % LOCK_WAIT_S)
        try:
            return run()
        except (Exception, KeyboardInterrupt) as e:
            # outside the restoring try nothing has been changed that a re-run cannot reconcile
            refuse(3, "STOPPED by an unexpected %s before any change it could not undo; if a marker "
                      "exists the next run reconciles it (%s)." % (type(e).__name__, MARKER))
        finally:
            DLOCK.__exit__(None, None, None)
    finally:
        unlink_quiet(pgfile)            # run-only: removed on exit, whatever happened


if __name__ == "__main__":
    sys.exit(main())
