def out(kind, text, cls=None, subj=None):
    """subj (r3 S2): WHAT failed — a path, a unit, a check. The alert is keyed per (class, subject),
    so a standing alert for one file can never swallow a new failure of the same class elsewhere."""
    line = "%-8s %s" % (kind, text)
    print(line, flush=True)
    if kind not in ("OK", "PENDING"):
        PROBLEMS.append(line)
        CLASSES.add((cls or kind, subj or "-"))


def read_small(path, limit=1 << 16):
    """(stat, bytes) of a small file that ANOTHER account may control (dt-api's page, a fetch stamp).
    r3: never follows a link, and never BLOCKS — a FIFO planted at the path used to hang the run until
    its 30-minute timeout. Raises OSError for anything but a regular file."""
    fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
    try:
        st = os.fstat(fd)
        if not stat.S_ISREG(st.st_mode):
            raise OSError("not a regular file")
        return st, os.read(fd, limit)
    finally:
        os.close(fd)


def P(path):
    return ROOT + path


def git(box, *args, binary=False):
    cmd = RUNUSER + [box["git_as"], "--"] + GIT_ENV + ["git", "--git-dir=" + P(box["git_dir"])] + list(args)
    try:
        r = subprocess.run(cmd, capture_output=True, timeout=GIT_TIMEOUT_S)
    except (subprocess.TimeoutExpired, OSError) as e:
        return None, "%s running git" % type(e).__name__
    if r.returncode != 0:
        return None, r.stderr.decode("utf-8", "replace").strip()[:200] or "git exited %d" % r.returncode
    return (r.stdout if binary else r.stdout.decode("utf-8", "replace").strip()), None


def blob_hash(data):
    return hashlib.sha1(b"blob %d\0" % len(data) + data).hexdigest()


def read_installed(path):
    fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW)
    try:
        st = os.fstat(fd)
        if not stat.S_ISREG(st.st_mode):
            raise OSError("not a regular file")
        chunks = []
        while True:
            b = os.read(fd, 1 << 20)
            if not b:
                break
            chunks.append(b)
        return st, b"".join(chunks)
    finally:
        os.close(fd)


def _name(fn, i):
    try:
        return fn(i)[0]
    except KeyError:
        return str(i)


def owner_ok(st, mode, user, group):
    try:
        uid, gid = pwd.getpwnam(user).pw_uid, grp.getgrnam(group).gr_gid
    except KeyError as e:
        return False, "the account %s does not exist" % e
    have = (stat.S_IMODE(st.st_mode), st.st_uid, st.st_gid)
    if have != (mode, uid, gid):
        return False, "mode/owner is %o %s:%s, wanted %o %s:%s" % (
            have[0], _name(pwd.getpwuid, have[1]), _name(grp.getgrgid, have[2]), mode, user, group)
    return True, ""


def source_fresh(box):
    """The newest SUCCESSFUL refresh. r3 S4, measured on git 2.43: a FAILED fetch truncates
    FETCH_HEAD to 0 bytes AND refreshes its mtime, so an mtime alone reads a dead fetch as fresh —
    after the repo goes private the checker's fetch fails and the stale check could never fire. A
    stamp counts only if it has CONTENT (a successful fetch writes the refs it fetched).
    ⚠️ FORWARD (Langston, Gate 1-2): when the repo goes private (OBJ-6) the checker's fetch starts
    failing → FETCH_HEAD 0 bytes → None here → SOURCE → a DAILY PAGE on staging. That is correct and
    loud, but it will read as drift rather than a credentials gap — OBJ-6 must move the checker's
    fetch credentials in the same change, or say explicitly that it expects this page."""
    newest = None
    for s in box["stamps"]:
        try:
            st, data = read_small(P(s), 64)
        except OSError:
            continue
        first = data.decode("utf-8", "replace").split()
        if not first:
            continue                            # an EMPTY stamp is a failed refresh, not a fresh one
        t = float(first[0]) if first[0].replace(".", "", 1).isdigit() else st.st_mtime
        newest = t if newest is None else max(newest, t)
    return newest


def systemctl(*args):
    try:
        r = subprocess.run([SYSTEMCTL] + list(args), capture_output=True, text=True, timeout=30)
        return r.returncode, r.stdout.strip()
    except (subprocess.TimeoutExpired, OSError) as e:
        return None, type(e).__name__


def check_units(box):
    for unit, (fragment, dropins) in box["units"].items():
        rc, o = systemctl("show", "-p", "LoadState,NeedDaemonReload,DropInPaths,FragmentPath", unit)
        props = dict(ln.split("=", 1) for ln in o.splitlines() if "=" in ln) if rc == 0 else {}
        if rc != 0 or props.get("LoadState") != "loaded":
            out("UNIT", "%s is not loaded (%s)" % (unit, props.get("LoadState") or o), "UNIT", unit)
            continue
        if props.get("NeedDaemonReload") != "no":
            out("UNIT", "%s changed on disk and systemd has not reloaded it — the running definition "
                        "is not the installed one" % unit, "UNIT", unit)
        if props.get("FragmentPath") != fragment:
            out("UNIT", "%s loads from %s, not the installed %s (a higher-priority copy shadows it)"
                % (unit, props.get("FragmentPath") or "nowhere", fragment), "UNIT", unit)
        have = sorted(x for x in props.get("DropInPaths", "").split() if x)
        if have != sorted(dropins):
            out("UNIT", "%s drop-ins are %s, wanted exactly %s (an extra drop-in can override "
                        "OnFailure or ExecStart)" % (unit, have or "none", dropins), "UNIT", unit)
    for t in box["timers"]:
        for verb, want in (("is-enabled", "enabled"), ("is-active", "active")):
            rc, o = systemctl(verb, t)
            if o != want:
                out("UNIT", "%s %s says %r, wanted %r" % (t, verb, o, want), "UNIT", t)


def raise_alert(key, title, body, meta):
    """One governance alert, as deploy, idempotent on its key while unresolved (system-alerts.ts addAlert dedupe).
    Returns None on success, else a short reason. Never raises."""
    cmd = RUNUSER + ["deploy", "--"] + ALERT_NPM + ["add",
        "--triggers-at", time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()), "--category", "governance",
        "--severity", "warning", "--dedupe-key", key, "--title", title, "--body", body,
        "--metadata", json.dumps(meta, sort_keys=True)]
    try:
        r = subprocess.run(cmd, cwd=P(APP_DIR), capture_output=True, timeout=180)
    except (subprocess.TimeoutExpired, OSError) as e:
        return type(e).__name__
    return None if r.returncode == 0 else "exit %d" % r.returncode


def resolve_alert_key(key, evidence):
    """Resolve every non-terminal row with this key, as the machine actor dt-install-drift. None, or a reason."""
    cmd = RUNUSER + ["deploy", "--"] + ALERT_NPM + ["resolve-key", key, "--by", "dt-install-drift", "--evidence", evidence]
    try:
        r = subprocess.run(cmd, cwd=P(APP_DIR), capture_output=True, timeout=180)
    except (subprocess.TimeoutExpired, OSError) as e:
        return type(e).__name__
    return None if r.returncode == 0 else "exit %d" % r.returncode


def open_alert_keys(prefix):
    """Dedupe keys with this prefix whose LATEST row (rows merged by id) is not resolved. Root reads the file."""
    last = {}
    with open(P(ALERTS_FILE), encoding="utf-8", errors="replace") as fh:
        for ln in fh:
            try:
                d = json.loads(ln)
            except ValueError:
                continue
            if isinstance(d, dict) and str(d.get("dedupe_key") or "").startswith(prefix):
                last[d.get("id")] = d
    return {d["dedupe_key"] for d in last.values() if d.get("state") != "resolved"}


def deploy_windows(box):
    """B-DEPLOY-WINDOW-GUARD (#1249, Langston BLOCKER-2, C-15, C-16). Rides this run's SCHEDULE, stays OFF its
    verdict for what belongs to another session: a stale observation window, and a deploy whose in-window alert
    was not raised (window_notice=notice-only), each get their OWN governance alert naming the window's owner.
    ON the verdict, deliberately, and mine: the register is unusable (so every deploy is now refused, exit 4), or
    this check cannot raise its alerts. It catches its own exceptions, so neither reaches check_extra's wrapper,
    whose page would name the wrong owner and the wrong causes."""
    try:
        _deploy_windows(box)
    except Exception as e:
        out("STATE", "the deploy_windows check crashed (%s) - stale observation windows and notice-only deploys are "
            "NOT being raised to their owners" % type(e).__name__, "WINDOWS", "deploy-windows-alert")


def _deploy_windows(box):
    text, err = git(box, "show", "%s:%s" % (box["ref"], REGISTER_PATH))
    stale = []
    census_ok = False
    if text is None:
        out("STATE", "the observation-window register %s is unreadable at the branch head (%s), so every deploy is "
            "now refused (dt-deploy exit 4)" % (REGISTER_PATH, err), "WINDOWS", "deploy-windows-register")
    else:
        try:
            r = subprocess.run([P(OBS_WINDOWS), "census"], input=(text + "\n").encode("utf-8"),
                               capture_output=True, timeout=60)
            rc, so, se = r.returncode, r.stdout.decode("utf-8", "replace"), r.stderr.decode("utf-8", "replace")
        except (subprocess.TimeoutExpired, OSError) as e:
            rc, so, se = None, "", type(e).__name__
        if rc == 4:
            out("STATE", "the observation-window register is unusable, so every deploy is now refused (dt-deploy "
                "exit 4): %s" % se.strip()[:200], "WINDOWS", "deploy-windows-register")
        elif rc != 0:
            out("STATE", "%s could not read the register (%s): %s" % (OBS_WINDOWS, rc, se.strip()[:160]),
                "WINDOWS", "deploy-windows-alert")
        else:
            census_ok = True
            stale = [ln.split(" ", 3) for ln in so.splitlines() if ln.startswith("STALE ")]
    failed = []
    for _, batch, owner, why in stale:
        why_ = raise_alert("deploy-window-stale:%s" % batch,
                           "Observation window %s is STALE (owner %s)" % (batch, owner),
                           "Owner %s: your observation window %s in %s is %s. A stale window no longer blocks a "
                           "deploy, so a deploy can now restart the app inside it with only a notice. Close it (an "
                           "entry with a reason code) or amend its review_by, by a commit. Resolve this alert once the "
                           "register says so; never ack. (B-DEPLOY-WINDOW-GUARD, #1249)" % (owner, batch, REGISTER_PATH, why),
                           {"batch": batch, "owner": owner, "reason": why})
        if why_:
            failed.append("stale %s (%s)" % (batch, why_))
    # Attack (2) (Langston, gate B): the mirror of the daily re-raise. A window that is NO LONGER stale (its owner
    # amended review_by, or closed it) leaves its active row with no clearing instrument - so resolve every open
    # deploy-window-stale:* key that is not in THIS run's stale set, citing the register ref. Only when the census
    # actually ran (text is not None and rc 0): an unreadable register must never clear an alert.
    if text is not None and census_ok:
        now_stale = {"deploy-window-stale:%s" % b for _, b, _, _ in stale}
        for key in sorted(open_alert_keys("deploy-window-stale:") - now_stale):
            why_ = resolve_alert_key(key, "no longer stale in %s at %s (dt-install-drift deploy_windows)" % (REGISTER_PATH, box["ref"]))
            if why_:
                failed.append("clear %s (%s)" % (key, why_))
            else:
                out("OK", "deploy_windows: %s is no longer stale - resolved" % key)
    raised = set()
    try:
        raised = set(open(P(NOTICE_RAISED)).read().split())
    except FileNotFoundError:
        pass
    lines = []
    try:
        lines = read_small(P(DEPLOY_NOTICE), limit=1 << 22)[1].decode("utf-8", "replace").splitlines()
    except FileNotFoundError:
        pass
    notice_only = 0
    for ln in lines:
        f = dict(kv.split("=", 1) for kv in ln.split() if "=" in kv)
        if f.get("window_notice") != "notice-only":
            continue
        notice_only += 1
        tag = "%s:%s" % (f.get("sha", "?"), f.get("attempt_at", "?"))
        if tag in raised:
            continue
        why_ = raise_alert("deploy-window-notice-only:%s" % tag.replace(":", "").replace("-", ""),
                           "A deploy landed in observation window(s) %s with NO alert raised" % f.get("in_window", "?"),
                           "dt-deploy started %s by %s at %s inside %s, but its in-window alert could not be raised "
                           "(window_notice=notice-only). The owners were told only by the Helsinki notice. Read "
                           "/home/deploy/dawntrader-deploy.record for the outcome. Resolve, never ack." % (
                               f.get("sha", "?"), f.get("by", "?"), f.get("attempt_at", "?"), f.get("in_window", "?")),
                           {"sha": f.get("sha"), "attempt_at": f.get("attempt_at"), "in_window": f.get("in_window")})
        if why_:
            failed.append("notice-only %s (%s)" % (tag, why_))
        else:
            with open(P(NOTICE_RAISED), "a") as fh:
                fh.write(tag + "\n")
    if failed:
        out("STATE", "the deploy_windows check could not raise %d owner alert(s): %s" % (len(failed), "; ".join(failed)),
            "WINDOWS", "deploy-windows-alert")
    out("OK", "deploy_windows: %d stale window(s) and %d notice-only deploy line(s), raised to their owners"
        % (len(stale), notice_only))


# B-4 (Langston, gate B r2): the watcher's key is bounded ONLY by the options on its authorized_keys line. Drop
# command= one day and that key is a full deploy shell from Helsinki - so the line itself is checked, exactly.
NOTICE_KEY_FILE = "/home/deploy/.ssh/authorized_keys"
NOTICE_KEY_COMMENT = "dt-deploy-notice@helsinki"
NOTICE_KEY_OPTIONS = 'restrict,from="204.168.141.77",command="/usr/local/bin/dt-deploy-notice-gate"'


def check_notice_key():
    """Exactly ONE line carries the watcher's comment, and its options are EXACTLY the pinned string. Fail-closed:
    a missing file, no such line, two of them, or any other options is a STATE failure (subject deploy-notice-key)."""
    try:
        body = read_small(P(NOTICE_KEY_FILE))[1].decode("utf-8", "replace")
    except OSError as e:
        out("STATE", "%s cannot be read (%s), so the deploy-notice key's restriction is unverified"
            % (NOTICE_KEY_FILE, type(e).__name__), "KEYS", "deploy-notice-key")
        return
    lines = [ln.strip() for ln in body.splitlines()
             if ln.strip() and not ln.strip().startswith("#") and ln.split()[-1] == NOTICE_KEY_COMMENT]
    if len(lines) != 1:
        out("STATE", "%s holds %d line(s) for %s; exactly one is required" % (NOTICE_KEY_FILE, len(lines), NOTICE_KEY_COMMENT),
            "KEYS", "deploy-notice-key")
        return
    opts = lines[0].split(" ssh-ed25519 ", 1)[0] if " ssh-ed25519 " in lines[0] else "<no options>"
    if opts != NOTICE_KEY_OPTIONS:
        out("STATE", "the deploy-notice key's options are %r, expected exactly %r - without them the key is a full "
            "deploy shell" % (opts[:160], NOTICE_KEY_OPTIONS), "KEYS", "deploy-notice-key")
        return
    out("OK", "the deploy-notice key is pinned to dt-deploy-notice-gate")


def check_extra(name, box):
    if name == "deploy_notice_key":
        check_notice_key()
    elif name == "deploy_windows":
        deploy_windows(box)
    elif name == "dt_api_page":
        p = P("/var/lib/dt-api/page.json")
        if os.path.lexists(p):
            try:
                pg = json.loads(read_small(p)[1].decode("utf-8"))
                pg = pg if isinstance(pg, dict) else {}
            except (OSError, ValueError):
                pg = {}
            kind = str(pg.get("kind", "unreadable"))
            out("STATE", "dt-api raised a PAGE at %s: %s — %s (fix the cause, then remove %s; dt-api "
                "makes no login while it stands)" % (pg.get("ts"), kind, pg.get("detail"), p),
                "PAGE-" + "".join(c for c in kind if c.isalnum() or c == "-")[:40], "page")
    elif name == "setter_marker":
        p = P("/var/lib/dt-api-setter/marker.json")
        if os.path.lexists(p):
            age = time.time() - os.lstat(p).st_mtime
            if age > MARKER_MAX_AGE_S:
                out("STATE", "an interrupted setter run left its marker at %s (%d min old) — re-run "
                             "the setter to reconcile it" % (p, age // 60), "MARKER", "marker")
    elif name == "accounts":
        try:
            if pwd.getpwnam("dtmint").pw_shell not in ("/bin/sh", "/usr/bin/sh"):
                out("STATE", "dtmint's shell is %s; the forced command needs /bin/sh"
                    % pwd.getpwnam("dtmint").pw_shell, "ACCOUNT", "dtmint")
        except KeyError:
            out("STATE", "the dtmint account does not exist", "ACCOUNT", "dtmint")
        try:
            if pwd.getpwnam("dtapi").pw_shell not in ("/usr/sbin/nologin", "/sbin/nologin"):
                out("STATE", "dtapi has a login shell (%s); it must be nologin"
                    % pwd.getpwnam("dtapi").pw_shell, "ACCOUNT", "dtapi")
        except KeyError:
            out("STATE", "the dtapi account does not exist", "ACCOUNT", "dtapi")
        try:
            for ln in open(P("/etc/shadow")):
                f = ln.split(":")
                if f[0] == "dtmint" and len(f) > 1 and f[1] != "*":
                    out("STATE", "dtmint's password field is %s, not '*' — a locked account can refuse the "
                        "mint's key login, and a hash is a usable password" % ("a hash" if f[1][:1] not in ("!", "") else repr(f[1][:2])), "ACCOUNT", "dtmint")
                # r3: an EMPTY field is not "no password" — it is an empty, usable one
                if f[0] == "dtapi" and len(f) > 1 and not (f[1] == "*" or f[1].startswith("!")):
                    out("STATE", "dtapi's password field is %s; it must be '*' or locked ('!')"
                        % ("EMPTY (a usable empty password)" if f[1] == "" else "a usable hash"), "ACCOUNT", "dtapi")
        except OSError as e:
            out("STATE", "cannot read the shadow file: %s" % e, "ACCOUNT", "shadow")
        # r3: a %group sudoers rule reaches a MEMBER without naming it — dtapi and dtmint must be in
        # no supplementary group, so no group rule can ever apply to them
        # Gate 1-2 r3 (Langston): getgrgid() returns ONE entry per gid, so a second group NAME sharing an
        # account's primary gid (`dtapi:x:1001:` + `staff:x:1001:`) passed the primary check below while a
        # %staff rule resolves to gid 1001 and applies. Every entry carrying that gid is compared here.
        # (The same trap is written at langston-privacy-check's group_members(); it did not travel.)
        # Only when the gid's own entry IS the account's group: a foreign or orphan primary is reported once,
        # by the primary check below, not twice.
        prim_gid = {}
        for who in ("dtapi", "dtmint"):
            try:
                gid0 = pwd.getpwnam(who).pw_gid
                if grp.getgrgid(gid0).gr_name == who:
                    prim_gid[who] = gid0
            except KeyError:
                pass                                       # missing account / orphan gid: reported elsewhere
        for g in grp.getgrall():
            for who in ("dtapi", "dtmint"):
                if who in g.gr_mem:
                    out("STATE", "%s is a member of group %s — a %%%s sudoers rule would apply to it"
                        % (who, g.gr_name, g.gr_name), "SUDO", who)
                if prim_gid.get(who) == g.gr_gid and g.gr_name != who:
                    out("STATE", "%s's PRIMARY gid %d is ALSO named %s — a %%%s sudoers rule would apply to it"
                        % (who, g.gr_gid, g.gr_name, g.gr_name), "SUDO", who)
        # Gate 1-2 (Langston, an enumerator-blind-spot): gr_mem does NOT list PRIMARY-group members,
        # so `usermod -g staff dtapi` was invisible above. Each account's primary group must be its own.
        for who in ("dtapi", "dtmint"):
            try:
                gid = pwd.getpwnam(who).pw_gid
            except KeyError:
                continue                                   # a missing account is the account check's to report
            try:
                prim = grp.getgrgid(gid).gr_name
            except KeyError:
                # Gate 1-2 r2 (Langston): an ORPHAN primary gid (`usermod -g 9999 dtapi`) is not a missing
                # account, and nothing else sees it — the sudoers scan matches neither the numeric
                # `%#9999` form nor the bare gid. Report it; never skip it.
                out("STATE", "%s's PRIMARY group id %d resolves to NO group — a %%#%d sudoers rule would "
                    "apply to it" % (who, gid, gid), "SUDO", who)
                continue
            if prim != who:
                out("STATE", "%s's PRIMARY group is %s, not its own — a %%%s sudoers rule would apply to it"
                    % (who, prim, prim), "SUDO", who)
    elif name == "sudoers_others":
        # r2: the main file too, not only the drop-in dir. r3: and every file an @include /
        # @includedir (or the older #include / #includedir) pulls in, followed to any depth.
        todo, seen = [P("/etc/sudoers")], set()
        mine = P("/etc/sudoers.d/dtapi")
        while todo:
            fp = todo.pop(0)
            if fp in seen:
                continue
            seen.add(fp)
            if os.path.isdir(fp):
                try:
                    todo += [os.path.join(fp, fn) for fn in sorted(os.listdir(fp))
                             if "." not in fn and not fn.endswith("~")]      # sudo's own skip rule
                except OSError as e:
                    out("STATE", "cannot list %s: %s" % (fp, e), "SUDO", fp)
                continue
            try:
                txt = open(fp, encoding="utf-8", errors="replace").read()
            except OSError as e:
                out("STATE", "cannot read %s: %s" % (fp, e), "SUDO", fp)
                continue
            for ln in txt.splitlines():
                w = ln.split()
                if len(w) >= 2 and w[0] in ("@include", "#include", "@includedir", "#includedir"):
                    todo.append(P(w[1]) if w[1].startswith("/") else os.path.join(os.path.dirname(fp), w[1]))
                elif w and w[0] == "ALL" and "=" in ln:
                    out("STATE", "%s has a rule for ALL users (%s) — it would apply to dtapi and dtmint"
                        % (fp, ln.strip()[:80]), "SUDO", fp)
            if fp != mine and ("dtapi" in txt or "dtmint" in txt):
                out("STATE", "%s also mentions dtapi or dtmint — only /etc/sudoers.d/dtapi may" % fp, "SUDO", fp)
    elif name == "no_authorized_keys2":
        p = P("/home/dtmint/.ssh/authorized_keys2")
        if os.path.lexists(p):
            out("STATE", "%s exists — sshd reads it too, and it carries no forced command" % p, "KEYS", p)
    elif name == "mint_key_pairing":
        if not box.get("_sha"):
            out("STATE", "the mint key's pairing is NOT checked: no installed sha to read it at", "KEYS", "mint-key")
            return
        try:
            pub = subprocess.run(["/usr/bin/ssh-keygen", "-y", "-f", P("/root/.ssh/dtmint_ed25519")],
                                 capture_output=True, text=True, timeout=30)
        except (subprocess.TimeoutExpired, OSError) as e:
            out("STATE", "cannot read the mint key: %s" % type(e).__name__, "KEYS", "mint-key")
            return
        data, err = git(box, "cat-file", "blob", "%s:comms-infra/staging/dtmint-authorized_keys" % box["_sha"], binary=True)
        if pub.returncode != 0 or data is None:
            out("STATE", "cannot compare the mint key with the committed authorized_keys: %s"
                % (pub.stderr.strip() or err), "KEYS", "mint-key")
            return
        key = " ".join(pub.stdout.split()[:2])
        if key not in data.decode("utf-8", "replace"):
            out("STATE", "the mint key's public half is NOT the one in the committed "
                         "comms-infra/staging/dtmint-authorized_keys — the mint will be refused", "KEYS", "mint-key")
        else:
            out("OK", "the mint key pairs with the committed authorized_keys")
    elif name == "staging_host_key":
        try:
            r = subprocess.run(["/usr/bin/ssh-keygen", "-F", "188.245.193.8", "-f", P("/root/.ssh/known_hosts")],
                               capture_output=True, text=True, timeout=30)
            if r.returncode != 0 or "188.245.193.8" not in r.stdout:
                out("STATE", "root's known_hosts has no entry for staging — the mint (StrictHostKeyChecking=yes) "
                             "will fail", "KEYS", "known_hosts")
        except (subprocess.TimeoutExpired, OSError) as e:
            out("STATE", "cannot check root's known_hosts: %s" % type(e).__name__, "KEYS", "known_hosts")


def compare_files(box, shas):
    """shas: repo path -> the sha that file was installed from (the default, or its override)."""
    for repo_path, inst, mode, user, group in box["files"]:
        path = P(inst)
        sha = shas[repo_path]
        bid, err = git(box, "rev-parse", "--verify", "%s:%s" % (sha, repo_path))
        if bid is None:
            out("SOURCE", "%s is not readable at %s: %s" % (repo_path, sha[:12], err), None, repo_path)
            continue
        try:
            st, data = read_installed(path)
        except FileNotFoundError:
            out("MISSING", path, None, path)
            continue
        except OSError as e:
            out("MISSING", "%s cannot be read as a regular file: %s" % (path, e), None, path)
            continue
        if blob_hash(data) != bid:
            out("DRIFT", "%s differs from %s at %s" % (path, repo_path, sha[:12]), None, path)
        else:
            out("OK", "%s = %s at %s" % (path, repo_path, sha[:12]))
        ok, why = owner_ok(st, mode, user, group)
        if not ok:
            out("PERM", "%s %s" % (path, why), None, path)


def pending(box, shas, head):
    """Files whose committed copy moved on the branch after their install. r3 S8: a git ERROR is
    SOURCE (mirror health), never "waited over 7 days" — and both reads failing is no longer a
    silent skip (None == None used to read as "unchanged")."""
    for repo_path in sorted({f[0] for f in box["files"]}):
        sha = shas[repo_path]
        if sha == head:
            continue
        a, aerr = git(box, "rev-parse", "--verify", "%s:%s" % (sha, repo_path))
        b, berr = git(box, "rev-parse", "--verify", "%s:%s" % (head, repo_path))
        if a is None or b is None:
            out("SOURCE", "cannot compare %s between the install and the branch head: %s"
                % (repo_path, aerr or berr), None, repo_path)
            continue
        if a == b:
            continue
        cts, err = git(box, "log", "--reverse", "--format=%ct", sha + ".." + head, "--", repo_path)
        ct = (cts or "").split()[:1]
        if cts is None or not ct or not ct[0].isdigit():
            out("SOURCE", "cannot date the change to %s after the install: %s"
                % (repo_path, err or "no commit in the range touches it"), None, repo_path)
            continue
        age = (time.time() - int(ct[0])) / 86400
        grace = box.get("pending_days", {}).get(repo_path, PENDING_DAYS)
        out("PENDING", "%s changed on the branch after the install at %s (%.1f days ago)" % (repo_path, sha[:12], age))
        if age > grace:
            out("STATE", "a reviewed change to %s has waited over %d day%s to be installed"
                % (repo_path, grace, "" if grace == 1 else "s"), "PENDING-STALE", repo_path)


def read_installed_shas(box):
    """(default sha or None, {repo path: sha}) from INSTALLED_SHA — see the header for the format."""
    try:
        text = read_small(P(INSTALLED_SHA))[1].decode("utf-8", "replace")
    except OSError:
        out("STATE", "no installed sha at %s — the install did not record what it installed" % INSTALLED_SHA,
            "INSTALL", "installed-sha")
        return None, {}
    known = {f[0] for f in box["files"]}
    default, over, bad = None, {}, []
    for ln in text.splitlines():
        w = ln.split()
        if not w:
            continue
        ok = len(w[0]) == 40 and all(c in "0123456789abcdef" for c in w[0])
        if not ok or len(w) > 2 or (len(w) == 2 and w[1] not in known):
            bad.append(ln.strip()[:80])
        elif len(w) == 1:
            if default is not None:
                bad.append(ln.strip()[:80] + " (a second default)")
            default = w[0]
        else:
            over[w[1]] = w[0]
    if bad or default is None:
        out("STATE", "the installed sha file is not <sha> [+ <sha> <repo path> lines for this box's files]: %s"
            % ("; ".join(bad) or "no default sha line"), "INSTALL", "installed-sha")
        return None, {}
    return default, over


def run():
    if os.geteuid() != 0:
        print("REFUSED: run as root (it must read root-only files and must not run git itself).")
        return 2
    host = HOSTNAME or socket.gethostname()
    box = BOXES.get(host)
    if not box:
        print("REFUSED: this host (%s) has no manifest — nothing is checked, which is a FAIL." % host)
        return 1
    head, err = git(box, "rev-parse", "--verify", box["ref"] + "^{commit}")
    if head is None:
        out("SOURCE", "cannot read %s in %s as %s: %s" % (box["ref"], box["git_dir"], box["git_as"], err), None, "head")
    t = source_fresh(box)
    age = None if t is None else time.time() - t
    if age is None:
        out("SOURCE", "no freshness stamp has content (%s) — a failed fetch leaves an empty one"
            % ", ".join(box["stamps"]), None, "stamp")
    elif age > box["max_age_s"]:
        out("SOURCE", "the committed source was last refreshed %d min ago (limit %d) — PENDING below "
                      "may be incomplete; the installed comparison is unaffected" % (age // 60, box["max_age_s"] // 60),
            None, "stamp")
    sha, overrides = read_installed_shas(box)
    if sha and head:
        for x in sorted({sha} | set(overrides.values())):
            have, _ = git(box, "cat-file", "-e", x + "^{commit}")
            if have is None:
                # C8: the source has not fetched the installed commit yet — mirror health, not drift
                out("SOURCE", "the installed sha %s is not in the source yet (it fetches every 30 min) — "
                              "the installed files are NOT compared this run" % x[:12], None, "installed-sha")
                sha = None
                break
            anc, aerr = git(box, "merge-base", "--is-ancestor", x, head)
            if anc is None:
                out("STATE", "the installed sha %s is in the source but NOT on %s — installed from an "
                    "unreviewed commit? (%s)" % (x[:12], box["ref"], aerr), "INSTALL", x[:12])
    box["_sha"] = sha
    print("# %s — installed files vs %s%s (branch head %s, source refreshed %s)" % (
        host, sha[:12] if sha else "NO INSTALLED SHA", " + %d per-file" % len(overrides) if overrides else "",
        head[:12] if head else "UNREADABLE", "?" if age is None else "%d min ago" % (age // 60)), flush=True)
    if sha:
        shas = {f[0]: overrides.get(f[0], sha) for f in box["files"]}
        compare_files(box, shas)
        if head:
            pending(box, shas, head)
    for d, mode, user, group in box["dirs"]:
        try:
            st = os.lstat(P(d))
            ok, why = owner_ok(st, mode, user, group) if stat.S_ISDIR(st.st_mode) else (False, "not a directory")
            if not ok:
                out("PERM", "%s %s" % (P(d), why), None, d)
        except FileNotFoundError:
            out("MISSING", P(d), None, d)
    for f, mode, user, group in box["private"]:
        try:
            st = os.lstat(P(f))
            ok, why = owner_ok(st, mode, user, group) if stat.S_ISREG(st.st_mode) else (False, "not a regular file")
            if not ok:
                out("PERM", "%s %s" % (P(f), why), None, f)
        except FileNotFoundError:
            out("MISSING", P(f), None, f)
    check_units(box)
    for c in box["checks"]:
        try:
            check_extra(c, box)
        except Exception as e:                  # a check that crashes is a FAIL with a line, never a traceback
            out("STATE", "the %s check could not run: %s" % (c, type(e).__name__), "CHECK", c)
    verdict = "PASS" if not PROBLEMS else "FAIL (%d problem%s)" % (len(PROBLEMS), "" if len(PROBLEMS) == 1 else "s")
    print("dt-install-drift %s: %s" % (host, verdict), flush=True)
    return 0 if not PROBLEMS else 1


def write_classes(text):
    try:
        tmp = P(CLASSES_OUT) + ".tmp"
        with open(tmp, "w") as fh:
            fh.write(text + "\n")
        os.chmod(tmp, 0o644)
        os.replace(tmp, P(CLASSES_OUT))
    except OSError:
        pass


def main():
    # r2: a run killed mid-way must not leave the LAST run's classes (the unit's ExecStartPre removes
    # the file too, for a run that cannot even start — r3 S5)
    write_classes("CRASH -")
    try:
        code = run()
    except Exception as e:
        print("STATE    dt-install-drift itself failed: %s" % type(e).__name__, flush=True)
        CLASSES.add(("CRASH", "-"))
        code = 1
    # one "<class> <subject>" line per failure: the alert script raises one alert for each (r3 S2)
    write_classes("\n".join("%s %s" % (c, "".join(ch for ch in subj if ch.isalnum() or ch in "/._@:-")[:120] or "-")
                            for c, subj in sorted(CLASSES)))
    return code


if __name__ == "__main__":
    sys.exit(main())
