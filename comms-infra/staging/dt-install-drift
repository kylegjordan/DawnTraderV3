# ── END CONSTANTS ──

GIT_ENV = ["/usr/bin/env", "-i", "PATH=/usr/bin:/bin", "HOME=/nonexistent", "GIT_CONFIG_NOSYSTEM=1"]

BOXES = {
    "dawntrader-staging": {
