        "git_dir": "/opt/governance-checker/DawnTraderV3/.git",
        "ref": "refs/remotes/origin/migration/aws-supabase",
        "stamps": ["/opt/governance-checker/DawnTraderV3/.git/FETCH_HEAD"],
        "max_age_s": 3 * 3600,
        "files": [
            ("comms-infra/staging/dt-api", "/usr/local/bin/dt-api", 0o755, "root", "root"),
            ("comms-infra/staging/dt-api-set-crew-password", "/usr/local/sbin/dt-api-set-crew-password", 0o700, "root", "root"),
            ("comms-infra/staging/sudoers-dtapi", "/etc/sudoers.d/dtapi", 0o440, "root", "root"),
            ("comms-infra/staging/dtmint-authorized_keys", "/home/dtmint/.ssh/authorized_keys", 0o640, "root", "dtmint"),
            ("comms-infra/staging/dt-install-drift", "/usr/local/sbin/dt-install-drift", 0o700, "root", "root"),
            ("comms-infra/staging/dt-unit-failure-alert", "/usr/local/bin/dt-unit-failure-alert", 0o755, "root", "root"),
            ("comms-infra/staging/systemd/dt-install-drift.service", "/etc/systemd/system/dt-install-drift.service", 0o644, "root", "root"),
            ("comms-infra/staging/systemd/dt-install-drift.timer", "/etc/systemd/system/dt-install-drift.timer", 0o644, "root", "root"),
            ("comms-infra/staging/systemd/dt-unit-failure@.service", "/etc/systemd/system/dt-unit-failure@.service", 0o644, "root", "root"),
            ("comms-infra/staging/systemd/dt-install-drift.service.d/onfailure.conf",
             "/etc/systemd/system/dt-install-drift.service.d/onfailure.conf", 0o644, "root", "root"),
        ],
        "dirs": [
            ("/etc/dt-api", 0o750, "root", "dtapi"),
            ("/var/lib/dt-api", 0o700, "dtapi", "dtapi"),
            ("/home/dtmint/.ssh", 0o750, "root", "dtmint"),
        ],
