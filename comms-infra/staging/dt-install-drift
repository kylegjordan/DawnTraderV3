            ("comms-infra/systemd/agent-staging-session.timer", "/etc/systemd/system/agent-staging-session.timer", 0o644, "root", "root"),
            ("comms-infra/systemd/onfailure.conf", "/etc/systemd/system/agent-staging-session.service.d/onfailure.conf", 0o644, "root", "root"),
            ("comms-infra/staging/dt-install-drift", "/usr/local/sbin/dt-install-drift", 0o700, "root", "root"),
            ("comms-infra/staging/systemd/dt-install-drift.service", "/etc/systemd/system/dt-install-drift.service", 0o644, "root", "root"),
            ("comms-infra/staging/systemd/dt-install-drift.timer", "/etc/systemd/system/dt-install-drift.timer", 0o644, "root", "root"),
            ("comms-infra/systemd/onfailure.conf", "/etc/systemd/system/dt-install-drift.service.d/onfailure.conf", 0o644, "root", "root"),
        ],
