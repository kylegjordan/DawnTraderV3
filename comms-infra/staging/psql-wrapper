#!/bin/sh
# /usr/local/bin/psql — B-DB-READ-TOOL (KD-96, #1259), pre-audit A10 / plan P2.
# It shadows /usr/bin/psql in root's and deploy's PATH (/usr/local/bin comes first) and changes exactly two things:
#   1. libpq's default sslmode is `prefer`, which retries a failed login WITHOUT SSL: every wrong password is sent
#      TWICE per call (measured against a local listener: prefer 2, require 1). Supabase bans an address after two
#      wrong passwords in a row. Here PGSSLMODE defaults to `require` and PGCONNECT_TIMEOUT to 15 — ONLY when the
#      caller has not set them; an `sslmode=` in the connection string still wins (0 of the ~50 helpers set one).
#   2. While dt-sql is LOCKED, or holds an INTENT (an attempt that ended without a result — the window in which this
#      address may already carry one wrong password), psql refuses too, so no helper or hand-run psql sends the next
#      wrong password. Since B-DB-READONLY-ROLE /var/lib/dt-sql is 0755 deploy (dtsql's helper must see INTENT and
#      LOCKED), so every account on the box can see these two files and this check binds them all, not only root and
#      deploy. Override for a deliberate, single check: DT_SQL_IGNORE_LOCK=1.
# It reaches psql (libpq) ONLY. A PGSSLMODE in the environment would reach the app too: node `pg` maps it to verified
# TLS, and the app connects without TLS today (pre-audit A10) — which is why this is a wrapper and not an env default.
if { [ -e /var/lib/dt-sql/LOCKED ] || [ -e /var/lib/dt-sql/INTENT ]; } && [ "${DT_SQL_IGNORE_LOCK:-}" != "1" ]; then
    echo "psql: REFUSED — dt-sql is LOCKED or holds an unfinished attempt (a staging database login was refused or unfinished)." >&2
    echo "      A second wrong password bans this address. See: dt-sql --status" >&2
    exit 4
fi
: "${PGSSLMODE:=require}" "${PGCONNECT_TIMEOUT:=15}"
export PGSSLMODE PGCONNECT_TIMEOUT
exec /usr/bin/psql "$@"
