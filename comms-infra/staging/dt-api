WRITE_ALLOW = ()

# CASE-INSENSITIVE, like Express's own mount and route matching: "/API/trading/set-mode" reaches
# set-mode, so it must pass the grammar and be DENIED by rule 2 — not dismissed as malformed.
PATH_RE = re.compile(r"^/api/[A-Za-z0-9/_.:-]+$", re.IGNORECASE)
QUERY_RE = re.compile(r"^[A-Za-z0-9_.=&,:/-]*$")   # r3: "/" so ?symbol=BTC/USD is expressible; a query never routes


class Refused(Exception):
    pass


# ───────────────────────────── the grammar and the rules ─────────────────────────────

def _bad_chars(s):
    for ch in s:
        o = ord(ch)
        if o < 0x21 or o == 0x7F or o > 0x7E:      # space, controls, DEL, non-ASCII
            return True
    return False


def canon(path):
    """For MATCHING only: lowercase (Express matches case-insensitively) and strip ONE trailing
    '/' (Express is not strict). The ORIGINAL text is what gets sent (D-4, D-5)."""
    p = path.lower()
    if len(p) > 1 and p.endswith("/"):
        p = p[:-1]
    return p


def _seg_match(pattern, path):
    ps, qs = pattern.split("/"), path.split("/")
    if len(ps) != len(qs):
        return False
    return all(a == b or (a.startswith(":") and b != "") for a, b in zip(ps, qs))


def parse(argv):
    """argv (without the program name) -> dict(kind, method, mode, path, query, target).
    Raises Refused(text) — every refusal is exactly one of the TXT_* texts."""
    if not argv:
        raise Refused(TXT_MALFORMED % "no arguments (usage: dt-api GET <path>)")
    if argv == ["mint"]:
        return {"kind": "mint"}
    a = list(argv)
    write = False
    if a[0] == "--write":
        write = True
        a.pop(0)
        if not a or a[0] not in METHODS_WRITE:
            raise Refused(TXT_MALFORMED % "--write must be followed by POST, PUT, PATCH or DELETE")
    if not a:
        raise Refused(TXT_MALFORMED % "no method")
    method = a.pop(0)
    if method != "GET" and method not in METHODS_WRITE:
        raise Refused(TXT_MALFORMED % ("unknown method (GET, POST, PUT, PATCH, DELETE only)"))
    if write and method == "GET":
        raise Refused(TXT_MALFORMED % "--write must be followed by POST, PUT, PATCH or DELETE")
    mode = None
    if a and a[0] == "--mode":
        if len(a) < 2 or a[1] not in ("paper", "live"):
            raise Refused(TXT_MALFORMED % "--mode takes paper or live")
        mode = a[1]
        a = a[2:]
    if not a:
        raise Refused(TXT_MALFORMED % "no path")
    target = a.pop(0)
    if a:
        raise Refused(TXT_MALFORMED % "an argument after the path")
    # ── rule 1: the grammar, on the raw text, before anything else ──
    for bad, why in (("#", "'#'"), ("%", "'%'"), ("..", "'..'"), ("/./", "'/./'"),
                     ("//", "'//'"), ("\\", "a backslash")):
        if bad in target:
            raise Refused(TXT_MALFORMED % ("contains %s" % why))
    if _bad_chars(target):
        raise Refused(TXT_MALFORMED % "contains a space, a control character or non-ASCII")
    path, sep, query = target.partition("?")
    if not PATH_RE.match(path):
        raise Refused(TXT_MALFORMED % "the path must match ^/api/[A-Za-z0-9/_.:-]+$")
    segs = path.split("/")[1:]
    if segs and segs[-1] == "":
        segs = segs[:-1]                                   # one trailing '/' is allowed
    if any(s in ("", ".", "..") for s in segs):
        raise Refused(TXT_MALFORMED % "an empty, '.' or '..' path segment")   # C10: a trailing '/.'
    if sep:
        if method != "GET":
            raise Refused(TXT_MALFORMED % "a query is allowed on GET only")
        if not QUERY_RE.match(query):
            raise Refused(TXT_MALFORMED % "the query must match ^[A-Za-z0-9_.=&,:/-]*$")
    c = canon(path)
    # ── rule 2: the whole-route denials, for EVERY method ──
    if c in WHOLE_ROUTE_DENY:
        raise Refused(TXT_WHOLE_ROUTE)
    if method == "GET":
        # ── rule 3: the read denylist ──
        for pre in READ_DENY_PREFIXES:
            if c == pre or c.startswith(pre + "/"):
                raise Refused(TXT_READ_ACCOUNT)
        for pat in READ_DENY_JOBS:
            if _seg_match(pat, c):
                raise Refused(TXT_READ_JOB % path)
    else:
        # ── rule 4 / rule 5 ──
        if not write:
            raise Refused(TXT_NEEDS_WRITE)
        if not any(m == method and _seg_match(p, c) for m, p in WRITE_ALLOW):
            raise Refused(TXT_NOT_ALLOWLISTED % (method, path))
    return {"kind": "call", "method": method, "mode": mode, "path": path,
            "query": query if sep else None, "target": target}


# ───────────────────────────── state files ─────────────────────────────

def _now():
    return time.time()


def _iso(t):
    return time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime(t))


def _read_json(path):
    try:
        with open(path, encoding="utf-8") as fh:
            return json.load(fh)
    except FileNotFoundError:
        return None
    except (ValueError, OSError):
        return None


def _write_json(path, obj):
    tmp = "%s.tmp.%d" % (path, os.getpid())
    try:
        fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC | os.O_NOFOLLOW, 0o600)
        with os.fdopen(fd, "w", encoding="utf-8") as fh:
            json.dump(obj, fh)
            fh.flush()
            os.fsync(fh.fileno())
        os.replace(tmp, path)
    except BaseException:
        try:
            os.unlink(tmp)                 # never leave a half-written copy (it may hold a token)
        except OSError:
            pass
        raise


def _append(path, line):
    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_APPEND | os.O_NOFOLLOW, 0o600)   # root appends here too
    with os.fdopen(fd, "a", encoding="utf-8") as fh:
        fh.write(line + "\n")


def ledger_entries():
    out = []
    try:
        with open(LEDGER, encoding="utf-8") as fh:
            for ln in fh:
                try:
                    out.append(json.loads(ln))
                except ValueError:
                    continue
    except FileNotFoundError:
        pass
    except OSError as e:
        die(3, "REFUSED: cannot read the login ledger %s (%s) — it must be dtapi-owned 0600. Nothing "
               "was sent." % (LEDGER, e.strerror))
    return out


def ledger_sent_since(since, whos=None):
    return [e for e in ledger_entries()
            if e.get("phase") == "sent" and e.get("ts", 0) >= since
            and (whos is None or e.get("who") in whos)]


def call_log(fields):
    try:
        if os.path.exists(CALL_LOG) and os.path.getsize(CALL_LOG) > 1_000_000:
            with open(CALL_LOG, encoding="utf-8") as fh:
                keep = fh.readlines()[-2000:]
            tmp = "%s.tmp.%d" % (CALL_LOG, os.getpid())
            with open(tmp, "w", encoding="utf-8") as fh:
                fh.writelines(keep)
            os.replace(tmp, CALL_LOG)
        _append(CALL_LOG, json.dumps(fields, sort_keys=True))
    except OSError:
        pass                                          # a log failure never blocks a call


class Lock:
    """dt-api's flock. The setter takes the SAME lock from before its step (0) through (5), so
    dt-api cannot read the cache or log in mid-change. A wait longer than LOCK_TIMEOUT_S
    REFUSES with its own text rather than re-minting (C7)."""

    def __init__(self):
        self.fd = None

    def __enter__(self):
        self.fd = os.open(LOCK_FILE, os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW, 0o600)
        deadline = _now() + LOCK_TIMEOUT_S
        while True:
            try:
                fcntl.flock(self.fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
                return self
            except OSError as e:
                if e.errno not in (errno.EAGAIN, errno.EACCES):
                    raise
            if _now() >= deadline:
                os.close(self.fd)
                self.fd = None
                die(3, "REFUSED: dt-api waited %d s for its credential lock — a password change or "
                       "a slow login/mint is in progress. Nothing was sent; try again in a minute." % LOCK_TIMEOUT_S)
            time.sleep(0.2)

    def __exit__(self, *exc):
        if self.fd is not None:
            fcntl.flock(self.fd, fcntl.LOCK_UN)
            os.close(self.fd)
            self.fd = None


# ───────────────────────────── output ─────────────────────────────

def die(code, text):
    sys.stderr.write(text.rstrip("\n") + "\n")
    sys.stderr.flush()
    raise SystemExit(code)


# STICKY = a login cannot fix it, so dt-api stops logging in until a person acts. Gate 1-1
# (Langston, 2026-10-01): crew-role-missing joins (a row with no role, routes.ts:226 — config, not a
# blip); login-failing LEAVES — it is an availability fault a login fixes once the app is back, and
# the 5xx backoff (BACKOFF_500_S) already paces logins during an outage, so stickiness bought no
# bucket protection and would block the mint after recovery until a person cleared it.
STICKY_KINDS = ("crew-password-wrong", "crew-user-missing", "crew-role-missing", "login-malformed",
                "login-unexpected")


def page_sticky(pg):
    """r3: stickiness is read from the FLAG *and* from the KIND — a page written by hand has no
    flag. A page file that exists but cannot be read is treated as sticky (fail closed)."""
    if not isinstance(pg, dict):
        return True
    return bool(pg.get("sticky")) or pg.get("kind") in STICKY_KINDS


def page_standing():
    """The standing page record, or None. A page file that cannot be read comes back as a
    sticky placeholder, never as None."""
    if not os.path.lexists(PAGE_FILE):
        return None
    pg = _read_json(PAGE_FILE)
    return pg if isinstance(pg, dict) else {"kind": "unreadable-page", "sticky": True, "_unreadable": True}


def page_write(standing, merged, kind, detail, sticky):
    """Writes a page. Gate 1-1 FINDING-2 (Langston, 2026-10-01): a page.json that cannot be read is
    NEVER written over — it holds the cause a person is being paged to read, and merging into the
    placeholder replaced it. The new cause goes to a side file beside it and stderr names it; the
    unreadable file still makes the page sticky (fail closed). dt-api and the setter both use this.
    Returns the path written."""
    if isinstance(standing, dict) and standing.get("_unreadable"):
        side = "%s.unreadable.%d" % (PAGE_FILE, os.getpid())
        _write_json(side, page_merge(None, kind, detail, sticky))
        sys.stderr.write("dt-api: NOTE — %s could not be read and was NOT written over; this page's "
                         "cause is in %s\n" % (PAGE_FILE, side))
        return side
    _write_json(PAGE_FILE, merged)
    return PAGE_FILE


def page_merge(old, kind, detail, sticky):
    """The ONE rule for adding a cause to a page — dt-api's pages and the setter's durable pages
    both go through it (r3: the setter used to overwrite the first cause)."""
    now = _iso(_now())
    if old is None:
        return {"ts": now, "kind": kind, "detail": detail, "sticky": sticky}
    # `_unreadable` marks page_standing()'s placeholder for page_write() ONLY — it must never be
    # written into a page file, or a readable page.json would read as unreadable from then on
    # (the setter writes this function's output directly).
    old = {k: v for k, v in old.items() if k != "_unreadable"}
    later = old.get("later")
    later = list(later)[-20:] if isinstance(later, list) else []
    if sticky and not page_sticky(old):
        # r3: a STICKY cause OUTRANKS a standing non-sticky one. The kind is what the drift class
        # and the refusal text read, so the worse cause becomes the kind and the old cause moves
        # to `later` — otherwise a wrong password hides behind a token-refused.
        later.append("%s %s" % (old.get("ts", "?"), old.get("kind", "?")))
        return {"ts": now, "kind": kind, "detail": detail, "sticky": True, "later": later}
    # r2: otherwise the FIRST cause stays the kind; later ones are appended, and stickiness only
    # ever grows
    later.append("%s %s" % (now, kind))
    return dict(old, later=later, sticky=page_sticky(old) or sticky)


def page(kind, detail, drop_token=None):
    """C6 / GB-7 — WHO THE PAGE REACHES: (1) the caller, now, on stderr, naming Infra Claude;
    (2) every session and Langston through a system alert, raised by the staging DAILY
    `dt-install-drift` run (05:15Z) while page.json exists (one alert per page class);
    (3) for the scheduled mint, Helsinki's agent-unit-failure@ on the next 04:40Z run.
    ⛔ No re-mint happens on a page: a login would spend the shared loopback bucket on a
    problem a login cannot fix.
    ★ STICKY for the faults a login cannot fix (fresh-reader r1): a wrong password, a missing
    row, a row with no role, a malformed login answer — while such a page stands dt-api
    makes NO login (a timer re-trying a known-bad password spent the bucket and kept the setter's
    quiet-900-s precondition from ever holding). A token-refused page (a DB or lookup failure,
    which may heal) and a login-failing page (the app's login down, which heals) are recorded and
    alerted but NOT sticky (r2; Gate 1-1). The kinds are STICKY_KINDS. Calls on a good cached token go on.
    The page is cleared by a person (after the cause is fixed) or by the setter when it succeeds.
    drop_token: the DEAD token's text — the cache is removed only if it still holds that token
    (r3: never a token another caller minted meanwhile). Callers hold the Lock."""
    if drop_token:
        cur = _read_json(TOKEN_FILE)
        if isinstance(cur, dict) and cur.get("accessToken") == drop_token:
            try:
                os.unlink(TOKEN_FILE)      # a token the app will never accept again is not a cache
            except FileNotFoundError:
                pass
    sticky = kind in STICKY_KINDS
    try:
        standing = page_standing()
        page_write(standing, page_merge(standing, kind, detail, sticky), kind, detail, sticky)
    except OSError:
        pass
    die(5, "PAGE (dt-api, %s): %s\nInfra Claude owns this. Nothing was re-minted.%s The daily "
           "dt-install-drift run raises it as a system alert; remove %s as root once the cause is "
           "fixed (the setter removes it when it succeeds)." % (
               kind, detail, " dt-api makes NO login while this page stands." if sticky else "", PAGE_FILE))


# ───────────────────────────── HTTP ─────────────────────────────

def app_request(method, path, token=None, body=None, mode=None, timeout=None):
    """One request to the app on loopback. Returns (status, headers{lower: value}, body bytes),
    or (None, {}, error text) when the app did not answer. ⛔ NO X-Forwarded-For is ever sent:
    the limiter must key this on 127.0.0.1 (C3)."""
    hdrs = {"Accept": "application/json", "Connection": "close"}
    if token:
        hdrs["Authorization"] = "Bearer " + token     # in memory only — never argv, never a file we print
    if mode:
        hdrs["x-app-mode"] = mode
    data = None
    if body is not None:
        data = body if isinstance(body, bytes) else json.dumps(body).encode("utf-8")
        hdrs["Content-Type"] = "application/json"
    conn = http.client.HTTPConnection(APP_HOST, APP_PORT, timeout=timeout or HTTP_TIMEOUT_S)
    try:
        conn.request(method, path, body=data, headers=hdrs)
        r = conn.getresponse()
        return r.status, {k.lower(): v for k, v in r.getheaders()}, r.read()
    except (OSError, http.client.HTTPException) as e:
        return None, {}, ("%s: %s" % (type(e).__name__, e)).encode()
    except ValueError:
        # http.client puts the offending header VALUE in its message — i.e. the token. Never show it.
        return None, {}, b"ValueError: a request header or the path was invalid (value not shown)"
    finally:
        conn.close()


def _json(b):
    try:
        return json.loads(b.decode("utf-8"))
    except (ValueError, UnicodeDecodeError, AttributeError):
        return None


def _obj(b):
    """The body as a JSON OBJECT, or {} — r3: a list or a scalar must not raise on .get()."""
    j = _json(b)
    return j if isinstance(j, dict) else {}


def jwt_claims(tok):
    """Unverified read of exp/iat — for scheduling only; the server is the verifier."""
    try:
        mid = tok.split(".")[1]
        mid += "=" * (-len(mid) % 4)
        return json.loads(base64.urlsafe_b64decode(mid.encode()).decode("utf-8"))
    except Exception:
        return {}


# ───────────────────────────── the login ─────────────────────────────

def read_env():
    out = {}
    try:
        with open(ENV_FILE, encoding="utf-8") as fh:
            for ln in fh:
                ln = ln.strip()
                if ln and not ln.startswith("#") and "=" in ln:
                    k, v = ln.split("=", 1)
                    out[k.strip()] = v.strip()
    except FileNotFoundError:
        die(3, "REFUSED: %s does not exist — the crew password has not been set on this box "
               "(the setter writes it). Nothing was sent." % ENV_FILE)
    except PermissionError:
        die(3, "REFUSED: cannot read %s — run dt-api as dtapi (sudo -u dtapi). Nothing was sent."
            % ENV_FILE)
    if not out.get("DT_API_USER") or not out.get("DT_API_PASS"):
        die(3, "REFUSED: %s lacks DT_API_USER or DT_API_PASS. Nothing was sent." % ENV_FILE)
    return out


def login(who):
    """A fresh login on the loopback bucket. Caller holds the Lock. Returns the token record."""
    t = _now()
    pg = page_standing()
    if pg is not None and page_sticky(pg):
        die(5, "PAGE STANDING (dt-api, %s since %s): dt-api makes no login until it is handled. "
               "Infra Claude owns it; root removes %s once the cause is fixed. Nothing was sent."
               % (pg.get("kind", "?"), pg.get("ts", "?"), PAGE_FILE))
    neg = _read_json(NEG_FILE)
    if neg and neg.get("until", 0) > t:
        die(3, "REFUSED: dt-api will not log in again until %s — the last login got %s (%s). "
               "Nothing was sent." % (_iso(neg["until"]), neg.get("status"), neg.get("reason")))
    recent = ledger_sent_since(t - WINDOW_S, whos=("dt-api", "mint"))
    if len(recent) >= DTAPI_CAP:
        die(3, "REFUSED: dt-api has already logged in %d times in the last %d s (cap %d, whatever "
               "the reason) — the loopback login bucket is shared and small. Nothing was sent; "
               "retry after %s." % (len(recent), WINDOW_S, DTAPI_CAP,
                                    _iso(min(e["ts"] for e in recent) + WINDOW_S)))
    env = read_env()
    results = [e for e in ledger_entries() if e.get("phase") == "result"]
    last = results[-1] if results else None
    # C4 (r2): the headers are authoritative — ANY loopback login (the setter's too) that left the
    # bucket empty blocks a login until its reset, without spending an attempt to learn that again
    if last and str(last.get("remaining")) == "0" and str(last.get("reset", "")).isdigit() \
            and last.get("ts", 0) + int(last["reset"]) > t:
        die(3, "REFUSED: the last loopback login (%s) left the bucket empty until %s. Nothing was sent."
            % (last.get("who"), _iso(last["ts"] + int(last["reset"]))))
    _append(LEDGER, json.dumps({"ts": t, "who": who, "phase": "sent", "bucket": "loopback"}))
    st, h, b = app_request("POST", "/api/auth/login",
                           body={"username": env["DT_API_USER"], "password": env["DT_API_PASS"]},
                           timeout=LOGIN_TIMEOUT_S)
    rem, rst = h.get("ratelimit-remaining"), h.get("ratelimit-reset")
    _append(LEDGER, json.dumps({"ts": _now(), "who": who, "phase": "result", "status": st,
                                "remaining": rem, "reset": rst, "bucket": "loopback"}))
    if st == 200:
        j = _obj(b)
        tok = j.get("accessToken")
        if not isinstance(tok, str):
            tok = None
        cl = jwt_claims(tok) if tok else {}
        if not tok or not isinstance(cl.get("exp"), (int, float)):
            page("login-malformed", "the login answered 200 without %s — every call would log in "
                 "again" % ("an accessToken" if not tok else "a readable token expiry"))
        rec = {"accessToken": tok, "refreshToken": j.get("refreshToken", ""),
               "issued_at": t, "exp": cl.get("exp"), "who": who,
               "role": j["user"].get("role") if isinstance(j.get("user"), dict) else None}
        _write_json(TOKEN_FILE, rec)
        try:
            os.unlink(NEG_FILE)
        except FileNotFoundError:
            pass
        if rem == "0":
            # C4: the headers are authoritative — the next login would meet a 429, so do not send it
            wait = int(rst) if rst and rst.isdigit() else WINDOW_S
            _neg(t + wait, 200, "RateLimit-Remaining 0: the loopback bucket is empty")
            sys.stderr.write("dt-api: note — the loopback login bucket is now empty for %d s "
                             "(RateLimit-Remaining 0); no login until then\n" % wait)
        return rec
    if st in (401, 404, 429):
        until = t + NEG_S
        if st == 429 and rst and rst.isdigit():
            until = t + int(rst)
        reason = {401: "wrong password for the crew user", 404: "the crew user does not exist",
                  429: "the loopback login bucket is exhausted"}[st]
        _neg(until, st, reason)
        # A 401 or 404 will not fix itself: someone changed the crew password or removed the row,
        # and only a person re-running the setter (or restoring the row) fixes it. A 429 does.
        if st == 404:
            page("crew-user-missing", "login answered 404 — the crew user %s does not exist"
                 % env["DT_API_USER"])
        if st == 401:
            page("crew-password-wrong", "login answered 401 — the stored crew password no longer "
                 "matches; re-run the setter (dt-api-set-crew-password)")
        die(3, "FAILED: login answered %d (%s). dt-api will not try again until %s. Nothing was "
               "sent." % (st, reason, _iso(until)))
    if st is not None and st < 500:
        # r3: every OTHER answer (400, 403, a 3xx, another 4xx) is neither a password, a user, a
        # rate nor an availability answer — the login request or the app's login route has
        # changed, and no retry fixes that. It used to fall into the 5xx branch and be retried.
        page("login-unexpected", "login answered %d — not a password (401), user (404), rate (429) "
             "or availability (5xx) answer; the login request or the app's login route has changed" % st)
    _neg(t + BACKOFF_500_S, st, "the app did not answer the login cleanly")
    # "The login is failing" = THIS failure plus the run of failed loopback logins (anyone's)
    # directly before it — no answer or a 5xx; any other result ends the run, and a 200 always
    # does — spanning at least LOGIN_FAILING_GAP_S. The floor stops one app restart (two failures
    # a minute apart) from paging (r2). ⛔ NO CEILING (Langston, Gate 1-1 BLOCKER-1, 2026-10-01):
    # r3's 60-minute ceiling meant the daily mint (failures 24 h apart) and an interactive burst
    # could never page. "No success between" is what the run already guarantees; a heal nobody
    # observed is not evidence of health (#453).
    run_start, run_n = None, 1
    for e in reversed(results):
        s = e.get("status")
        if s is None or (isinstance(s, int) and s >= 500):
            run_n += 1
            if isinstance(e.get("ts"), (int, float)):
                run_start = e["ts"]
            continue
        break                                          # a success, or a different cause: the run ends
    if run_start is not None and t - run_start >= LOGIN_FAILING_GAP_S:
        # Gate 1-1 r4 FINDING-2: say what was measured — N ATTEMPTS spanning M min, never M min of
        # continuous failure (a daily mint's two attempts span 24 h with nothing observed between)
        page("login-failing", "%d loopback login attempts spanning %d min all got no answer or a 5xx, "
             "with no successful login between them — attempts, not continuous monitoring; there may "
             "have been no attempt in between. The app's login is failing, not the password"
             % (run_n, (t - run_start) // 60))
    die(3, "FAILED: login got %s — backing off %d s and keeping any current token. Nothing was "
           "sent." % (st if st is not None else b.decode("utf-8", "replace"), BACKOFF_500_S))


def _neg(until, status, reason):
    """The negative cache. r3: a failure to WRITE it must never stop the page that follows it
    (an OSError here used to escape as an internal error, before the 401/404 page)."""
    try:
        _write_json(NEG_FILE, {"until": until, "status": status, "reason": reason})
    except OSError as e:
        sys.stderr.write("dt-api: WARNING — could not write the negative cache (%s)\n" % e.strerror)


def cached_token():
    rec = _read_json(TOKEN_FILE)
    if not rec or not rec.get("accessToken"):
        return None
    exp = rec.get("exp")
    if not isinstance(exp, (int, float)) or exp <= _now() + 60:
        return None                                   # expired, or no readable expiry: never reuse it
    return rec


def get_token():
    with Lock():
        return cached_token() or login("dt-api")


# ───────────────────────────── the 401 path (C6: three cases) ─────────────────────────────

def auth_passed(status):
    """r3: the probe asks ONE question — did authenticateToken (routes.ts:181-243) let the token
    through? It answers only 401 (no/bad/expired token, no DB row, ANY exception) or 403 (a row
    with no role); every other answer means it called next(), so a handler 5xx is the HANDLER's
    health, not the token's. (/api/settings used to be read as "200 or unknown", so a settings
    handler failure blocked the daily mint.)"""
    return status is not None and status not in (401, 403)


def page_role_missing():
    """Gate 1-1 FINDING-1: authenticateToken answers 403 for a crew row with NO ROLE (routes.ts:226,
    'User account improperly configured - no role assigned'). A login cannot fix it, so it is its
    own STICKY kind — it used to be filed under the non-sticky token-refused, and each later call
    then spent another login from the shared bucket on it. The caller holds the Lock."""
    page("crew-role-missing", "GET /api/settings answered 403 — the crew row has no role "
         "(routes.ts:226 'User account improperly configured - no role assigned'); a login cannot "
         "fix it — give the row its role, then clear the page")


def classify_401(token):
    """The caller's route answered 401. Returns "route" (the token is fine, the route itself said
    401), "dead" (re-mint), or pages. Order: probe /api/settings, then /api/auth/verify.
    The caller holds the Lock (r3: a page may drop the cached token)."""
    st, _, b = app_request("GET", "/api/settings", token=token, timeout=PROBE_TIMEOUT_S)
    if auth_passed(st):
        return "route"
    if st is None:
        die(3, "FAILED: the route answered 401 and the probe GET /api/settings got no answer — "
               "dt-api cannot tell whether the token is good. Nothing was re-minted.")
    if st == 403:
        page_role_missing()
    probe_err = _obj(b).get("error")
    vs, _, vb = app_request("GET", "/api/auth/verify", token=token, timeout=PROBE_TIMEOUT_S)
    if vs == 401:
        return "dead"                                 # signature or expiry: a login fixes it
    if vs != 200:
        die(3, "FAILED: /api/auth/verify answered %s — dt-api cannot classify the 401. Nothing "
               "was re-minted." % vs)
    # The signature is good, so a login cannot help (routes.ts:215-241: the DB lookup runs after it).
    if probe_err == "User account not found":        # routes.ts:220
        page("crew-user-missing", "the token is signature-valid but the API says 'User account "
             "not found' — the crew row has been deleted or replaced", drop_token=token)
    if probe_err == "Invalid or expired token":      # routes.ts:241 — ANY exception, a DB error included
        page("token-refused", "the token is signature-valid but GET /api/settings refuses it — "
             "the app's user lookup or its database is failing")
    page("token-refused-unknown", "the token is signature-valid but GET /api/settings answered 401 "
         "with an unrecognised body")


# ───────────────────────────── the verbs ─────────────────────────────

def _emit(b):
    """The app's body to stdout. r3: a reader that went away (`| head`) does not change what the app
    answered, so it must not turn the exit code into 3 — stdout is pointed at /dev/null instead."""
    try:
        sys.stdout.buffer.write(b)
        sys.stdout.buffer.flush()
    except BrokenPipeError:
        try:
            os.dup2(os.open(os.devnull, os.O_WRONLY), sys.stdout.fileno())
        except OSError:
            pass


def do_call(req):
    body = None
    if req["method"] in ("POST", "PUT", "PATCH"):
        raw = sys.stdin.buffer.read()
        if raw.strip():
            if _json(raw) is None:
                die(2, TXT_MALFORMED % "the stdin body is not JSON")
            body = raw
    rec = get_token()
    st, h, b = app_request(req["method"], req["target"], token=rec["accessToken"], body=body,
                    mode=req["mode"])
    if st == 401:
        first = b
        try:
            with Lock():                               # r3: the probes AND any token drop under the lock
                verdict = classify_401(rec["accessToken"])
                if verdict == "dead":
                    cur = cached_token()
                    if cur and cur["accessToken"] != rec["accessToken"]:
                        rec = cur                      # someone re-minted while we checked
                    else:
                        rec = login("dt-api")
        except SystemExit as e:
            # the request itself WAS sent once and answered 401: hand back its body, say so, and
            # exit 1 (the contract's "the app answered non-2xx") — a PAGE keeps its 5 (r2)
            _emit(first)
            sys.stderr.write("dt-api: NOTE — your request WAS sent once and the app answered HTTP 401 "
                             "(body on stdout); the line above is about the check or the re-mint "
                             "after it, and no retry was sent.\n")
            raise SystemExit(5 if e.code == 5 else 1)
        if verdict == "dead":
            st, h, b = app_request(req["method"], req["target"], token=rec["accessToken"], body=body,
                                   mode=req["mode"])   # ONE retry, never more
    if st == 403:                                      # Gate 1-1: a role-less row, or the route's own rule?
        # authenticateToken answers 403 for a row with NO ROLE (routes.ts:226); a route's own
        # authorization rule answers 403 too. The same probe the 401 path uses tells them apart:
        # if GET /api/settings also answers 403, the fault is the row, and it pages. Otherwise —
        # including no answer — the 403 is the route's, and the call exits 1 as before.
        # Gate 1-1 r4 BLOCKER-1 (Langston): the request is already SENT and ANSWERED here, so a lock
        # held right now (a password change or mint in progress) must not escape as the lock's own
        # "Nothing was sent" exit 3 — the r2 401-path class, on this branch. The probe is skipped
        # instead: no page on a check that did not run, the body goes back ONCE (the _emit below),
        # exit 1. A role-less row answers 403 again on the next call and pages then.
        # ⛔ r5 BLOCKER-2: the page is written INSIDE the lock, like every page() call ("Callers hold
        # the Lock"). Written after it, the setter could clear page.json between the two and a sticky
        # crew-role-missing would land over the clear, refusing every login for a fixed cause.
        # page_role_missing() exits 5 through __exit__ (the lock is released); `as e` tells that
        # apart from the lock's own refusal.
        try:
            with Lock():
                pst, _, _ = app_request("GET", "/api/settings", token=rec["accessToken"],
                                        timeout=PROBE_TIMEOUT_S)
                if pst == 403:
                    _emit(b)
                    sys.stderr.write("dt-api: NOTE — your request WAS sent once and the app answered "
                                     "HTTP 403 (body on stdout); the page below is why.\n")
                    page_role_missing()                # SystemExit(5)
        except SystemExit as e:
            if e.code == 5:
                raise                                  # the page — its body is already out, once
            sys.stderr.write("dt-api: NOTE — your request WAS sent once and the app answered HTTP 403 "
                             "(body on stdout); the line above is about the role check after it, which "
                             "did not run, so nothing was paged and no retry was sent.\n")
    if st is None:
        die(3, "FAILED: the app did not answer (%s). For a write, check whether it took effect "
               "before retrying." % b.decode("utf-8", "replace"))
    _emit(b)
    sys.stderr.write("dt-api: HTTP %d %s %s\n" % (st, req["method"], req["path"]))
    return 0 if 200 <= st < 300 else 1


def do_mint():
    """The agents' browser token (C-10). ⛔ Refused unless sudo says the caller is dtmint — a
    second layer beside sudoers, which gives `deploy` only the GET and --write forms."""
    if os.environ.get("SUDO_USER") != MINT_CALLER:
        die(2, "REFUSED: dt-api mint is only reachable through the %s forced-command key"
            % MINT_CALLER)
    with Lock():
        rec = cached_token()
        t = _now()
        reused = False
        if rec and t - rec.get("issued_at", 0) < MINT_REUSE_S and \
                isinstance(rec.get("exp"), (int, float)) and rec["exp"] - t >= MIN_EXP_LEFT_S:
            # ⛔ /api/auth/verify checks the SIGNATURE only (no DB): a token for a deleted or replaced
            #    row passes it. GET /api/settings runs authenticateToken's user lookup (fresh-reader r1).
            vs, _, _ = app_request("GET", "/api/settings", token=rec["accessToken"],
                                   timeout=PROBE_TIMEOUT_S)
            if auth_passed(vs):
                reused = True
            elif vs is None:
                die(3, "FAILED: GET /api/settings got no answer; not handing out a token it could not "
                       "check.")
            elif classify_401(rec["accessToken"]) == "route":
                reused = True                  # the probe recovered between the two reads
        if not reused:
            rec = login("mint")
    exp = rec.get("exp")
    if not isinstance(exp, (int, float)) or exp - _now() < MIN_EXP_LEFT_S:
        die(3, "FAILED: the minted token expires %s — under the %d-day floor; not handing it out."
            % (_iso(exp) if isinstance(exp, (int, float)) else "unreadable", MIN_EXP_LEFT_S // 86400))
    sys.stdout.write(json.dumps({"accessToken": rec["accessToken"],
                                 "refreshToken": rec.get("refreshToken", ""),
                                 "issued_at": _iso(rec["issued_at"]), "exp": _iso(exp),
                                 "reused": reused}) + "\n")
    return 0


def main(argv):
    if argv and argv[0] in ("-h", "--help"):
        sys.stdout.write(__doc__)
        return 0
    me = pwd.getpwuid(os.geteuid()).pw_name
    if me != EXPECT_USER:
        die(2, "REFUSED: run dt-api as %s — sudo -u %s /usr/local/bin/dt-api ... (running it as "
               "%s would leave its cache owned by the wrong account)." % (EXPECT_USER, EXPECT_USER, me))
    os.umask(0o077)
    if not os.path.isdir(STATE_DIR):
        die(3, "REFUSED: %s is missing — dt-api is not installed completely." % STATE_DIR)
    fields = {"ts": _iso(_now()), "caller": os.environ.get("SUDO_USER", "?"), "verb": "refused"}
    code = 3
    try:
        try:
            req = parse(argv)
        except Refused as r:
            die(2, str(r))                     # refusals are logged too (the audit trail)
        fields["verb"] = req["kind"]
        if req["kind"] == "call":
            fields.update(method=req["method"], path=canon(req["path"]))
        code = do_mint() if req["kind"] == "mint" else do_call(req)
        return code
    except SystemExit as e:
        code = e.code
        raise
    except Exception as e:
        # ⛔ the TYPE only: a message can carry a header value, i.e. a token
        code = 3
        die(3, "FAILED: dt-api hit an internal %s; nothing further was sent." % type(e).__name__)
    finally:
        fields["exit"] = code
        call_log(fields)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
