<?xml version="1.0" encoding="UTF-8"?>
<!-- B-TRANSCRIPT-ARCHIVE P7(a): the nightly archive. Runs the INSTALLED copy (~\.claude\transcript-archive-bin, copied
     from a reviewed sha), never a working clone. 02:30 local; P9 adds the archive to the 11:30 additive backup
     (backup-claude-sessions.ps1), which then carries the night's archive the same day. StartWhenAvailable: a laptop asleep at 02:30 runs it on waking; a whole day off fires the
     staging never-ran check (dt_archive_trigger.py docstring). Interactive token: it needs the user's ssh keys.
     Install: schtasks /create /tn "\DawnTrader-Transcript-Archive" /xml <this file> -->
<Task version="1.4" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task">
  <RegistrationInfo>
    <Description>B-TRANSCRIPT-ARCHIVE P7: nightly transcript archive (Infra Claude). A failure or a missed night raises a staging system alert, key transcript-archive-nightly.</Description>
  </RegistrationInfo>
  <Triggers>
    <CalendarTrigger>
      <StartBoundary>2026-11-07T02:30:00</StartBoundary>
      <Enabled>true</Enabled>
      <ScheduleByDay>
        <DaysInterval>1</DaysInterval>
      </ScheduleByDay>
    </CalendarTrigger>
  </Triggers>
  <Principals>
    <Principal id="Author">
      <LogonType>InteractiveToken</LogonType>
      <RunLevel>LeastPrivilege</RunLevel>
    </Principal>
  </Principals>
  <Settings>
    <MultipleInstancesPolicy>IgnoreNew</MultipleInstancesPolicy>
    <DisallowStartIfOnBatteries>false</DisallowStartIfOnBatteries>
    <StopIfGoingOnBatteries>false</StopIfGoingOnBatteries>
    <StartWhenAvailable>true</StartWhenAvailable>
    <RunOnlyIfNetworkAvailable>false</RunOnlyIfNetworkAvailable>
    <WakeToRun>false</WakeToRun>
    <ExecutionTimeLimit>PT1H</ExecutionTimeLimit>
    <Enabled>true</Enabled>
    <Hidden>false</Hidden>
  </Settings>
  <Actions Context="Author">
    <Exec>
      <Command>C:\Python313\python.exe</Command>
      <Arguments>-I "C:\Users\kyleg\.claude\transcript-archive-bin\dt_archive_trigger.py" nightly</Arguments>
      <WorkingDirectory>C:\Users\kyleg\.claude\transcript-archive-bin</WorkingDirectory>
    </Exec>
  </Actions>
</Task>
