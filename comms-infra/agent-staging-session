#!/usr/bin/env python3
"""Refresh BOTH headless agents' staging browser sessions from ONE crew-login mint.

★ KYLE'S RULING, 2026-09-09, AFTER I PUT THE READ-ONLY QUESTION TO HIM TWICE:
  *"The way it's been working now is that the sessions navigate through the browser to a
  staging page that's already open and logged into... if you guys were going to be making
  changes and causing problems, then that would have already happened by now... You guys can
  do much more damage in the back end than you can from the front end. I don't need read
  only. Let's just give the access."*
  ⇒ **THE READ-ONLY FENCE IS DELIBERATELY NOT BUILT.** `#1022` records what a viewer account
    would and would not have stopped; it stands as a finding for `B-SEC-HARDEN`, not as a
    blocker on this. Do not re-litigate it here.

★ B-CREDENTIALS-PRIVATE-REPO OBJ-1 (#1023) — NO PASSWORD ON THIS BOX ANY MORE. The token comes
  from staging's crew login: one ssh with a dedicated key whose ONLY power is a forced command,
  `sudo -n -u dtapi /usr/local/bin/dt-api mint` (staging's dtmint account, from= this box). The
  two password files this script used to read (/etc/langston/staging.env, /etc/coltrane/staging.env)
  and its public-host login are RETIRED (DELETED_COMPONENTS_LOG). One mint writes both agents'
  storage states; staging hands back the same token for 20 h, so a re-run costs no login.

⛔⛔ NO PASSWORD IS EVER TYPED INTO A FORM, AND THAT BOUNDARY IS UNTOUCHED. The tokens are written
    into a Playwright storage-state file, which the browser loads as its starting state. **The
    browser therefore OPENS logged in rather than logging itself in**, which is the same position
    Kyle's own Chrome is in when a session verifies through it.

⛔ THE TOKEN NEVER TOUCHES argv, stdout or a log: it arrives on the ssh's stdout into memory and
   goes straight into each agent's 0600 state file.

⚠️ THE TOKEN LASTS 7 DAYS (routes.ts issueTokens), the timer runs daily, and a mint is refused
   unless it still has 6 days left (OBJ-1(e)). ★ A file that is merely PRESENT proves nothing about
   whether it still works, which is why `--check` asks the API rather than reading a timestamp.
"""

import argparse
import calendar
import json
import os
import pwd
import stat
import ssl
import subprocess
import sys
import time
import urllib.error
import urllib.request

AGENTS = ("coltrane", "langston")
BASE = "https://188.245.193.8.sslip.io"
ORIGIN = BASE                               # the storage state is keyed to the PUBLIC origin (C-10)
SSH = "/usr/bin/ssh"
MINT_KEY = "/root/.ssh/dtmint_ed25519"
MINT_TARGET = "dtmint@188.245.193.8"
KNOWN_HOSTS = "/root/.ssh/known_hosts"
MIN_EXP_LEFT_S = 6 * 86400
NL = chr(10)

# ⚠️ The staging cert is for the sslip.io host and is valid, but the box also answers on a
#    bare IP; verification is left ON and this note exists so nobody "fixes" a failure by
#    turning it off.
CTX = ssl.create_default_context()


def state_file(agent):
    return "/home/%s/.staging-session.json" % agent


def mint():
    """One ssh; the forced command on staging decides what runs. We pass NO command."""
    # -F /dev/null: root's own ssh config (a ControlPath, a ProxyCommand) must not shape this call (r2)
    cmd = [SSH, "-F", "/dev/null", "-i", MINT_KEY, "-o", "IdentitiesOnly=yes", "-o", "BatchMode=yes",
           "-o", "StrictHostKeyChecking=yes", "-o", "UserKnownHostsFile=" + KNOWN_HOSTS,
           "-o", "ConnectTimeout=20", "-T", MINT_TARGET]
    try:
        r = subprocess.run(cmd, stdin=subprocess.DEVNULL, capture_output=True, timeout=180)
    except subprocess.TimeoutExpired:
        print("FAILED: the mint did not answer within 180 s. The sessions were NOT refreshed.")
        raise SystemExit(3)
    if r.returncode != 0:
        # stderr is dt-api's or ssh's own text — it never carries the token
        print("FAILED: the mint exited %d: %s. The sessions were NOT refreshed; the old ones stay "
              "until they expire." % (r.returncode, r.stderr.decode("utf-8", "replace").strip()[:400]))
        raise SystemExit(3)
    try:
        j = json.loads(r.stdout.decode("utf-8"))
    except (ValueError, UnicodeDecodeError):
        j = None
    if not isinstance(j, dict):
        print("FAILED: the mint returned something that is not a JSON object. NOT writing a state file.")
        raise SystemExit(4)
    if not j.get("accessToken"):
        print("FAILED: the mint returned no accessToken. NOT writing a state file — a file with no "
              "token in it is worse than none, because the browser would open, look logged out, "
              "and nobody would know why.")
        raise SystemExit(4)
    try:
        exp = calendar.timegm(time.strptime(str(j.get("exp", "")), "%Y-%m-%dT%H:%M:%SZ"))
    except ValueError:
        print("FAILED: the mint's exp is unreadable. NOT writing a state file.")
        raise SystemExit(4)
    if exp - time.time() < MIN_EXP_LEFT_S:
        print("FAILED: the minted token expires %s — under the 6-day floor. NOT writing it." % j["exp"])
        raise SystemExit(4)
    return j


def write_state(agent, tokens):
    """The storage-state shape Playwright loads. ⚠️ All THREE keys are written because
    `client/src/lib/auth.ts` sets `accessToken`, `refreshToken` AND a legacy `token`, and
    `getAccessToken()` falls back to the legacy one. Writing only the modern name would work
    today and break on whichever path still reads the old key."""
    access, refresh = tokens["accessToken"], tokens.get("refreshToken", "")
    state = {"cookies": [], "origins": [{"origin": ORIGIN, "localStorage": [
        {"name": "accessToken", "value": access},
        {"name": "refreshToken", "value": refresh},
        {"name": "token", "value": access}]}]}
    # ⛔⛔ ROOT WRITES INTO A DIRECTORY THE AGENT OWNS, SO EVERY STEP IS BY HANDLE, NEVER BY PATH
    #    (fresh-reader r1, BLOCKER: a path-based chown after close let the agent swap the temp file
    #    for a symlink and have root chown /etc/shadow to it). The home is opened O_NOFOLLOW and
    #    every name is resolved relative to that handle; the temp is created O_EXCL (a planted file
    #    or link fails the run instead of being reused); ownership is set on the OPEN fd; the data
    #    is fsync'd before the rename; rename never follows a link at its destination.
    pw = pwd.getpwnam(agent)
    home = os.path.dirname(state_file(agent))
    name = os.path.basename(state_file(agent))
    tmp = name + ".tmp"
    dfd = os.open(home, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
    try:
        try:
            os.unlink(tmp, dir_fd=dfd)         # a leftover from an earlier crash (a link is removed, not followed)
        except FileNotFoundError:
            pass
        fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600, dir_fd=dfd)
        try:
            os.fchown(fd, pw.pw_uid, pw.pw_gid)
            os.fchmod(fd, 0o600)
            os.write(fd, json.dumps(state).encode("utf-8"))
            os.fsync(fd)
        finally:
            os.close(fd)
        os.replace(tmp, name, src_dir_fd=dfd, dst_dir_fd=dfd)
        os.fsync(dfd)
    finally:
        os.close(dfd)


def check(agent):
    """⛔ ASK THE API, DO NOT STAT THE FILE — through the route the crew login's own control uses
    (OBJ-1(a): GET /api/settings sits behind authenticateToken, which also looks the user up)."""
    try:
        # O_NOFOLLOW|O_NONBLOCK + a regular-file check: an agent-owned path must not hang or
        # redirect a root read (r2: a FIFO planted there hung --check)
        fd = os.open(state_file(agent), os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
        with os.fdopen(fd, "rb") as fh:
            if not stat.S_ISREG(os.fstat(fh.fileno()).st_mode):
                raise OSError("not a regular file")
            state = json.loads(fh.read(1 << 20).decode("utf-8"))
        tok = [i["value"] for o in state["origins"] for i in o["localStorage"]
               if i["name"] == "accessToken"][0]
    except Exception as e:
        print("NO SESSION: %s: %s" % (type(e).__name__, e))
        return 1
    req = urllib.request.Request(BASE + "/api/settings", headers={"Authorization": "Bearer " + tok})
    try:
        with urllib.request.urlopen(req, timeout=20, context=CTX) as r:
            r.read()
        print("SESSION OK — the API served GET /api/settings with %s's stored token." % agent)
        return 0
    except urllib.error.HTTPError as e:
        # ⛔⛔ 404 IS NOT 401. A missing endpoint and a rejected token are different facts.
        if e.code == 401:
            print("SESSION DEAD — the API REJECTED %s's stored token (HTTP 401). Re-run without "
                  "--check to mint a new one." % agent)
            return 1
        print("INCONCLUSIVE — GET /api/settings answered HTTP %d, which says nothing certain "
              "about the token." % e.code)
        return 2
    except Exception as e:
        print("UNKNOWN — could not reach staging to test the token: %s: %s" % (type(e).__name__, e))
        return 2


def main():
    ap = argparse.ArgumentParser(description=__doc__.split(NL)[0])
    ap.add_argument("--check", action="store_true",
                    help="test an agent's STORED token against the API; mints nothing")
    ap.add_argument("--user", choices=AGENTS, help="with --check: which agent (default: both)")
    a = ap.parse_args()
    if a.check:
        codes = [check(u) for u in ([a.user] if a.user else AGENTS)]
        return 1 if 1 in codes else max(codes)   # a DEAD session is never hidden behind an INCONCLUSIVE one
    if a.user:
        ap.error("--user only goes with --check: one mint always refreshes both agents")
    tokens = mint()
    failed = []
    for agent in AGENTS:
        # ⛔ one agent's failure must never skip the other (C-10; r2: an agent could otherwise block
        #    the other's refresh by planting a directory where its own state file goes)
        try:
            write_state(agent, tokens)
            print("Refreshed %s (token %s, expires %s)." % (state_file(agent),
                  "reused" if tokens.get("reused") else "fresh", tokens.get("exp")))
        except Exception as e:
            failed.append(agent)
            print("FAILED to write %s's session: %s. The other agent is unaffected." % (agent, type(e).__name__))
    return 5 if failed else 0


if __name__ == "__main__":
    sys.exit(main())
