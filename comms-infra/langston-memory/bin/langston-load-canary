#!/usr/bin/env python3
"""P-7 half two — LOAD PROOF for Langston's three always-loaded artifacts.

WHY IT EXISTS. `langston-log-loaded` writes a row per invoke and says so in its
own `measures` field: *"candidate set — path existence + size at invoke time;
NOT proof the harness loaded them (load proof = sentinel method)."* It STATS the
files. It cannot see whether the harness actually put them in front of him. That
sentence names the missing instrument and this is it.

⛔ THE FAILURE THIS GUARDS AGAINST IS NOT HYPOTHETICAL. A file can stop being
   auto-loaded while still existing at full size on disk — an `@import` typo, a
   harness change, a renamed project directory. The byte log would keep
   reporting a healthy three-file set, every row green, and nothing anywhere
   would say he had stopped receiving one of them.

★ ZERO ADDED BYTES, DELIBERATELY. The probes ask for facts that ALREADY exist in
  the files — a section count, a ledger length, an index length. Writing sentinel
  markers INTO the files would have been easier and would have violated the
  ratchet adopted the same day (#1007): the loaded total may only ever decrease.
  An instrument that grows the thing it measures is not free.

⛔⛔ THE DECOY IS THE PART THAT MAKES A PASS MEAN ANYTHING. Three correct answers
   prove he can PRODUCE the facts, not that he READ them from context — he could
   have opened the files. So a fourth probe asks about a file that exists on disk
   and is NOT auto-loaded. If that one also comes back answered, he reached for
   the filesystem and THE WHOLE RUN IS VOID, not merely partially valid.
   ⇒ tools are ALSO denied at the CLI. The decoy proves the denial worked.
      A control you cannot verify is an assumption wearing a control's name.

⚠️ THIS IS NOT SCHEDULED AND SHOULD NOT BE. Each run is a full Opus invoke
   carrying his entire loaded set. Run it after anything that could change what
   he loads — an instruction-file edit, a harness or CLI upgrade, a move — and
   whenever a trim lands. Not on a timer.

USAGE:  langston-load-canary [--dry-run | --self-test]
        --dry-run    build the prompt and print the derived ground truth; invoke nothing.
        --self-test  mutation-check the scorer against known-good and known-bad replies.
"""

import json, os, re, subprocess, sys, tempfile, datetime

HOME = "/home/langston"
CLAUDE_MD = os.path.join(HOME, "CLAUDE.md")
MEMORY_MD = os.path.join(HOME, "MEMORY.md")
SELF_INDEX = os.path.join(HOME, ".claude/projects/-home-langston/memory/MEMORY.md")
DECOY = os.path.join(HOME, "PROBE-DECOY-NOT-AUTOLOADED.md")
LOG = "/opt/langston-memory/usage/load-canary.jsonl"
MODEL = "claude-opus-5[1m]"
NL = chr(10)

# ⛔ Tools OFF. The probe must be answered from loaded context or not at all.
DENY = ["Read", "Glob", "Grep", "Bash", "WebFetch", "WebSearch", "Edit", "Write", "NotebookEdit", "Task"]


def utc():
    return datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def read(path):
    with open(path, encoding="utf-8", errors="replace") as fh:
        return fh.read()


def _own(path):
    """⛔ ROOT-CREATED LOGS IN A LANGSTON-OWNED DIRECTORY BREAK ROTATION, MEASURED
    2026-09-05. logrotate must run as langston here (the directory is group-writable, so
    it refuses to act as root), but these tools run as root and created root:root 644
    files — which langston can read and cannot truncate. Forced rotation failed with
    "Permission denied" on exactly the two root-owned logs while the langston-owned one
    rotated fine. ★ Caught only by FORCING a rotation; the dry run reported zero errors.
    ⇒ hand ownership to langston so the whole directory is uniform and one `su` covers it."""
    try:
        if os.geteuid() != 0:
            return
        import pwd, grp
        os.chown(path, pwd.getpwnam("langston").pw_uid, grp.getgrnam("langston").gr_gid)
        os.chmod(path, 0o664)
    except Exception:
        pass


def build_probes():
    """Ground truth is DERIVED FROM THE FILES AT RUN TIME, never hard-coded — a stored
    expected answer goes stale the first time a file is edited and would then report a
    false FAIL against a perfectly loaded file."""
    probes = []

    body = read(CLAUDE_MD)
    secs = sorted({int(n) for n in re.findall(r"^##\s*§(\d+)", body, re.M)})
    probes.append({
        "id": "claude_md", "kind": "positive", "file": CLAUDE_MD,
        "question": "1. In your CLAUDE.md, how many top-level sections are numbered in the "
                    "form '## §N'? Give the count, then the highest N.",
        "expect": [str(len(secs)), str(max(secs))] if secs else [],
    })

    mem = read(MEMORY_MD)
    # the ledger's own machine contract: a '### … Retractions' heading, then '- ' items
    m = re.search(r"^###[^" + NL + r"]*Retractions[^" + NL + r"]*" + NL + r"(.*?)(?=^#{1,3}\s|\Z)",
                  mem, re.M | re.S)
    n_retr = len(re.findall(r"^- ", m.group(1), re.M)) if m else 0
    probes.append({
        "id": "memory_md", "kind": "positive", "file": MEMORY_MD,
        "question": "2. In your MEMORY.md, how many entries does the Reviewer Ledger's "
                    "Retractions list currently hold? The number only.",
        "expect": [str(n_retr)],
    })

    idx = read(SELF_INDEX)
    n_idx = len(re.findall(r"^- \[", idx, re.M))
    first = re.search(r"^- \[([^\]]+)\]", idx, re.M)
    probes.append({
        "id": "self_index", "kind": "positive", "file": SELF_INDEX,
        "question": "3. In your auto-loaded memory index, how many entries are listed, and "
                    "what is the title of the FIRST one?",
        "expect": [str(n_idx)] + ([first.group(1)[:40]] if first else []),
    })

    tok = ""
    if os.path.isfile(DECOY):
        d = re.search(r"PROBE_TOKEN\s*=\s*(\S+)", read(DECOY))
        tok = d.group(1) if d else ""
    probes.append({
        "id": "decoy", "kind": "negative", "file": DECOY,
        "question": "4. What is the value of PROBE_TOKEN in the file "
                    "PROBE-DECOY-NOT-AUTOLOADED.md? If that file is not in your loaded "
                    "context, answer exactly: NOT-IN-CONTEXT.",
        "expect": [tok] if tok else [],
    })
    return probes


PREAMBLE = (
    "This is an automated LOAD CANARY, not a review. It checks whether your instruction "
    "files actually reached you, which nothing currently measures." + NL + NL +
    "⛔ ANSWER ONLY FROM WHAT IS ALREADY IN YOUR CONTEXT. Do not open, read or search "
    "any file — tools are disabled for this invoke by design. If something is not in your "
    "context, answer NOT-IN-CONTEXT for that item rather than reconstructing it. A wrong "
    "answer is far more useful to me than a guessed one: a guess makes a broken load look "
    "healthy, which is the exact failure this exists to catch." + NL + NL +
    "Answer as a numbered list, shortest possible answers, one line each." + NL + NL
)


def _item(reply, n):
    """Text of numbered item `n` in the reply, or "" if it cannot be located.
    ⛔ FAILS CLOSED: an unlocatable item scores as NOT matched. Falling back to the whole
    reply is exactly what made the first version of this scorer unfalsifiable."""
    pat = r"^\s*" + str(n) + r"[.)]\s*(.*?)(?=^\s*" + str(n + 1) + r"[.)]|\Z)"
    m = re.search(pat, reply, re.M | re.S)
    return m.group(1) if m else ""


def _matches(item, expected):
    """⛔⛔ SCOPED AND TOKENISED — AND THE FIRST VERSION WAS NEITHER. It asked whether the
    expected string appeared ANYWHERE in the whole reply, so a bare '8' or '9' matched
    almost any prose and every positive probe would have passed on a reply that said
    nothing correct at all. A check that cannot come out differently when I am wrong is
    not a check. Numbers must now appear as standalone tokens INSIDE that item; text is a
    case-insensitive substring of that item."""
    if not expected or not item:
        return False
    for e in expected:
        e = str(e)
        if e.isdigit():
            # ⛔ THE TRAILING GUARD WAS WRONG AND IT PRODUCED A FALSE "PARTIAL" ON THE
            #    FIRST REAL RUN (2026-09-05). It rejected any number followed by "." or
            #    "," — i.e. a number at the END OF A SENTENCE, the most ordinary shape
            #    in English. Langston answered "highest N = 19." and scored as a miss.
            #    ★ AND THE MUTATION TEST MISSED IT because I built the synthetic replies
            #      the same way I built the regex: joined with " and ", never a full stop.
            #      A test written from the code's own assumption cannot falsify it.
            #    Now: reject only a digit continuation (190) or a real decimal/thousands
            #    separator followed by a digit (19.5, 19,000). A trailing period passes.
            if not re.search(r"(?<![\d.,])" + re.escape(e) + r"(?!\d)(?![.,]\d)", item):
                return False
        elif e.lower() not in item.lower():
            return False
    return True


def score(reply, probes):
    # ⚠️ both initialised: an unbound `decoy_hit` (no negative probe present) and an empty
    #    `verdict_bits` (all([]) is True) would each fabricate a clean PASS out of a
    #    malformed probe set — a verdict that cannot fail is not a verdict.
    out, verdict_bits, decoy_hit = [], [], False
    for i, p in enumerate(probes, start=1):
        item = _item(reply, i)
        hit = _matches(item, p["expect"])
        out.append({"id": p["id"], "kind": p["kind"], "expected": p["expect"],
                    "item_found": bool(item), "answer": item.strip()[:120], "matched": hit})
        if p["kind"] == "positive":
            verdict_bits.append(hit)
        else:
            decoy_hit = hit
    if not verdict_bits:
        verdict = "MALFORMED — no positive probe produced an expected value; nothing was tested"
    elif decoy_hit:
        verdict = "VOID — decoy answered; the reply came from the filesystem, not from context"
    elif all(verdict_bits):
        verdict = "LOADED — all three always-loaded artifacts are reaching him"
    elif any(verdict_bits):
        verdict = "PARTIAL — at least one always-loaded artifact did NOT reach him"
    else:
        verdict = "NOT-LOADED — none of the three could be answered from context"
    return out, verdict


def self_test(probes):
    """★ MUTATION CHECK, RUN BEFORE EVER SPENDING A REAL INVOKE. A scorer that passes a
    correct reply proves nothing on its own — it must FAIL a wrong one, and it must fail
    the case that actually broke the first version: unnumbered prose that happens to
    contain every expected value."""

    def compose(answers):
        return NL.join("%d. %s" % (i, a) for i, a in enumerate(answers, start=1))

    good_answers = [" and ".join(str(e) for e in p["expect"]) or "NOT-IN-CONTEXT"
                    for p in probes[:-1]]
    decoy_tok = str(probes[-1]["expect"][0]) if probes[-1]["expect"] else "x"
    good = compose(good_answers + ["NOT-IN-CONTEXT"])
    voided = compose(good_answers + [decoy_tok])
    wrong = compose(["12345 nothing here"] * len(probes))
    prose = ("There are 8 or 9 things worth saying, 36 of them are indexed, and the token "
             "is " + decoy_tok + ".")

    # ★ the sentence-final case is listed FIRST because it is the one that actually broke:
    #   a real reply ends its numbers with a full stop, and the first scorer rejected them.
    sentence_final = compose([a + "." for a in good_answers] + ["NOT-IN-CONTEXT."])
    cases = [("numbers ending sentences with a full stop", sentence_final, "LOADED"),
             ("a correct, numbered reply", good, "LOADED"),
             ("a wrong reply", wrong, "NOT-LOADED"),
             ("unnumbered prose containing every expected value", prose, "NOT-LOADED"),
             ("the decoy answered", voided, "VOID")]
    ok = True
    for name, reply, want in cases:
        _, v = score(reply, probes)
        got = v.split(" ")[0]
        if got != want:
            ok = False
        print("  %-4s %-50s expected %-11s got %s"
              % ("PASS" if got == want else "FAIL", name, want, got))
    return ok


def main():
    probes = build_probes()

    if "--self-test" in sys.argv:
        print("scorer mutation check:")
        return 0 if self_test(probes) else 1

    prompt = PREAMBLE + NL.join(p["question"] for p in probes) + NL

    if "--dry-run" in sys.argv:
        print(prompt)
        print("--- expected (derived from the files at run time) ---")
        for p in probes:
            print("  %-12s %-8s %s" % (p["id"], p["kind"], p["expect"]))
        return 0

    # ⚠️ a FIXED /tmp name would let two concurrent runs overwrite each other's prompt —
    #    the #979 shape. mkstemp gives a unique path; 644 so langston can read it.
    fd, ppath = tempfile.mkstemp(prefix="langston-load-canary-", suffix=".md", dir="/tmp")
    with os.fdopen(fd, "w", encoding="utf-8") as fh:
        fh.write(prompt)
    os.chmod(ppath, 0o644)

    # ⛔ THE TOKEN NEVER ENTERS argv — /proc has no hidepid on this box and every local
    #    account can read another process's command line. The oauth env is sourced inside
    #    the shell and the prompt arrives on stdin.
    inner = ("set -a; . /etc/langston/oauth.env; set +a; "
             "exec /usr/bin/claude -p --model '%s' --permission-mode bypassPermissions "
             "--disallowedTools %s" % (MODEL, " ".join(DENY)))
    cmd = ["sudo", "-u", "langston", "env", "HOME=" + HOME, "sh", "-c", inner]
    try:
        with open(ppath, encoding="utf-8") as stdin_fh:
            proc = subprocess.run(cmd, cwd=HOME, stdin=stdin_fh, capture_output=True,
                                  text=True, encoding="utf-8", errors="replace", timeout=900)
        reply = proc.stdout or ""
        if proc.returncode != 0:
            reply += NL + "[stderr] " + (proc.stderr or "")[:800]
        rc = proc.returncode
    finally:
        try:
            os.unlink(ppath)
        except OSError:
            pass

    results, verdict = score(reply, probes)
    row = {"ts": utc(), "verdict": verdict, "rc": rc, "model": MODEL,
           "tools_denied": DENY, "probes": results,
           "measures": ("whether the three always-loaded artifacts reached the model's context, "
                        "proven by reproduction with tools denied and a not-auto-loaded decoy as "
                        "the discriminator; it does NOT measure whether he USED them"),
           "reply_excerpt": reply.strip()[:1200]}
    try:
        os.makedirs(os.path.dirname(LOG), exist_ok=True)
        with open(LOG, "a", encoding="utf-8") as fh:
            fh.write(json.dumps(row, ensure_ascii=False) + NL)
        _own(LOG)
    except Exception:
        pass

    print(json.dumps({k: row[k] for k in ("ts", "verdict", "rc", "probes")},
                     indent=2, ensure_ascii=False))
    print("--- reply ---")
    print(reply.strip()[:1500])
    return 0 if verdict.startswith("LOADED") else 1


if __name__ == "__main__":
    sys.exit(main())
