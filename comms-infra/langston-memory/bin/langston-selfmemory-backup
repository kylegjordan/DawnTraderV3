#!/usr/bin/env python3
"""P-3 — recurring, reproduction-verified backup of Langston's OWN decision store,
plus a manifest he can read himself.

⛔⛔ WHAT THIS PROTECTS, AND WHY IT IS NOT AN ORDINARY BACKUP JOB.
   `/home/langston/.claude/projects/-home-langston/memory/` is a store Langston
   built HIMSELF, unprompted, starting 2026-05-07 — the day after he came
   online — and is still writing to. Its entries are not notes: each carries the
   incident, a `Why:`, a `How to apply:` and `[[wiki-links]]` to related rulings.
   It is the most valuable artifact on that box and, until this script, the
   least protected: ONE manual snapshot taken 2026-09-03, nothing scheduled to
   ever take another. A store that only grows, holding reasoning that cannot be
   reconstructed, backed up once by hand, is a single bad `rm` from gone.

★ THE GATE IS REPRODUCTION, NOT COMPARISON — CLAUDE.md §7.1, learned the hard way
  on this project: comparing refs "certified an EMPTY backup four times." So this
  does not compare a file listing. It EXTRACTS the archive it just wrote into a
  temp directory and compares sha256 of every member against the live file. A
  backup that has not been read back is a hope, not a backup.

⛔ THE MANIFEST IS IN HIS REACH ON PURPOSE. He is stateless and cannot remember
   that a backup exists. A manifest he cannot read is a manifest that, from where
   he sits, does not exist — so it is written somewhere langston can open, and it
   states what was captured, when, and how it was verified.

⚠️ RETENTION IS BY COUNT, AND THE OLDEST IS DROPPED ONLY AFTER A NEW ONE HAS
   PASSED VERIFICATION. Pruning first would, on a bad day, delete the last good
   copy to make room for a broken one.

⛔ TWO SOURCES SINCE P-6b (B-LANGSTON-CONTEXT, 2026-09-11). `langston-memory-write` keeps the ONLY
   copy of every version of his MEMORY.md it overwrote, in /home/langston/.memory-archive. Langston's
   condition: "an archive outside the backup is a removal with no durable copy, one level down." So
   that folder is archived and REPRODUCTION-VERIFIED in the same snapshot as the store. It may not exist
   yet (the writer creates it on its first overwrite) - an absent archive is recorded, never an error;
   an absent or empty STORE still refuses.
   Member names are now prefixed by their source folder (`memory/...`, `.memory-archive/...`).

PATH OVERRIDES, FOR TESTING ONLY: SELFMEM_STORE, SELFMEM_ARCHIVE, SELFMEM_DEST, SELFMEM_MANIFEST,
SELFMEM_RUNLOG. The timer sets none of them, so the scheduled run always uses the real paths.

USAGE:  langston-selfmemory-backup [--dry-run] [--prove]
"""

import hashlib, json, os, shutil, subprocess, sys, tarfile, tempfile, datetime

STORE = os.environ.get("SELFMEM_STORE", "/home/langston/.claude/projects/-home-langston/memory")
ARCHIVE = os.environ.get("SELFMEM_ARCHIVE", "/home/langston/.memory-archive")
SOURCES = [STORE, ARCHIVE]
DEST = os.environ.get("SELFMEM_DEST", "/root/backups/langston-selfmemory")
MANIFEST = os.environ.get("SELFMEM_MANIFEST", "/opt/langston-memory/usage/selfmemory-backup-manifest.md")
RUNLOG = os.environ.get("SELFMEM_RUNLOG", "/opt/langston-memory/usage/selfmemory-backup.jsonl")
KEEP = 14
NL = chr(10)


def utc():
    return datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def sha(path):
    h = hashlib.sha256()
    with open(path, "rb") as fh:
        for chunk in iter(lambda: fh.read(65536), b""):
            h.update(chunk)
    return h.hexdigest()


def _own(path):
    """Same ownership reasoning as the other tools in this directory — see
    langston-size-watch._own. Root-created files here break logrotate."""
    try:
        if os.geteuid() != 0:
            return
        import pwd, grp
        os.chown(path, pwd.getpwnam("langston").pw_uid, grp.getgrnam("langston").gr_gid)
        os.chmod(path, 0o664)
    except Exception:
        pass


def live_files(sources=None):
    """⛔ WALKS RECURSIVELY, AND THE PREVIOUS VERSION DID NOT (Langston, Step-4).
    `tarfile.add(STORE)` captures subdirectories, but verification listed only the top
    level — so anything in a subdirectory was archived and sat SILENTLY OUTSIDE THE
    VERIFIED POPULATION. The backup would have reported 37/37 while carrying unverified
    content. ★ Naming the population is half of rule 29; this is the half where the
    population and the claim had quietly diverged."""
    out = {}
    for src in (sources if sources is not None else present_sources()):
        top = os.path.basename(src.rstrip("/"))
        for root, _dirs, names in os.walk(src):
            for name in sorted(names):
                p = os.path.join(root, name)
                if os.path.isfile(p):
                    rel = os.path.relpath(p, src).replace(os.sep, "/")
                    out[top + "/" + rel] = {"bytes": os.path.getsize(p), "sha256": sha(p)}
    return out


def per_source(expected):
    """Every configured source BY NAME, with its member count and bytes. An absent source is listed as absent, never
    dropped - the whole point is that a skipped archive is visible in the row (Langston, amendment B)."""
    out = {}
    for src in SOURCES:
        top = os.path.basename(src.rstrip("/"))
        members = [v for k, v in expected.items() if k.startswith(top + "/")]
        out[top] = {"path": src, "present": os.path.isdir(src), "members": len(members),
                    "bytes": sum(m["bytes"] for m in members)}
    return out


def present_sources():
    """The sources that exist right now. STORE is checked separately and refuses when absent."""
    return [s for s in SOURCES if os.path.isdir(s)]


def verify_by_reproduction(archive, expected, prove=False, tops=None):
    """⛔ `prove=True` corrupts ONE EXTRACTED member before hashing, so the caller can watch
    this function return False. A verifier that has never been seen to fail has only been
    seen to be quiet."""
    """⛔ THE ONLY CHECK THAT COUNTS. Extract what was just written and hash every
    member against the live file. Returns (ok, detail) and never raises past the caller."""
    tmp = tempfile.mkdtemp(prefix="selfmem-verify-")
    try:
        with tarfile.open(archive, "r:gz") as tf:
            tf.extractall(tmp)
        if prove:
            # ⛔ THE LIVE STORE AND THE REAL ARCHIVE ARE NEVER TOUCHED — only this throwaway
            #    extraction. Coltrane's equivalent learned that the hard way: its first
            #    --prove shared a filename with the real archive and DELETED it.
            victim = None
            for r, _d, fs in os.walk(tmp):
                for f in sorted(fs):
                    victim = os.path.join(r, f)
                    break
                if victim:
                    break
            if victim is None:
                return False, "PROVE: nothing was extracted, so nothing could be corrupted"
            with open(victim, "ab") as vh:
                vh.write(b"\x00")
        tops = tops or [os.path.basename(STORE)]
        got = {}
        for top in tops:
            root = os.path.join(tmp, top)
            if not os.path.isdir(root):
                return False, "archive does not contain the expected top-level directory %r" % top
            for r, _d, names in os.walk(root):
                for name in sorted(names):
                    p = os.path.join(r, name)
                    if os.path.isfile(p):
                        got[top + "/" + os.path.relpath(p, root).replace(os.sep, "/")] = sha(p)
        unexpected = sorted(set(os.listdir(tmp)) - set(tops))
        if unexpected:
            return False, "archive holds unexpected top-level entries %s" % unexpected
        missing = [n for n in expected if n not in got]
        extra = [n for n in got if n not in expected]
        mismatch = [n for n in expected if n in got and got[n] != expected[n]["sha256"]]
        if missing or extra or mismatch:
            return False, {"missing": missing, "extra": extra, "sha_mismatch": mismatch}
        return True, "%d/%d members reproduced with matching sha256" % (len(got), len(expected))
    except Exception as e:
        return False, "%s: %s" % (type(e).__name__, e)
    finally:
        shutil.rmtree(tmp, ignore_errors=True)


def write_manifest(archive, expected, verified, detail, snapshots):
    lines = []
    lines.append("# Langston self-memory store — backup manifest")
    lines.append("")
    lines.append("> **GENERATED:** " + utc() + "  ·  **written by** `langston-selfmemory-backup`")
    lines.append("> ⛔ **IF `GENERATED` IS OLD, THE BACKUP HAS STOPPED.** A quiet job and a dead job")
    lines.append("> look identical without this line. The job runs daily; a stamp older than about")
    lines.append("> two days means nobody has captured your store since then.")
    lines.append("")
    lines.append("**WHAT IS BACKED UP:** `" + STORE + "` — the decision store you built yourself — and `" + ARCHIVE + "`,")
    lines.append("every earlier version of your `MEMORY.md` that `langston-memory-write` replaced (" +
                 ("present" if os.path.isdir(ARCHIVE) else "not created yet — the writer has not overwritten anything") + ").")
    lines.append("The store:")
    lines.append("starting 2026-05-07. Entries carry the incident, a `Why:`, a `How to apply:` and")
    lines.append("`[[wiki-links]]`. This is a **copy for recovery**, not a second place to write:")
    lines.append("the live store above remains the only one you edit.")
    lines.append("")
    lines.append("**VERIFIED BY REPRODUCTION, NOT BY COMPARISON:** the archive is extracted after")
    lines.append("writing and every member's sha256 is compared against the live file. Comparing a")
    lines.append("listing instead has, on this project, certified an empty backup four times.")
    lines.append("")
    lines.append("| latest snapshot | " + os.path.basename(archive) + " |")
    lines.append("|---|---|")
    lines.append("| members captured | " + str(len(expected)) + " |")
    for top, info in per_source(expected).items():
        lines.append("| source `" + top + "` | " + ("present" if info["present"] else "**ABSENT**") + " — " +
                     str(info["members"]) + " members, " + str(info["bytes"]) + " B |")
    lines.append("| verification | " + ("PASSED — " if verified else "**FAILED** — ") + str(detail) + " |")
    lines.append("| snapshots retained | " + str(len(snapshots)) + " (newest first, cap " + str(KEEP) + ") |")
    lines.append("")
    lines.append("**RETAINED SNAPSHOTS**")
    for s in snapshots:
        lines.append("- `" + s + "`")
    lines.append("")
    lines.append("**MEMBERS IN THE LATEST SNAPSHOT** — name, bytes, sha256 (first 16)")
    lines.append("")
    lines.append("| file | bytes | sha256 |")
    lines.append("|---|---|---|")
    for name in sorted(expected):
        lines.append("| `%s` | %d | `%s` |" % (name, expected[name]["bytes"],
                                               expected[name]["sha256"][:16]))
    lines.append("")
    lines.append("⚠️ **RECOVERY IS A DELIBERATE, KYLE-AUTHORISED EVENT, NOT A ROUTINE ONE**")
    lines.append("(`CLAUDE.md` §7.1: a copy that can write upstream is not a backup, it is a second")
    lines.append("author). The archives live under `" + DEST + "`, which is root-owned — ask rather")
    lines.append("than reaching for them.")
    lines.append("")
    tmp = MANIFEST + ".tmp"
    os.makedirs(os.path.dirname(MANIFEST), exist_ok=True)
    with open(tmp, "w", encoding="utf-8") as fh:
        fh.write(NL.join(lines) + NL)
    os.replace(tmp, MANIFEST)
    _own(MANIFEST)


# ⛔⛔ ARGPARSE, NOT `in sys.argv`. The old form silently ignored every flag it did not
#    know and ran a normal backup, so `--prove` — and `--this-flag-does-not-exist` — both
#    exited 0 with a PASS-shaped result. A tool that answers a question you did not ask,
#    reassuringly, is worse than one that refuses.
KNOWN_FLAGS = ("--dry-run", "--prove")


def main():
    unknown = [a for a in sys.argv[1:] if a.startswith("-") and a not in KNOWN_FLAGS]
    if unknown:
        print("REFUSED: unrecognised flag(s): %s. Known: %s."
              % (", ".join(unknown), ", ".join(KNOWN_FLAGS)))
        print("  Refusing rather than ignoring them — an ignored flag returns a clean PASS")
        print("  for a run that did not do what was asked.")
        return 2
    dry = "--dry-run" in sys.argv
    prove = "--prove" in sys.argv
    if not os.path.isdir(STORE):
        print("REFUSED: store not found at " + STORE)
        return 2
    sources = present_sources()
    expected = live_files(sources)
    store_top = os.path.basename(STORE.rstrip("/")) + "/"
    if not any(k.startswith(store_top) for k in expected):
        # ⛔ AN EMPTY STORE IS NOT A SUCCESSFUL BACKUP OF NOTHING. Writing an empty
        #    archive and pruning an older good one on the strength of it is how a
        #    backup system destroys the thing it protects.
        print("REFUSED: the store is empty — refusing to snapshot it or prune anything.")
        return 2

    if dry:
        print("would capture %d members from %s" % (len(expected), ", ".join(sources)))
        for top, info in per_source(expected).items():
            print("   source %-18s %s  members %d  bytes %d" % (top, "present" if info["present"] else "ABSENT ", info["members"], info["bytes"]))
        for n in sorted(expected):
            print("   %-52s %7d B" % (n, expected[n]["bytes"]))
        return 0

    os.makedirs(DEST, exist_ok=True)
    stamp = datetime.datetime.now(datetime.timezone.utc).strftime("%Y%m%dT%H%M%SZ")
    # ⛔ A PROVE RUN NEVER SHARES A FILENAME WITH A REAL ARCHIVE (Coltrane's measured
    #    lesson: its first --prove overwrote and then deleted the real one).
    archive = os.path.join(DEST, ("PROVE-DISCARD-" if prove else "")
                           + "selfmemory-" + stamp + ".tar.gz")
    with tarfile.open(archive, "w:gz") as tf:
        for src in sources:
            tf.add(src, arcname=os.path.basename(src.rstrip("/")))

    # ⛔ RE-HASH AFTER THE TAR. `expected` was taken BEFORE the archive was written, so a
    #    write by Langston during those seconds surfaced as `sha_mismatch` — reported as a
    #    CORRUPTED BACKUP when the truth is a moving source. Two different events with two
    #    different responses, and conflating them would send someone hunting a corruption
    #    that never happened (Langston, Step-4 minor).
    after = live_files(sources)
    changed = sorted([n for n in expected
                      if n not in after or after[n]["sha256"] != expected[n]["sha256"]]
                     + [n for n in after if n not in expected])
    if changed:
        os.unlink(archive)
        print("STORE CHANGED MID-RUN — not a corruption. Files that moved: %s. "
              "The archive is discarded and every older snapshot is untouched; the next "
              "scheduled run will capture a quiet store." % ", ".join(changed[:5]))
        row = {"ts": utc(), "archive": None, "members": len(expected), "verified": False,
               "detail": {"store_changed_mid_run": changed},
               "retained": len([f for f in os.listdir(DEST) if f.startswith("selfmemory-")]),
               "pruned": [],
               "measures": "the source moved while being archived; this is NOT a verification failure",
               "population": "every regular file under " + ", ".join(sources) + ", recursively"}
        try:
            os.makedirs(os.path.dirname(RUNLOG), exist_ok=True)
            with open(RUNLOG, "a", encoding="utf-8") as fh:
                fh.write(json.dumps(row, ensure_ascii=False) + NL)
            _own(RUNLOG)
        except Exception:
            pass
        print(json.dumps(row, indent=2, ensure_ascii=False))
        return 1

    verified, detail = verify_by_reproduction(archive, expected, prove=prove,
                                              tops=[os.path.basename(x.rstrip("/")) for x in sources])

    if prove:
        # ⛔⛔ THE PROVE RUN'S PASS CONDITION IS THE VERIFIER SAYING **NO**. It never prunes,
        #    never writes a manifest, and always discards its own archive — the retention
        #    filter below matches `selfmemory-` and a prove archive is `PROVE-DISCARD-…`,
        #    so it is structurally outside retention as well as deleted here.
        try:
            os.unlink(archive)
        except OSError:
            pass
        if verified:
            print("⛔ PROVE FAILED: a deliberately corrupted extraction still verified as "
                  "%s. This checker does not discriminate — no PASS from it means anything "
                  "until this is fixed." % detail)
            return 3
        print("✅ PROVE OK: the corrupted extraction was REJECTED (%s), so a PASS from this "
              "verifier carries information." % detail)
        return 0

    snapshots = sorted([f for f in os.listdir(DEST) if f.startswith("selfmemory-")], reverse=True)
    pruned = []
    if verified:
        # ⚠️ PRUNE ONLY AFTER A PASS. Pruning first would, on a bad day, drop the last
        #    good copy to make room for a broken one.
        for old in snapshots[KEEP:]:
            try:
                os.unlink(os.path.join(DEST, old))
                pruned.append(old)
            except OSError:
                pass
        snapshots = sorted([f for f in os.listdir(DEST) if f.startswith("selfmemory-")], reverse=True)
    else:
        os.unlink(archive)      # a snapshot that failed verification is not kept
        print("VERIFICATION FAILED — archive discarded, older snapshots untouched:", detail)

    write_manifest(archive, expected, verified, detail, snapshots)

    row = {"ts": utc(), "archive": os.path.basename(archive) if verified else None,
           "members": len(expected), "sources": per_source(expected), "verified": verified, "detail": detail,
           "retained": len(snapshots), "pruned": pruned,
           "measures": ("a snapshot of the self-memory store, verified by EXTRACTING it and "
                        "hashing every member against the live file — not by comparing a listing; "
                        "the store is re-hashed after the tar so a concurrent write is reported "
                        "as a moving source, never as corruption"),
           "population": "every regular file under " + ", ".join(sources) + ", RECURSIVELY"}
    try:
        os.makedirs(os.path.dirname(RUNLOG), exist_ok=True)
        with open(RUNLOG, "a", encoding="utf-8") as fh:
            fh.write(json.dumps(row, ensure_ascii=False) + NL)
        _own(RUNLOG)
    except Exception:
        pass

    if not verified:
        try:
            subprocess.run(["/usr/local/bin/cc-send", "--sender", "Infra Claude", "--notify",
                            "--message", "⛔ LANGSTON SELF-MEMORY BACKUP FAILED VERIFICATION and the "
                            "archive was discarded — older snapshots are untouched, so nothing was "
                            "lost, but nothing new was captured either. Detail: " + str(detail)],
                           capture_output=True, timeout=120)
        except Exception:
            pass

    print(json.dumps({k: row[k] for k in ("ts", "archive", "members", "sources", "verified", "detail",
                                          "retained", "pruned")}, indent=2, ensure_ascii=False))
    return 0 if verified else 1


if __name__ == "__main__":
    sys.exit(main())
