#!/usr/bin/env python3
"""langston-privacy-check — once a day: can an account that is neither root nor langston read
the reviewer's private content? (B-LANGSTON-CONTEXT pre-audit §20.6 / §21.3.)

★ WHY IT EXISTS. Langston ruled the exposure a HAZARD on 2026-09-11, and on INDEPENDENCE, not
  confidentiality: Coltrane advises Kyle on the same work Langston reviews, so if it can read his
  store, his ledger or his session records, a "second opinion" can be an echo of his with nothing
  able to tell the difference. The fix is a handful of permission changes — and permissions drift.

⛔ HIS CONDITION, AND THE REASON THIS TOOL ATTEMPTS READS INSTEAD OF COMPARING MODE BITS:
   "a mode-bit comparison passes against an ACL grant." So every read target is opened, one byte,
   AS the reader account. Mode checks are kept as well, for the paths whose mode IS the fence.

⛔ TWO CONTROLS, BOTH REQUIRED, OR THE VERDICT IS "INSTRUMENT", NEVER "PASS":
   · the reader MUST be able to read its OWN memory folder — otherwise sudo, the account or the
     box is broken and every "refused" below means nothing;
   · the reader MUST be REFUSED Langston's OAuth token file — otherwise the reads are not running
     as the reader at all (root by mistake), and every "readable" below is a false alarm.

★ SAMPLING, AND WHY IT IS ENOUGH: one tool-output file and one corpus file are attempted, not all of
  them. That is sufficient only because `750` on /home/langston and on /opt/langston-memory is the
  fence — both are checked directly below. If either directory opens, the samples stop being enough,
  and the directory finding says so first.

Exit codes are DISJOINT FROM PYTHON'S OWN (Langston Step-4 BLOCKER-2): an uncaught exception exits 1,
and this unit treats 1 as a correct EXPOSED run — so entry() turns ANY exception into 2.
  0 PASS · 1 EXPOSED (an alert is armed and delivered; a CORRECT run) · 2 INSTRUMENT (a control failed,
  a target is missing, an alert could not be delivered, or the tool crashed — cannot tell) · 3 refused.
"""
import datetime, grp, json, os, pwd, shlex, shutil, stat, subprocess, sys, tempfile, traceback

READER = "coltrane"
OWNER = "langston"
CONTROL_READABLE = "/home/coltrane/memory"
CONTROL_REFUSED = "/etc/langston/oauth.env"
LANGSTON_HOME = "/home/langston"
SESSIONS = LANGSTON_HOME + "/.claude/projects/-home-langston"
STORE = SESSIONS + "/memory"
MEMDIR = "/opt/langston-memory"
INDEX = MEMDIR + "/index/records.jsonl"
LIVE_MEMORY = LANGSTON_HOME + "/MEMORY.md"
STALE_LOG = "/var/log/langston-queue-forensics.log"
RUNLOG = MEMDIR + "/usage/privacy-check.jsonl"
STATEFILE = MEMDIR + "/usage/privacy-check-state.json"
STAGING_CMD = "cd /home/deploy/dawntrader && npm run --silent system-alerts --"
ACTOR = "langston-privacy-check"      # a MACHINE actor (condition 3): a root timer must not claim a session
KEY_EXPOSED = "langston-privacy-exposed"
KEY_INSTRUMENT = "langston-privacy-instrument"
SHARED_LINES = 10          # >= this many distinct >=40-char lines shared with the live file = a copy
MIN_LINE = 40
NL = chr(10)

KNOWN_FLAGS = ("--self-test", "--dry-run", "--status")


def utc():
    return datetime.datetime.now(datetime.timezone.utc)


def _refuse_unknown_flags():
    unknown = [a for a in sys.argv[1:] if a.startswith("-") and a not in KNOWN_FLAGS]
    if unknown:
        sys.stderr.write("REFUSED: unrecognised flag(s): %s. Known: %s.%s"
                         % (", ".join(unknown), ", ".join(KNOWN_FLAGS), NL))
        return True
    return False


def first_file_under(root, must_contain):
    """The first regular file whose directory path contains `must_contain`, or None."""
    for dp, dirs, files in os.walk(root):
        dirs.sort()
        if must_contain in dp + "/":
            for f in sorted(files):
                p = os.path.join(dp, f)
                if os.path.isfile(p):
                    return p
    return None


def scan_roots():
    """/tmp plus root's own temp directory: the writers use mkstemp, which follows TMPDIR."""
    return sorted(set(["/tmp", tempfile.gettempdir()]))


def live_config():
    fixed = [LIVE_MEMORY, LANGSTON_HOME + "/CLAUDE.md", STORE + "/MEMORY.md", INDEX]
    tool_output = first_file_under(SESSIONS, "/tool-results/")
    corpus = first_file_under(MEMDIR + "/corpus", "/corpus/")
    # ⛔ BLOCKER-4: an absent target used to read as "not exposed", because a read of a missing path
    #    fails exactly like a refused one. Every target is checked for EXISTENCE first, as root.
    missing = [p for p in fixed if not os.path.exists(p)]
    missing += [label for label, p in (("a tool-output file under " + SESSIONS, tool_output),
                                       ("a corpus file under " + MEMDIR + "/corpus", corpus)) if not p]
    return {
        "reader": READER, "owner": OWNER,
        "control_readable": CONTROL_READABLE, "control_refused": CONTROL_REFUSED,
        "read_targets": [p for p in fixed if os.path.exists(p)] + [p for p in (tool_output, corpus) if p],
        "missing_targets": missing,
        "closed_dirs": [LANGSTON_HOME, MEMDIR],
        "private_files": [INDEX],
        "store_dir": STORE,
        "live_memory": LIVE_MEMORY,
        "scan_roots": scan_roots(),
        "not_world_writable": [STALE_LOG],
    }


def reads_as(user, path):
    """True if `user` can read one byte of `path` (a directory: list it). Nothing is printed.
    A timeout is RAISED, not swallowed: it is an instrument failure, and entry() maps it to 2."""
    if os.path.isdir(path):
        cmd = ["sudo", "-n", "-u", user, "ls", path]
    else:
        cmd = ["sudo", "-n", "-u", user, "head", "-c", "1", path]
    r = subprocess.run(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=30)
    return r.returncode == 0


def copies_in(roots, live_memory, reader):
    """Files anywhere under `roots` that share >= SHARED_LINES distinct long lines with the live file,
    and that the READER can read. ⛔ Condition 1: no depth limit, no size limit, and ownership-agnostic -
    a 0600 file owned by the reader is readable by it and was invisible to a world-readable filter.
    Every file root reads is content-matched; only the (rare) matches are then read as the reader.
    Every skip is COUNTED BY REASON, so a zero is published with its population."""
    with open(live_memory, encoding="utf-8", errors="replace") as fh:
        keys = set(l.strip() for l in fh if len(l.strip()) >= MIN_LINE)
    live_real = os.path.realpath(live_memory)
    pop = {"walked": 0, "text_scanned": 0, "skipped_binary": 0, "skipped_unreadable_by_root": 0,
           "skipped_not_regular": 0, "skipped_symlinked_dir": 0, "matched": 0,
           "matched_not_readable_by_reader": 0}
    found, seen = [], set()
    for root in roots:
        for dp, dirs, files in os.walk(root):
            # ⛔ FINDING-2: os.walk does not follow a symlinked directory, and it lands in `dirs`, not
            #    `files` - so a copy under one was neither scanned nor counted. It is COUNTED now; it is
            #    still not followed (following would let a link loop or leave the scan root).
            pop["skipped_symlinked_dir"] += sum(1 for d in dirs if os.path.islink(os.path.join(dp, d)))
            for f in files:
                p = os.path.join(dp, f)
                real = os.path.realpath(p)
                if real in seen:
                    continue
                seen.add(real)
                pop["walked"] += 1
                try:
                    st = os.lstat(p)
                except OSError:
                    pop["skipped_unreadable_by_root"] += 1
                    continue
                if not stat.S_ISREG(st.st_mode):
                    pop["skipped_not_regular"] += 1
                    continue
                if real == live_real:
                    continue
                try:
                    with open(p, "rb") as fh:
                        if b"\0" in fh.read(4096):
                            pop["skipped_binary"] += 1
                            continue
                        fh.seek(0)
                        shared = set()
                        for raw in fh:
                            line = raw.decode("utf-8", "replace").strip()
                            if line in keys:
                                shared.add(line)
                except OSError:
                    pop["skipped_unreadable_by_root"] += 1
                    continue
                pop["text_scanned"] += 1
                if len(shared) >= SHARED_LINES:
                    pop["matched"] += 1
                    if reads_as(reader, p):
                        found.append({"path": p, "shared_lines": len(shared)})
                    else:
                        pop["matched_not_readable_by_reader"] += 1
    return found, pop, len(keys)


def store_findings(store_dir, owner):
    """Condition 5: every store file owned by the owner and not group/other-writable. An unidentified
    past writer (a root-owned file) becomes a DETECTED future one instead of a shrug."""
    out = []
    uid = pwd.getpwnam(owner).pw_uid
    # ⛔ FINDING-1: the store DIRECTORY and its parent, not just the files - both measured 0775 on 2026-09-11.
    for d in (store_dir, os.path.dirname(store_dir.rstrip("/"))):
        dm = stat.S_IMODE(os.stat(d).st_mode)
        if dm & 0o022:
            out.append({"kind": "store-directory-group-or-other-writable", "path": d, "mode": oct(dm)})
    for f in sorted(os.listdir(store_dir)):
        p = os.path.join(store_dir, f)
        st = os.lstat(p)
        if not stat.S_ISREG(st.st_mode):
            continue
        if st.st_uid != uid:
            out.append({"kind": "store-file-not-owned-by-" + owner, "path": p,
                        "owner": pwd.getpwuid(st.st_uid).pw_name})
        if stat.S_IMODE(st.st_mode) & 0o022:
            out.append({"kind": "store-file-group-or-other-writable", "path": p,
                        "mode": oct(stat.S_IMODE(st.st_mode))})
    return out


def evaluate(cfg):
    """The whole decision, and nothing else. Returns a verdict and the findings behind it."""
    controls = {
        "reader_reads_own_folder": reads_as(cfg["reader"], cfg["control_readable"]),
        "reader_refused_token_file": not reads_as(cfg["reader"], cfg["control_refused"]),
    }
    if not all(controls.values()):
        return {"verdict": "INSTRUMENT", "reason": "a control failed", "controls": controls, "findings": []}
    findings = []
    for n in cfg.get("missing_targets", []):
        findings.append({"kind": "target-not-found", "path": n})
    for d in cfg["closed_dirs"]:
        if not os.path.exists(d):
            findings.append({"kind": "target-not-found", "path": d})
            continue
        mode = stat.S_IMODE(os.stat(d).st_mode)
        if mode & stat.S_IRWXO:
            findings.append({"kind": "directory-open-to-others", "path": d, "mode": oct(mode)})
        # ⛔ FINDING-1: a mode comparison is the thing this tool's docstring forbids - adding the reader to
        #    the owner's group would open everything while the other-bits still read 0. Attempt it.
        if reads_as(cfg["reader"], d):
            findings.append({"kind": "directory-listable-by-" + cfg["reader"], "path": d, "mode": oct(mode)})
    for p in cfg["read_targets"]:
        if reads_as(cfg["reader"], p):
            findings.append({"kind": "readable-by-" + cfg["reader"], "path": p})
    for f in cfg["private_files"]:
        if os.path.exists(f):
            mode = stat.S_IMODE(os.stat(f).st_mode)
            if mode & 0o077:
                findings.append({"kind": "file-not-0600", "path": f, "mode": oct(mode)})
    for f in cfg["not_world_writable"]:
        if os.path.exists(f) and stat.S_IMODE(os.stat(f).st_mode) & stat.S_IWOTH:
            findings.append({"kind": "world-writable", "path": f})
    if os.path.isdir(cfg["store_dir"]):
        findings.extend(store_findings(cfg["store_dir"], cfg["owner"]))
    else:
        findings.append({"kind": "target-not-found", "path": cfg["store_dir"]})
    copies, pop, keys = copies_in(cfg["scan_roots"], cfg["live_memory"], cfg["reader"])
    for c in copies:
        findings.append({"kind": "readable-copy-of-memory", "path": c["path"], "shared_lines": c["shared_lines"]})
    exposures = [f for f in findings if f["kind"] != "target-not-found"]
    if exposures:
        verdict, reason = "EXPOSED", ""
    elif findings:
        verdict, reason = "INSTRUMENT", "a target is missing, so its exposure cannot be measured"
    else:
        verdict, reason = "PASS", ""
    return {"verdict": verdict, "reason": reason, "controls": controls, "findings": findings,
            "scan": {"roots": cfg["scan_roots"], "live_lines": keys, "population": pop,
                     # ⛔ FINDING-3 (#661 leg 1): whole stripped lines are matched, so a copy stored ESCAPED
                     #    (a JSON prompt body, a transcript) cannot match. The zero means exactly this:
                     "claim": "no LINE-PRESERVING copy of the live MEMORY.md readable by the reader; "
                              "escaped copies (JSON bodies, transcripts) are outside this instrument's reach"}}


def _alerts(argv):
    inner = STAGING_CMD + " " + " ".join(shlex.quote(a) for a in argv)
    cmd = ["sudo", "-u", "langston", "ssh", "-o", "ConnectTimeout=25", "-o", "BatchMode=yes", "staging", inner]
    try:
        p = subprocess.run(cmd, capture_output=True, text=True, encoding="utf-8", errors="replace", timeout=180)
        return p.returncode, (p.stdout or ""), (p.stderr or "")
    except Exception as e:
        return 255, "", "%s: %s" % (type(e).__name__, e)


def load_state():
    try:
        with open(STATEFILE, encoding="utf-8") as fh:
            return json.load(fh)
    except Exception:
        return {}


def save_state(st):
    tmp = STATEFILE + ".tmp"
    with open(tmp, "w", encoding="utf-8") as fh:
        json.dump(st, fh, indent=2)
    os.replace(tmp, STATEFILE)


def next_runlog_line():
    try:
        with open(RUNLOG, encoding="utf-8") as fh:
            return sum(1 for _ in fh) + 1
    except OSError:
        return 1


def alert_is_live(alert_id):
    """(live, why). ⛔ BLOCKER-5 (Langston, #982): addAlert returns the EXISTING row on a dedupe hit
    whenever state != resolved - and acknowledged is not terminal. So an `add` after someone acked the
    alert hands back the silenced row's id, and "armed" would be a claim about a row nobody will see.
    Arm/resolve/delivered are claims about a row, so the row is read back."""
    rc, out, err = _alerts(["list", "--category", "health_check"])
    if rc != 0:
        return False, "read-back failed rc=%d %s" % (rc, (err or out)[:120])
    rows = [l for l in out.splitlines() if ("id=" + str(alert_id)) in l]
    if not rows:
        return False, "alert %s not found on read-back" % alert_id
    line = rows[0]
    if "(acked by" in line:
        return False, "alert %s is ACKNOWLEDGED - silenced; resolve it to free the key" % alert_id
    state = line.split()[0] if line.split() else ""
    if state not in ("active", "scheduled"):
        return False, "alert %s is in state %s" % (alert_id, state)
    return True, "live (%s)" % state


def reconcile_alerts(result, st):
    """Arm the alert matching the verdict; resolve the ones it discharges. Returns (notes, delivered).
    ⛔ BLOCKER-3: the alert IS the delivery. A failed arm or resolve makes the run INSTRUMENT (exit 2), so
       the unit's own OnFailure page carries what the alert could not."""
    notes, delivered = [], True
    evidence = "%s:%d" % (RUNLOG, next_runlog_line())
    wanted = {"EXPOSED": KEY_EXPOSED, "INSTRUMENT": KEY_INSTRUMENT}.get(result["verdict"])
    for key in (KEY_EXPOSED, KEY_INSTRUMENT):
        prev = st.get(key)
        if prev and key != wanted:
            rc, out, err = _alerts(["resolve", prev, "--by", ACTOR, "--evidence", evidence])
            blob = (out + " " + err).lower()
            if rc == 0 or "already" in blob or "not found" in blob:
                st.pop(key, None)
                notes.append("resolved %s" % prev)
            else:
                delivered = False
                notes.append("RESOLVE FAILED %s rc=%d %s" % (prev, rc, err[:120]))
    if wanted and not st.get(wanted):
        lines = ["%s %s%s" % (f["kind"], f["path"], (" " + f["mode"]) if f.get("mode") else "")
                 for f in result["findings"]][:12]
        if result["verdict"] == "EXPOSED":
            title = "Langston private content is readable by another account"
            body = ("The daily read-as-" + READER + " check found: " + "; ".join(lines) + ". "
                    "Langston ruled this a hazard to review independence (B-LANGSTON-CONTEXT pre-audit 21.3). "
                    "Owner CC-INFRA - re-close the path, then let the next run resolve this.")
        else:
            title = "Langston privacy check cannot measure the exposure"
            body = ("Reason: " + result.get("reason", "") + ". Controls: " + json.dumps(result["controls"])
                    + "; findings: " + "; ".join(lines) + ". Until this clears there is no instrument on "
                    "the exposure. Owner CC-INFRA.")
        rc, out, err = _alerts(["add", "--triggers-at", utc().strftime("%Y-%m-%dT%H:%M:%SZ"),
                                "--category", "health_check", "--severity", "warning",
                                "--dedupe-key", wanted, "--title", title, "--body", body])
        new_id, row = None, {}
        if rc == 0:
            try:
                row = json.loads(out)
                new_id = row.get("id")
            except Exception:
                new_id = None
        if new_id and row.get("acknowledged_at"):
            delivered = False
            notes.append("ARM RETURNED A SILENCED ROW %s (acknowledged_at %s)" % (new_id, row.get("acknowledged_at")))
        elif new_id:
            st[wanted] = new_id
            notes.append("armed %s" % new_id)
        else:
            delivered = False
            notes.append("ARM FAILED rc=%d %s" % (rc, (err or out)[:160]))
    # ⛔ BLOCKER-5, every run: the tracked alert for this verdict must still be LIVE - one that someone
    #    acknowledged since the last run is silenced, and silence is not delivery.
    if wanted and delivered and st.get(wanted):
        live, why = alert_is_live(st[wanted])
        notes.append("read-back: " + why)
        if not live:
            delivered = False
    save_state(st)
    return notes, delivered


def log_row(row):
    with open(RUNLOG, "a", encoding="utf-8") as fh:
        fh.write(json.dumps(row, ensure_ascii=False) + NL)


CODES = {"PASS": 0, "EXPOSED": 1}


def run_once(cfg, st, dry=False):
    """One evaluation, its alerts and its row. Returns (row, exit code)."""
    result = evaluate(cfg)
    row = {"ts": utc().strftime("%Y-%m-%dT%H:%M:%SZ"), "verdict": result["verdict"],
           "reason": result.get("reason", ""), "controls": result["controls"],
           "findings": result["findings"], "scan": result.get("scan"),
           "targets_attempted": len(cfg["read_targets"]),
           "sampling": "one tool-output and one corpus file; sufficient only while the closed_dirs are 750"}
    code = CODES.get(result["verdict"], 2)
    if dry:
        return row, code
    notes, delivered = reconcile_alerts(result, st)
    row["alerts"] = notes
    if not delivered:
        row["evaluated_verdict"] = row["verdict"]
        row["verdict"] = "INSTRUMENT"
        row["reason"] = "alert delivery failed"
        code = 2
    log_row(row)
    return row, code


def self_test():
    """⛔ DRIVES evaluate(), run_once() and entry() — the functions the daily run uses — against fixtures
    built to be EXPOSED and fixtures built to be CLOSED, as the real reader account. Alerts are faked;
    state and run log go to the fixture directory. Nothing on staging is touched."""
    global RUNLOG, STATEFILE, _alerts, main
    ok = True

    def check(name, got, want):
        nonlocal ok
        good = got == want
        ok = ok and good
        print("  %-4s %-66s expected %-10s got %s" % ("PASS" if good else "FAIL", name, want, got))

    real_runlog, real_state, real_alerts, real_main = RUNLOG, STATEFILE, _alerts, main
    top = tempfile.mkdtemp(prefix="langston-privacy-selftest-")
    reader_uid = pwd.getpwnam(READER).pw_uid
    owner_uid, owner_gid = pwd.getpwnam(OWNER).pw_uid, grp.getgrnam(OWNER).gr_gid
    try:
        os.chmod(top, 0o755)
        RUNLOG, STATEFILE = os.path.join(top, "run.jsonl"), os.path.join(top, "state.json")
        live = os.path.join(top, "live-MEMORY.md")
        with open(live, "w", encoding="utf-8") as fh:
            for i in range(12):
                fh.write("fixture ledger line %02d that is comfortably longer than forty chars\n" % i)
        os.chmod(live, 0o600)
        with open(live, encoding="utf-8") as fh:
            copy_text = fh.read()

        def make(rel, mode, content="x\n", uid=None, gid=None, dirmode=0o755):
            p = os.path.join(top, rel)
            d = os.path.dirname(p)
            os.makedirs(d, exist_ok=True)
            walk = d
            while walk.startswith(top) and walk != top:
                os.chmod(walk, dirmode)
                walk = os.path.dirname(walk)
            with open(p, "w", encoding="utf-8") as fh:
                fh.write(content)
            os.chmod(p, mode)
            if uid is not None:
                os.chown(p, uid, gid if gid is not None else -1)
            return p

        def mkdir(rel, mode):
            p = os.path.join(top, rel)
            os.makedirs(p, exist_ok=True)
            os.chmod(p, mode)
            return p

        base = {"reader": READER, "owner": OWNER, "control_readable": CONTROL_READABLE,
                "control_refused": CONTROL_REFUSED, "live_memory": live, "missing_targets": []}
        # EXPOSED: every finding kind, including the three condition-1 narrowings the first version had
        make("store-exposed/root-owned.md", 0o644)
        make("store-exposed/group-writable.md", 0o664, uid=owner_uid, gid=owner_gid)
        make("store-exposed/fine.md", 0o644, uid=owner_uid, gid=owner_gid)
        make("scan-exposed/a/b/c/deep-copy.md", 0o644, copy_text)                       # 4+ levels deep
        make("scan-exposed/reader-owned-copy.md", 0o600, copy_text, uid=reader_uid)     # 0600, reader's own
        make("scan-exposed/big-copy.md", 0o644, ("filler line\n" * 600000) + copy_text)  # > 5 MB
        make("scan-exposed/root-only-copy.md", 0o600, copy_text)                        # matched, unreachable
        with open(make("scan-exposed/binary.bin", 0o644), "wb") as fh:
            fh.write(b"\0\1\2" + copy_text.encode())
        exposed = dict(base, read_targets=[make("readable.md", 0o644)],
                       closed_dirs=[mkdir("open-dir", 0o755)],
                       private_files=[make("index-open.jsonl", 0o644)],
                       store_dir=os.path.join(top, "store-exposed"),
                       scan_roots=[os.path.join(top, "scan-exposed")],
                       not_world_writable=[make("stale.log", 0o666)])
        r1 = evaluate(exposed)
        kinds = [f["kind"] for f in r1["findings"]]
        paths = [f["path"] for f in r1["findings"] if f["kind"] == "readable-copy-of-memory"]
        pop = r1["scan"]["population"]
        check("EXPOSED fixture -> verdict", r1["verdict"], "EXPOSED")
        check("  a 644 file is flagged readable by the reader", ("readable-by-" + READER) in kinds, True)
        check("  a 755 directory is flagged open", "directory-open-to-others" in kinds, True)
        check("  a 644 index is flagged not-0600", "file-not-0600" in kinds, True)
        check("  a 666 log is flagged world-writable", "world-writable" in kinds, True)
        check("  a root-owned store file is flagged (condition 5)", ("store-file-not-owned-by-" + OWNER) in kinds, True)
        check("  a 664 store file is flagged (condition 5)", "store-file-group-or-other-writable" in kinds, True)
        check("  the owner's own 644 store file is NOT flagged", any(p.endswith("fine.md") for p in
              [f["path"] for f in r1["findings"]]), False)
        check("  a copy 4 levels deep is found (condition 1)", any(p.endswith("deep-copy.md") for p in paths), True)
        check("  a 0600 copy OWNED BY THE READER is found (condition 1)", any(p.endswith("reader-owned-copy.md") for p in paths), True)
        check("  a copy over 5 MB is found (condition 1)", any(p.endswith("big-copy.md") for p in paths), True)
        check("  a root-only copy is matched but NOT flagged", any(p.endswith("root-only-copy.md") for p in paths), False)
        check("  ...and is counted as matched-not-readable", pop["matched_not_readable_by_reader"], 1)
        check("  a binary file is skipped and counted", pop["skipped_binary"], 1)

        closed = dict(base, read_targets=[make("private.md", 0o600)],
                      closed_dirs=[mkdir("closed-dir", 0o750)],
                      private_files=[make("index-closed.jsonl", 0o600)],
                      store_dir=mkdir("store-closed", 0o755),
                      scan_roots=[mkdir("scan-closed", 0o755)],
                      not_world_writable=[make("quiet.log", 0o644)])
        make("store-closed/fine.md", 0o644, uid=owner_uid, gid=owner_gid)
        make("scan-closed/unrelated.md", 0o644, "nothing shared here\n")
        r2 = evaluate(closed)
        check("CLOSED fixture -> verdict", r2["verdict"], "PASS")
        check("  and it has no findings at all", len(r2["findings"]), 0)

        broken = dict(closed, control_refused=exposed["read_targets"][0])
        check("a control that cannot fail -> INSTRUMENT, never PASS", evaluate(broken)["verdict"], "INSTRUMENT")
        gone = dict(closed, missing_targets=["/nonexistent/records.jsonl"])
        check("BLOCKER-4: a missing target -> INSTRUMENT, not PASS", evaluate(gone)["verdict"], "INSTRUMENT")

        # FINDING-1: a directory whose other-bits are 0 but that the reader can list through its GROUP
        reader_gid = pwd.getpwnam(READER).pw_gid
        group_dir = mkdir("group-open-dir", 0o750)
        os.chown(group_dir, 0, reader_gid)
        store_open = mkdir("store-open-dir", 0o775)
        make("store-open-dir/fine.md", 0o644, uid=owner_uid, gid=owner_gid)
        os.chmod(store_open, 0o775)   # make() resets every parent to 0755; re-open the directory under test
        fence = dict(closed, closed_dirs=[group_dir], store_dir=store_open)
        rf = evaluate(fence)
        fk = [f["kind"] for f in rf["findings"]]
        check("FINDING-1: other-bits 0 but listable via GROUP -> flagged", ("directory-listable-by-" + READER) in fk, True)
        check("  ...and the mode-bit check alone would have missed it", "directory-open-to-others" in fk, False)
        check("FINDING-1: a 0775 store directory is flagged", "store-directory-group-or-other-writable" in fk, True)
        # FINDING-2: a symlinked directory holding a copy is COUNTED, not silently skipped
        outside = mkdir("outside-scan", 0o755)
        make("outside-scan/copy-behind-link.md", 0o644, copy_text)
        linkroot = mkdir("scan-with-link", 0o755)
        os.symlink(outside, os.path.join(linkroot, "linked-dir"))
        rl = evaluate(dict(closed, scan_roots=[linkroot]))
        check("FINDING-2: a symlinked directory is counted", rl["scan"]["population"]["skipped_symlinked_dir"], 1)
        check("FINDING-3: the scan publishes its reach", "LINE-PRESERVING" in rl["scan"]["claim"], True)
        # BLOCKER-5: an add that returns an ACKNOWLEDGED row, and a tracked alert acked since the last run
        acked_row = json.dumps({"id": "fixture-acked", "acknowledged_at": "2026-09-11T00:00:00Z"})
        _alerts = lambda argv: (0, acked_row, "") if argv[0] == "add" else (0, "", "")
        row, code = run_once(exposed, {})
        check("BLOCKER-5: add returns a SILENCED row -> exit", code, 2)
        listing = "acknowledged  [warning ] health_check       triggers_at=x id=fixture-tracked  t (acked by kyle at y)"
        _alerts = lambda argv: (0, listing, "") if argv[0] == "list" else (0, "{}", "")
        row, code = run_once(exposed, {KEY_EXPOSED: "fixture-tracked"})
        check("BLOCKER-5: tracked alert acked since last run -> exit", code, 2)
        live_listing = "active        [warning ] health_check       triggers_at=x id=fixture-tracked  t"
        _alerts = lambda argv: (0, live_listing, "") if argv[0] == "list" else (0, "{}", "")
        row, code = run_once(exposed, {KEY_EXPOSED: "fixture-tracked"})
        check("  control: tracked alert still active -> exit", code, 1)

        # BLOCKER-3: a delivery failure turns EXPOSED into INSTRUMENT / exit 2
        _alerts = lambda argv: (255, "", "ssh: connect to host staging: Connection timed out")
        row, code = run_once(exposed, {})
        check("BLOCKER-3: EXPOSED whose alert fails to arm -> exit", code, 2)
        check("  ...and the row says INSTRUMENT, keeping the evaluated verdict", (row["verdict"], row.get("evaluated_verdict")),
              ("INSTRUMENT", "EXPOSED"))
        _alerts = lambda argv: ((0, json.dumps({"id": "fixture-alert-id"}), "") if argv[0] == "add" else
                                (0, "active        [warning ] health_check       triggers_at=x id=fixture-alert-id  t", ""))
        row, code = run_once(exposed, {})
        check("  control: the same run with delivery working -> exit", code, 1)

        # BLOCKER-2: ANY exception becomes 2, never Python's own 1
        def boom():
            raise RuntimeError("fixture crash")
        main = boom
        check("BLOCKER-2: a crash inside main() -> entry() exit", entry(), 2)
    finally:
        RUNLOG, STATEFILE, _alerts, main = real_runlog, real_state, real_alerts, real_main
        shutil.rmtree(top, ignore_errors=True)
    print("self-test %s" % ("PASSED" if ok else "FAILED"))
    return 0 if ok else 1


def main():
    if _refuse_unknown_flags():
        return 3
    if os.geteuid() != 0:
        print("REFUSED: run as root - the reads are attempted through sudo -u " + READER + ".")
        return 3
    if "--self-test" in sys.argv:
        return self_test()
    if "--status" in sys.argv:
        try:
            with open(RUNLOG, encoding="utf-8") as fh:
                print(fh.readlines()[-1].strip())
            return 0
        except (OSError, IndexError):
            print("no run recorded yet at " + RUNLOG)
            return 2
    cfg = live_config()
    if "--dry-run" in sys.argv:
        row, code = run_once(cfg, {}, dry=True)
        print(json.dumps(row, indent=2))
        return code
    row, code = run_once(cfg, load_state())
    print("%s: %d finding(s); controls %s; alerts: %s%s"
          % (row["verdict"], len(row["findings"]), row["controls"], "; ".join(row.get("alerts", [])) or "none",
             (" (" + row["reason"] + ")") if row.get("reason") else ""))
    return code


def entry():
    """⛔ BLOCKER-2: exit codes disjoint from Python's own. An uncaught exception would exit 1, which the
    unit treats as a correct EXPOSED run - so OnFailure would never page and nothing would be armed."""
    try:
        return main()
    except SystemExit:
        raise
    except BaseException:
        traceback.print_exc()
        return 2


if __name__ == "__main__":
    sys.exit(entry())
