#!/usr/bin/env python3
"""P-5 — the size/staleness watch over Langston's always-loaded set, and the
instrument that makes the #1007 ratchet bind instead of being decoration.

⛔⛔ WHY THIS EXISTS, AND IT IS NOT A HYPOTHETICAL. Item 2 of the 2026-08-05
   Langston plan CONTAINED a daily size watch. It was never started. That is
   precisely why his MEMORY.md grew +137% in 28 days with nobody noticing — the
   alarm was itself the unfinished item. A ceiling nobody measures is a number
   in a document, and this project has paid for that shape repeatedly.

★ THE RULE IT ENFORCES (Langston 2026-09-05, Kyle approved same day, #1007):
    the CEILING is the SUM of everything auto-loaded per invoke, and it may
    ONLY EVER DECREASE. Any batch touching any of the three leaves the total at
    or below the value it found.

⛔ THE UNIT IS THE SUM, NEVER THE FILE — and that is load-bearing, not style. A
   per-file cap is satisfiable by SPLITTING a file while the loaded total is
   unchanged; Langston rejected a per-file number for exactly that reason.

⛔⛔ IT DOES NOT RATCHET AUTOMATICALLY, AND THAT IS A DELIBERATE DESIGN CHOICE.
   An automatic ratchet-down on any observed dip would lock in a TRANSIENT — a
   file caught mid-edit, a truncated write — and the next legitimate restore
   would then read as a breach. So: the watch OBSERVES, RECORDS and ALARMS. The
   ceiling is lowered DELIBERATELY, by whoever lands a trim, as part of that
   batch — which is where Langston's rule puts the obligation ("stated in the
   governance ledger") rather than in a background job's judgement.

★ MONOTONICITY IS ENFORCED, NOT REMEMBERED: `--set-ceiling` REFUSES to raise the
  value. Per CLAUDE.md §29's standing preference — prefer IMPOSSIBLE over
  INTERCEPTED — a raise fails at the tool, not at somebody's discipline.

⛔ THE LIVE VALUE LIVES HERE, IN A STATE FILE, AND NOWHERE ELSE. A ratchet
   ratchets, so the number changes by design; governance text names this FILE,
   never the number. Measured cost of ignoring that rule: the Langston-model
   line was wrong for 17 days, and PHASE_19_PLAN row 2.8 carried a false
   34,605 B for weeks with an argument built on top of it.

USAGE:
    langston-size-watch                 measure, record a run row, alarm on breach
    langston-size-watch --quiet         same, but never post to Discord (for testing)
    langston-size-watch --status        print state and exit; records nothing
    langston-size-watch --set-ceiling N --by <actor>
                                        lower the ceiling to N. REFUSES to raise, refuses a
                                        value already below the current total, and refuses a
                                        --by outside the actor allowlist.
    langston-size-watch --self-test     positive control: prove it CAN alarm
    langston-size-watch --fire-drill    prove the alarm can REACH a human — injects a breach
                                        and really posts, labelled as a drill, and adds + resolves one
                                        DRILL alert row under its own key. Does NOT
                                        touch the heartbeat.
"""

import hashlib, json, os, re, shlex, stat, subprocess, sys, datetime

HOME = "/home/langston"
WATCHED = [
    (os.path.join(HOME, "CLAUDE.md"), "harness auto-load (persona+rules)"),
    (os.path.join(HOME, "MEMORY.md"), "@MEMORY.md import from CLAUDE.md"),
    (os.path.join(HOME, ".claude/projects/-home-langston/memory/MEMORY.md"), "harness auto-memory index"),
]
# ⭐ THE WRITER'S ARCHIVE (B-LANGSTON-CONTEXT P-6b, Langston's answer 1). Every MEMORY.md version that
#    langston-memory-write replaced lives here, and nothing prunes it: it is the only copy of removed content, and the
#    one safe deletion predicate ("this content survives in a committed artifact") cannot be proved today.
#    ⛔ IT IS NOT AUTO-LOADED, SO IT NEVER ENTERS THE RATCHET'S SUM. It is watched for DISK, against a named threshold.
#    THRESHOLD: 500 MiB. Langston measured ~69 KB per overwrite and ~100 MB a year at four whole-file syncs a day,
#    against 44 GB free - so crossing it means roughly five years of normal use, or something writing far too often.
#    OWNER: CC-INFRA (Infra Claude). Crossing it is an alarm to LOOK, never an order to prune.
ARCHIVE_DIR = os.path.join(HOME, ".memory-archive")
ARCHIVE_THRESHOLD_BYTES = 500 * 1024 * 1024
ARCHIVE_OWNER = "CC-INFRA"
# ⛔ STATE DIR (B-LANGSTON-RELIEF, Kyle-approved 2026-10-19): this tool runs as ROOT, so its state and logs live in
#    /opt/langston-memory/state (root:root 0755, files 0644) - readable by langston, writable only by root. They used
#    to live in usage/, which langston owns and can write, and were handed to langston after each write; a root
#    process should not write into a directory a less-trusted account controls. The parent is root:langston 0750,
#    so only root can create or replace state/. Coltrane's tools were already laid out this way (/opt/coltrane-memory).
STATE = "/opt/langston-memory/state/ratchet-state.json"
RUNLOG = "/opt/langston-memory/state/size-watch.jsonl"
SENDER = "Infra Claude"
NL = chr(10)
STALE_HOURS = 48

# ⛔⛔ THE HEARTBEAT — LANGSTON, STEP-4 POINT (2), AND HE NAMED THE RIGHT RESIDUAL.
#    My worry was that the ceiling only falls when someone remembers to lower it.
#    That is SLACK: the rule still binds directionally, a late trim is not a breach.
#    ★ THE ONE THAT ACTUALLY BITES IS THAT THE WATCH ATTESTS ITS OWN LIVENESS.
#    `gap_h` can only be computed on a run that HAPPENS, so a disabled or erroring
#    unit reports nothing, forever, and the ratchet quietly has no instrument —
#    which is the 2026-08-05 failure this whole tool exists to answer, rebuilt one
#    level up. A watchdog that can only bark while it is alive is not a watchdog.
# ⇒ EVERY SUCCESSFUL RUN RESOLVES THE PENDING ALERT AND ARMS THE NEXT ONE 26h OUT.
#    If tomorrow's run happens it resolves in time; if it does NOT, the alert fires
#    on staging and re-surfaces on the dispatcher's widening back-off until a human
#    acts. ★ The absence of a run becomes the event, and the thing that notices is
#    NOT this process. Same shape as B-STAGING-LIVENESS-WATCH, same dedupe-key
#    discipline so an outage produces ONE alert rather than one per missed day.
HEARTBEAT_KEY = "langston-size-watch-heartbeat"
HEARTBEAT_HOURS = 26        # the daily timer plus slack for RandomizedDelaySec
STAGING_CMD = "cd /home/deploy/dawntrader && npm run --silent system-alerts --"

# ⭐ B-SIZE-WATCH-BREACH-ALARM (#1215, 2026-11-13). Until this, a breach was a Discord post and nothing else: no alert
#    row ever had a breach as its subject, so the per-turn alert read every session does never saw one (55 breach runs
#    in the retained logs, none a row). Each condition below now keeps ONE row under its OWN key (Langston C-2: a shared
#    key would keep showing the first event's title), and the id is saved the moment the add returns (C-3).
# ⛔ THE ADD RUNS ON EVERY RUN WHILE THE CONDITION HOLDS (Langston r1 BLOCKER-2). addAlert returns the existing row
#    unchanged on a dedupe hit (server/services/system-alerts.ts, the dedupe block in addAlert) and a RESOLVED same-key
#    row does not block a fresh one, so: open row -> no-op; a row someone resolved by hand while the breach lasts ->
#    re-minted; a lost state file -> healed. "Skip the add while an id is stored" latched the alarm OFF.
# ⛔ A RESOLVE NEEDS POSITIVE EVIDENCE OF THE CLEAN STATE (Langston C-1). measure() leaves a missing file OUT of the
#    total, so "total <= ceiling" can be true with his rules file gone. Each condition resolves only on its own clean
#    predicate; a run that cannot establish it resolves nothing.
# ⛔ A ROW'S BODY IS FROZEN AT MINT (Langston, Step-2 condition). While a breach lasts every add returns the day-one
#    row, so every body states WHEN it measured and WHERE the live number is. The Discord post carries today's number.
CONDITION_ALERTS = {
    "breach": ("breach_alert_id", "langston-size-watch-breach"),
    "missing": ("missing_alert_id", "langston-size-watch-missing-file"),
    "archive": ("archive_alert_id", "langston-size-watch-archive"),
    "tamper": ("rules_tamper_alert_id", "langston-rules-tamper"),
    "guard_cli": ("guard_cli_alert_id", "langston-index-guard-cli-mismatch"),
    "guard_tool": ("guard_tool_alert_id", "langston-index-guard-unenumerated-tool"),
    "guard_unestablished": ("guard_unestablished_alert_id", "langston-index-guard-could-not-establish"),
    "guard_blind": ("guard_blind_alert_id", "langston-index-guard-reader-blind"),
}
# ⭐ THE INDEX GUARD'S READER (B-LANGSTON-CLAUDEMD-RESIDUAL, Langston Step-4 R-3: a new counter needs a reader).
#    langston-index-guard refuses a growing save to his auto-memory index that would put the set over the ceiling. It
#    was enumerated against ONE Claude Code version, and it refuses any tool it was not enumerated for. Two conditions:
#    guard_cli  - the installed CLI version differs from the guard's CLI_VERSION_ENUMERATED. Read DIRECTLY (both files),
#                 so a bump is seen on a day with no index save. NEVER auto-resolved, not even on a match (Langston,
#                 re-review (a)): a match is exactly what a lazy bump produces - one constant edited, the checklist not
#                 run - so the resolve is by hand, carrying the checklist evidence in --evidence (the #447 shape).
#    guard_tool - a NEW log row since the last run refused a tool as unenumerated. An event: never auto-resolved.
#    guard_unestablished - a NEW refused row of the fail-closed class (the guard could not establish a size or the
#                 ratchet). Refusals are PARTITIONED BY MESSAGE CLASS (re-review (b)): an OVER refusal is the guard
#                 working and raises nothing; every other refusal that is not unenumerated lands here, so no refusal
#                 class is invisible. Never auto-resolved.
#    guard_blind - THIS READER could not read one of its own inputs: the guard's CLI_VERSION_ENUMERATED (the source-text
#                 parse below), the installed CLI version (package.json), or the guard log. Without it the three rows
#                 above go silent forever, and a CLI bump - the event guard_cli exists for - is the likeliest thing to
#                 move package.json (Langston, R-3 C-2). Resolves on the first run that reads all three.
#    Both are NOT ESTABLISHED (nothing raised, nothing resolved) while the guard is not installed.
GUARD_PATH = "/opt/langston-memory/bin/langston-index-guard"
GUARD_LOG = "/var/log/langston-index-guard.jsonl"
CLI_PACKAGE = "/usr/lib/node_modules/@anthropic-ai/claude-code/package.json"
UNENUMERATED_MARK = "not a tool this guard was enumerated for"
OVER_MARK = "OVER its ceiling"


def refusal_class(msg):
    """unenumerated | over | unestablished - every refused row lands in exactly one class."""
    if UNENUMERATED_MARK in msg:
        return "unenumerated"
    if OVER_MARK in msg:
        return "over"
    return "unestablished"
DRILL_KEY = "langston-size-watch-breach-drill"   # a drill NEVER touches a real key (Langston ruling (b))
EPISODE_CAP = 100                                # breach episodes kept in state; the run log keeps every run
LIVE_READ = "langston-size-watch --status on Helsinki, or its run log " + RUNLOG


def utc():
    return datetime.datetime.now(datetime.timezone.utc)


def iso(dt=None):
    return (dt or utc()).strftime("%Y-%m-%dT%H:%M:%SZ")


def measure():
    """⛔ A MISSING FILE IS NOT ZERO BYTES, IT IS A DIFFERENT AND WORSE EVENT.
    Summing it as 0 would show the total FALLING and read as a successful trim —
    the ratchet would then congratulate us for losing his rules."""
    files, total, missing = [], 0, []
    for path, why in WATCHED:
        try:
            st = os.stat(path)
            files.append({"path": path, "why": why, "bytes": st.st_size,
                          "mtime": iso(datetime.datetime.fromtimestamp(st.st_mtime,
                                                                       datetime.timezone.utc))})
            total += st.st_size
        except OSError as e:
            files.append({"path": path, "why": why, "bytes": None, "error": str(e)})
            missing.append(path)
    return files, total, missing


def measure_archive():
    """The writer's archive, measured. ABSENT is its own state (the writer has not overwritten anything yet), never
    "0 B and fine" - and an unreadable file is counted and named rather than silently skipped."""
    if not os.path.isdir(ARCHIVE_DIR):
        return {"path": ARCHIVE_DIR, "present": False, "bytes": 0, "files": 0, "unreadable": []}
    total, count, unreadable = 0, 0, []
    for root, _dirs, names in os.walk(ARCHIVE_DIR):
        for name in names:
            p = os.path.join(root, name)
            try:
                total += os.lstat(p).st_size
                count += 1
            except OSError:
                unreadable.append(p)
    return {"path": ARCHIVE_DIR, "present": True, "bytes": total, "files": count, "unreadable": unreadable}


def load_state():
    try:
        with open(STATE, encoding="utf-8") as fh:
            return json.load(fh)
    except Exception:
        return None


def save_state(st):
    # the file list is persisted so langston-memory-write's growth gate can refuse when ITS list disagrees -
    # a fourth loaded file must not drift into one program and not the other (Langston, 2026-10-17)
    st["watched"] = [p for p, _w in WATCHED]
    os.makedirs(os.path.dirname(STATE), exist_ok=True)
    tmp = STATE + ".tmp"
    with open(tmp, "w", encoding="utf-8") as fh:
        json.dump(st, fh, indent=2)
    os.replace(tmp, STATE)


def post(msg, quiet):
    """Discord is best-effort; a failed post must never make the watch fail. But it IS
    recorded in the run row, so a silent delivery failure is visible in the log rather
    than being indistinguishable from 'nothing was wrong'."""
    if quiet:
        return "suppressed (--quiet)"
    try:
        p = subprocess.run(["/usr/local/bin/cc-send", "--sender", SENDER, "--notify",
                            "--message", msg],
                           capture_output=True, text=True, encoding="utf-8",
                           errors="replace", timeout=120)
        return "sent" if p.returncode == 0 else "FAILED rc=%d %s" % (p.returncode, (p.stderr or "")[:200])
    except Exception as e:
        return "FAILED %s: %s" % (type(e).__name__, e)


def _alerts(argv):
    """Run the staging alert CLI as langston over his IP-restricted key. Returns
    (rc, stdout, stderr). NEVER raises — the caller records the outcome in the run row."""
    # ⛔⛔ BLOCKER-3 (Langston, Step-4 r2) — AND HE FOUND IT BY RUNNING THE ARTIFACT,
    #    NOT BY READING THIS LINE. The old form wrapped each argument in LITERAL single
    #    quotes. The alert body contains `Langston's`; that apostrophe CLOSED the quote,
    #    `s` concatenated, the remaining words became 27 stray positional arguments — and
    #    `#1007` opened a SHELL COMMENT that swallowed everything after it INCLUDING the
    #    unmatched trailing quote.
    # ★ SO THE COMMAND PARSED, rc=0 CAME BACK, THE TOOL PRINTED `armed <id>`, AND THE
    #   LIVE ROW CARRIED A 38-CHARACTER BODY: "The daily ratchet watch over Langstons".
    #   Not "THE WATCH IS DOWN", not #1007, not which timer to check, not the owner.
    # ⛔ Worse: whether it armed AT ALL was decided by the accident of a `#` in the body.
    #   He reproduced rc=2 on the same string with the `#` removed — without that comment
    #   it is a syntax error. A control whose success depends on a coincidence in its own
    #   payload is not a control.
    # ⇒ shlex.quote. This is my OWN standing lesson — never hand structured text to a
    #   shell — broken inside a tool whose entire job is to be readable at 05:20.
    inner = STAGING_CMD + " " + " ".join(shlex.quote(a) for a in argv)
    cmd = ["sudo", "-u", "langston", "ssh", "-o", "ConnectTimeout=25",
           "-o", "BatchMode=yes", "staging", inner]
    try:
        p = subprocess.run(cmd, capture_output=True, text=True, encoding="utf-8",
                           errors="replace", timeout=180)
        return p.returncode, (p.stdout or ""), (p.stderr or "")
    except Exception as e:
        return 255, "", "%s: %s" % (type(e).__name__, e)


def _not_found(rc, err, alert_id):
    """The ONE shape that means the row is gone: the CLI's own `Alert <id> not found` on stderr with exit 1
    (scripts/system-alerts.ts, cmdResolve). Langston, Step 4: the old test scanned stdout+stderr for "not found" or
    "no such", and a broken transport says exactly that ("cd: ... No such file or directory", "npm: command not
    found"), so a failed resolve read as discharged and the stored id was cleared with the row still open."""
    return rc == 1 and ("Alert %s not found" % alert_id) in [x.strip() for x in (err or "").splitlines()]


def heartbeat(st, status):
    # ⚠️ `status` was accepted and never used (Langston, r2 minor). An argument a function
    #    ignores is a claim about what it considers, so it is now IN the alert body: if the
    #    watch dies, the reader gets the last thing it saw before it went quiet.
    """Resolve the pending heartbeat, then arm the next. Returns a short outcome string
    that goes into the run row, so a heartbeat that quietly stops working is visible in
    the same place as everything else rather than being another silent absence."""
    notes = []
    # ⛔ EVIDENCE MUST BE A REFERENCE TOKEN, NOT PROSE — measured 2026-09-06: a sentence
    #    was REFUSED ("must be a reference token (path:line | sha | uuid | §/#ref)").
    # ★ AND THE RIGHT REFERENCE IS THE ROW THIS RUN IS ABOUT TO WRITE, so the evidence
    #    points at the artifact that discharges the alert rather than describing it.
    try:
        with open(RUNLOG, encoding="utf-8") as fh:
            next_line = sum(1 for _ in fh) + 1
    except Exception:
        next_line = 1
    evidence = "%s:%d" % (RUNLOG, next_line)

    prev = st.get("heartbeat_alert_id")
    if prev:
        rc, out, err = _alerts(["resolve", prev, "--by", "cc-infra", "--evidence", evidence])
        # ⛔ AN ALREADY-RESOLVED OR MISSING PRIOR IS A DISCHARGED PRIOR, NOT A FAILURE
        #    (Langston, r2 minor). A human resolving the row by hand is a NORMAL thing to
        #    do; treating it as a failure would latch the refuse-to-re-arm guard below and
        #    leave a hand-edit of the state file as the only exit — which is BLOCKER-1's
        #    shape, rebuilt in the fix for BLOCKER-1's sibling.
        # ⛔ Only the CLI's exact not-found shape is a discharge (_not_found). A re-resolve of a resolved row
        #    exits 0 in the real store, so there is no "already" case to catch.
        if rc != 0 and _not_found(rc, err, prev):
            notes.append("prior %s no longer exists - discharged" % prev)
            rc = 0
        else:
            notes.append("resolved %s" % prev if rc == 0
                         else "RESOLVE FAILED rc=%d %s" % (rc, err[:120]))
        # ⛔⛔ THE RESOLVE IS LOAD-BEARING, NOT TIDINESS. `--dedupe-key` makes the re-arm
        #    below collapse onto a STILL-OPEN alert of the same key — returning the old
        #    id AND THE OLD `triggers_at`. So a failed resolve does not merely leave a
        #    stale row: it means the heartbeat FIRES AT THE ORIGINAL TIME however many
        #    healthy runs follow, and the liveness alarm becomes a false positive that
        #    trains everyone to ignore it. Refusing to re-arm on a failed resolve keeps
        #    the failure visible instead of burying it under a spurious alert.
        if rc != 0:
            notes.append("re-arm SKIPPED — dedupe would collapse onto the unresolved alert")
            return "; ".join(notes)

    fire_at = (utc() + datetime.timedelta(hours=HEARTBEAT_HOURS)).strftime("%Y-%m-%dT%H:%M:%SZ")
    rc, out, err = _alerts([
        "add", "--triggers-at", fire_at, "--category", "health_check",
        "--severity", "warning", "--dedupe-key", HEARTBEAT_KEY,
        "--title", "Langston size watch has not run",
        # ⚠️ NO APOSTROPHE, deliberately — shlex.quote makes it safe, but this string's
        #    only job is to survive every transport between here and a human's phone.
        "--body", ("Last observed status before this alert was armed: " + str(status) + ". "
                   "The daily ratchet watch over the always-loaded files did not run "
                   "within " + str(HEARTBEAT_HOURS) + "h. Each successful run resolves this "
                   "and arms the next, so this alert firing MEANS THE WATCH IS DOWN and the "
                   "#1007 ceiling currently has no instrument. Check "
                   "langston-size-watch.timer on Helsinki. Owner CC-INFRA."),
    ])
    if rc == 0:
        try:
            new_id = json.loads(out).get("id")
            st["heartbeat_alert_id"] = new_id
            # ⛔ PERSIST IMMEDIATELY (Langston, r2 minor). This used to be written only at
            #    the END of run(), so a crash in that window left an alert armed on staging
            #    that this tool no longer knew about — and the next run would refuse to
            #    re-arm forever, exit-by-hand-edit. Same shape as BLOCKER-1.
            save_state(st)
            notes.append("armed %s for %s" % (new_id, fire_at))
        except Exception:
            notes.append("armed, but the id could not be parsed from the reply")
    else:
        notes.append("ARM FAILED rc=%d %s" % (rc, err[:120]))
    return "; ".join(notes)


def _runlog_ref():
    """The reference token a resolve cites: the run-log line THIS run is about to write (the heartbeat's form)."""
    try:
        with open(RUNLOG, encoding="utf-8") as fh:
            return "%s:%d" % (RUNLOG, sum(1 for _ in fh) + 1)
    except Exception:
        return "%s:1" % RUNLOG


def _alert_add(key, severity, title, body):
    """Add (or, on a dedupe hit, get back) the row under `key`. Returns (id, None) or (None, failure note)."""
    rc, out, err = _alerts(["add", "--triggers-at", iso(), "--category", "health_check",
                            "--severity", severity, "--dedupe-key", key, "--title", title, "--body", body])
    if rc != 0:
        return None, "ADD FAILED rc=%d %s" % (rc, err[:120])
    try:
        new_id = json.loads(out).get("id")
    except Exception:
        new_id = None
    if not new_id:
        return None, "added, but the id could not be parsed from the reply"
    return new_id, None


def _alert_resolve(alert_id, evidence):
    """Resolve one row. Returns (discharged, note). A row resolved by hand re-resolves with exit 0 in the real store;
    a row that no longer exists answers with the CLI's exact not-found shape. Anything else is a FAILURE, kept."""
    rc, out, err = _alerts(["resolve", alert_id, "--by", "cc-infra", "--evidence", evidence])
    if rc == 0:
        return True, "resolved %s" % alert_id
    if _not_found(rc, err, alert_id):
        return True, "%s no longer exists - discharged" % alert_id
    return False, "RESOLVE FAILED %s rc=%d %s" % (alert_id, rc, err[:120])


def condition_alert(st, name, active, clean, title, body, evidence):
    """One condition, one key, one stored id. Returns a short note for the run row."""
    field, key = CONDITION_ALERTS[name]
    prev = st.get(field)
    if active:
        new_id, failure = _alert_add(key, "warning", title, body)
        if not new_id:
            return failure          # the stored id (if any) is kept; the next run tries again
        st[field] = new_id
        save_state(st)              # C-3: persisted before anything else can fail
        return ("same %s" if new_id == prev else "new %s") % new_id
    if clean:
        if not prev:
            return "none"
        ok, note = _alert_resolve(prev, evidence)
        if ok:
            st[field] = None
            save_state(st)
        return note                 # a failed resolve keeps the id; the next clean run retries
    return ("not established - %s left as it is" % prev) if prev else "not established"


def update_episodes(st, status, over, total, ts):
    """OBJ-2: each breach episode survives the run log's rotation. A MISSING-FILE run changes nothing (its total is
    short by the missing file); only UNDER or AT-CEILING closes an episode (C-1's predicate). Returns a note when the
    cap drops an episode, so a truncated list is never read as the whole history (Langston ruling (g))."""
    eps = st.setdefault("breach_episodes", [])
    open_ep = eps[-1] if eps and eps[-1].get("end") is None else None
    if status == "BREACH":
        if open_ep is None:
            eps.append({"start": ts, "end": None, "peak_over": over, "peak_total": total})
        elif over > open_ep.get("peak_over", 0):
            open_ep["peak_over"], open_ep["peak_total"] = over, total
    elif status in ("UNDER", "AT-CEILING") and open_ep is not None:
        open_ep["end"] = ts
    if len(eps) > EPISODE_CAP:
        dropped = len(eps) - EPISODE_CAP
        del eps[:dropped]
        return ("dropped the %d oldest breach episode(s) at the cap of %d; the run log keeps every run"
                % (dropped, EPISODE_CAP))
    return None


def guard_check(st):
    """The index guard's two conditions. Returns {installed, enumerated, running, cli_established, mismatch,
    unenumerated (new rows), log_ok, offset_from, offset_to}. Reads the log from the byte offset the last run stored;
    a log shorter than that offset (rotated or replaced) is read from 0."""
    g = {"installed": os.path.exists(GUARD_PATH), "enumerated": None, "running": None, "cli_established": False,
         "mismatch": False, "unenumerated": [], "unestablished": [], "over": 0, "log_ok": False,
         "offset_from": None, "offset_to": None, "blind": []}
    if not g["installed"]:
        return g
    try:
        with open(GUARD_PATH, encoding="utf-8") as fh:
            mm = re.search(r'^CLI_VERSION_ENUMERATED = "([^"]+)"', fh.read(), re.M)
        g["enumerated"] = mm.group(1) if mm else None
        if not mm:
            g["blind"].append("CLI_VERSION_ENUMERATED not found in %s (the parse expects ^CLI_VERSION_ENUMERATED = \"x\")"
                              % GUARD_PATH)
    except OSError as e:
        g["blind"].append("%s unreadable (%s)" % (GUARD_PATH, type(e).__name__))
    try:
        with open(CLI_PACKAGE, encoding="utf-8") as fh:
            g["running"] = json.load(fh).get("version")
        if not g["running"]:
            g["blind"].append("%s has no version key" % CLI_PACKAGE)
    except (OSError, ValueError) as e:
        g["blind"].append("%s unreadable (%s)" % (CLI_PACKAGE, type(e).__name__))
    g["cli_established"] = bool(g["enumerated"] and g["running"])
    g["mismatch"] = g["cli_established"] and g["enumerated"] != g["running"]
    off = st.get("guard_log_offset") or 0
    try:
        size = os.path.getsize(GUARD_LOG)
        if size < off:
            off = 0
        with open(GUARD_LOG, "rb") as fh:
            fh.seek(off)
            data = fh.read()
        # the offset stops at the LAST NEWLINE (Langston R-3 fold-in 1): a row still being written is read whole next
        # run instead of being consumed half-read; a complete line that does not parse is reported, never skipped
        cut = data.rfind(NL.encode())
        data = data[:cut + 1] if cut >= 0 else b""
        g["offset_from"], g["offset_to"] = off, off + len(data)
        bad = 0
        for line in data.decode("utf-8", "replace").split(NL):
            if not line.strip():
                continue
            try:
                r = json.loads(line)
            except ValueError:
                bad += 1
                continue
            if r.get("verdict") != "refused":
                continue
            cls = refusal_class(r.get("message") or "")
            if cls == "over":
                g["over"] += 1
            else:
                g[cls].append({"ts": r.get("ts"), "tool": r.get("tool"), "cli_running": r.get("cli_running"),
                               "message": (r.get("message") or "")[:160]})
        g["log_ok"] = True
        if bad:
            g["blind"].append("%d line(s) of %s from byte %d do not parse as JSON" % (bad, GUARD_LOG, off))
    except FileNotFoundError:
        g["log_ok"] = True          # installed but never written: no rows is a measured zero, the file is created on install
        g["offset_from"] = g["offset_to"] = 0
    except OSError as e:
        g["blind"].append("%s unreadable (%s)" % (GUARD_LOG, type(e).__name__))
    return g


def tamper_established(rules):
    """The tamper check's own assertions (1)-(2) actually ran: an install record was read, and lsattr answered.
    Assertion (3)'s network failure is NOT part of this - it says nothing about tampering."""
    return rules.get("record") is not None and not any("lsattr" in u for u in rules.get("unknown") or [])


def drill_alert():
    """Ruling (b): a drill proves the add and resolve path under its OWN key, never the real one. Returns (ok, row)."""
    new_id, failure = _alert_add(DRILL_KEY, "info", "DRILL - Langston size watch alarm path (not a real breach)",
                                 "A fire drill of the size watch's alert path, run by hand by CC-INFRA. Nothing is "
                                 "wrong with Langston's files. It is resolved by the same run that made it.")
    if not new_id:
        return False, {"id": None, "add": failure, "resolve": "not attempted"}
    ok, note = _alert_resolve(new_id, new_id)
    return ok, {"id": new_id, "add": "ok", "resolve": note}


# ⭐ HIS RULES FILE'S INSTALL CHECK (B-LANGSTON-CLAUDEMD-RESIDUAL; Langston r1 on 9384b919a). The file is installed only
#    by langston-rules-install, root:root 0644 and immutable. Prevention cannot see a crash between clearing and
#    re-setting the flag, a flag that silently did not take, or a reviewed commit that was never installed - so this
#    compares the live file against the ROOT-ONLY install record every day. THREE ASSERTIONS, REPORTED SEPARATELY:
#    (1) the live bytes match the record; (2) it is a regular root:root 0644 file with the immutable flag - (1) and
#    (2) are TAMPER and page; (3) the record matches the rules file at GitHub's branch head - PENDING, which is benign
#    and frequent (a reviewed edit not yet installed) and is reported in the row only, never paged: folding it into
#    the tamper page would train the reader to ignore the page.
RULES_TARGET = os.path.join(HOME, "CLAUDE.md")
RULES_RECORD = "/root/langston-rules-backup/INSTALLED"
RULES_REPO_PATH = "comms-infra/langston/LANGSTON_CLAUDE.md"
RULES_MIRROR = "/srv/dawntrader-backup.git"
RULES_UPSTREAM = "https://github.com/kylegjordan/DawnTraderV3.git"
# ⛔ The mirror is langston-writable, so the branch-head comparison reads through the INSTALLER'S verified walk (every
#    object on commit -> trees -> blob re-hashed; Langston r2 B-3) - one function, imported, never a second copy.
RULES_INSTALLER = "/usr/local/sbin/langston-rules-install"


def _installer(path=None):
    import importlib.machinery, importlib.util
    ld = importlib.machinery.SourceFileLoader("langston_rules_install", path or RULES_INSTALLER)
    spec = importlib.util.spec_from_loader("langston_rules_install", ld)
    mod = importlib.util.module_from_spec(spec)
    sys.dont_write_bytecode = True
    ld.exec_module(mod)
    return mod


def rules_check(target=None, record=None, mirror=None, upstream=None, installer=None):
    target, record = target or RULES_TARGET, record or RULES_RECORD
    mirror, upstream = mirror or RULES_MIRROR, upstream or RULES_UPSTREAM
    out = {"target": target, "record": None, "tamper": [], "pending": None, "unknown": []}
    try:
        with open(record, encoding="utf-8") as fh:
            rec = json.load(fh)
    except FileNotFoundError:
        out["unknown"].append("no install record (%s): the rules file has not been installed by langston-rules-install"
                              % record)
        return out
    except Exception as e:
        out["unknown"].append("the install record %s is unreadable (%s)" % (record, type(e).__name__))
        return out
    out["record"] = {k: rec.get(k) for k in ("commit", "blob", "sha256", "installed_at")}
    try:
        fd = os.open(target, os.O_RDONLY | os.O_NOFOLLOW)
    except FileNotFoundError:
        out["tamper"].append("%s does not exist" % target)
    except OSError as e:
        out["tamper"].append("%s cannot be opened without following a link (%s)" % (target, type(e).__name__))
    else:
        try:
            st = os.fstat(fd)
            chunks = []
            while True:
                c = os.read(fd, 1 << 20)
                if not c:
                    break
                chunks.append(c)
        finally:
            os.close(fd)
        if not stat.S_ISREG(st.st_mode):
            out["tamper"].append("%s is not a regular file" % target)
        if hashlib.sha256(b"".join(chunks)).hexdigest() != rec.get("sha256"):
            out["tamper"].append("its content differs from the installed commit %s" % str(rec.get("commit"))[:12])
        if (st.st_uid, st.st_gid, stat.S_IMODE(st.st_mode)) != (0, 0, 0o644):
            out["tamper"].append("it is %d:%d mode %o, not root:root 0644" % (st.st_uid, st.st_gid,
                                                                              stat.S_IMODE(st.st_mode)))
        # ⛔ GUARDED ON ITS OWN (Langston, Step 4): an exception here used to escape into run()'s catch-all, which
        #    REPLACES the whole result - a sha or mode mismatch already collected above was thrown away and reported
        #    as "not established".
        try:
            r = subprocess.run(["lsattr", "-d", target], capture_output=True, text=True)
            flags = r.stdout.split()[0] if r.returncode == 0 and r.stdout.split() else None
            why = r.stderr.strip()[:80] or r.returncode
        except Exception as e:
            flags, why = None, "%s: %s" % (type(e).__name__, str(e)[:80])
        if flags is None:
            out["unknown"].append("lsattr could not read its flags (%s)" % why)
        elif "i" not in flags:
            out["tamper"].append("its immutable flag is NOT set (lsattr %s)" % flags)
    try:
        inst = _installer(installer)
        head = inst.github_head(upstream)
        blob_id, _data = inst.verified_blob(mirror, head)
        if blob_id != rec.get("blob"):
            out["pending"] = ("a newer reviewed rules file (blob %s at GitHub head %s) is not installed; installed is %s"
                              % (blob_id[:12], head[:12], str(rec.get("commit"))[:12]))
    except Exception as e:
        out["unknown"].append("the branch-head comparison could not run (%s: %s)" % (type(e).__name__, str(e)[:120]))
    return out


def run(quiet=False, injected_total=None, injected_archive_bytes=None, drill_store=False):
    # ⛔ ONE timestamp for the whole run (Langston, Step 4): the run row, every alert body's "Measured", the breach
    #    episode and last_run_ts all carry it, so the stamp printed in an alert greps straight to its run-log row.
    run_ts = iso()
    files, total, missing = measure()
    if injected_total is not None:      # --self-test only; never reachable in a real run
        total = injected_total
    archive = measure_archive()
    if injected_archive_bytes is not None:   # --self-test only
        archive = dict(archive, bytes=injected_archive_bytes, present=True, injected=True)
    archive["threshold_bytes"] = ARCHIVE_THRESHOLD_BYTES
    archive["over"] = archive["bytes"] > ARCHIVE_THRESHOLD_BYTES
    st = load_state()

    if st is None:
        # ⛔⛔ BLOCKER-1 (Langston, Step-4). SEEDING IS REFUSED WHILE ANY FILE IS MISSING,
        #    and this is not defensive tidiness — it was a one-way trap.
        #    `measure()` deliberately does NOT count a missing file as zero, so `total`
        #    EXCLUDES it. Seeding on that short total saves a ceiling below the true set;
        #    status correctly reads MISSING-FILE, but the number is already poisoned. And
        #    `--set-ceiling` REFUSES TO RAISE — by design — so the ratchet would sit in
        #    permanent BREACH with the only exit being a hand-edit of the state file.
        # ★ THAT DEFEATS THE EXACT PROPERTY THE TOOL IS BUILT ON: a monotonicity you can
        #    only escape by editing state by hand is intercepted, not impossible.
        if missing:
            print(json.dumps({"ts": iso(), "status": "SEED-REFUSED",
                              "reason": "cannot seed a ceiling while files are missing",
                              "missing": missing,
                              "note": ("the total excludes missing files, so seeding here would "
                                       "lock in a short ceiling that can never be raised")},
                             indent=2, ensure_ascii=False))
            return 2
        # ⛔ FIRST RUN SEEDS AT WHAT IT FINDS. It cannot alarm on a value it has never
        #    seen, and pretending otherwise would make run one meaningless.
        st = {"ceiling_bytes": total, "set_at": iso(), "set_by": "first-run seed",
              "history": [{"ts": iso(), "ceiling": total, "by": "first-run seed"}]}
        save_state(st)

    ceiling = st["ceiling_bytes"]
    over = total - ceiling
    last = st.get("last_run_ts")
    gap_h = None
    if last:
        try:
            prev = datetime.datetime.strptime(last, "%Y-%m-%dT%H:%M:%SZ").replace(
                tzinfo=datetime.timezone.utc)
            gap_h = round((utc() - prev).total_seconds() / 3600.0, 1)
        except Exception:
            gap_h = None

    if missing:
        status = "MISSING-FILE"
    elif over > 0:
        status = "BREACH"
    elif over < 0:
        status = "UNDER"          # a trim landed; lowering the ceiling is a DELIBERATE act
    else:
        status = "AT-CEILING"

    alarm = None
    drill = injected_total is not None
    prefix = ("🧪 FIRE DRILL — THIS IS A TEST OF THE ALARM PATH, NOT A REAL BREACH. "
              "Nothing is wrong with Langston's files; ignore the numbers below. "
              "Posted deliberately by Infra Claude to prove the alarm can reach a human. "
              + NL + NL) if drill else ""

    if status == "MISSING-FILE":
        alarm = ("⛔ LANGSTON LOAD SET — A FILE IS MISSING, which is not the same as it being "
                 "small and is worse: " + ", ".join(missing) + ". Nothing he loads should ever "
                 "vanish. The byte total is meaningless until this is resolved.")
    elif status == "BREACH":
        alarm = ("⛔ LANGSTON LOAD SET IS OVER ITS CEILING by " + str(over) + " B. "
                 "Total " + str(total) + " B against a ceiling of " + str(ceiling) + " B "
                 "(set " + str(st.get("set_at")) + " by " + str(st.get("set_by")) + "). "
                 "The rule (#1007) is that the total may only ever DECREASE, so whatever "
                 "landed here has to be paid for by a trim in the same work — or the "
                 "ceiling was lowered and this addition was not accounted for. "
                 "Per file: " + "; ".join("%s=%s" % (os.path.basename(f["path"]), f["bytes"])
                                          for f in files) + ". "
                 "⛔ Do NOT raise the ceiling to make this go away — the tool refuses it.")
    elif gap_h is not None and gap_h > STALE_HOURS:
        alarm = ("⚠️ LANGSTON SIZE WATCH WAS DOWN — " + str(gap_h) + "h since its previous run, "
                 "against a daily schedule. It is running now and the current total is "
                 "compliant, but anything that happened in that window went unwatched.")

    delivery = post(prefix + alarm, quiet) if alarm else "no alarm"
    archive_delivery = "no alarm"
    if archive["over"] or archive["unreadable"]:
        archive_delivery = post(prefix + (
            "⚠️ LANGSTON MEMORY ARCHIVE (" + ARCHIVE_DIR + ") - " +
            ("OVER its watch threshold: " + str(archive["bytes"]) + " B across " + str(archive["files"]) +
             " files, threshold " + str(ARCHIVE_THRESHOLD_BYTES) + " B. " if archive["over"] else "") +
            (str(len(archive["unreadable"])) + " file(s) could not be measured. " if archive["unreadable"] else "") +
            "It is unbounded BY DESIGN - the only copy of every MEMORY.md the writer replaced - so this is a disk "
            "check, NOT an order to prune. Owner " + ARCHIVE_OWNER + ": read its index.jsonl for what is writing so "
            "often before deciding anything."), quiet)

    # ⛔ A SYNTHETIC ROW MUST SAY SO, IN THE ROW. The first fire drill wrote a row that
    #    was indistinguishable from a real breach — same status, same shape, a plausible
    #    total. A run log that cannot tell a drill from an event is a confidently wrong
    #    record, which is worse than no record: the next reader would investigate a
    #    breach that never happened, or dismiss a real one as "probably another test".
    # ⛔ THE HEARTBEAT RUNS BEFORE THE ROW IS BUILT, SO ONE RUN PRODUCES ONE ROW.
    #    It used to run after the write and append a second `heartbeat_followup` line —
    #    which meant a reader had to JOIN TWO ROWS to answer 'was this run healthy?',
    #    and any reader who didn't know that would see a clean row and a live watch
    #    while the liveness alert had silently failed to arm.
    # ⛔ A DRILL MUST NOT TOUCH IT: resolving a real pending alert on the strength of a
    #    synthetic total would re-arm liveness from a run that never measured anything.
    # a detector fault must not abort the run before the heartbeat re-arms (Langston r2 record item)
    try:
        rules = rules_check()
    except Exception as e:
        rules = {"target": RULES_TARGET, "record": None, "tamper": [], "pending": None,
                 "unknown": ["the rules check itself failed (%s: %s)" % (type(e).__name__, str(e)[:120])]}
    rules_delivery = "no alarm"
    if rules["tamper"]:
        rules_delivery = post(prefix + "⛔ LANGSTON'S RULES FILE (" + rules["target"] + ") DOES NOT MATCH ITS INSTALL: " +
                              "; ".join(rules["tamper"]) + ". It is installed only by langston-rules-install from a "
                              "reviewed commit, so this is a change nobody reviewed, or an install that died before it "
                              "re-protected the file. Owner " + ARCHIVE_OWNER + ": compare it with "
                              "/root/langston-rules-backup/ and re-install the recorded commit.", quiet)
    hb = heartbeat(st, status) if injected_total is None else "skipped (drill)"
    # ⚠️ A HEARTBEAT THAT STOPS WORKING IS ITSELF A SILENT ABSENCE, so it is loud.
    if "FAILED" in hb and not quiet:
        post("⚠️ LANGSTON SIZE WATCH RAN, BUT ITS HEARTBEAT COULD NOT BE RE-ARMED on "
             "staging: " + hb + ". The size check itself is fine (" + status + "); what is "
             "broken is the thing that would tell you if the watch STOPPED running.", quiet)

    # ⭐ B-SIZE-WATCH-BREACH-ALARM: one row per condition (see CONDITION_ALERTS). A drill touches none of them.
    alerts, episodes_note, drill_row, drill_ok, guard = {}, None, None, True, None
    if injected_total is None:
        ts, ev = run_ts, _runlog_ref()
        per_file = "; ".join("%s=%s" % (os.path.basename(f["path"]), f["bytes"]) for f in files)
        stamp = (" Measured " + ts + "; this row is NOT updated while the condition lasts - the live number is "
                 + LIVE_READ + ". Owner CC-INFRA.")
        alerts["missing"] = condition_alert(
            st, "missing", bool(missing), not missing,
            "A file Langston loads every invoke is missing",
            "Missing: " + ", ".join(missing) + ". A missing file is not a small one: the measured total leaves it "
            "out, so no size reading means anything until it is back. Restore it; this row resolves on the first "
            "daily run with no file missing." + stamp, ev)
        alerts["breach"] = condition_alert(
            st, "breach", status == "BREACH", status in ("UNDER", "AT-CEILING"),
            "Langston load set is over its size ceiling",
            "Total " + str(total) + " B against a ceiling of " + str(ceiling) + " B, over by " + str(over) +
            " B. Per file: " + per_file + ". Rule #1007: the total may only decrease, so the fix is a trim in the "
            "work that grew it - never a raise (the tool refuses one). This row resolves on the first daily run at "
            "or under the ceiling." + stamp, ev)
        alerts["archive"] = condition_alert(
            st, "archive", bool(archive["over"] or archive["unreadable"]),
            not archive["over"] and not archive["unreadable"],
            "Langston memory archive needs a look",
            ARCHIVE_DIR + ": " + str(archive["bytes"]) + " B across " + str(archive["files"]) + " files against a "
            "threshold of " + str(ARCHIVE_THRESHOLD_BYTES) + " B; " + str(len(archive["unreadable"])) + " file(s) "
            "could not be measured. It is unbounded by design (the only copy of every replaced MEMORY.md), so this "
            "is a disk check, NOT an order to prune: read its index.jsonl for what is writing so often. Resolves on "
            "the first run under the threshold with every file measured." + stamp, ev)
        alerts["tamper"] = condition_alert(
            st, "tamper", bool(rules["tamper"]), not rules["tamper"] and tamper_established(rules),
            "Langston rules file does not match its install",
            RULES_TARGET + ": " + "; ".join(rules["tamper"]) + ". It is installed only by langston-rules-install "
            "from a reviewed commit. Compare it with /root/langston-rules-backup/ and re-install the recorded "
            "commit. Resolves on the first run where the file matches its install record." + stamp, ev)
        guard = guard_check(st)
        alerts["guard_cli"] = condition_alert(
            st, "guard_cli", guard["mismatch"], False,
            "Langston index guard was enumerated for a different Claude Code version",
            "Installed Claude Code is " + str(guard["running"]) + "; " + GUARD_PATH + " was enumerated for " +
            str(guard["enumerated"]) + ". The guard still runs and still refuses unknown tools; what is unchecked is "
            "whether Write/Edit inputs or the path keys changed. Run the BUMP CHECKLIST at the top of the guard, then "
            "update CLI_VERSION_ENUMERATED through a reviewed commit. NOT auto-resolved, even once they match: "
            "resolve by hand with the checklist evidence (the commit that re-ran items 1-4) in --evidence."
            + stamp, ev)
        alerts["guard_tool"] = condition_alert(
            st, "guard_tool", bool(guard["unenumerated"]), False,
            "Langston index guard refused a tool it was not enumerated for",
            str(len(guard["unenumerated"])) + " refusal(s) since the last run, first " +
            json.dumps(guard["unenumerated"][:3]) + ", in " + GUARD_LOG + " (re-read it from byte " +
            str(guard["offset_from"]) + ": this row's body is frozen at first mint, later refusals are not in it). A tool aimed at his auto-memory index "
            "that the guard cannot size was refused, so a save he tried did not land. Run the bump checklist; add "
            "the tool to WRITERS only if its effect can be predicted. Resolve this row by hand: a quiet day says "
            "nothing about the tool." + stamp, ev)
        alerts["guard_unestablished"] = condition_alert(
            st, "guard_unestablished", bool(guard["unestablished"]), False,
            "Langston index guard refused a save it could not measure",
            str(len(guard["unestablished"])) + " fail-closed refusal(s) since the last run, first " +
            json.dumps(guard["unestablished"][:3]) + ", in " + GUARD_LOG + " (re-read it from byte " +
            str(guard["offset_from"]) + ": this row's body is frozen at first mint, later refusals are not in it). The guard could not establish the "
            "size or the loaded-set ratchet, so it refused a growing save to his auto-memory index: a save he tried "
            "did not land. Read the message; the usual cause is the ratchet state or a watched file. Resolve this "
            "row by hand once the cause is fixed." + stamp, ev)
        alerts["guard_blind"] = condition_alert(
            st, "guard_blind", guard["installed"] and bool(guard["blind"]), guard["installed"] and not guard["blind"],
            "Langston index guard's reader cannot read its own inputs",
            "langston-size-watch could not read: " + "; ".join(guard["blind"]) + ". Until it can, the guard's "
            "version-drift, unknown-tool and could-not-establish rows cannot fire. Restore the path or fix the parse; "
            "resolves on the first run that reads all three." + stamp, ev)
        # the offset moves only when no event is waiting on an add that failed - an unrecorded refusal is re-read
        recorded = all(not guard[k] or str(alerts[a]).startswith(("new ", "same "))
                       for k, a in (("unenumerated", "guard_tool"), ("unestablished", "guard_unestablished")))
        if guard["log_ok"] and recorded:
            st["guard_log_offset"] = guard["offset_to"]
        episodes_note = update_episodes(st, status, over, total, ts)
    elif drill_store:
        drill_ok, drill_row = drill_alert()

    row = {"ts": run_ts, "drill": drill, "status": status,
           "total_bytes": total, "ceiling_bytes": ceiling,
           "over_by": over, "files": files, "missing": missing,
           "hours_since_previous_run": gap_h, "alarm": bool(alarm), "delivery": delivery,
           "measures": ("SUM of the auto-loaded set vs the recorded ceiling. It observes and "
                        "alarms; it NEVER lowers the ceiling itself — that is a deliberate act "
                        "in the batch that lands the trim (#1007)."),
           "heartbeat": hb, "archive": archive, "archive_delivery": archive_delivery,
           "rules": rules, "rules_delivery": rules_delivery, "guard": guard,
           "alerts": alerts, "episodes_note": episodes_note, "drill_alert": drill_row,
           "population": "the three files in WATCHED, all of them, every run; plus the writer's archive, "
                         "measured separately and never added to the sum"}
    try:
        os.makedirs(os.path.dirname(RUNLOG), exist_ok=True)
        with open(RUNLOG, "a", encoding="utf-8") as fh:
            fh.write(json.dumps(row, ensure_ascii=False) + NL)
    except Exception:
        pass

    if injected_total is None:
        st["last_run_ts"] = row["ts"]
        st["last_total_bytes"] = total
        st["last_status"] = status
        save_state(st)

    print(json.dumps({k: row[k] for k in ("ts", "drill", "status", "total_bytes", "ceiling_bytes",
                                          "over_by", "hours_since_previous_run", "alarm", "heartbeat",
                                          "delivery", "archive", "rules", "alerts", "drill_alert")},
                     indent=2, ensure_ascii=False))
    if not drill_ok:
        return 3            # a drill whose own row did not resolve is a failed drill (ruling (b)), never a pass
    return 1 if (status in ("BREACH", "MISSING-FILE") or archive["over"] or archive["unreadable"]
                 or rules["tamper"] or (guard and (guard["mismatch"] or guard["unenumerated"]
                                                   or guard["unestablished"] or guard["blind"]))) else 0


# ⛔ THE ACTOR IS AN ALLOWLIST, NOT FREE TEXT. The old `SUDO_USER or "unknown"` was the
#    THIRD instance of that class in one week (#987, #656): a free-text actor produces a
#    history nobody can attribute.
# ⚠️ THIS IS A KNOWINGLY UNFENCED HAND-COPY, AND THE DERIVATION IS STATED SO A LATER
#    READER CAN CHECK IT RATHER THAN TRUST THE WORD "mirrors" (Langston, r3 minor 3).
#    `ALERT_ACTORS` in server/services/system-alerts.ts has NINE entries. This is the
#    same subset `B-DEPLOY-ACTOR-ALLOWLIST` used: tag !== 'machine' — i.e. the four
#    roster sessions plus the two humans — canonical values only, aliases NOT accepted.
#    The three machine actors are excluded because no timer sets this ceiling; a human
#    or a session does.
# ⛔ NOTHING SYNCS THE TWO. If `ALERT_ACTORS` gains a roster session this list will not
#    know, and the failure is a REFUSAL of a legitimate actor — loud, not silent, which
#    is why the copy is acceptable and the silence about it was not.
ACTORS = ("cc-a", "cc-b", "cc-c", "cc-infra", "kyle", "langston")


def set_ceiling(new, by):
    if by not in ACTORS:
        print("REFUSED: --by must be one of: " + ", ".join(ACTORS))
        print("A free-text actor produces a history nobody can attribute (#987, #656).")
        return 2
    st = load_state()
    if st is None:
        print("REFUSED: no state yet — run the watch once so a ceiling exists to lower.")
        return 2
    cur = st["ceiling_bytes"]
    if new >= cur:
        # ★ THE MONOTONICITY IS ENFORCED HERE, MECHANICALLY. A rule that can be broken by
        #   typing a bigger number is a habit; this is a refusal.
        print("REFUSED: the ceiling may only ever DECREASE. Current %d B, asked for %d B."
              % (cur, new))
        print("If a real addition is justified, it is paid for by a trim elsewhere in the "
              "same work — the total is what is capped, never any single file.")
        return 2
    files, total, missing = measure()
    # ⛔⛔ BLOCKER-4 (Langston, r3) — BLOCKER-1's ONE-WAY TRAP AT THE OTHER WRITER, and the
    #    tell was an unused variable sitting at the guard site: `missing` was bound here
    #    and never read.
    # ★ `measure()` deliberately excludes a missing file, so with one file gone the total
    #   is SHORT, a lower ceiling is accepted, and `--set-ceiling` then refuses to raise —
    #   permanent BREACH, exit by hand-editing state. `run()` guards exactly this and
    #   `set_ceiling()` did not, so the batch had one guarded writer and one unguarded.
    # ⛔ AND THE TRIGGER IS SCHEDULED WORK: `B-LANGSTON-LEDGER-SPLIT` (plan 2.8) MOVES
    #   these files, and lowering the ceiling is precisely what a trim batch does.
    if missing:
        print("REFUSED: cannot lower the ceiling while files are missing: "
              + ", ".join(missing))
        print("The measured total EXCLUDES a missing file, so any ceiling set now would be "
              "short — and this tool refuses to raise it again. Restore the file first.")
        return 2
    if total > new:
        print("REFUSED: %d B is below the CURRENT total of %d B — that would be a ceiling "
              "already breached on the day it was set." % (new, total))
        return 2
    st["history"].append({"ts": iso(), "ceiling": new, "by": by,
                          "from": cur, "measured_total": total})
    st["ceiling_bytes"], st["set_at"] = new, iso()
    st["set_by"] = by
    save_state(st)
    print("ceiling lowered %d B -> %d B (current total %d B)" % (cur, new, total))
    return 0


def self_test():
    """★ POSITIVE CONTROL. A watch that has never alarmed and a watch that CANNOT alarm
    look identical from outside, and only one of them is doing its job. This drives a
    synthetic overage through the real run path with delivery suppressed."""
    st = load_state()
    if st is None:
        print("no state yet — run the watch once first")
        return 2
    ceiling = st["ceiling_bytes"]
    print("positive control: injecting a synthetic total of ceiling+1 B (%d)" % (ceiling + 1))
    rc = run(quiet=True, injected_total=ceiling + 1)
    ok_breach = rc == 1
    print("  %s  synthetic overage produced a BREACH" % ("PASS" if ok_breach else "FAIL"))
    print("positive control: injecting ceiling-1 B (%d)" % (ceiling - 1))
    rc2 = run(quiet=True, injected_total=ceiling - 1)
    ok_under = rc2 == 0
    print("  %s  a value under the ceiling did NOT alarm" % ("PASS" if ok_under else "FAIL"))
    # the archive watch: its own positive control and its own negative control, with the load set UNDER the ceiling
    print("positive control: archive at threshold+1 B, load set under the ceiling")
    rc3 = run(quiet=True, injected_total=ceiling - 1, injected_archive_bytes=ARCHIVE_THRESHOLD_BYTES + 1)
    ok_arch = rc3 == 1
    print("  %s  an archive over its threshold alarms on its own" % ("PASS" if ok_arch else "FAIL"))
    rc4 = run(quiet=True, injected_total=ceiling - 1, injected_archive_bytes=ARCHIVE_THRESHOLD_BYTES)
    ok_arch_under = rc4 == 0
    print("  %s  an archive AT its threshold does not" % ("PASS" if ok_arch_under else "FAIL"))
    ok_under = ok_under and ok_arch and ok_arch_under
    print("⚠️  both rows are written to the run log with a synthetic total — they are "
          "labelled by their impossible-in-practice shape, and neither touched the state file.")
    return 0 if (ok_breach and ok_under) else 1


# ⛔⛔ AN UNRECOGNISED FLAG MUST REFUSE, NOT FALL THROUGH TO A REAL RUN (Langston, r7).
#    This file dispatches on `in sys.argv`, so ANY unknown flag was silently ignored and
#    the tool proceeded with its DEFAULT behaviour while the operator believed they had
#    asked for something else. Measured across this tool family: one wrote a real run-log
#    row, and the load canary spent THREE live `claude -p` invokes on a typo.
#    ⇒ the cost is not the wasted run — it is that the operator reads the output as the
#      answer to the question they asked.
KNOWN_FLAGS = ("--status", "--self-test", "--fire-drill", "--set-ceiling", "--by", "--quiet",)


def _refuse_unknown_flags():
    unknown = [a for a in sys.argv[1:] if a.startswith("-") and a not in KNOWN_FLAGS]
    if unknown:
        sys.stderr.write("REFUSED: unrecognised flag(s): %s. Known: %s.%s"
                         % (", ".join(unknown), ", ".join(KNOWN_FLAGS), chr(10)))
        sys.stderr.write("  Refusing rather than ignoring — an ignored flag runs the "
                         "DEFAULT action and returns its output as though it answered "
                         "the question you asked.%s" % chr(10))
        return True
    return False


def main():
    if _refuse_unknown_flags():
        return 2
    if "--status" in sys.argv:
        st = load_state()
        files, total, missing = measure()
        print(json.dumps({"state": st, "measured_total": total, "missing": missing,
                          "files": files, "archive": dict(measure_archive(), threshold_bytes=ARCHIVE_THRESHOLD_BYTES,
                                                          owner=ARCHIVE_OWNER, counted_in_total=False),
                          "guard": guard_check(dict(st or {}))},
                         indent=2, ensure_ascii=False))
        return 0
    if "--self-test" in sys.argv:
        return self_test()
    if "--fire-drill" in sys.argv:
        # ⛔ THE LAST LEG NEEDS ITS OWN PROOF. --self-test suppresses delivery, so it
        #    verifies the DECISION to alarm and says nothing about whether an alarm can
        #    actually reach a person. An instrument that detects perfectly and cannot
        #    reach anyone is indistinguishable, from outside, from one that never fired.
        #    This injects a breach and REALLY posts, labelled so nobody acts on it.
        st = load_state()
        if st is None:
            print("no state yet — run the watch once first")
            return 2
        print("FIRE DRILL — a real Discord post will be made, labelled as a drill, and one DRILL alert row "
              "is added and resolved under its own key (" + DRILL_KEY + "). No real alert key is touched.")
        rc = run(quiet=False, injected_total=st["ceiling_bytes"] + 4242, drill_store=True)
        return 0 if rc == 1 else 1
    if "--set-ceiling" in sys.argv:
        i = sys.argv.index("--set-ceiling")
        if i + 1 >= len(sys.argv) or not sys.argv[i + 1].isdigit():
            print("usage: --set-ceiling <bytes> --by <" + "|".join(ACTORS) + ">")
            return 2
        by = ""
        if "--by" in sys.argv:
            j = sys.argv.index("--by")
            by = sys.argv[j + 1] if j + 1 < len(sys.argv) else ""
        return set_ceiling(int(sys.argv[i + 1]), by)
    return run(quiet="--quiet" in sys.argv)


if __name__ == "__main__":
    # ⛔ A CRASH MUST NOT EXIT 1 (Langston, B-LANGSTON-CONTEXT Step-4 BLOCKER-2, class fix 2026-09-11).
    #    This tool's unit sets SuccessExitStatus=0 1 because 1 means "ran and found a breach" -
    #    and Python's own uncaught-exception exit is also 1, so a crash read as a correct breach
    #    day, OnFailure never paged, and nothing was armed. Any exception now exits 2.
    try:
        sys.exit(main())
    except SystemExit:
        raise
    except BaseException:
        import traceback
        traceback.print_exc()
        sys.exit(2)
