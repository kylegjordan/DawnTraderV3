#!/usr/bin/env python3
"""langston-memory-write — the ONE writer for Langston's memory file (B-LANGSTON-CONTEXT P-6b).

★ WHY IT EXISTS. Until now, sessions updated /home/langston/MEMORY.md by writing it to the fixed path
  /tmp/langston_memory.md, copying it to the same fixed path on the box, and `cp`-ing it over the live
  file (workflow-10-governance 10.b). Three defects, all measured (pre-audit §20.6, §21.3):
   · /tmp is 1777 and that path does not normally exist - any account can pre-create it, as a symlink
     (a root write to a path of its choosing) or as a file it owns (rewrite the bytes between the copy
     and the cp, i.e. inject text into every Langston invoke);
   · no compare-and-swap - two sessions writing in the same window silently lose one write;
   · no durable copy of what an overwrite removed - a removal with no copy is unrecoverable.

⛔ WHAT IT DOES, IN ORDER (Langston r7, pre-audit §20.2-§20.3):
   1. content arrives on STDIN - no file in a shared temp directory at any hop;
   2. flock on a lock file inside the target's own directory;
   3. COMPARE-AND-SWAP: the caller passes --expect-sha <sha256 OF THE BYTES IT READ AND EDITED>; under the lock
      the target is re-hashed and the write proceeds only on a match. ⛔ A sha taken fresh at write time
      defeats this entirely - it matches whoever wrote in between (Langston Step-4 BLOCKER-1).
   4. the OLD content goes to the archive as <sha256>.md, created EXCLUSIVELY, plus an append-only index row
      for the ATTEMPT - BEFORE anything is replaced;
   5. a temp file in the TARGET'S OWN DIRECTORY, fsynced, renamed into place - owner preserved, mode set OWNER-ONLY
      (group/other cleared; the archive was 700/600 while the primary output kept 644 - Langston, 18:37Z);
   6. TWO counters must move by exactly what the call declared, or the old content is restored:
       · RETRACTIONS - entries parsed by the reader (langston_memory.py), IMPORTED, never re-implemented (rule 4);
       · THE WHOLE REVIEWER LEDGER - column-0 '- ' bullets between the '## … REVIEWER LEDGER' heading and the
         next '## ' heading. The reader's parse stops at '### Rulings of mine that GENERALISE', so it covers one
         of the ledger's three subsections; deleting every GENERALISE ruling passed the first version with
         exit 0 (Langston Step-4 BLOCKER-2). This counter measures a DIFFERENT OBJECT; the reader is untouched.

⛔ OWNERSHIP (Langston Step-4 BLOCKER-3): every call in the recipe is ssh root, and Langston must still be able to
   run this afterwards. So when running as root, the lock, the archive directory, every archive file and the index
   are handed to the TARGET'S owner, and any unwritable one is a stated refusal, never a traceback.

⛔ --by IS RECORDED AS A CLAIM. Every session reaches this box as root (the dt-deploy precedent), so the
   observed identity cannot attribute a write to a session; the real uid is kept beside it as `via_uid`.

MODES
   whole file:     langston-memory-write --expect-sha SHA --ledger-delta L --retractions-delta R --by WHO --reason WHY < file
                   L = change in bullets across the whole REVIEWER LEDGER block; R = change in retraction entries.
   ledger append:  langston-memory-write --expect-sha SHA --ledger-append --entries N --by WHO --reason WHY < entries
                   both counters must move by exactly N. Rules for an appended entry (r7):
       (1) one entry = one '- ' at column 0; continuation lines indented, or led by '·';
       (2) no column-0 '#' anywhere in the appended text;
       (3) inserted immediately above '### Rulings of mine that GENERALISE' (exactly one required);
       (4) the counts after the write equal the counts before plus --entries.
                   ★ AFTER THE SPLIT (LEDGER.md exists) the append goes to LEDGER.md: --expect-sha is LEDGER.md's sha,
                   the entry is added at its end, and an absent LEDGER.md REFUSES - it is never recreated.
   split ledger:   langston-memory-write --split-ledger --expect-sha PART_SHA --by WHO --reason WHY < stub
                   ONE-TIME (B-LANGSTON-RELIEF OBJ-3): the '### Retractions' block moves verbatim to LEDGER.md, the
                   <=4096 B stub replaces it, the header recipe gains the new line, MEMORY.md is recomposed. Read-back is
                   set equality both ways on the reader's fingerprints; any mismatch restores everything.
   trim:           langston-memory-write --trim [--dry-run] --by WHO --reason WHY
                   (B-LANGSTON-RELIEF OBJ-3 Q3) moves every batch section whose LAST line is `STATE: closed · batch: ID
                   · superseded-by: PATH` verbatim to MEMORY-ARCHIVE.md, leaving an index line + its `keep: ` lines.
                   Refuses if any non-protected section has no STATE line. Run daily by langston-memory-trim.timer.
   self-test:      langston-memory-write --self-test          (only as the sole argument)

EXIT  0 written (or no change) · 2 refused input · 3 not root or langston · 4 compare-and-swap mismatch (nothing
      written; the message says whether the file changed OUTSIDE this tool) · 5 a declared count was wrong and the
      previous content was RESTORED · 6 a refusal about the environment, or an internal error (see stderr)
"""
import datetime, fcntl, hashlib, importlib.util, json, os, pwd, re, stat, subprocess, sys, tempfile, time, traceback

sys.dont_write_bytecode = True   # a root run must not leave a root-owned __pycache__ beside a langston-owned reader
# ⛔ GUARD (c) condition (Langston, 20:26Z): cache_from_source honours sys.pycache_prefix, so an env var
#    (PYTHONPYCACHEPREFIX) could relocate the loaded .pyc to a langston-owned tree the trust check never walked.
#    Pin it None so the checked cache path IS the loaded one by construction - the env var cannot move it.
#    ⚠️ HONEST REACH (Langston, 20:43Z, measured): this pin closes the READER leg only, not PYTHONPYCACHEPREFIX as
#    a class. With that env var set, the interpreter caches ~18 modules under the prefix at STARTUP, before this
#    line runs, and a header-matched planted .pyc among them executes. The only total closure is at the invocation
#    (python3 -E/-I, or nothing exporting it) - tracked as B-PYCACHE-PREFIX-INVOCATION. Premise holds today: no
#    PYTHON* var in any unit, /etc/environment or /etc/profile.d.
sys.pycache_prefix = None

OWNER = "langston"
LIVE_HOME = "/home/langston"
LANGSTON_HOME = os.environ.get("LANGSTON_HOME", LIVE_HOME)
TARGET = os.path.join(LANGSTON_HOME, "MEMORY.md")
ARCHIVE_DIR = os.path.join(LANGSTON_HOME, ".memory-archive")
ARCHIVE_INDEX = os.path.join(ARCHIVE_DIR, "index.jsonl")
LOCK = os.path.join(LANGSTON_HOME, ".memory-write.lock")
PARTS_DIR = os.path.join(LANGSTON_HOME, "memory-parts")          # P-2: the parts MEMORY.md is composed from
COMPOSE_STATE = os.path.join(ARCHIVE_DIR, "compose-state.json")  # in the backed-up, owner-only archive dir
STAMP_RE = re.compile(r"^<!-- composed .*-->$")
PART_FRONTMATTER_RE = re.compile(r"\A<!-- part\n.*?\n-->\n", re.DOTALL)   # optional leading obligations block
READER = os.environ.get("LANGSTON_MEMORY_READER", "/opt/langston-memory/bin/langston_memory.py")
ANCHOR = "### Rulings of mine that GENERALISE"
LEDGER_HEADING = re.compile(r"^## .*REVIEWER LEDGER")
KNOWN_FLAGS = ("--expect-sha", "--ledger-delta", "--retractions-delta", "--ledger-append", "--entries", "--by", "--reason", "--compose", "--part", "--rename-part", "--to", "--split-ledger", "--trim", "--dry-run", "--allow-growth")
VALUE_FLAGS = ("--expect-sha", "--ledger-delta", "--retractions-delta", "--entries", "--by", "--reason", "--part", "--rename-part", "--to", "--allow-growth")
NL = chr(10)


class Refused(Exception):
    def __init__(self, code, msg):
        super().__init__(msg)
        self.code = code


def utc():
    return datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def sha(b):
    return hashlib.sha256(b).hexdigest()


def parse_args(argv):
    """Refuse unknown and conflicting flags rather than ignore them - an ignored flag returns a clean result for a
    run that did not do what was asked (the class 91ec9a543 closed in the other tools)."""
    out, i = {}, 0
    while i < len(argv):
        a = argv[i]
        if a not in KNOWN_FLAGS:
            raise Refused(2, "REFUSED: unrecognised argument %r. Known: %s" % (a, ", ".join(KNOWN_FLAGS)))
        if a in VALUE_FLAGS:
            if i + 1 >= len(argv):
                raise Refused(2, "REFUSED: %s needs a value" % a)
            out[a] = argv[i + 1]
            i += 2
        else:
            out[a] = True
            i += 1
    if out.get("--ledger-append"):
        for bad in ("--ledger-delta", "--retractions-delta"):
            if bad in out:
                raise Refused(2, "REFUSED: %s does not apply to --ledger-append (both counters move by --entries)" % bad)
    elif "--entries" in out:
        raise Refused(2, "REFUSED: --entries applies only to --ledger-append; a whole-file write declares "
                         "--ledger-delta and --retractions-delta")
    if out.get("--trim"):
        for bad in ("--expect-sha", "--compose", "--ledger-append", "--ledger-delta", "--retractions-delta", "--entries",
                    "--part", "--rename-part", "--to", "--split-ledger"):
            if bad in out:
                raise Refused(2, "REFUSED: %s does not apply to --trim (it evicts every STATE: closed section under the "
                                 "lock and takes no content)" % bad)
    elif "--dry-run" in out:
        raise Refused(2, "REFUSED: --dry-run applies only to --trim")
    if out.get("--split-ledger"):
        for bad in ("--compose", "--ledger-append", "--ledger-delta", "--retractions-delta", "--entries", "--part",
                    "--rename-part", "--to"):
            if bad in out:
                raise Refused(2, "REFUSED: %s does not apply to --split-ledger (a one-time move of the Retractions block "
                                 "to LEDGER.md; the stub arrives on stdin)" % bad)
    if "--rename-part" in out or "--to" in out:
        if ("--rename-part" in out) != ("--to" in out):
            raise Refused(2, "REFUSED: --rename-part and --to must be given together (rename OLD --to NEW)")
        for bad in ("--compose", "--ledger-append", "--ledger-delta", "--retractions-delta", "--entries", "--part"):
            if bad in out:
                raise Refused(2, "REFUSED: %s does not apply to a rename (a rename moves a part's name, it writes no "
                                 "content and declares no ledger delta)" % bad)
    return out


def reader_trust_problems(path):
    """⛔ GUARD (c) (Langston, 20:09Z, widened): a ROOT-run write EXECUTES the reader, so everything that decides what
    runs must be root-controlled - root-owned and not group- or other-writable:
      · EVERY directory on the path, not the leaf: renaming an entry needs write on the PARENT, so a langston-owned
        parent swaps a root-owned bin wholesale (BLOCKER-1);
      · the path ACTUALLY loaded - READER after the env var - both as given and with symlinks resolved;
      · its bytecode cache: a header-matched .pyc runs IN PLACE OF clean source even with dont_write_bytecode, and no
        source hash sees it (proven 2026-09-11 on scratch files, reproduced by Langston).
    Returns a list of plain problems; empty means root may execute it. A missing file is not a problem here - the load
    itself refuses it."""
    problems, seen = [], set()

    def chain(q):
        q = os.path.abspath(q)
        out = []
        while True:
            out.append(q)
            parent = os.path.dirname(q)
            if parent == q:
                break
            q = parent
        return list(reversed(out))

    given, real = os.path.abspath(path), os.path.realpath(path)
    candidates = chain(given) + chain(real)
    for src in (given, real):
        cache = importlib.util.cache_from_source(src)
        # walk the cache DIRECTORY's whole chain, not just its parent - belt and brace beside the pin above, so the
        # guard's coverage does not silently depend on that pin surviving a later edit 350 lines away.
        candidates += chain(os.path.dirname(cache)) + [cache]
    for c in candidates:
        if c in seen:
            continue
        seen.add(c)
        try:
            st = os.lstat(c)
        except FileNotFoundError:
            continue
        if st.st_uid != 0:
            try:
                who = pwd.getpwuid(st.st_uid).pw_name
            except KeyError:
                who = "uid %d (no account)" % st.st_uid
            problems.append("%s is owned by %s" % (c, who))
        elif not stat.S_ISLNK(st.st_mode) and stat.S_IMODE(st.st_mode) & 0o022:
            problems.append("%s is group- or other-writable (mode %s)" % (c, oct(stat.S_IMODE(st.st_mode))))
    return problems


def load_reader():
    """Rule (4): the writer IMPORTS the reader's parser rather than re-implementing it."""
    if os.geteuid() == 0:
        problems = reader_trust_problems(READER)
        if problems:
            # Run as the OWNER, a reader the owner controls is not an escalation - so the guard is root-only.
            raise Refused(6, "REFUSED: this write runs as root and would EXECUTE the reader at %s, but root does not "
                             "control it: %s. Nothing was written. Every directory on its path, the file and its "
                             "__pycache__ must be root-owned and not group- or other-writable (comms-infra/systemd/"
                             "README.md, the langston-memory rows) - fix that and tell Infra Claude."
                             % (READER, "; ".join(problems)))
    spec = importlib.util.spec_from_file_location("langston_memory_reader", READER)
    if spec is None or spec.loader is None:
        raise Refused(6, "REFUSED: cannot load the reader at %s" % READER)
    mod = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(mod)
    return mod


def reader_requires_offsets(reader):
    """⛔ P-2 FAIL-FAST (B-LANGSTON-CONTEXT, after a fresh-reviewer catch 2026-09-13): the ledger guards' containment
    check needs a BYTE OFFSET per ledger entry. A reader that PREDATES the offset field returns entries without it, and
    the guard would then read a missing offset as -1 and refuse EVERY write as 'ledger corruption' (reproduced on the
    box with the installed reader: exit 5 '... at byte None'). Probe the reader on a synthetic 1-entry ledger and
    REFUSE UP FRONT, before any write, with a clear reader-version message - so no path writes bad-then-refuses and the
    failure never masquerades as corruption. Also guards against a future reader edit that drops the field."""
    probe = b"### Retractions\n- a probe entry, long enough to parse.\n"
    fd, p = tempfile.mkstemp(prefix=".reader-offset-probe-", suffix=".md")
    try:
        os.write(fd, probe)
        os.close(fd)
        fd = -1                                   # closed cleanly; the finally must not double-close
        status, entries = reader._parse_ledger(p)
        # ANY misbehaviour (non-ok status, no entries, non-dict entries, a crash) => not offset-capable. Catch it here
        # so a broken reader yields the clean version-mismatch refusal below, never a bare traceback (fresh-reviewer r2).
        ok = status == "ok" and bool(entries) and all(isinstance(e.get("offset"), int) for e in entries)
    except Exception:
        ok = False
    finally:
        if fd != -1:                              # os.write raised before the close - don't leak the descriptor (Langston nit)
            try:
                os.close(fd)
            except OSError:
                pass
        try:
            os.unlink(p)
        except OSError:
            pass
    if not ok:
        raise Refused(6, "REFUSED: the reader at %s does not emit a byte offset per ledger entry - it predates the "
                         "B-LANGSTON-CONTEXT P-2 offset field, which the ledger guards require. Install the matching "
                         "reader. This is a reader-version MISMATCH, not ledger corruption; nothing was written." % READER)
    # FINDING-3 (Langston Step-4, 2026-09-13): the guard's Q3 heading check reuses the reader's RETRACTIONS_HEADING_PATTERN.
    #   Gate it HERE too - a reader with offsets but no export (a hand edit, a partial install) would otherwise turn Q3
    #   off with NO signal (the guard defaults the pattern to None and skips). Never skip: refuse at the version gate.
    if not isinstance(getattr(reader, "RETRACTIONS_HEADING_PATTERN", None), str):
        raise Refused(6, "REFUSED: the reader at %s does not export RETRACTIONS_HEADING_PATTERN - the ledger guard's Q3 "
                         "single-heading check would silently skip. Install the matching P-2 reader. Reader-version "
                         "MISMATCH; nothing was written." % READER)


def retraction_count(reader, path):
    status, entries = reader._parse_ledger(path)
    if status == "unreadable":
        raise Refused(6, "REFUSED: the reader cannot read %s" % path)
    return len(entries) if status == "ok" else 0


def ledger_block_count(text):
    """Column-0 '- ' bullets between the ONE '## … REVIEWER LEDGER' heading and the next column-0 '## ' heading
    ('### ' subsections do not end it). No heading -> 0, so deleting the block shows up as a negative delta.
    More than one heading is ambiguous and refuses."""
    lines = text.split(NL)
    heads = [i for i, l in enumerate(lines) if LEDGER_HEADING.match(l)]
    if len(heads) > 1:
        raise Refused(2, "REFUSED: %d '## … REVIEWER LEDGER' headings - the ledger block is ambiguous" % len(heads))
    if not heads:
        return 0
    n = 0
    for l in lines[heads[0] + 1:]:
        if l.startswith("## "):
            break
        if l.startswith("- "):
            n += 1
    return n


def check_entry_text(text, declared):
    """Rules (1) and (2) on the appended text itself."""
    non_empty = [l for l in text.split(NL) if l.strip()]
    if not non_empty:
        raise Refused(2, "REFUSED: no entry text on stdin")
    if not non_empty[0].startswith("- "):
        raise Refused(2, "REFUSED (rule 1): an appended entry must start with '- ' at column 0")
    for l in non_empty:
        if l.startswith("#"):
            raise Refused(2, "REFUSED (rule 2): a column-0 '#' inside the ledger ends the section for the reader: %r" % l[:60])
        if not (l.startswith("- ") or l[0] in " \t" or l.startswith("·")):
            raise Refused(2, "REFUSED (rule 1): a continuation line must be indented or led by '·': %r" % l[:60])
    if declared < 1:
        raise Refused(2, "REFUSED: --entries must be at least 1 for --ledger-append")


def compose_append(current, entry_text):
    """Rule (3): insert immediately above the GENERALISE heading, which must appear exactly once."""
    marker = NL + ANCHOR
    n = current.count(marker)
    if n != 1:
        raise Refused(2, "REFUSED (rule 3): %r appears %d times in the target; append needs exactly one" % (ANCHOR, n))
    i = current.index(marker)
    before, after = current[:i], current[i + 1:]
    return before.rstrip(NL) + NL + entry_text.strip(NL) + NL + NL + after


def hand_to_owner(fd_or_path, st):
    """BLOCKER-3: when root, anything this tool creates belongs to the TARGET'S owner."""
    if os.geteuid() != 0:
        return
    if isinstance(fd_or_path, int):
        os.fchown(fd_or_path, st.st_uid, st.st_gid)
    else:
        os.chown(fd_or_path, st.st_uid, st.st_gid)


def open_lock(st):
    try:
        fd = os.open(LOCK, os.O_WRONLY | os.O_CREAT, 0o600)
    except OSError as e:
        raise Refused(6, "REFUSED: cannot open the lock %s (%s). It must be writable by root and %s - fix its "
                         "owner; never bypass the lock. Nothing was written." % (LOCK, type(e).__name__, OWNER))
    hand_to_owner(fd, st)
    return fd


def archive_old(old_bytes, old_sha, st):
    """Exclusive create, so an archived version can never be overwritten. If the same content was archived before,
    the existing file must hash to the same value - otherwise the archive is corrupt and we stop."""
    path = os.path.join(ARCHIVE_DIR, old_sha + ".md")
    try:
        if not os.path.isdir(ARCHIVE_DIR):
            os.makedirs(ARCHIVE_DIR, mode=0o750, exist_ok=True)
            hand_to_owner(ARCHIVE_DIR, st)
        try:
            fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
        except FileExistsError:
            with open(path, "rb") as fh:
                if sha(fh.read()) != old_sha:
                    raise Refused(6, "REFUSED: archive file %s exists and does not match its name - archive corrupt. "
                                     "Nothing was written." % path)
            return path, False
    except OSError as e:
        raise Refused(6, "REFUSED: cannot write the archive %s (%s). It must be writable by root and %s. Nothing "
                         "was written." % (ARCHIVE_DIR, type(e).__name__, OWNER))
    try:
        os.write(fd, old_bytes)
        os.fsync(fd)
        hand_to_owner(fd, st)
    finally:
        os.close(fd)
    return path, True


def append_index(row, st):
    try:
        fd = os.open(ARCHIVE_INDEX, os.O_WRONLY | os.O_CREAT | os.O_APPEND, 0o600)
    except OSError as e:
        raise Refused(6, "REFUSED: cannot append to the archive index %s (%s)" % (ARCHIVE_INDEX, type(e).__name__))
    try:
        os.write(fd, (json.dumps(row, ensure_ascii=False) + NL).encode("utf-8"))
        os.fsync(fd)
        hand_to_owner(fd, st)
    finally:
        os.close(fd)


UNREADABLE_INDEX = "unreadable"


def index_rows():
    """Every PARSEABLE object row of the index, in order, and how many non-blank lines would not parse. One bad line
    never hides the rest (Langston r1 C-1, 2026-10-17)."""
    rows, bad = [], 0
    with open(ARCHIVE_INDEX, encoding="utf-8", errors="replace") as fh:
        for l in fh:
            if not l.strip():
                continue
            try:
                r = json.loads(l)
            except ValueError:
                bad += 1
                continue
            if isinstance(r, dict):
                rows.append(r)
            else:
                bad += 1
    return rows, bad


def last_index_row():
    """The last row that records a WRITE; None when the index is absent or holds no write row and every line parsed;
    UNREADABLE_INDEX when no write row parsed but some line did not - that line may have been the write, so the
    cause is unknown, never "no recorded write" (Langston r2 C-4: a noop row beside a cut line). A `trim-noop`
    row is a pass-through that wrote nothing (Langston, Step 8 gate A, 2026-10-17: never a link in the sha chain), so
    it is skipped."""
    try:
        rows, bad = index_rows()
    except OSError:
        return None
    # a refused-growth row wrote nothing either (Langston, approving 3872c50a4): not a link in the sha chain
    writes = [r for r in rows if r.get("mode") != "trim-noop" and r.get("outcome") != "refused-growth"]
    if writes:
        return writes[-1]
    return UNREADABLE_INDEX if bad else None


def noop_rows_exist():
    """True if the index already holds a trim-noop ROW - by the row's own mode field, never a substring (a prior
    write with --reason trim-noop must not suppress the first row's note; Langston r1 C-2)."""
    try:
        rows, _bad = index_rows()
    except OSError:
        return False
    return any(r.get("mode") == "trim-noop" for r in rows)


def final_sha_of(row):
    """The sha the target held after the recorded call, or None when the record cannot say."""
    if not row:
        return None
    if row.get("outcome") in ("written", "no-change"):
        return row.get("new_sha")
    if row.get("outcome") == "restored" and row.get("restored_byte_identical"):
        return row.get("old_sha")
    return None


def cas_mismatch_message(live_sha):
    """Condition (Langston, answer 3): a hand edit must not look like a benign race."""
    last = last_index_row()
    try:
        _rows, bad = index_rows()
    except OSError:
        bad = 0
    base = "REFUSED: compare-and-swap mismatch - nothing written. current sha256 %s. " % live_sha
    # Langston r3 C-7: every branch is hedged when any index line is unreadable - append_index is O_APPEND + fsync, so
    # a torn record is most likely the LAST line, i.e. a write NEWER than the newest readable one.
    hedge = ("" if not bad else " ⚠️ %d line(s) of this tool's archive index could not be read; one may be a LATER "
             "write through this tool, so this verdict may be stale - tell Infra Claude." % bad)
    if last == UNREADABLE_INDEX:
        # C-6: say what was measured - lines DID parse when only noop rows remain readable
        return (base + "⚠️ No line recording a write through this tool can be read, and %d line(s) of its archive "
                "index could not be read, so whether the file changed outside this tool is UNKNOWN. Do not redo "
                "blind - tell Infra Claude." % bad)
    if last is None:
        return base + "This tool has no recorded write to compare against. Re-read the file and redo." + hedge
    prior = final_sha_of(last)
    if prior == live_sha:
        return (base + "The file matches this tool's last recorded write (%s, by %s): another session wrote THROUGH "
                "this tool. Re-read, redo, never force." % (last.get("ts"), last.get("by_claimed")) + hedge)
    if prior is None:
        return (base + "This tool's last record (%s, outcome %s) cannot say what the file held afterwards. Re-read "
                "and redo, and tell Infra Claude." % (last.get("ts"), last.get("outcome")) + hedge)
    if bad:
        return (base + "⚠️ The file differs from this tool's last READABLE write (%s left sha %s), but %d line(s) of "
                "its archive index could not be read and may hold a later write through this tool - so this is NOT "
                "proof of a hand edit. Tell Infra Claude before redoing." % (last.get("ts"), str(prior)[:16], bad))
    return (base + "⚠️ THE FILE CHANGED OUTSIDE THIS TOOL since its last recorded write (%s left sha %s). Someone "
            "edited it by hand. Tell Infra Claude before redoing." % (last.get("ts"), str(prior)[:16]))


def owner_only(mode):
    """Group and other bits cleared, owner bits kept. The archive was already 700/600; the primary output was left at
    whatever mode it had (644 on the live box), protected only by the 750 home around it (Langston, 18:37Z)."""
    return (mode & 0o7777) & ~0o077


# ⛔ THE RATCHET AT WRITE TIME (Langston, 2026-10-17; PHASE_19_PLAN row 2.8b): the loaded set is capped as a SUM and
#    may only go down, but a breach used to be found by the 05:40Z size watch, hours after the write that caused it.
#    So a write that GROWS MEMORY.md and would leave the loaded set over the ceiling is refused, unless
#    --allow-growth "<reason>" records a deliberate override. A NON-INCREASE gate, never an absolute ceiling: a write
#    that does not grow MEMORY.md always passes, so the trim and any prune can never be locked out.
#    r2 (Langston): the size watch's daily last_status is the WRONG signal - it passed on MISSING-FILE, AT-CEILING and
#    any unrecognised value, and was up to a day stale. The gate reads ONLY ceiling_bytes from the state (the one
#    number nothing else can supply; --set-ceiling refuses to raise it) and sums the loaded set LIVE: the other watched
#    files by stat, MEMORY.md as the new bytes. Anything it cannot establish - the state, the ceiling, the watch's
#    persisted file list matching this one, every watched file present - is UNKNOWN, and unknown refuses growth on the
#    live home. Every gated row carries what the gate saw (`ratchet`); a refusal is RECORDED before it is raised.
#    Not gated, stated (Langston r2): --trim only removes (it is the remedy); --rename-part is zero-delta by
#    construction (compose_body concatenates part BODIES, names enter only as fixed-length digests, the stamp's
#    timestamp is fixed width); a ROLLBACK is never gated - it restores a prior state, and gating it would refuse the
#    restore of a failed shrink.
# the size watch writes this as root into the root-only state/ dir (B-LANGSTON-RELIEF, 2026-10-19); read-only here
RATCHET_STATE = os.environ.get("LMW_RATCHET_STATE") or "/opt/langston-memory/state/ratchet-state.json"
AUTO_MEMORY_INDEX = os.path.join(".claude", "projects", "-home-langston", "memory", "MEMORY.md")


def watched_paths():
    """The loaded set as THIS program knows it; the size watch persists its own list and the two must agree."""
    return [os.path.join(LANGSTON_HOME, "CLAUDE.md"), TARGET, os.path.join(LANGSTON_HOME, AUTO_MEMORY_INDEX)]


def read_ratchet(mem_len):
    """THE ONE READ of the ratchet, shared by growth_gate and size_line (Langston, 2026-10-17: two copies of one read is
    the fix-follows-pointer generator). Returns {state, live, no_state, ceiling_bytes, other, missing, total, unknown}:
    `total` = the other watched files by stat + mem_len; `unknown` names the first thing that could not be established
    (state unreadable, no valid positive integer ceiling, the watch's persisted list != watched_paths() on the live
    home, a watched file missing on the live home). A test home uses ITS OWN state file, never the live one."""
    live = os.path.realpath(LANGSTON_HOME) == os.path.realpath(LIVE_HOME)
    path = RATCHET_STATE if (live or os.environ.get("LMW_RATCHET_STATE")) else os.path.join(LANGSTON_HOME, ".ratchet-state.json")
    r = {"state": path, "live": live, "no_state": False, "ceiling_bytes": None, "other": None, "missing": [],
         "total": None, "unknown": None}
    try:
        with open(path, encoding="utf-8") as fh:
            rs = json.load(fh)
        if not isinstance(rs, dict):
            raise ValueError("not an object")
    except (OSError, ValueError) as e:
        if not live and isinstance(e, FileNotFoundError):
            r["no_state"] = True
        r["unknown"] = "the ratchet state %s cannot be read (%s)" % (path, type(e).__name__)
        return r
    ceiling = rs.get("ceiling_bytes")
    r["ceiling_bytes"] = ceiling
    mine = watched_paths()
    if not isinstance(ceiling, int) or isinstance(ceiling, bool) or ceiling <= 0:
        r["unknown"] = "the ratchet state carries no valid ceiling_bytes (%r)" % (ceiling,)
        return r
    if live and rs.get("watched") != mine:
        r["unknown"] = ("the size watch's persisted file list %r does not match this writer's %r - a loaded file could "
                        "be uncounted" % (rs.get("watched"), mine))
        return r
    other, missing = 0, []
    for f in mine:
        if os.path.realpath(f) == os.path.realpath(TARGET):
            continue
        try:
            other += os.stat(f).st_size
        except OSError:
            missing.append(f)
    r.update({"other": other, "missing": missing, "total": other + mem_len})
    if missing and live:
        r["unknown"] = "a watched file is missing (%s) - the sum is meaningless until it is resolved" % missing[0]
    return r


def growth_gate(old_bytes, new_bytes, opts, st, mode):
    """What the gate saw (a dict for the index row), or Refused(7) after recording the refusal."""
    delta = len(new_bytes) - len(old_bytes)
    r = read_ratchet(len(new_bytes))
    if r["no_state"]:
        return {"delta_bytes": delta, "state": r["state"], "note": "test home with no ratchet state: not gated"}
    unknown = r["unknown"]
    seen = {"delta_bytes": delta, "state": r["state"], "ceiling_bytes": r["ceiling_bytes"]}
    if r["total"] is not None:
        seen.update({"total_before": r["other"] + len(old_bytes), "total_after": r["total"], "missing": r["missing"]})
    seen["unknown"] = unknown
    if delta <= 0:
        return seen
    over = unknown is None and seen["total_after"] > seen["ceiling_bytes"]
    if not (over or unknown):
        return seen
    why = opts.get("--allow-growth")
    if why:
        seen["override"] = {"by": opts.get("--by"), "reason": why}
        return seen
    append_index({"ts": utc(), "target": TARGET, "mode": mode, "outcome": "refused-growth", "ratchet": seen,
                  "by_claimed": opts.get("--by"), "via_uid": os.getuid(), "reason": opts.get("--reason")}, st)
    if unknown:
        msg = "REFUSED: this write grows MEMORY.md by %d B and the ratchet is UNKNOWN: %s." % (delta, unknown)
    else:
        msg = ("REFUSED: this write grows MEMORY.md by %d B and would leave the loaded set at %d B over its ceiling of "
               "%d B (live sum; PHASE_19_PLAN row 2.8b - it may only go down)." % (delta, seen["total_after"],
                                                                                    seen["ceiling_bytes"]))
    raise Refused(7, msg + " Shrink something in the same write, or pass --allow-growth \"<reason>\" to record a "
                           "deliberate override. The refusal is recorded; nothing was written.")


def replace_target(new_bytes, st):
    """Temp file in the target's own directory, fsync, OWNER-ONLY mode and the target's owner, rename, fsync the
    directory."""
    d = os.path.dirname(TARGET)
    fd, tmp = tempfile.mkstemp(prefix=".MEMORY.md.write-", suffix=".tmp", dir=d)
    try:
        os.write(fd, new_bytes)
        os.fsync(fd)
        os.fchmod(fd, owner_only(st.st_mode))
        hand_to_owner(fd, st)
    finally:
        os.close(fd)
    try:
        os.replace(tmp, TARGET)
    except BaseException:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise
    dfd = os.open(d, os.O_RDONLY)
    try:
        os.fsync(dfd)
    finally:
        os.close(dfd)


def replace_file(path, new_bytes, st):
    """Generalises replace_target for part files: temp in path's dir, fsync, owner-only mode + owner, atomic rename."""
    d = os.path.dirname(path)
    fd, tmp = tempfile.mkstemp(prefix="." + os.path.basename(path) + ".write-", suffix=".tmp", dir=d)
    try:
        os.write(fd, new_bytes)
        os.fsync(fd)
        os.fchmod(fd, owner_only(st.st_mode))
        hand_to_owner(fd, st)
    finally:
        os.close(fd)
    try:
        os.replace(tmp, path)
    except BaseException:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise
    dfd = os.open(d, os.O_RDONLY)
    try:
        os.fsync(dfd)
    finally:
        os.close(dfd)


LEDGER_DECL_RE = re.compile(r"\A<!-- part\n.*?\n-->\n", re.DOTALL)
LEDGER_TRUE_RE = re.compile(r"^ledger:\s*true\s*$", re.MULTILINE)


def part_declares_ledger(raw_bytes):
    """True iff the part's leading `<!-- part ... -->` frontmatter carries a `ledger: true` line."""
    m = LEDGER_DECL_RE.match(raw_bytes.decode("utf-8", "replace"))
    return bool(m and LEDGER_TRUE_RE.search(m.group(0)))


def resolve_target_part(parts, append, explicit_part=None):
    """P-2b resolution (Langston 22:19Z). Returns (name, rule).
    --ledger-append: 1 part -> the sole part ('single-part-fallback'); >=2 parts -> the ONE part DECLARING
      `ledger: true` is REQUIRED ('declared'); 0 or >=2 declarations at >=2 parts refuses, naming EVERY part
      (the full enumeration, count asserted - never a windowed read). An --part assertion must equal the resolved part.
    whole-file: --part names the target ('explicit'); else exactly one part ('single-part'); >=2 without --part
      refuses, naming EVERY part and the verb to use."""
    allnames = ", ".join(n for n, _, _, _ in parts)
    if append:
        if len(parts) == 1:
            name, rule = parts[0][0], "single-part-fallback"
        else:
            # FINDING (Langston 22:38Z): resolve the declaration on the SAME bytes parts_digest hashed (carried in the
            #   tuple), not a re-read off disk - the declaration must not be decided on bytes that were never hashed.
            decl = [n for n, _, _, rawb in parts if part_declares_ledger(rawb)]
            if len(decl) != 1:
                raise Refused(2, "REFUSED: --ledger-append needs exactly ONE part declaring `ledger: true` when %d parts "
                                 "exist; found %d (%s). All %d parts: %s. Mark the ledger part's frontmatter."
                              % (len(parts), len(decl), ", ".join(decl) or "none", len(parts), allnames))
            name, rule = decl[0], "declared"
        if explicit_part is not None and explicit_part != name:
            raise Refused(2, "REFUSED: --part %s does not match the resolved ledger part %s (%s rule)."
                          % (explicit_part, name, rule))
        return name, rule
    if explicit_part is not None:
        return explicit_part, "explicit"
    if len(parts) != 1:
        raise Refused(2, "REFUSED: a whole-file write is ambiguous with %d parts. Target one with `--part <name>` "
                         "(all %d parts: %s), or append to the ledger with `--ledger-append`."
                      % (len(parts), len(parts), allnames))
    return parts[0][0], "single-part"


def size_line(n):
    """MEMORY.md's size and the LOADED SET against its ceiling (PHASE_19_PLAN row 2.8b), through read_ratchet - the
    same read the growth gate makes (one function, not a copy). It used to print a per-file "24576 B cap", the fifth
    surviving copy of a cap 2.8b retired, on every write (found at the 2026-10-17 install)."""
    r = read_ratchet(n)
    if r["unknown"]:
        return "size %d B; loaded-set ceiling UNKNOWN - %s (see `langston-size-watch --status`)" % (n, r["unknown"])
    miss = (" - %d watched file(s) absent from this home, not counted" % len(r["missing"])) if r["missing"] else ""
    return "size %d B; loaded set %d B vs ceiling %d B (%s by %d B; row 2.8b)%s" % (
        n, r["total"], r["ceiling_bytes"], "OVER" if r["total"] > r["ceiling_bytes"] else "under",
        abs(r["total"] - r["ceiling_bytes"]), miss)


def corrupt_switch_armed(home):
    """⛔ CONDITION 1 (Langston, 19:23Z): LMW_TEST_CORRUPT_RESTORE writes deliberately WRONG bytes into the target. Unlike
    LMW_TEST_HOLD_AFTER_LOCK, which only delays, it must be incapable of reaching the live file BY CONSTRUCTION - not
    merely because nobody sets it. Honoured only when the home is not the live one (symlinks resolved)."""
    return bool(os.environ.get("LMW_TEST_CORRUPT_RESTORE")) and os.path.realpath(home) != os.path.realpath(LIVE_HOME)


def part_body(raw_bytes):
    """A part's BODY is its bytes minus an optional leading `<!-- part ... -->` frontmatter block (the obligations
    list P-1b reads). The migration part 00-legacy.md carries none, so its body is the whole file."""
    text = raw_bytes.decode("utf-8")   # caller has already validated UTF-8 and named the file on failure
    return PART_FRONTMATTER_RE.sub("", text, count=1).encode("utf-8")


def read_parts():
    """Every file in PARTS_DIR in filename order, as (name, raw_sha, body, raw). Refuses, NAMING THE FILE, on non-UTF-8
    or a body that does not end in exactly one newline - never normalizes (Langston, 20:48Z)."""
    if not os.path.isdir(PARTS_DIR):
        raise Refused(2, "REFUSED: no parts directory at %s - nothing to compose" % PARTS_DIR)
    names = sorted(n for n in os.listdir(PARTS_DIR)
                   if not n.startswith(".") and os.path.isfile(os.path.join(PARTS_DIR, n)))
    if not names:
        raise Refused(2, "REFUSED: %s holds no parts - refusing to compose an empty memory file" % PARTS_DIR)
    parts = []
    for n in names:
        fp = os.path.join(PARTS_DIR, n)
        with open(fp, "rb") as fh:
            b = fh.read()
        try:
            b.decode("utf-8")
        except UnicodeDecodeError:
            raise Refused(2, "REFUSED: part %s is not valid UTF-8" % fp)
        if not b.endswith(b"\n") or b.endswith(b"\n\n"):
            raise Refused(2, "REFUSED: part %s must end in exactly one newline (it does not); fix the part, "
                             "the composer never normalizes bytes in a governance file" % fp)
        parts.append((n, sha(b), part_body(b), b))
    return parts


def valid_part_name(name):
    """A part name must be a MEMBER of the set read_parts() enumerates (Langston 22:38Z, a predicate not a blacklist):
    equal to its own basename (no `/`, no `..`, no absolute path) and not a dotfile - or --expect-sha new could mint a
    part the enumerator never sees again (a root-run write to an arbitrary path)."""
    return bool(name) and name == os.path.basename(name) and not name.startswith(".")


def parts_digest(parts):
    """sha256 over the ordered (name, raw_sha) list - the identity of the parts set as read."""
    return sha(("\n".join("%s %s" % (n, h) for n, h, _, _ in parts)).encode("utf-8"))


def compose_body(parts):
    """The composed BODY (pre-stamp) is the parts' bodies concatenated in order. parts_sha is over the ordered
    (name, raw_sha) list; body_sha is over the body."""
    body = b"".join(pb for _, _, pb, _ in parts)
    return body, parts_digest(parts), sha(body)


def stamp_line(n_parts, parts_sha, body_sha):
    # ONE line, HTML comment (inert where the file is RENDERED - not justified on prompt-invisibility, Langston 20:48Z).
    return "<!-- composed %s | %d parts | parts-sha %s | body-sha %s -->" % (utc(), n_parts, parts_sha, body_sha)


def strip_stamp(composed_bytes):
    """composed = body + stamp-line + '\n'. Remove that last stamp line and return the body (which ends in '\n').
    If there is no stamp last line, return the bytes unchanged."""
    lines = composed_bytes.split(b"\n")
    if len(lines) >= 2 and lines[-1] == b"" and STAMP_RE.match(lines[-2].decode("utf-8", "replace")):
        return b"\n".join(lines[:-2]) + b"\n"
    return composed_bytes


# ⛔ LEDGER GUARDS (B-LANGSTON-CONTEXT P-2, Langston C-1..C-3 2026-09-12). ALL BYTE-BASED so the span, the part
#    ranges and the reader's entry offsets are ONE coordinate system (validated against the live 72,578 B file:
#    span (12394,24943) matches Langston's own measurement). Run on every recompose (compose / direct write / rename).
LEDGER_HEADING_BYTES = re.compile(rb"(?m)^## .*REVIEWER LEDGER.*$")     # C-1: anchored ^## , not a substring
# NOTE (Langston Step-4 Q3): '### Retractions' is NOT in this literal list - it is checked via the reader's OWN
#   exported pattern (RETRACTIONS_HEADING_PATTERN, compiled to bytes) so the guard and the reader share ONE definition.
#   These two have no competing reader definition, so a literal present-and-in-span check is the single source for them.
LEDGER_SUBSECTIONS = (b"### Rulings of mine that GENERALISE", b"### CC-A errors I logged")


def lands_on_bullet(body, off):
    """SELF-LOCATION (Langston FINDING-1, 2026-09-13): a reader entry's byte offset must point AT that entry's '- ' at
    column 0 - body[off:off+2] == '- ' and it starts a line. A range check alone (s <= off < e) passes a WRONG-
    coordinate offset that happens to land inside the span (proven on the live file: a char-vs-byte reader offset
    diverges 203-315 B but still falls inside a 12,549 B span). This does not: it fails at the first entry under any
    coordinate error, and is its own positive control (9/9 on the live file)."""
    return (isinstance(off, int) and 0 <= off <= len(body) - 2
            and body[off:off + 2] == b"- " and (off == 0 or body[off - 1:off] == b"\n"))


def ledger_span(data):
    """[start,end) BYTE offsets of the ## …REVIEWER LEDGER block (anchored heading -> next column-0 '## ' or EOF).
    ('multi', n) if >1 anchored heading; None if none."""
    heads = [m.start() for m in LEDGER_HEADING_BYTES.finditer(data)]
    if len(heads) > 1:
        return ("multi", len(heads))
    if not heads:
        return None
    s = heads[0]
    nl = data.find(b"\n", s)
    after = (nl + 1) if nl != -1 else len(data)
    nxt = re.search(rb"(?m)^## ", data[after:])
    return (s, after + nxt.start() if nxt else len(data))


def ledger_guard_problems(body, part_bodies, reader_entries, reader_status, part_names=None, retractions_pattern=None,
                          split=False):
    """Every ledger guard over the PRE-STAMP composed body (bytes). Returns a list of problems (empty = clean).
    reader_entries/status from _parse_ledger on the written MEMORY.md; offsets are byte offsets valid in the body
    region (the stamp is appended after it). part_names (optional, composed order) names parts in the split-block
    message. retractions_pattern (optional, bytes) is the reader's OWN heading pattern - passed by the tool so the Q3
    single-definition heading check runs; direct unit callers may omit it to exercise the other guards alone.
    split=True (LEDGER.md exists, B-LANGSTON-RELIEF OBJ-3): the retractions live there, so MEMORY.md must hold NO
    '### Retractions' heading and the reader must find no section in it - a second copy would be a second ledger source
    (ledger-sources-disagree on the first amendment). The REVIEWER LEDGER block, its other subsections and the
    part-range checks still bind; containment has no entries to place."""
    problems = []
    names = part_names or [str(i) for i in range(len(part_bodies))]
    span = ledger_span(body)
    if isinstance(span, tuple) and span and span[0] == "multi":                     # C-1
        return ["%d '## …REVIEWER LEDGER' headings (anchored) - the ledger block is ambiguous" % span[1]]
    if split:
        if reader_status != "no-section":
            problems.append("LEDGER.md exists but the reader parses a Retractions section in the composed MEMORY.md "
                            "(status=%s) - after the split MEMORY.md must hold none" % reader_status)
        if retractions_pattern is not None:
            rm = [m.start() for m in re.finditer(retractions_pattern, body)]
            if rm:
                problems.append("%d '### Retractions' heading(s) in the composed MEMORY.md although LEDGER.md exists "
                                "- the retractions belong in LEDGER.md only" % len(rm))
        reader_entries = []
    elif reader_status != "ok":                                                     # condition-2, never vacuous
        problems.append("the reader could not parse the composed ledger: status=%s" % reader_status)
    if span is None:
        problems.append("no '## …REVIEWER LEDGER' block in the composed file")
        return problems
    s, e = span
    if retractions_pattern is not None and not split:                               # Q3: ONE heading definition
        rm = [m.start() for m in re.finditer(retractions_pattern, body)]
        if len(rm) != 1:
            problems.append("%d '### Retractions' headings (reader pattern %r) - exactly one is required; a second "
                            "copy (before OR after the block) splits what the reader binds from what the guard checks"
                            % (len(rm), retractions_pattern.decode("utf-8", "replace")))
        elif not (s <= rm[0] < e):
            problems.append("the '### Retractions' heading at byte %d is OUTSIDE the block span [%d,%d)" % (rm[0], s, e))
    for sub in LEDGER_SUBSECTIONS:                                                  # C-2 span-extent canary (other subs)
        i = body.find(sub)
        if i == -1:
            problems.append("ledger subsection %r absent from the composed file" % sub.decode())
        elif not (s <= i < e):
            problems.append("ledger subsection %r at byte %d is OUTSIDE the block span [%d,%d)" % (sub.decode(), i, s, e))
    off = 0                                                                          # C-3 WRITER-SIDE range-arithmetic control
    ranges = []
    for b in part_bodies:
        ranges.append((off, off + len(b)))
        off += len(b)
    if off != len(body):
        problems.append("part ranges sum %d != composed body %d bytes - coordinate systems disagree" % (off, len(body)))
    for i in range(1, len(ranges)):
        if ranges[i][0] != ranges[i - 1][1]:
            problems.append("part ranges not contiguous at index %d" % i)
    holder = [i for i, (a, b) in enumerate(ranges) if a <= s and e <= b]
    if len(holder) != 1:                                                            # block-single-part (FINDING-2 wording)
        sp = next((i for i, (a, b) in enumerate(ranges) if a <= s < b), None)
        ep = next((i for i, (a, b) in enumerate(ranges) if a < e <= b), None)
        problems.append("the ledger block [%d,%d) runs past the end of part '%s' into part '%s' (matched %d whole-part "
                        "ranges) - the block must lie within ONE part; the part after the ledger must begin its body "
                        "with a column-0 '## ' (or the ledger part must be last)"
                        % (s, e, names[sp] if sp is not None else "?", names[ep] if ep is not None else "?", len(holder)))
    entries = reader_entries or []                                                   # containment (SELF-LOCATING, FINDING-1)
    no_offset = [en for en in entries if not isinstance(en.get("offset"), int)]
    if no_offset:
        # a reader without the P-2 offset field - report the MISMATCH, never a false 'corruption' (the fail-fast probe
        # in load_reader should have caught this already; this is the belt-and-braces path).
        problems.append("the reader emitted %d of %d ledger entries WITHOUT a byte offset - reader-version mismatch "
                        "(install the P-2 reader), NOT ledger corruption" % (len(no_offset), len(entries)))
    else:
        miscoord = [en for en in entries if not lands_on_bullet(body, en["offset"])]
        if miscoord:
            problems.append("%d ledger entr%s offset does NOT point at a column-0 '- ' bullet (first %r at byte %d) - "
                            "the reader's offsets are on a DIFFERENT coordinate system from the body (byte/char "
                            "mismatch); containment cannot be trusted" % (
                                len(miscoord), "y" if len(miscoord) == 1 else "ies",
                                miscoord[0]["text"][:40], miscoord[0]["offset"]))
        outside = [en for en in entries if lands_on_bullet(body, en["offset"]) and not (s <= en["offset"] < e)]
        if outside:
            problems.append("%d retraction entr%s OUTSIDE the block span [%d,%d): first %r at byte %d" % (
                len(outside), "y" if len(outside) == 1 else "ies", s, e, outside[0]["text"][:40], outside[0]["offset"]))
    return problems


def ledger_guard_after_recompose(reader, body, parts):
    """Run every ledger guard against the JUST-WRITTEN TARGET. Returns the problems list (empty = clean) so each
    recompose path raises with its OWN restore/rollback wording (compose has none, direct write and rename each roll
    back), never a generic raise here. `body` is the pre-stamp composed body; `parts` is the read_parts() tuple list
    in composed order. The reader parses the full file incl. the trailing stamp, but every ledger byte precedes the
    stamp, so its entry offsets coincide with body-offsets over the block - the one coordinate system C-3 demands."""
    part_bodies = [pb for _, _, pb, _ in parts]
    part_names = [n for n, _, _, _ in parts]
    status, entries = reader._parse_ledger(TARGET)
    # Q3: hand the guard the reader's OWN heading pattern (bytes), so both share one definition. reader_requires_offsets
    #   has already version-gated the reader, so RETRACTIONS_HEADING_PATTERN is present; default to the reader's literal
    #   only if a very old reader somehow lacks the export (then the Q3 heading check is skipped, not wrong).
    pat = getattr(reader, "RETRACTIONS_HEADING_PATTERN", None)
    pat = pat.encode("utf-8") if isinstance(pat, str) else None
    return ledger_guard_problems(body, part_bodies, entries, status, part_names, pat, split=ledger_split_active())


def read_compose_state():
    try:
        with open(COMPOSE_STATE, "rb") as fh:
            return json.loads(fh.read().decode("utf-8"))
    except FileNotFoundError:
        return {}


def write_compose_state(d, st):
    """Owner-only JSON, atomic (temp+rename in the archive dir), full sha256 values only."""
    os.makedirs(ARCHIVE_DIR, exist_ok=True)
    fd, tmp = tempfile.mkstemp(prefix=".compose-state-", suffix=".tmp", dir=ARCHIVE_DIR)
    try:
        os.write(fd, (json.dumps(d, indent=2) + "\n").encode("utf-8"))
        os.fsync(fd)
        os.fchmod(fd, 0o600)
        hand_to_owner(fd, st)
    finally:
        os.close(fd)
    os.replace(tmp, COMPOSE_STATE)


def do_compose(opts):
    """P-2: regenerate MEMORY.md from the parts, under the lock. Never on a timer."""
    reader = load_reader()
    reader_requires_offsets(reader)   # fail-fast before any write if the reader predates the P-2 offset field
    try:
        st = os.stat(TARGET)
    except OSError as e:
        raise Refused(2, "REFUSED: cannot stat the target %s (%s)" % (TARGET, type(e).__name__))
    lfd = open_lock(st)
    try:
        fcntl.flock(lfd, fcntl.LOCK_EX)
        with open(TARGET, "rb") as fh:
            cur = fh.read()
        cur_sha = sha(cur)
        state = read_compose_state()
        r_before = retraction_count(reader, TARGET)
        parts = read_parts()
        body, parts_sha, body_sha = compose_body(parts)
        # BLOCKER-1 (Langston 21:22Z): compose is the reconciliation verb - it ACCEPTS a parts change, but the
        #   transition is made visible rather than silent (a direct write, by contrast, refuses it below).
        parts_reconciled = bool(state.get("parts_sha")) and state["parts_sha"] != parts_sha
        # ⛔ first-compose predicate (Langston point-3): composed-MINUS-STAMP == current MEMORY.md bytes, so the
        #    migration cannot silently clobber a hand-edited live file.
        if "last_written_sha" not in state:
            if body != cur:
                raise Refused(4, "REFUSED: first compose, but the parts do NOT reproduce the live %s "
                                 "(part bodies %d B vs live %d B). Fix 00-legacy.md to equal the live file byte-for-byte "
                                 "before composing." % (TARGET, len(body), len(cur)))
        else:
            # ⛔ out-of-band (Langston point-3): the live file must carry a sha this composer last wrote OR a pending one
            #    (a rename->state-write crash leaves pending set - admissible, not a false alarm).
            admissible = {state.get("last_written_sha"), state.get("pending_sha")} - {None}
            if cur_sha not in admissible:
                raise Refused(4, "REFUSED: %s was written OUTSIDE the composer (out-of-band). Its current sha is %s; "
                                 "the composer last wrote %s (pending %s). A stale `cp` or a direct edit - reconcile the "
                                 "parts and recompose deliberately." % (TARGET, cur_sha, state.get("last_written_sha"),
                                                                        state.get("pending_sha")))
        composed = body + stamp_line(len(parts), parts_sha, body_sha).encode("utf-8") + b"\n"
        new_sha = sha(composed)
        growth = growth_gate(cur, composed, opts, st, "compose")
        arch_path, created = archive_old(cur, cur_sha, st)
        row = {"ts": utc(), "target": TARGET, "old_sha": cur_sha, "new_sha": new_sha, "old_bytes": len(cur),
               "new_bytes": len(composed), "mode": "compose", "part_count": len(parts), "parts_sha": parts_sha,
               "prev_parts_sha": state.get("parts_sha"), "parts_reconciled": parts_reconciled,
               "body_sha": body_sha, "stamp_bytes": len(composed) - len(body), "by_claimed": opts["--by"],
               "via_uid": os.getuid(), "reason": opts["--reason"], "archived": os.path.basename(arch_path),
               "ratchet": growth}
        append_index(dict(row, outcome="attempted"), st)
        # pending_sha BEFORE the rename; a crash here leaves it recognisable next time.
        write_compose_state(dict(state, pending_sha=new_sha, ts=utc()), st)
        replace_target(composed, st)
        if os.environ.get("LMW_TEST_CRASH_BEFORE_STATE") and os.path.realpath(LANGSTON_HOME) != os.path.realpath(LIVE_HOME):
            raise SystemExit(99)   # self-test only, non-live home: crash between rename and state-collapse
        with open(TARGET, "rb") as fh:
            back = fh.read()
        if sha(back) != new_sha or strip_stamp(back) != body:
            raise Refused(6, "REFUSED: post-compose read-back does not match; %s is at %s" % (TARGET, arch_path))
        r_after = retraction_count(reader, TARGET)
        if r_after != r_before:
            raise Refused(5, "REFUSED: composing changed the ledger entry count %d -> %d - a part reshaped the ledger; "
                             "%s is at %s" % (r_before, r_after, TARGET, arch_path))
        # ⛔ LEDGER GUARDS (Langston C-1..C-3): the count check above catches ADD/DROP; these catch a block that moved,
        #    split across parts, lost a subsection, or holds an entry outside its own span. compose has no auto-restore
        #    (it is the reconciliation verb - pending stays set for next-time), so it refuses naming the archive.
        lg = ledger_guard_after_recompose(reader, body, parts)
        if lg:
            raise Refused(5, "REFUSED (ledger integrity): " + "; ".join(lg) + " - a part reshaped the ledger block; "
                             "%s is at %s (pending_sha stays set; reconcile the parts and recompose)" % (TARGET, arch_path))
        # collapse: the write is durable, pending clears, last_written advances.
        write_compose_state({"last_written_sha": new_sha, "pending_sha": None, "ts": utc(),
                             "parts_sha": parts_sha, "part_count": len(parts)}, st)
        append_index(dict(row, ts=utc(), outcome="composed", retractions=[r_before, r_after]), st)
        recon = "" if not parts_reconciled else " [parts changed since last compose: %s -> %s]" % (
            (state.get("parts_sha") or "none")[:12], parts_sha[:12])
        return "COMPOSED %s -> %s from %d part(s)%s (%d -> %d B; stamp %d B; retractions %d -> %d); %s" % (
            cur_sha[:16], new_sha[:16], len(parts), recon, len(cur), len(composed), len(composed) - len(body),
            r_before, r_after, size_line(len(composed)))
    finally:
        os.close(lfd)


# ---------------- the ledger split (B-LANGSTON-RELIEF OBJ-3, Langston's rulings Q1/Q2/Q5, 2026-10-16) ----------------
# `### Retractions` was 84 % of an auto-loaded MEMORY.md ~6x its ceiling. It moves, verbatim, to LEDGER.md - the recall
# reader's PRIORITY source, NOT imported by CLAUDE.md, so not loaded every invoke - and a <=4 KB stub (the §19
# instruction + the retraction CLASS index) takes its place. After the split:
#   - `--ledger-append` writes LEDGER.md (same lock, CAS on LEDGER.md's sha, archive, counts AND set check, rollback);
#   - it REFUSES if LEDGER.md is absent - never recreates it (Q2: counters restarting at 0 would hide exit-5);
#   - the ledger guards on MEMORY.md flip: NO Retractions heading there, the other subsections still required;
#   - every failure restores toward the BREACH (MEMORY.md keeps the block), never toward a loss (Q5b).
LEDGER_FILE = os.path.join(LANGSTON_HOME, "LEDGER.md")
STUB_MAX = 4096
LEDGER_PREAMBLE = ("# Langston — LEDGER.md: my retractions (moved out of MEMORY.md 2026-10-16, B-LANGSTON-RELIEF OBJ-3)\n\n"
                   "Not auto-loaded. `langston-recall <term>` reads this file FIRST and prints the relevant entries before "
                   "any result. Append only with `langston-memory-write --ledger-append` (`--expect-sha` = THIS file's "
                   "sha256). EVERY version this tool wrote, the current one included, is in `.memory-archive/<sha>.md` "
                   "(the index row's `ledger_sha` / `ledger_new_sha`); that directory is backed up daily.\n"
                   "If this file exists while MEMORY.md STILL holds a `### Retractions` block, a split was interrupted "
                   "between its writes: recall refuses `ledger-sources-disagree` or serves identical sets, and the writer "
                   "refuses. Recovery: move this file aside, then `langston-memory-write --compose`; never hand-edit.\n\n")
RECIPE_ANCHOR = "> ⛔⛔ **HOW YOU WRITE THIS FILE"
RECIPE_NOTE = ("> ⛔ **SINCE 2026-10-16 YOUR RETRACTIONS LIVE IN `/home/langston/LEDGER.md` (B-LANGSTON-RELIEF OBJ-3).** "
               "`--ledger-append` now writes THAT file: pass `--expect-sha $(sha256sum /home/langston/LEDGER.md)` - not the "
               "part's sha. It refuses if LEDGER.md is missing. Whole-file part writes are unchanged.")


def ledger_split_active():
    return os.path.isfile(LEDGER_FILE)


def _fp(reader, entries):
    return reader._fingerprint(entries) if entries else set()


def do_ledger_file_append(opts, content, n):
    """Q2: append N retraction entries to LEDGER.md under the writer's lock, with the same discipline as a part write."""
    st = os.stat(TARGET)                        # lock ownership follows MEMORY.md, exactly as every other verb
    lfd = open_lock(st)
    try:
        fcntl.flock(lfd, fcntl.LOCK_EX)
        if not os.path.isfile(LEDGER_FILE):
            raise Refused(2, "REFUSED: %s is missing. After the split the ledger is NEVER recreated by an append (the "
                             "counters would restart at zero). Restore it from .memory-archive/ and tell Infra Claude."
                          % LEDGER_FILE)
        lst = os.stat(LEDGER_FILE)
        with open(LEDGER_FILE, "rb") as fh:
            old = fh.read()
        old_sha = sha(old)
        if old_sha != opts["--expect-sha"].strip().lower():
            raise Refused(4, "REFUSED: --expect-sha does not match LEDGER.md (current sha256 %s, you passed %s). Since "
                             "the split, --ledger-append takes LEDGER.md's sha, not the part's." % (old_sha, opts["--expect-sha"]))
        reader = load_reader()
        s0, e0 = reader._parse_ledger(LEDGER_FILE)
        if s0 != "ok":
            raise Refused(6, "REFUSED: the reader cannot parse LEDGER.md before the append (status %s) - nothing written" % s0)
        new = (old.decode("utf-8").rstrip(NL) + NL + content.strip(NL) + NL).encode("utf-8")
        arch, _ = archive_old(old, old_sha, st)
        archive_old(new, sha(new), st)          # the current version is restorable from the backed-up archive too
        # ledger_* keys, never old_sha/new_sha: final_sha_of() reads those as MEMORY.md's sha
        row = {"ts": utc(), "target": LEDGER_FILE, "mode": "ledger-file-append", "ledger_old_sha": old_sha,
               "ledger_new_sha": sha(new),
               "declared_retractions_delta": n, "by_claimed": opts["--by"], "via_uid": os.getuid(),
               "reason": opts["--reason"], "archived": os.path.basename(arch)}
        append_index(dict(row, outcome="attempted"), st)
        replace_file(LEDGER_FILE, new, lst)
        try:
            with open(LEDGER_FILE, "rb") as fh:
                if sha(fh.read()) != sha(new):
                    raise Refused(6, "REFUSED: LEDGER.md read-back mismatch after write")
            s1, e1 = reader._parse_ledger(LEDGER_FILE)
            problems = []
            if s1 != "ok":
                problems.append("the reader cannot parse LEDGER.md after the append (status %s)" % s1)
            elif len(e1) - len(e0) != n:
                problems.append("retraction entries moved %+d, declared %+d" % (len(e1) - len(e0), n))
            elif not _fp(reader, e0) <= _fp(reader, e1):
                problems.append("an existing retraction changed or vanished - the old set is not contained in the new")
            if problems:
                raise Refused(5, "REFUSED (rule 4): " + "; ".join(problems))
        except BaseException as e:
            replace_file(LEDGER_FILE, old, lst)
            with open(LEDGER_FILE, "rb") as fh:
                back = sha(fh.read()) == old_sha
            append_index(dict(row, ts=utc(), outcome="restored" if back else "restore-failed", why=str(e)[:300]), st)
            if not back:
                raise Refused(6, "REFUSED: LEDGER.md restore was NOT byte-identical (cause %s). Prior version at %s - "
                                 "restore by hand and tell Infra Claude." % (str(e)[:160], arch))
            base = str(e) if isinstance(e, Refused) else "the post-write check crashed (%s)" % type(e).__name__
            raise Refused(5, "REFUSED: " + base + " - LEDGER.md restored byte-identical (prior at %s)" % arch)
        append_index(dict(row, ts=utc(), outcome="written", retractions=[len(e0), len(e1)]), st)
        return "WRITTEN LEDGER.md (%s -> %s); retractions %d -> %d" % (old_sha[:12], sha(new)[:12], len(e0), len(e1))
    finally:
        os.close(lfd)


def check_stub(stub, reader):
    b = stub.encode("utf-8")
    if not stub.strip():
        raise Refused(2, "REFUSED: the stub is empty")
    if len(b) > STUB_MAX:
        raise Refused(2, "REFUSED: the stub is %d B; the budget is %d B (Langston Q1b)" % (len(b), STUB_MAX))
    if re.search(reader.RETRACTIONS_HEADING_PATTERN, stub):
        raise Refused(2, "REFUSED: the stub carries a '### Retractions' heading - after the split MEMORY.md must have none")
    for l in stub.split(NL):
        if l.startswith("## ") or l.startswith("# "):
            raise Refused(2, "REFUSED: a column-0 '#'/'##' heading in the stub would end the ledger block: %r" % l[:60])


def do_split_ledger(opts, stub):
    """One transaction under the writer's lock (Langston Q1/Q5): LEDGER.md gets the Retractions block verbatim, the part
    loses it in favour of the stub, the header gains the new recipe line, and MEMORY.md is recomposed. Read-back is SET
    EQUALITY BOTH WAYS on the reader's fingerprints; any mismatch restores part, MEMORY.md and compose-state and REMOVES
    LEDGER.md, so the file of record always holds every retraction."""
    if ledger_split_active():
        raise Refused(2, "REFUSED: %s already exists - the split has been done" % LEDGER_FILE)
    st = os.stat(TARGET)
    lfd = open_lock(st)
    try:
        fcntl.flock(lfd, fcntl.LOCK_EX)
        with open(TARGET, "rb") as fh:
            mem_old = fh.read()
        mem_old_sha = sha(mem_old)
        state = read_compose_state()
        if mem_old_sha not in ({state.get("last_written_sha"), state.get("pending_sha")} - {None}):
            raise Refused(4, "REFUSED: %s was written outside the composer - reconcile with --compose first" % TARGET)
        parts = read_parts()
        if state.get("parts_sha") and state["parts_sha"] != parts_digest(parts):
            raise Refused(4, "REFUSED: a part changed since the last compose - run --compose first")
        if len(parts) != 1:
            raise Refused(2, "REFUSED: the split handles the single-part layout only; %d parts exist" % len(parts))
        name, part_old_sha, _pb, part_old = parts[0]
        if part_old_sha != opts["--expect-sha"].strip().lower():
            raise Refused(4, "REFUSED: --expect-sha does not match part %s (current %s)" % (name, part_old_sha))
        part_path = os.path.join(PARTS_DIR, name)
        pst = os.stat(part_path)
        reader = load_reader()
        reader_requires_offsets(reader)
        check_stub(stub, reader)
        text = part_old.decode("utf-8")
        heads = [m.start() for m in re.finditer(reader.RETRACTIONS_HEADING_PATTERN, text)]
        if len(heads) != 1:
            raise Refused(2, "REFUSED: %d '### Retractions' headings in the part - exactly one is required" % len(heads))
        a = heads[0]
        anchor_at = text.find(NL + ANCHOR, a)
        if anchor_at == -1:
            raise Refused(2, "REFUSED: %r does not follow the Retractions block" % ANCHOR)
        b_ = anchor_at + 1
        if "\n##" in text[a:anchor_at]:
            raise Refused(2, "REFUSED: a '##' heading sits inside the Retractions block before %r - the reader would end "
                             "the block there, so what moves and what parses would differ" % ANCHOR)
        if text.count(RECIPE_ANCHOR) != 1:
            raise Refused(2, "REFUSED: the header recipe line %r must appear exactly once" % RECIPE_ANCHOR)
        block = text[a:b_]
        ledger_new = (LEDGER_PREAMBLE + block.rstrip(NL) + NL).encode("utf-8")
        part_text = text[:a] + stub.strip(NL) + NL + NL + text[b_:]
        ri = part_text.index(RECIPE_ANCHOR)
        line_end = part_text.index(NL, ri) + 1
        part_text = part_text[:line_end] + RECIPE_NOTE + NL + part_text[line_end:]
        part_new = part_text.encode("utf-8")
        s_old, e_old = reader._parse_ledger(TARGET)
        if s_old != "ok":
            raise Refused(6, "REFUSED: MEMORY.md does not parse before the split (status %s)" % s_old)
        new_parts = [(name, sha(part_new), part_body(part_new), part_new)]
        body, parts_sha, body_sha = compose_body(new_parts)
        mem_new = body + stamp_line(1, parts_sha, body_sha).encode("utf-8") + b"\n"
        mem_new_sha = sha(mem_new)
        growth = growth_gate(mem_old, mem_new, opts, st, "split-ledger")
        part_arch, _ = archive_old(part_old, part_old_sha, st)
        mem_arch, _ = archive_old(mem_old, mem_old_sha, st)
        # the NEW LEDGER.md is archived too: the daily backup covers .memory-archive/, not the live file, so this is what
        # makes "restore LEDGER.md from .memory-archive/" true (Langston Step-4 condition, 2026-10-16)
        archive_old(ledger_new, sha(ledger_new), st)
        row = {"ts": utc(), "target": TARGET, "part": name, "mode": "split-ledger", "part_old_sha": part_old_sha,
               "part_new_sha": sha(part_new), "mem_old_sha": mem_old_sha, "mem_new_sha": mem_new_sha,
               "ledger_sha": sha(ledger_new), "by_claimed": opts["--by"], "via_uid": os.getuid(),
               "reason": opts["--reason"], "part_archived": os.path.basename(part_arch),
               "mem_archived": os.path.basename(mem_arch), "retractions_moved": len(e_old), "ratchet": growth}
        append_index(dict(row, outcome="attempted"), st)
        old_state = dict(state)
        write_compose_state(dict(state, pending_sha=mem_new_sha, ts=utc()), st)
        try:
            replace_file(LEDGER_FILE, ledger_new, pst)          # Q5: the superset first
            replace_file(part_path, part_new, pst)
            replace_target(mem_new, st)
            problems = []
            with open(LEDGER_FILE, "rb") as fh:
                if sha(fh.read()) != sha(ledger_new):
                    problems.append("LEDGER.md read-back mismatch")
            with open(TARGET, "rb") as fh:
                if sha(fh.read()) != mem_new_sha:
                    problems.append("MEMORY.md read-back mismatch")
            # the PART is the file of record and MEMORY.md is composed in memory, so MEMORY.md's read-back cannot see a
            # bad part write (Langston, 13:0xZ - the write and rename paths read it back; this did not)
            with open(part_path, "rb") as fh:
                if sha(fh.read()) != sha(part_new):
                    problems.append("part read-back mismatch")
            s_l, e_l = reader._parse_ledger(LEDGER_FILE)
            s_m, _e_m = reader._parse_ledger(TARGET)
            if s_l != "ok":
                problems.append("LEDGER.md does not parse (status %s)" % s_l)
            else:
                f_old, f_new = _fp(reader, e_old), _fp(reader, e_l)
                if f_old - f_new:
                    problems.append("%d retraction(s) in MEMORY.md are missing from LEDGER.md" % len(f_old - f_new))
                if f_new - f_old:
                    problems.append("%d entr(ies) in LEDGER.md were not in MEMORY.md" % len(f_new - f_old))
            if s_m != "no-section":
                problems.append("MEMORY.md still parses a Retractions section after the split (status %s)" % s_m)
            lg = ledger_guard_after_recompose(reader, body, new_parts)
            if lg:
                problems += lg
            st_now = reader.ledger_state()[0]
            if st_now != "ok":
                problems.append("recall's ledger_state is %s after the split" % st_now)
            inject = os.environ.get("LMW_TEST_SPLIT_FAIL")
            if inject and os.path.realpath(LANGSTON_HOME) != os.path.realpath(LIVE_HOME):   # self-test only, never live
                if inject == "raise":
                    raise RuntimeError("injected crash after the split writes")
                problems.append("injected post-write failure")
            if problems:
                raise Refused(5, "REFUSED (split): " + "; ".join(problems))
        except BaseException as e:
            try:
                replace_file(part_path, part_old, pst)
                replace_target(mem_old, st)
                write_compose_state(old_state, st)
                try:
                    os.remove(LEDGER_FILE)               # Q5b: fail toward the breach - MEMORY.md keeps the block
                except FileNotFoundError:
                    pass
                with open(TARGET, "rb") as fh:
                    mem_ok = sha(fh.read()) == mem_old_sha
                with open(part_path, "rb") as fh:
                    part_ok = sha(fh.read()) == part_old_sha
                restored = mem_ok and part_ok and not os.path.exists(LEDGER_FILE)
            except BaseException as re_err:
                append_index(dict(row, ts=utc(), outcome="restore-failed", why=type(re_err).__name__), st)
                raise Refused(6, "REFUSED: SPLIT RESTORE FAILED (%s). part at %s, MEMORY.md at %s - restore by hand and "
                                 "remove LEDGER.md; tell Infra Claude." % (type(re_err).__name__, part_arch, mem_arch))
            append_index(dict(row, ts=utc(), outcome="restored" if restored else "restore-incomplete", why=str(e)[:300]), st)
            if not restored:
                raise Refused(6, "REFUSED: the split rollback was NOT complete (cause: %s). part at %s, MEMORY.md at %s - "
                                 "restore by hand, remove LEDGER.md, tell Infra Claude." % (str(e)[:160], part_arch, mem_arch))
            base = str(e) if isinstance(e, Refused) else "the post-write check crashed (%s)" % type(e).__name__
            raise Refused(5, "REFUSED: " + base + " - MEMORY.md, the part and compose-state restored, LEDGER.md removed")
        write_compose_state({"last_written_sha": mem_new_sha, "pending_sha": None, "ts": utc(),
                             "parts_sha": parts_sha, "part_count": 1}, st)
        append_index(dict(row, ts=utc(), outcome="written"), st)
        return ("SPLIT: %d retractions moved to LEDGER.md (%d B); MEMORY.md %d -> %d B; set equality both ways held; %s"
                % (len(e_old), len(ledger_new), len(mem_old), len(mem_new), size_line(len(mem_new))))
    finally:
        os.close(lfd)


# ---------------- the trim (B-LANGSTON-RELIEF OBJ-3 Q3, Langston's ruling + allowlist r1, 2026-10-16) ----------------
# Eviction by SUPERSESSION, never by age (PHASE_19_PLAN 2.8a). A batch section's state is a DECLARED FIELD at a fixed
# position - its last non-blank line - never read from its prose (his BLOCKER-2: a heading quotes its own history):
#     STATE: closed · batch: <id> · superseded-by: <path>        STATE: open · batch: <id>
# --trim moves every `STATE: closed` section VERBATIM to MEMORY-ARCHIVE.md (not auto-loaded; indexed by langston-recall),
# leaves one index line per section plus its `keep: ` lines under `## Archived batch sections`, and REFUSES - before any
# write - if any non-protected `## ` section carries no STATE line, naming the count, so an absent marker announces
# itself instead of reading as "nothing to evict". Same lock, archive, guards and fail-toward-the-breach rollback.
ARCHIVE_FILE = os.path.join(LANGSTON_HOME, "MEMORY-ARCHIVE.md")
ARCHIVE_PREAMBLE = ("# Langston — MEMORY-ARCHIVE.md: closed batch sections evicted from MEMORY.md (B-LANGSTON-RELIEF OBJ-3)\n\n"
                    "Not auto-loaded. `langston-recall <batch-id | term>` searches it. Written ONLY by "
                    "`langston-memory-write --trim`, append-only; every version is in `.memory-archive/<sha>.md`.\n\n")
TRIM_PROTECTED = ("## ★", "## RULINGS OF YOURS EXECUTED", "## Archived batch sections")
# (TRIM_INDEX_HEADING, which named that section's heading, was deleted with this change - nothing references it.)
# ⛔ NO INDEX LINES (Langston, 2026-10-17, on the 79 KB MEMORY.md): each eviction used to append a "- `<id>` — evicted"
#    line here - 144 B per batch, unbounded, 37 lines / 5,353 B by then - and every byte of it is already in the
#    archived section's own STATE line, inside the region recall indexes. Retrieval is `langston-recall <id>`;
#    discovery is BATCH_CATALOG + the completion reports. A third copy is the #641 two-sources failure. The trim now
#    adds NOTHING to that section; `keep:` lines (deliberately retained standing content) are hoisted into the
#    section below - "## ★" so it is protected - never into an index heading.
TRIM_KEEP_HEADING = "## ★ Kept lines from closed batches (each `keep:` line was hoisted by the trim when its batch closed)"
STATE_RE = re.compile(r"^STATE: (closed|open) · batch: (.+?)(?: · superseded-by: (.+))?$")


def trim_plan(text):
    """Pure: (keep_text, evicted [(id, superseded, section_lines)], added_index_lines, open_count) or Refused.
    The part is split at column-0 '## ' headings; the header block before the first is untouched."""
    lines = text.split(NL)
    if lines and lines[-1] == "":
        lines = lines[:-1]
    heads = [i for i, l in enumerate(lines) if l.startswith("## ")]
    if not heads:
        raise Refused(2, "REFUSED: no '## ' sections in the part")
    out = lines[:heads[0]]
    evicted, unmarked, open_n = [], [], 0
    for k, h in enumerate(heads):
        sec = lines[h:(heads[k + 1] if k + 1 < len(heads) else len(lines))]
        title = sec[0]
        if title.startswith(TRIM_PROTECTED):
            if any(l.startswith("STATE: ") for l in sec):
                raise Refused(2, "REFUSED: a STATE line inside protected section %r" % title[:60])
            out += sec
            continue
        nonblank = [l for l in sec if l.strip()]
        states = [l for l in sec if l.startswith("STATE: ")]
        if len(states) != 1 or nonblank[-1] != states[0]:
            unmarked.append(title[:70])
            out += sec
            continue
        m = STATE_RE.match(states[0])
        if not m:
            raise Refused(2, "REFUSED: unparseable STATE line in %r: %r" % (title[:50], states[0][:80]))
        if m.group(1) == "open":
            open_n += 1
            out += sec
            continue
        if not m.group(3):
            raise Refused(2, "REFUSED: a closed section must name superseded-by: %r" % title[:60])
        evicted.append((m.group(2), m.group(3).strip(), sec))
    if unmarked:
        raise Refused(2, "REFUSED: %d batch section(s) carry no STATE line as their last line - declare one before any "
                         "trim (first: %r). Nothing was evicted." % (len(unmarked), unmarked[0]))
    keeps = [l for _bid, _sup, sec in evicted for l in sec if l.startswith("keep: ")]
    added = []
    if keeps:
        keep_at = next((i for i, l in enumerate(out) if l.startswith(TRIM_KEEP_HEADING[:40])), None)
        while out and out[-1] == "":
            out.pop()
        if keep_at is None:
            out += ["", TRIM_KEEP_HEADING, ""] + keeps
            added = [TRIM_KEEP_HEADING] + keeps
        else:
            nxt = next((i for i in range(keep_at + 1, len(out)) if out[i].startswith("## ")), len(out))
            seg = out[keep_at:nxt]
            while seg and seg[-1] == "":
                seg.pop()
            out = out[:keep_at] + seg + keeps + ([""] + out[nxt:] if nxt < len(out) else [])
            added = list(keeps)
    keep_text = NL.join(out).rstrip(NL) + NL
    return keep_text, evicted, added, open_n


def do_trim(opts):
    st = os.stat(TARGET)
    lfd = open_lock(st)
    try:
        fcntl.flock(lfd, fcntl.LOCK_EX)
        with open(TARGET, "rb") as fh:
            mem_old = fh.read()
        mem_old_sha = sha(mem_old)
        state = read_compose_state()
        if mem_old_sha not in ({state.get("last_written_sha"), state.get("pending_sha")} - {None}):
            raise Refused(4, "REFUSED: %s was written outside the composer - reconcile with --compose first" % TARGET)
        parts = read_parts()
        if state.get("parts_sha") and state["parts_sha"] != parts_digest(parts):
            raise Refused(4, "REFUSED: a part changed since the last compose - run --compose first")
        if len(parts) != 1:
            raise Refused(2, "REFUSED: the trim handles the single-part layout only; %d parts exist" % len(parts))
        name, part_old_sha, _pb, part_old = parts[0]
        part_path = os.path.join(PARTS_DIR, name)
        pst = os.stat(part_path)
        keep_text, evicted, added, open_n = trim_plan(part_old.decode("utf-8"))
        if not evicted:
            if opts.get("--dry-run"):
                return "TRIM DRY RUN: nothing to evict (%d open batch section(s), 0 unmarked); nothing written" % open_n
            # Langston, Step 8 gate A (2026-10-17): systemctl holds only the LAST run, so a clean no-op night is
            # unreadable once the unit runs again. One row per no-op run gives the nightly history and the section
            # census. It is NOT a link in the sha chain: no old/new sha, no archive - last_index_row() skips it.
            row = {"ts": utc(), "target": TARGET, "part": name, "mode": "trim-noop", "outcome": "noop",
                   "part_sha": part_old_sha, "mem_sha": mem_old_sha,
                   "sections_open": open_n, "sections_closed": 0, "unmarked": 0}
            if not noop_rows_exist():
                row["note"] = ("first trim-noop row: nights before this row have no row BY DESIGN (the row type did "
                               "not exist), not because the trim did not run")
            append_index(row, st)
            return "TRIM: nothing to evict (%d open batch section(s), 0 unmarked); no-op row recorded" % open_n
        if opts.get("--dry-run"):
            return "TRIM DRY RUN: would evict %d section(s) [%s], %d open stay; part %d -> %d B; nothing written" % (
                len(evicted), ", ".join(b for b, _s, _x in evicted), open_n, len(part_old), len(keep_text.encode("utf-8")))
        reader = load_reader()
        reader_requires_offsets(reader)
        arch_existed = os.path.isfile(ARCHIVE_FILE)
        arch_old = open(ARCHIVE_FILE, "rb").read() if arch_existed else b""
        block = ""
        for bid, _sup, sec in evicted:
            body = list(sec)
            while body and body[-1] == "":
                body.pop()
            block += "<!-- evicted %s from MEMORY.md by langston-memory-write --trim; batch %s -->%s%s%s%s" % (
                utc(), bid, NL, NL.join(body), NL, NL)
        arch_new = (arch_old.decode("utf-8") if arch_existed else ARCHIVE_PREAMBLE) + block
        arch_new_b = arch_new.encode("utf-8")
        part_new = keep_text.encode("utf-8")
        # line conservation (checked BEFORE any write): the old part's non-blank lines == the new part's minus the lines
        # this trim added (the hoisted keep: lines, and the kept-lines heading if it created one), plus the evicted lines
        from collections import Counter
        nb = lambda ls: Counter(l for l in ls if l.strip())
        lhs = nb(part_old.decode("utf-8").split(NL))
        rhs = nb(keep_text.split(NL)) - nb(added)
        for _b, _s, sec in evicted:
            rhs += nb(sec)
        if lhs != rhs:
            raise Refused(6, "REFUSED: trim line conservation does not close (%d lost, %d extra) - nothing written"
                          % (sum((lhs - rhs).values()), sum((rhs - lhs).values())))
        new_parts = [(name, sha(part_new), part_body(part_new), part_new)]
        body_, parts_sha, body_sha = compose_body(new_parts)
        mem_new = body_ + stamp_line(1, parts_sha, body_sha).encode("utf-8") + b"\n"
        mem_new_sha = sha(mem_new)
        r_before = retraction_count(reader, TARGET)
        part_arch, _ = archive_old(part_old, part_old_sha, st)
        mem_arch, _ = archive_old(mem_old, mem_old_sha, st)
        if arch_existed:
            archive_old(arch_old, sha(arch_old), st)
        archive_old(arch_new_b, sha(arch_new_b), st)
        # ⚠️ ERA WARNING (Langston, 2026-10-16): recall dates an archived section by EVICTION time, so its cross-corpus
        #    caution cannot see a section from before the 2026-06-19 Discord cutover. The trim is the only writer of
        #    the archive, so it names any section whose heading lines carry a pre-cutover date - stated, never blocking.
        pre_cutover = [bid for bid, _s, sec in evicted
                       if any(d < "2026-06-19" for l in sec if l.startswith("#")
                              for d in re.findall(r"20\d\d-\d\d-\d\d", l))]
        row = {"ts": utc(), "target": TARGET, "part": name, "mode": "trim", "part_old_sha": part_old_sha,
               "part_new_sha": sha(part_new), "mem_old_sha": mem_old_sha, "mem_new_sha": mem_new_sha,
               "memory_archive_sha": sha(arch_new_b), "evicted": [b for b, _s, _x in evicted], "open_left": open_n,
               "pre_cutover_heading": pre_cutover,
               "by_claimed": opts["--by"], "via_uid": os.getuid(), "reason": opts["--reason"]}
        append_index(dict(row, outcome="attempted"), st)
        old_state = dict(state)
        write_compose_state(dict(state, pending_sha=mem_new_sha, ts=utc()), st)
        try:
            replace_file(ARCHIVE_FILE, arch_new_b, pst)           # the superset first - fail toward the breach
            replace_file(part_path, part_new, pst)
            replace_target(mem_new, st)
            problems = []
            with open(ARCHIVE_FILE, "rb") as fh:
                got = fh.read()
            if sha(got) != sha(arch_new_b) or not got.startswith(arch_old if arch_existed else ARCHIVE_PREAMBLE.encode("utf-8")):
                problems.append("MEMORY-ARCHIVE.md read-back mismatch, or its prior content is not a prefix of it")
            with open(TARGET, "rb") as fh:
                if sha(fh.read()) != mem_new_sha:
                    problems.append("MEMORY.md read-back mismatch")
            with open(part_path, "rb") as fh:                  # the file of record (Langston, 13:0xZ)
                if sha(fh.read()) != sha(part_new):
                    problems.append("part read-back mismatch")
            if any(l.startswith("STATE: closed") for l in keep_text.split(NL)):
                problems.append("a closed section survived the trim")
            if retraction_count(reader, TARGET) != r_before:
                problems.append("the retraction count moved")
            problems += ledger_guard_after_recompose(reader, body_, new_parts)
            if problems:
                raise Refused(5, "REFUSED (trim): " + "; ".join(problems))
        except BaseException as e:
            try:
                replace_file(part_path, part_old, pst)
                replace_target(mem_old, st)
                write_compose_state(old_state, st)
                if arch_existed:
                    replace_file(ARCHIVE_FILE, arch_old, pst)
                elif os.path.exists(ARCHIVE_FILE):
                    os.remove(ARCHIVE_FILE)
                with open(TARGET, "rb") as fh:
                    ok = sha(fh.read()) == mem_old_sha
                with open(part_path, "rb") as fh:
                    ok = ok and sha(fh.read()) == part_old_sha
            except BaseException as re_err:
                append_index(dict(row, ts=utc(), outcome="restore-failed", why=type(re_err).__name__), st)
                raise Refused(6, "REFUSED: TRIM RESTORE FAILED (%s). part at %s, MEMORY.md at %s - tell Infra Claude."
                              % (type(re_err).__name__, part_arch, mem_arch))
            append_index(dict(row, ts=utc(), outcome="restored" if ok else "restore-incomplete", why=str(e)[:300]), st)
            if not ok:
                raise Refused(6, "REFUSED: the trim rollback was NOT complete (cause: %s). part at %s, MEMORY.md at %s"
                              % (str(e)[:160], part_arch, mem_arch))
            base = str(e) if isinstance(e, Refused) else "the post-write check crashed (%s)" % type(e).__name__
            raise Refused(5, "REFUSED: " + base + " - part, MEMORY.md, compose-state and MEMORY-ARCHIVE.md restored")
        write_compose_state({"last_written_sha": mem_new_sha, "pending_sha": None, "ts": utc(),
                             "parts_sha": parts_sha, "part_count": 1}, st)
        append_index(dict(row, ts=utc(), outcome="written"), st)
        warn = ("" if not pre_cutover else
                "; ⚠️ PRE-CUTOVER ERA in the heading of %s - recall dates these by eviction time, so its cross-corpus "
                "caution will NOT fire for them" % ", ".join(pre_cutover))
        return "TRIM: evicted %d section(s) [%s] to MEMORY-ARCHIVE.md; %d open stay; MEMORY.md %d -> %d B; %s%s" % (
            len(evicted), ", ".join(b for b, _s, _x in evicted), open_n, len(mem_old), len(mem_new),
            size_line(len(mem_new)), warn)
    finally:
        os.close(lfd)


def run(argv, stdin_bytes):
    opts = parse_args(argv)
    if opts.get("--trim"):
        for req in ("--by", "--reason"):
            if req not in opts or not str(opts[req]).strip():
                raise Refused(2, "REFUSED: %s is required" % req)
        if os.geteuid() not in (0, pwd.getpwnam(OWNER).pw_uid):
            raise Refused(3, "REFUSED: run as root or %s only" % OWNER)
        return do_trim(opts)
    if opts.get("--split-ledger"):
        for req in ("--expect-sha", "--by", "--reason"):
            if req not in opts or not str(opts[req]).strip():
                raise Refused(2, "REFUSED: %s is required" % req)
        if os.geteuid() not in (0, pwd.getpwnam(OWNER).pw_uid):
            raise Refused(3, "REFUSED: run as root or %s only" % OWNER)
        try:
            stub = stdin_bytes.decode("utf-8")
        except UnicodeDecodeError:
            raise Refused(2, "REFUSED: the stub on stdin is not valid UTF-8")
        return do_split_ledger(opts, stub)
    if opts.get("--compose"):
        for req in ("--by", "--reason"):
            if req not in opts or not str(opts[req]).strip():
                raise Refused(2, "REFUSED: %s is required" % req)
        for bad in ("--expect-sha", "--ledger-append", "--ledger-delta", "--retractions-delta", "--entries"):
            if bad in opts:
                raise Refused(2, "REFUSED: %s does not apply to --compose" % bad)
        owner_uid = pwd.getpwnam(OWNER).pw_uid
        if os.geteuid() not in (0, owner_uid):
            raise Refused(3, "REFUSED: run as root or %s only" % OWNER)
        return do_compose(opts)
    if opts.get("--rename-part"):
        for req in ("--expect-sha", "--by", "--reason"):
            if req not in opts or not str(opts[req]).strip():
                raise Refused(2, "REFUSED: %s is required" % req)
        owner_uid = pwd.getpwnam(OWNER).pw_uid
        if os.geteuid() not in (0, owner_uid):
            raise Refused(3, "REFUSED: run as root or %s only" % OWNER)
        return do_rename(opts)
    owner_uid = pwd.getpwnam(OWNER).pw_uid
    if os.geteuid() not in (0, owner_uid):
        raise Refused(3, "REFUSED: run as root or %s only" % OWNER)
    for req in ("--expect-sha", "--by", "--reason"):
        if req not in opts or not str(opts[req]).strip():
            raise Refused(2, "REFUSED: %s is required" % req)
    append = bool(opts.get("--ledger-append"))
    try:
        if append:
            declared_ledger = declared_retractions = int(opts["--entries"])
        else:
            declared_ledger = int(opts["--ledger-delta"])
            declared_retractions = int(opts["--retractions-delta"])
    except KeyError as e:
        raise Refused(2, "REFUSED: %s is required" % e.args[0])
    except ValueError:
        raise Refused(2, "REFUSED: a declared count must be an integer")
    try:
        content = stdin_bytes.decode("utf-8")
    except UnicodeDecodeError:
        raise Refused(2, "REFUSED: stdin is not valid UTF-8")
    if append:
        check_entry_text(content, declared_ledger)
        # Q2 (Langston, 2026-10-16): after the split the retractions live in LEDGER.md, and an append NEVER recreates it.
        if ledger_split_active():
            return do_ledger_file_append(opts, content, declared_ledger)
        reader = load_reader()
        if reader._parse_ledger(TARGET)[0] == "no-section":
            raise Refused(2, "REFUSED: %s is missing and %s has no '### Retractions' section - the ledger was split out "
                             "and its file is gone. An append never recreates it (the counters would restart at zero). "
                             "Restore LEDGER.md from .memory-archive/ and tell Infra Claude." % (LEDGER_FILE, TARGET))
    elif not content.strip():
        raise Refused(2, "REFUSED: empty stdin would blank the memory file")
    # ⛔ P-2 unit 2 dispatch (Langston BLOCKER-2, 21:22Z): predicate on the PARTS, not the state - so losing the state
    #    file with parts in place REFUSES rather than falling open onto MEMORY.md and stranding the parts. Before the
    #    migration (no parts dir) the legacy MEMORY.md path is unchanged, so the tool behaves exactly as today and the
    #    self-test (no parts) exercises the legacy path.
    try:
        parts_present = os.path.isdir(PARTS_DIR) and any(
            not n.startswith(".") and os.path.isfile(os.path.join(PARTS_DIR, n)) for n in os.listdir(PARTS_DIR))
    except OSError as e:
        raise Refused(6, "REFUSED: cannot read the parts directory %s (%s) - fix its permissions; nothing was "
                         "written." % (PARTS_DIR, type(e).__name__))
    state_live = bool(read_compose_state().get("last_written_sha"))
    if parts_present or state_live:
        if not state_live:
            raise Refused(2, "REFUSED: %s holds parts but %s has no compose-state - the composed model is half-installed "
                             "or the state file was lost. Run --compose to reconcile before any direct write; refusing to "
                             "write MEMORY.md directly and strand the parts." % (PARTS_DIR, TARGET))
        return do_direct_write(opts, content, append, declared_ledger, declared_retractions)
    return do_direct_write_legacy(opts, content, append, declared_ledger, declared_retractions)


def do_direct_write_legacy(opts, content, append, declared_ledger, declared_retractions):
    """Pre-migration path: the write targets MEMORY.md directly, as before P-2. Unchanged from P-6b.
    ⛔ UNREACHABLE on a migrated box (parts present + state_live route to do_direct_write); it survives only because the
    self-test still exercises it. SCHEDULED FOR DELETION in the retrofit batch (P-3, RUNNING_ISSUES #1055), right after
    the self-test is re-pointed at the parts path - do not harden code we are about to delete (Langston Step-4 Q2, §15).
    It deliberately does NOT call reader_requires_offsets and carries none of the four byte-based ledger guards: it runs
    no offset-based guard, so the offset field it would probe for is never read on this path."""
    reader = load_reader()
    try:
        st = os.stat(TARGET)
    except OSError as e:
        raise Refused(2, "REFUSED: cannot stat the target %s (%s)" % (TARGET, type(e).__name__))
    lfd = open_lock(st)
    try:
        fcntl.flock(lfd, fcntl.LOCK_EX)
        hold = float(os.environ.get("LMW_TEST_HOLD_AFTER_LOCK", "0") or 0)   # self-test only: widen the race window
        with open(TARGET, "rb") as fh:
            old = fh.read()
        old_sha = sha(old)
        if hold:
            time.sleep(hold)
        if old_sha != opts["--expect-sha"].strip().lower():
            raise Refused(4, cas_mismatch_message(old_sha))
        r_before = retraction_count(reader, TARGET)
        l_before = ledger_block_count(old.decode("utf-8"))
        new_text = compose_append(old.decode("utf-8"), content) if append else content
        new = new_text.encode("utf-8")
        new_sha = sha(new)
        growth = growth_gate(old, new, opts, st, "ledger-append" if append else "whole-file")
        arch_path, created = archive_old(old, old_sha, st)
        row = {"ts": utc(), "target": TARGET, "old_sha": old_sha, "new_sha": new_sha,
               "old_bytes": len(old), "new_bytes": len(new), "mode": "ledger-append" if append else "whole-file",
               "declared_ledger_delta": declared_ledger, "declared_retractions_delta": declared_retractions,
               "by_claimed": opts["--by"], "via_uid": os.getuid(), "reason": opts["--reason"],
               "archived": os.path.basename(arch_path), "archive_created": created,
               "mode_before": oct(st.st_mode & 0o7777), "mode_after": oct(owner_only(st.st_mode)),
               "ratchet": growth}
        append_index(dict(row, outcome="attempted"), st)          # FINDING-2: the ATTEMPT is on record first
        try:
            replace_target(new, st)
        except OSError as e:
            append_index(dict(row, ts=utc(), outcome="replace-failed", why=type(e).__name__), st)
            raise Refused(6, "REFUSED: the replace failed (%s). The rename is atomic, so the target should still be "
                             "the previous content; that content is also at %s" % (type(e).__name__, arch_path))
        try:
            r_after = retraction_count(reader, TARGET)
            with open(TARGET, "rb") as fh:
                l_after = ledger_block_count(fh.read().decode("utf-8"))
            problems = []
            if r_after - r_before != declared_retractions:
                problems.append("retraction entries moved %+d, declared %+d" % (r_after - r_before, declared_retractions))
            if l_after - l_before != declared_ledger:
                problems.append("REVIEWER LEDGER bullets moved %+d, declared %+d" % (l_after - l_before, declared_ledger))
            if problems:
                raise Refused(5, "REFUSED (rule 4): " + "; ".join(problems) + " - previous content restored")
        except BaseException as e:
            try:
                corrupt = b"#corrupted-by-self-test" if corrupt_switch_armed(LANGSTON_HOME) else b""   # self-test only, never live
                replace_target(old + corrupt, st)
                with open(TARGET, "rb") as fh:
                    restored_ok = sha(fh.read()) == old_sha
            except BaseException as re_err:
                append_index(dict(row, ts=utc(), outcome="restore-failed", why=type(re_err).__name__), st)
                raise Refused(6, "REFUSED: RESTORE FAILED (%s). The target may hold the rejected content. The previous "
                                 "content is at %s (sha %s) - restore it by hand and tell Infra Claude."
                              % (type(re_err).__name__, arch_path, old_sha))
            append_index(dict(row, ts=utc(), outcome="restored", restored_byte_identical=restored_ok, why=str(e)[:300]), st)
            if not restored_ok:
                # ⛔ AMENDMENT E (Langston, 19:06Z): an INEXACT rollback is not a clean one. The operator action differs -
                #    restore by hand and tell Infra Claude - which is what exit 6 already means. It must not read as 5.
                raise Refused(6, "REFUSED: the rollback did NOT restore the previous content byte-for-byte (cause: %s). The "
                                 "target may hold neither version. The previous content is at %s (sha %s) - restore it by "
                                 "hand and tell Infra Claude." % (str(e)[:200], arch_path, old_sha))
            if isinstance(e, Refused):
                # ⛔ CONDITION 1 (Langston, 18:43Z): a refusal raised by the post-replace recount - e.g. new content
                #    carrying a pasted-twice ledger heading, which ledger_block_count refuses as exit 2 - must NOT keep
                #    its own code. Exit 2 means "refused input, nothing touched"; here the content transited the live
                #    file and was rolled back. So it is exit 5, with the cause kept and the restore stated.
                text = str(e)
                if "restored" not in text:
                    text += " - the new content reached the live file and was rolled back"
                raise Refused(5, text + "; previous content restored, byte-identical=%s; also at %s" % (restored_ok, arch_path))
            raise Refused(5, "REFUSED: the post-write check crashed (%s) - previous content restored, byte-identical=%s; "
                             "it is also at %s" % (type(e).__name__, restored_ok, arch_path))
        outcome = "no-change" if new_sha == old_sha else "written"
        append_index(dict(row, ts=utc(), outcome=outcome, retractions=[r_before, r_after], ledger_bullets=[l_before, l_after]), st)
        return "%s %s -> %s (%d -> %d B; retractions %d -> %d; REVIEWER LEDGER bullets %d -> %d); %s" % (
            outcome.upper(), old_sha[:16], new_sha[:16], len(old), len(new), r_before, r_after, l_before, l_after,
            size_line(len(new)))
    finally:
        os.close(lfd)


def do_direct_write(opts, content, append, declared_ledger, declared_retractions):
    """P-2 unit 2: the write TARGETS A PART; MEMORY.md is then recomposed. --expect-sha is the sha of the PART the
    caller read. A failed post-write delta rolls back all THREE of part, MEMORY.md and compose-state to their exact
    prior bytes (recompose re-stamps, so it cannot restore byte-identically - hence three-way, not a recompose)."""
    reader = load_reader()
    reader_requires_offsets(reader)   # fail-fast before any write if the reader predates the P-2 offset field
    try:
        st = os.stat(TARGET)
    except OSError as e:
        raise Refused(2, "REFUSED: cannot stat the target %s (%s)" % (TARGET, type(e).__name__))
    lfd = open_lock(st)
    try:
        fcntl.flock(lfd, fcntl.LOCK_EX)
        hold = float(os.environ.get("LMW_TEST_HOLD_AFTER_LOCK", "0") or 0)   # self-test only: widen the race window
        with open(TARGET, "rb") as fh:
            mem_old = fh.read()
        mem_old_sha = sha(mem_old)
        state = read_compose_state()
        admissible = {state.get("last_written_sha"), state.get("pending_sha")} - {None}
        if mem_old_sha not in admissible:
            raise Refused(4, "REFUSED: %s was written OUTSIDE the composer (out-of-band). Its current sha is %s; the "
                             "composer last wrote %s (pending %s). Reconcile the parts and recompose before writing."
                          % (TARGET, mem_old_sha, state.get("last_written_sha"), state.get("pending_sha")))
        parts = read_parts()
        # BLOCKER-1 (Langston 21:22Z): the parts are the file of record. If a part changed out of band since the last
        #   compose, a direct write would launder it into MEMORY.md. Refuse - --compose is the reconciliation verb, not this.
        cur_parts_sha = parts_digest(parts)
        if state.get("parts_sha") and state["parts_sha"] != cur_parts_sha:
            raise Refused(4, "REFUSED: a part in %s changed since the last compose (parts-sha %s, last composed %s). A "
                             "direct write would fold that unreviewed change into %s. Run --compose to reconcile first."
                          % (PARTS_DIR, cur_parts_sha, state["parts_sha"], TARGET))
        explicit_part = opts.get("--part")
        # ⛔ BLOCKER (Langston 22:38Z): a --part name must be a MEMBER of the set read_parts() enumerates, or a create
        #    could mint a part the enumerator never sees again (a dotfile, a subdir, `..`, or an absolute path - a
        #    root-run write to an arbitrary location). Predicate, not a blacklist.
        if explicit_part is not None and not valid_part_name(explicit_part):
            raise Refused(2, "REFUSED: --part %r is not a bare part filename (no directories, no '..', no leading '.'). "
                             "A part lives directly in %s and read_parts() would never see this name." % (explicit_part, PARTS_DIR))
        target_name, resolve_rule = resolve_target_part(parts, append, explicit_part)
        part_path = os.path.join(PARTS_DIR, target_name)
        expect = opts["--expect-sha"].strip().lower()
        if hold:
            time.sleep(hold)
        # --part with `--expect-sha new` CREATES a part (the retrofit's split); it must not already exist.
        is_new = (not append) and explicit_part is not None and expect == "new"
        if is_new:
            if os.path.exists(part_path):
                raise Refused(4, "REFUSED: --part %s exists - pass its current sha as --expect-sha, not 'new'." % target_name)
            part_old, part_old_sha, pst = b"", None, st   # a new part inherits MEMORY.md's owner/mode
        else:
            if not os.path.isfile(part_path):
                raise Refused(4, "REFUSED: part %s does not exist. Pass `--expect-sha new` to create it (with --part); "
                                 "a whole-file write never creates a part implicitly." % part_path)
            pst = os.stat(part_path)
            with open(part_path, "rb") as fh:
                part_old = fh.read()
            part_old_sha = sha(part_old)
            if part_old_sha != expect:
                raise Refused(4, "REFUSED: --expect-sha does not match the part it names. Compared against %s: its current "
                                 "sha256 is %s, you passed %s. (Since P-2, --expect-sha is the PART's sha, not MEMORY.md's.)"
                              % (part_path, part_old_sha, expect))
        r_before = retraction_count(reader, TARGET)
        l_before = ledger_block_count(mem_old.decode("utf-8"))
        # FINDING-1 (Langston 21:22Z): a whole-file write that carries a stamp line is the composed file pasted where
        #   the PART belongs - it would bake the stamp into the part body and grow MEMORY.md by a stale stamp per write.
        if not append and any(STAMP_RE.match(l) for l in content.split(NL)):
            raise Refused(2, "REFUSED: the content carries a `<!-- composed ... -->` stamp line - you passed the composed "
                             "%s, not the part. Fetch and pass the part's own bytes." % os.path.basename(TARGET))
        part_new_text = compose_append(part_old.decode("utf-8"), content) if append else content
        part_new = part_new_text.encode("utf-8")
        if not part_new.endswith(b"\n") or part_new.endswith(b"\n\n"):
            raise Refused(2, "REFUSED: the new content for part %s must end in exactly one newline; the composer never "
                             "normalizes" % part_path)
        if is_new:
            new_parts = sorted(parts + [(target_name, sha(part_new), part_body(part_new), part_new)], key=lambda t: t[0])
        else:
            new_parts = [(n, sha(part_new), part_body(part_new), part_new) if n == target_name else (n, h, b, rb) for (n, h, b, rb) in parts]
        body, parts_sha, body_sha = compose_body(new_parts)
        mem_new = body + stamp_line(len(new_parts), parts_sha, body_sha).encode("utf-8") + b"\n"
        mem_new_sha = sha(mem_new)
        growth = growth_gate(mem_old, mem_new, opts, st, "part-ledger-append" if append else "part-whole-file")
        part_arch = None if is_new else archive_old(part_old, part_old_sha, st)[0]   # a create has no prior part to archive
        mem_arch, _ = archive_old(mem_old, mem_old_sha, st)
        row = {"ts": utc(), "target": TARGET, "part": target_name, "part_old_sha": part_old_sha,
               "part_new_sha": sha(part_new), "mem_old_sha": mem_old_sha, "mem_new_sha": mem_new_sha,
               "mode": "part-ledger-append" if append else "part-whole-file",
               "declared_ledger_delta": declared_ledger, "declared_retractions_delta": declared_retractions,
               "by_claimed": opts["--by"], "via_uid": os.getuid(), "reason": opts["--reason"],
               "part_archived": (os.path.basename(part_arch) if part_arch else None), "created": is_new,
               "mem_archived": os.path.basename(mem_arch), "resolve_rule": resolve_rule, "ratchet": growth}
        append_index(dict(row, outcome="attempted"), st)
        old_state = dict(state)
        write_compose_state(dict(state, pending_sha=mem_new_sha, ts=utc()), st)
        replace_file(part_path, part_new, pst)
        replace_target(mem_new, st)
        try:
            with open(part_path, "rb") as fh:
                if sha(fh.read()) != sha(part_new):
                    raise Refused(6, "REFUSED: part read-back mismatch after write")
            # ⛔ ROUND-TRIP (Langston 22:38Z): the part just written MUST be a member of what read_parts() enumerates -
            #    proves the name is not one the enumerator drops (the create-that-vanishes). Rolls back if not.
            if target_name not in [n for n, _, _, _ in read_parts()]:
                raise Refused(6, "REFUSED: part %s is not enumerated by read_parts() after the write - the name is not "
                                 "one the composer can see; rolling back." % target_name)
            with open(TARGET, "rb") as fh:
                mem_back = fh.read()
            if sha(mem_back) != mem_new_sha or strip_stamp(mem_back) != body:
                raise Refused(6, "REFUSED: MEMORY.md read-back mismatch after recompose")
            r_after = retraction_count(reader, TARGET)
            l_after = ledger_block_count(mem_back.decode("utf-8"))
            problems = []
            if r_after - r_before != declared_retractions:
                problems.append("retraction entries moved %+d, declared %+d" % (r_after - r_before, declared_retractions))
            if l_after - l_before != declared_ledger:
                problems.append("REVIEWER LEDGER bullets moved %+d, declared %+d" % (l_after - l_before, declared_ledger))
            if problems:
                raise Refused(5, "REFUSED (rule 4): " + "; ".join(problems))
            # ⛔ LEDGER GUARDS (Langston C-1..C-3): rule 4 above governs the DECLARED count deltas; these govern the
            #    block's STRUCTURE - moved, split across parts, a lost subsection, an entry outside its own span. Same
            #    try-block, so a problem hits the three-way rollback below (part + MEMORY.md + compose-state).
            lg = ledger_guard_after_recompose(reader, body, new_parts)
            if lg:
                raise Refused(5, "REFUSED (ledger integrity): " + "; ".join(lg))
        except BaseException as e:
            # THREE-WAY ROLLBACK (Langston 20:48Z): restore the exact prior bytes of part, MEMORY.md AND compose-state.
            corrupt = b"#corrupted-by-self-test" if corrupt_switch_armed(LANGSTON_HOME) else b""   # self-test only, never live
            try:
                if is_new:
                    # a create's prior state is "no such part" - restore = remove it (corrupt switch leaves it, for the test)
                    if not corrupt:
                        try:
                            os.remove(part_path)
                        except FileNotFoundError:
                            pass
                    part_ok = (not os.path.exists(part_path))
                else:
                    replace_file(part_path, part_old, pst)
                    with open(part_path, "rb") as fh:
                        part_ok = sha(fh.read()) == part_old_sha
                replace_target(mem_old + corrupt, st)
                write_compose_state(old_state, st)
                with open(TARGET, "rb") as fh:
                    mem_ok = sha(fh.read()) == mem_old_sha
                state_ok = read_compose_state() == old_state
            except BaseException as re_err:
                append_index(dict(row, ts=utc(), outcome="restore-failed", why=type(re_err).__name__), st)
                raise Refused(6, "REFUSED: THREE-WAY RESTORE FAILED (%s). part at %s, MEMORY.md at %s - restore by hand "
                                 "and tell Infra Claude." % (type(re_err).__name__, part_arch, mem_arch))
            restored_ok = part_ok and mem_ok and state_ok
            append_index(dict(row, ts=utc(), outcome="restored", part_ok=part_ok, mem_ok=mem_ok, state_ok=state_ok,
                              why=str(e)[:300]), st)
            if not restored_ok:
                raise Refused(6, "REFUSED: the three-way rollback was NOT byte-identical (part_ok=%s mem_ok=%s state_ok=%s; "
                                 "cause: %s). part at %s, MEMORY.md at %s - restore by hand and tell Infra Claude."
                              % (part_ok, mem_ok, state_ok, str(e)[:160], part_arch, mem_arch))
            base = str(e) if isinstance(e, Refused) else "the post-write check crashed (%s)" % type(e).__name__
            raise Refused(5, "REFUSED: " + base + " - part, MEMORY.md and compose-state all restored byte-identical "
                             "(part at %s, MEMORY.md at %s)" % (part_arch, mem_arch))
        write_compose_state({"last_written_sha": mem_new_sha, "pending_sha": None, "ts": utc(),
                             "parts_sha": parts_sha, "part_count": len(new_parts)}, st)
        outcome = "no-change" if mem_new_sha == mem_old_sha else "written"
        append_index(dict(row, ts=utc(), outcome=outcome, retractions=[r_before, r_after], ledger_bullets=[l_before, l_after]), st)
        return "%s part %s (%s%s->%s) [resolved: %s]; MEMORY.md %s -> %s (%d -> %d B; retractions %d -> %d; ledger bullets %d -> %d); %s" % (
            outcome.upper(), target_name, ("CREATED " if is_new else ""), (part_old_sha[:12] if part_old_sha else "new"),
            sha(part_new)[:12], resolve_rule, mem_old_sha[:12], mem_new_sha[:12],
            len(mem_old), len(mem_new), r_before, r_after, l_before, l_after, size_line(len(mem_new)))
    finally:
        os.close(lfd)


def fsync_dir(path):
    """fsync a directory so a rename/create/unlink within it is durable (the replace_* helpers do this inline; a bare
    os.rename needs it done by hand)."""
    dfd = os.open(path, os.O_RDONLY)
    try:
        os.fsync(dfd)
    finally:
        os.close(dfd)


def do_rename(opts):
    """P-2 rename: rename a PART (--rename-part OLD --to NEW), then recompose MEMORY.md. Reads NO stdin. --expect-sha
    is the sha of the OLD part the caller read (CAS). The part's BYTES do not change - only its filename, and so its
    place in the composition order (parts compose in filename order), which can RELOCATE the ledger block. Hence:
      - delta-0: a rename must not change the retraction or REVIEWER LEDGER counts (bytes are identical);
      - the C-1..C-3 ledger guards: the block must stay whole, single-part, sub-sections present, entries in span.
    The rename is a single atomic os.rename (no both-exist / neither-exists window). A failed post-write check rolls
    back all THREE of the part (rename back), MEMORY.md and compose-state to their exact prior bytes.
    CRASH WINDOW (Langston Step-4 note 1): the writes (os.rename -> fsync_dir -> replace_target) sit OUTSIDE the try,
    as in do_direct_write. A crash there is recoverable by exactly one verb: the parts changed, so a second
    --rename-part refuses on parts-drift, and --compose reconciles (MEMORY.md still carries last_written_sha and the
    pending_sha is admissible). Such a crash leaves an index.jsonl row with outcome='attempted' and NO terminal row -
    a reader of index.jsonl must read that shape as 'crashed mid-write', not 'still running'.
    ROW TYPE `trim-noop` (Langston, Step 8 gate A, 2026-10-17): written by --trim on a night with nothing to evict.
    It WROTE NOTHING and is NOT a link in the sha chain - a reader that walks consecutive writes must skip it. Fields:
    ts, target, part, mode="trim-noop", outcome="noop", part_sha, mem_sha (the bytes it read, unchanged),
    sections_open / sections_closed / unmarked (the census of the part's MARKED batch sections - protected sections
    are not counted, so the three are not a total section count; in a noop row sections_closed and unmarked are
    ALWAYS 0 BY CONSTRUCTION - the trim refuses on any unmarked section and a noop evicted nothing - so they are
    structural constants, not measurements), and on the FIRST such row only a `note` saying
    nights before it have no row by design."""
    reader = load_reader()
    reader_requires_offsets(reader)   # fail-fast before any write if the reader predates the P-2 offset field
    old_name, new_name = opts["--rename-part"], opts["--to"]
    for label, nm in (("--rename-part", old_name), ("--to", new_name)):
        if not valid_part_name(nm):
            raise Refused(2, "REFUSED: %s %r is not a bare part filename (no directories, no '..', no leading '.'); a "
                             "part lives directly in %s and read_parts() would never see this name." % (label, nm, PARTS_DIR))
    if old_name == new_name:
        raise Refused(2, "REFUSED: --rename-part and --to are the same name %r - nothing to rename." % old_name)
    try:
        st = os.stat(TARGET)
    except OSError as e:
        raise Refused(2, "REFUSED: cannot stat the target %s (%s)" % (TARGET, type(e).__name__))
    lfd = open_lock(st)
    try:
        fcntl.flock(lfd, fcntl.LOCK_EX)
        hold = float(os.environ.get("LMW_TEST_HOLD_AFTER_LOCK", "0") or 0)   # self-test only: widen the race window
        with open(TARGET, "rb") as fh:
            mem_old = fh.read()
        mem_old_sha = sha(mem_old)
        state = read_compose_state()
        admissible = {state.get("last_written_sha"), state.get("pending_sha")} - {None}
        if mem_old_sha not in admissible:
            raise Refused(4, "REFUSED: %s was written OUTSIDE the composer (out-of-band). Its current sha is %s; the "
                             "composer last wrote %s (pending %s). Reconcile the parts and recompose before renaming."
                          % (TARGET, mem_old_sha, state.get("last_written_sha"), state.get("pending_sha")))
        parts = read_parts()
        # BLOCKER-1 (Langston 21:22Z): the parts are the file of record. A part changed out of band since the last
        #   compose would be laundered into MEMORY.md by the recompose a rename performs. --compose reconciles, not this.
        cur_parts_sha = parts_digest(parts)
        # Langston Step-4 note 2: a rename recomposes, so a missing parts_sha must REFUSE, not fall open. do_direct_write
        #   tolerates a missing field for back-compat; the rename is the retrofit's verb and cannot skip the check.
        if not state.get("parts_sha"):
            raise Refused(4, "REFUSED: compose-state has no parts_sha, so a rename cannot verify the parts are unchanged "
                             "since the last compose (it recomposes). Run --compose to reconcile and stamp parts_sha "
                             "first.")
        if state["parts_sha"] != cur_parts_sha:
            raise Refused(4, "REFUSED: a part in %s changed since the last compose (parts-sha %s, last composed %s). A "
                             "rename recomposes and would fold that unreviewed change into %s. Run --compose first."
                          % (PARTS_DIR, cur_parts_sha, state["parts_sha"], TARGET))
        names = [n for n, _, _, _ in parts]
        if old_name not in names:
            raise Refused(4, "REFUSED: no part named %s to rename. Parts: %s." % (old_name, ", ".join(names)))
        new_path = os.path.join(PARTS_DIR, new_name)
        if new_name in names or os.path.exists(new_path):
            raise Refused(4, "REFUSED: --to %s already exists - a rename never overwrites a part." % new_name)
        old_path = os.path.join(PARTS_DIR, old_name)
        pst = os.stat(old_path)
        with open(old_path, "rb") as fh:
            part_bytes = fh.read()
        part_sha = sha(part_bytes)
        expect = opts["--expect-sha"].strip().lower()
        if hold:
            time.sleep(hold)
        if part_sha != expect:
            raise Refused(4, "REFUSED: --expect-sha does not match the part %s it names. Its current sha256 is %s, you "
                             "passed %s. (--expect-sha is the OLD part's sha.)" % (old_name, part_sha, expect))
        r_before = retraction_count(reader, TARGET)
        l_before = ledger_block_count(mem_old.decode("utf-8"))
        # the renamed part carries the SAME bytes; only its filename (and thus composition order) changes.
        new_parts = sorted([(new_name, part_sha, part_body(part_bytes), part_bytes) if n == old_name else (n, h, b, rb)
                            for (n, h, b, rb) in parts], key=lambda t: t[0])
        body, parts_sha, body_sha = compose_body(new_parts)
        mem_new = body + stamp_line(len(new_parts), parts_sha, body_sha).encode("utf-8") + b"\n"
        mem_new_sha = sha(mem_new)
        part_arch, _ = archive_old(part_bytes, part_sha, st)   # the renamed part's bytes, keyed by sha
        mem_arch, _ = archive_old(mem_old, mem_old_sha, st)
        row = {"ts": utc(), "target": TARGET, "mode": "rename-part", "old_name": old_name, "new_name": new_name,
               "part_sha": part_sha, "mem_old_sha": mem_old_sha, "mem_new_sha": mem_new_sha,
               "by_claimed": opts["--by"], "via_uid": os.getuid(), "reason": opts["--reason"],
               "part_archived": os.path.basename(part_arch), "mem_archived": os.path.basename(mem_arch)}
        append_index(dict(row, outcome="attempted"), st)
        old_state = dict(state)
        write_compose_state(dict(state, pending_sha=mem_new_sha, ts=utc()), st)
        os.rename(old_path, new_path)          # atomic; preserves inode, owner and mode - no both/neither window
        fsync_dir(PARTS_DIR)
        replace_target(mem_new, st)
        try:
            with open(new_path, "rb") as fh:
                if sha(fh.read()) != part_sha:
                    raise Refused(6, "REFUSED: renamed part read-back mismatch")
            enum = [n for n, _, _, _ in read_parts()]
            if new_name not in enum:
                raise Refused(6, "REFUSED: renamed part %s is not enumerated by read_parts() after the rename" % new_name)
            if old_name in enum:
                raise Refused(6, "REFUSED: the old part name %s is still enumerated after the rename" % old_name)
            with open(TARGET, "rb") as fh:
                mem_back = fh.read()
            if sha(mem_back) != mem_new_sha or strip_stamp(mem_back) != body:
                raise Refused(6, "REFUSED: MEMORY.md read-back mismatch after recompose")
            r_after = retraction_count(reader, TARGET)
            l_after = ledger_block_count(mem_back.decode("utf-8"))
            problems = []
            if r_after != r_before:
                problems.append("a rename changed retraction entries %+d (must be 0 - the bytes are identical)" % (r_after - r_before))
            if l_after != l_before:
                problems.append("a rename changed REVIEWER LEDGER bullets %+d (must be 0)" % (l_after - l_before))
            if problems:
                raise Refused(5, "REFUSED (delta-0): " + "; ".join(problems))
            # ⛔ LEDGER GUARDS (Langston C-1..C-3): a rename reorders the composition, so the block can relocate. These
            #    confirm it stayed whole, single-part, sub-sections present, and every entry inside its own span.
            lg = ledger_guard_after_recompose(reader, body, new_parts)
            if lg:
                raise Refused(5, "REFUSED (ledger integrity): " + "; ".join(lg))
        except BaseException as e:
            # THREE-WAY ROLLBACK: rename the part back, restore MEMORY.md and compose-state to their exact prior bytes.
            corrupt = b"#corrupted-by-self-test" if corrupt_switch_armed(LANGSTON_HOME) else b""   # self-test only, never live
            try:
                if os.path.exists(new_path) and not corrupt:
                    os.rename(new_path, old_path)
                    fsync_dir(PARTS_DIR)
                with open(old_path, "rb") as fh:
                    part_ok = sha(fh.read()) == part_sha
                new_gone = (not os.path.exists(new_path)) or bool(corrupt)
                replace_target(mem_old + corrupt, st)
                write_compose_state(old_state, st)
                with open(TARGET, "rb") as fh:
                    mem_ok = sha(fh.read()) == mem_old_sha
                state_ok = read_compose_state() == old_state
            except BaseException as re_err:
                append_index(dict(row, ts=utc(), outcome="restore-failed", why=type(re_err).__name__), st)
                raise Refused(6, "REFUSED: THREE-WAY RESTORE FAILED (%s). the part may be at %s or %s, MEMORY.md at %s "
                                 "- restore by hand and tell Infra Claude." % (type(re_err).__name__, old_path, new_path, mem_arch))
            restored_ok = part_ok and new_gone and mem_ok and state_ok
            append_index(dict(row, ts=utc(), outcome="restored", part_ok=part_ok, new_gone=new_gone, mem_ok=mem_ok,
                              state_ok=state_ok, why=str(e)[:300]), st)
            if not restored_ok:
                raise Refused(6, "REFUSED: the rename rollback was NOT byte-identical (part_ok=%s new_gone=%s mem_ok=%s "
                                 "state_ok=%s; cause: %s). old part at %s, MEMORY.md at %s - restore by hand and tell "
                                 "Infra Claude." % (part_ok, new_gone, mem_ok, state_ok, str(e)[:160], part_arch, mem_arch))
            base = str(e) if isinstance(e, Refused) else "the post-rename check crashed (%s)" % type(e).__name__
            raise Refused(5, "REFUSED: " + base + " - part, MEMORY.md and compose-state all restored byte-identical "
                             "(old part at %s, MEMORY.md at %s)" % (part_arch, mem_arch))
        write_compose_state({"last_written_sha": mem_new_sha, "pending_sha": None, "ts": utc(),
                             "parts_sha": parts_sha, "part_count": len(new_parts)}, st)
        append_index(dict(row, ts=utc(), outcome="renamed", retractions=[r_before, r_after], ledger_bullets=[l_before, l_after]), st)
        return "RENAMED part %s -> %s (part sha %s); MEMORY.md %s -> %s (%d -> %d B; retractions %d; ledger bullets %d); %s" % (
            old_name, new_name, part_sha[:12], mem_old_sha[:12], mem_new_sha[:12], len(mem_old), len(mem_new),
            r_after, l_after, size_line(len(mem_new)))
    finally:
        os.close(lfd)


def load_reader_from(path):
    spec = importlib.util.spec_from_file_location("langston_memory_reader_selftest", path)
    mod = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(mod)
    return mod


def self_test():
    """Drives run() through a SUBPROCESS of this file for every case, so the entry point, stdin handling and exit
    codes are what is tested. Every refusal asserts the target BYTE-IDENTICAL afterwards."""
    import shutil
    ok = True
    top = tempfile.mkdtemp(prefix="lmw-selftest-")
    here = os.path.abspath(__file__)
    # ⛔ CONDITION 2 (Langston, 18:43Z): installed, this file is /usr/local/bin/langston-memory-write and the reader is
    #    NOT beside it - it lives at READER (/opt/langston-memory/bin/). A reader beside the file (the repo layout) is
    #    used when present; otherwise READER, the same path a real write uses. No env var the recipe never mentions.
    beside = os.path.join(os.path.dirname(here), "langston_memory.py")
    reader = os.environ.get("LANGSTON_MEMORY_READER") or (beside if os.path.exists(beside) else READER)
    env = dict(os.environ, LANGSTON_HOME=top, LANGSTON_MEMORY_READER=reader)
    target = os.path.join(top, "MEMORY.md")
    arch = os.path.join(top, ".memory-archive")
    base = NL.join([
        "# MEMORY — fixture", "",
        "## ★★ REVIEWER LEDGER — MY OWN RETRACTIONS, RULINGS AND ERRORS", "",
        "### Retractions (things I asserted and then withdrew — do NOT re-assert)",
        "- **first retraction**, a fixture entry long enough to look like one.",
        "- **second retraction**, with a continuation line below.",
        "  · a continuation led by a middle dot",
        "", ANCHOR + " (reusable)",
        "- a generalised ruling, which the reader must NOT count as a retraction",
        "- a second generalised ruling", "",
        "### CC-A errors I logged",
        "- an error note", "",
        "## ★ STANDING NOTES", "- a note outside the ledger", ""])
    # hand-counted, NOT computed by the functions under test: 2 retractions; 2 + 2 + 1 = 5 ledger bullets

    def reset(text=base):
        with open(target, "w", encoding="utf-8", newline="") as fh:
            fh.write(text)
        os.chmod(target, 0o644)        # start readable by others, as the live file is, so the narrowing is measured
        if os.path.isdir(arch):
            shutil.rmtree(arch)

    def current():
        with open(target, "rb") as fh:
            b = fh.read()
        return b, sha(b)

    def archived():
        return sorted(f for f in os.listdir(arch) if f.endswith(".md")) if os.path.isdir(arch) else []

    def index_outcomes():
        p = os.path.join(arch, "index.jsonl")
        if not os.path.exists(p):
            return []
        return [json.loads(l)["outcome"] for l in open(p, encoding="utf-8").read().split(NL) if l.strip()]

    def call(args, stdin_text, extra_env=None, as_user=None, script=None):
        cmd = [sys.executable, script or here] + args
        e = dict(env, **(extra_env or {}))
        if as_user:
            cmd = ["sudo", "-n", "-u", as_user, "env", "LANGSTON_HOME=" + e["LANGSTON_HOME"],
                   "LANGSTON_MEMORY_READER=" + e["LANGSTON_MEMORY_READER"]] + cmd
        p = subprocess.run(cmd, input=stdin_text.encode("utf-8"), capture_output=True, env=e, timeout=120)
        return p.returncode, (p.stdout + p.stderr).decode("utf-8", "replace")

    def check(name, got, want):
        nonlocal ok
        good = got == want
        ok = ok and good
        print("  %-4s %-76s expected %-8s got %s" % ("PASS" if good else "FAIL", name, want, got))

    whole = lambda s_, l, r: ["--expect-sha", s_, "--ledger-delta", str(l), "--retractions-delta", str(r), "--by", "t", "--reason", "t"]
    appendargs = lambda s_, n=1: ["--expect-sha", s_, "--ledger-append", "--entries", str(n), "--by", "t", "--reason", "t"]
    try:
        rd = load_reader_from(reader)
        retr = lambda: (lambda st: len(st[1]) if st[0] == "ok" else 0)(rd._parse_ledger(target))
        reset()
        check("control: the reader counts the fixture's 2 retractions", retr(), 2)

        b0, s0 = current()
        rc, out = call(appendargs("0" * 64), "- a new entry" + NL)
        check("a stale --expect-sha refuses -> exit", rc, 4)
        check("  ...target byte-identical", current()[0] == b0, True)
        check("  ...archive untouched", archived(), [])
        check("  ...and with no record, the message says so", "no recorded write" in out, True)

        rc, out = call(appendargs(s0), "- an entry" + NL + "# a column-0 heading inside it" + NL)
        check("a column-0 '#' in an appended entry refuses -> exit", rc, 2)
        check("  ...and it is RULE 2 that refused, not the continuation check", "(rule 2)" in out, True)
        check("  ...target byte-identical", current()[0] == b0, True)

        rc, out = call(appendargs(s0), "- an entry" + NL + "a plain column-0 line the reader would silently glue on" + NL)
        check("an unindented continuation refuses -> exit", rc, 2)
        check("  ...and it is RULE 1 that refused (the counters would NOT catch this one)", "(rule 1)" in out, True)
        check("  ...target byte-identical", current()[0] == b0, True)

        rc, out = call(appendargs(s0), "- one entry" + NL + "- a stray second column-0 bullet" + NL,
                       extra_env={"LMW_TEST_CORRUPT_RESTORE": "1"})
        check("AMENDMENT E: the same refusal with an INEXACT rollback -> exit 6, not 5", rc, 6)
        check("  ...and it says the rollback was not byte-for-byte, with the archive path", "did NOT restore" in out and ".memory-archive" in out, True)
        prev_switch = os.environ.get("LMW_TEST_CORRUPT_RESTORE")
        os.environ["LMW_TEST_CORRUPT_RESTORE"] = "1"
        try:
            live_armed, temp_armed = corrupt_switch_armed(LIVE_HOME), corrupt_switch_armed(top)
        finally:
            if prev_switch is None:
                os.environ.pop("LMW_TEST_CORRUPT_RESTORE", None)
            else:
                os.environ["LMW_TEST_CORRUPT_RESTORE"] = prev_switch
        check("CONDITION 1: the corrupting switch is INERT under the live home, even with it set", live_armed, False)
        check("  ...and armed under the self-test's own home, so the exit-6 case above really ran it", temp_armed, True)
        reset()
        b0, s0 = current()
        rc, out = call(appendargs(s0), "- one entry" + NL + "- a stray second column-0 bullet" + NL)
        check("a stray second bullet (moves +2, declared +1) refuses -> exit", rc, 5)
        check("  ...target byte-identical after the restore", current()[0] == b0, True)
        check("  ...and the RESTORE is owner-only too", oct(os.stat(target).st_mode & 0o777), "0o600")
        check("  ...the reader still counts 2", retr(), 2)

        reset()
        b0, s0 = current()
        rc, out = call(appendargs(s0), "- **third retraction**, appended by the writer." + NL + "  · with a continuation" + NL)
        check("control: a valid append lands -> exit", rc, 0)
        check("  ...the reader counts 3", retr(), 3)
        check("  ...the success line reports both counters", "REVIEWER LEDGER bullets 5 -> 6" in out, True)
        check("  ...no per-file cap is printed", "B cap by" in out, False)
        # two NAMED branches of size_line (Langston, 2026-10-17: an `or` over both accepted the UNKNOWN string, so the
        # suite had never produced the real wording) - the UNKNOWN branch here, the staged branches at the end
        check("  size line, UNKNOWN branch (this test home has no ratchet state): says UNKNOWN and why",
              ("loaded-set ceiling UNKNOWN" in out, "cannot be read" in out), (True, True))
        check("  ...the archive gained exactly one file, named by the OLD sha", archived(), [s0 + ".md"])
        check("  ...the index records the ATTEMPT first, then the outcome (FINDING-2)", index_outcomes(), ["attempted", "written"])
        check("  ...and the target is written OWNER-ONLY, from a 644 start (the 18:37Z ruling)",
              oct(os.stat(target).st_mode & 0o777), "0o600")

        b1, s1 = current()
        rc, out = call(whole(s1, 0, 0), b1.decode("utf-8").replace("- a note outside the ledger", "- a note outside the ledger, edited"))
        check("whole file, an edit OUTSIDE the ledger, declared 0/0 -> exit", rc, 0)
        check("  ...one archive file per overwrite: now two", len(archived()), 2)

        b2, s2 = current()
        gutted = b2.decode("utf-8").replace("- a generalised ruling, which the reader must NOT count as a retraction" + NL, "") \
                                   .replace("- a second generalised ruling" + NL, "")
        rc, out = call(whole(s2, 0, 0), gutted)
        check("BLOCKER-2: deleting every GENERALISE ruling, declared 0/0 -> exit", rc, 5)
        check("  ...target byte-identical after the restore", current()[0] == b2, True)
        check("  ...and the refusal names the REVIEWER LEDGER counter", "REVIEWER LEDGER bullets moved -2" in out, True)
        rc, out = call(whole(s2, -2, 0), gutted)
        check("  control: the same deletion DECLARED as -2/0 lands -> exit", rc, 0)

        b3, s3 = current()
        doubled = b3.decode("utf-8").replace("## ★ STANDING NOTES", "## ★★ REVIEWER LEDGER — pasted twice by accident" + NL + NL + "## ★ STANDING NOTES")
        rc, out = call(whole(s3, 0, 0), doubled)
        check("CONDITION 1: new content with a duplicate REVIEWER LEDGER heading -> exit 5, not 2", rc, 5)
        check("  ...the cause is kept", "ambiguous" in out, True)
        check("  ...and the rollback is stated, byte-identical", "byte-identical=True" in out, True)
        check("  ...target byte-identical", current()[0] == b3, True)
        rc, out = call(whole(s3, 0, 0), b3.decode("utf-8").replace("### Retractions", "### Something else"))
        check("whole file that renames the Retractions section, declared 0/0 -> exit", rc, 5)
        check("  ...target byte-identical after the restore", current()[0] == b3, True)

        rc, out = call(appendargs(s3) + ["--ledger-delta", "0"], "- x" + NL)
        check("FINDING-3: --ledger-delta beside --ledger-append refuses -> exit", rc, 2)
        rc, out = call(["--expect-sha", s3, "--ledger-delta", "0", "--by", "t", "--reason", "t"], b3.decode("utf-8"))
        check("  ...a whole-file write without --retractions-delta refuses -> exit", rc, 2)
        check("  ...target byte-identical", current()[0] == b3, True)

        rc, out = call(["--expect-sha", s3, "--ledger-delta", "0", "--retractions-delta", "0", "--by", "t",
                        "--reason", "--self-test"], b3.decode("utf-8").replace("- a note outside", "- a note (self-test value) outside"))
        check("FINDING-1: a --reason value of '--self-test' still WRITES -> exit", rc, 0)
        check("  ...the target really changed", current()[1] != s3, True)

        b4, s4 = current()
        rc, out = call(whole(s4, 0, 0), b4.decode("utf-8"))
        check("answer 2: an unchanged rewrite -> exit", rc, 0)
        check("  ...recorded as no-change, not written", index_outcomes()[-1], "no-change")

        with open(target, "ab") as fh:
            fh.write(b"a hand edit" + NL.encode())
        rc, out = call(whole(s4, 0, 0), b4.decode("utf-8"))
        check("answer 3: after a HAND edit, a stale sha refuses -> exit", rc, 4)
        check("  ...and says the file changed OUTSIDE this tool", "OUTSIDE THIS TOOL" in out, True)

        reset()
        b0, s0 = current()
        procs = [subprocess.Popen([sys.executable, here] + appendargs(s0), stdin=subprocess.PIPE, stdout=subprocess.PIPE,
                                  stderr=subprocess.PIPE, env=dict(env, LMW_TEST_HOLD_AFTER_LOCK="1.5")) for _ in range(2)]
        for n, p in enumerate(procs):
            p.stdin.write(("- racer %d" % n + NL).encode("utf-8"))
            p.stdin.close()
        results = [(p.wait(timeout=120), (p.stdout.read() + p.stderr.read()).decode("utf-8", "replace")) for p in procs]
        check("two concurrent writers holding the same sha -> exit codes", sorted(r[0] for r in results), [0, 4])
        check("  ...exactly one landed: the reader counts 3", retr(), 3)
        loser = [o for c, o in results if c == 4]
        check("  ...and the loser is told another session wrote THROUGH this tool", bool(loser) and "THROUGH" in loser[0], True)

        rc, out = call(["--expect-sha", s0, "--bogus"], "- x" + NL)
        check("an unknown flag refuses -> exit", rc, 2)

        # BLOCKER-3: a root run must leave everything usable by the owner
        # ⛔ GUARD (c) CASES. Fixtures live under ROOT'S OWN HOME, never /tmp: /tmp is 1777, so it would refuse every case
        #    for the wrong reason and the control could not come out differently.
        if os.geteuid() == 0:
            try:
                gown = pwd.getpwnam(OWNER)
            except KeyError:
                gown = None
            check("GUARD (c) fixture: the owner account exists", gown is not None, True)
            if gown is not None:
                groot = tempfile.mkdtemp(prefix="lmw-guard-", dir=pwd.getpwuid(0).pw_dir)
                try:
                    os.chmod(groot, 0o755)
                    gbin = os.path.join(groot, "bin")
                    os.makedirs(gbin)
                    os.chmod(gbin, 0o755)
                    greader = os.path.join(gbin, "langston_memory.py")
                    shutil.copy(reader, greader)
                    os.chown(greader, 0, 0)
                    os.chmod(greader, 0o644)

                    def guard_case(reader_path):
                        reset()
                        g0, gs0 = current()
                        rc_, out_ = call(appendargs(gs0), "- guard case" + NL, extra_env={"LANGSTON_MEMORY_READER": reader_path})
                        return rc_, out_, current()[1] == gs0

                    rc, out, same = guard_case(greader)
                    check("GUARD (c) control: a root write with a ROOT-CONTROLLED reader proceeds -> exit", rc, 0)

                    os.chown(greader, gown.pw_uid, gown.pw_gid)
                    rc, out, same = guard_case(greader)
                    check("GUARD (c): the reader FILE owned by the owner account -> exit", rc, 6)
                    check("  ...names the file, and the target is byte-identical", ("%s is owned by %s" % (greader, OWNER)) in out and same, True)
                    os.chown(greader, 0, 0)

                    os.chmod(gbin, 0o775)
                    rc, out, same = guard_case(greader)
                    check("GUARD (c): a directory on its path is group-writable -> exit", rc, 6)
                    check("  ...names that directory, and the target is byte-identical", ("%s is group- or other-writable" % gbin) in out and same, True)
                    os.chmod(gbin, 0o755)

                    os.chown(groot, gown.pw_uid, gown.pw_gid)
                    rc, out, same = guard_case(greader)
                    check("GUARD (c): the PARENT owned by the owner (swap bin wholesale) -> exit", rc, 6)
                    check("  ...names the parent, and the target is byte-identical", ("%s is owned by %s" % (groot, OWNER)) in out and same, True)
                    os.chown(groot, 0, 0)

                    gcache = os.path.dirname(importlib.util.cache_from_source(greader))
                    os.makedirs(gcache)
                    os.chown(gcache, gown.pw_uid, gown.pw_gid)
                    rc, out, same = guard_case(greader)
                    check("GUARD (c): its __pycache__ owned by the owner (a .pyc runs in place of source) -> exit", rc, 6)
                    check("  ...names the cache, and the target is byte-identical", ("%s is owned by %s" % (gcache, OWNER)) in out and same, True)
                    shutil.rmtree(gcache)

                    # GUARD (c) condition: a hostile PYTHONPYCACHEPREFIX at a langston-owned tree does NOT refuse a
                    #   legitimate root write - the pin neutralises it, so the loaded cache stays root-owned (N/A-by-pinning).
                    gpref = os.path.join(groot, "langston-pycache")
                    os.makedirs(gpref)
                    os.chown(gpref, gown.pw_uid, gown.pw_gid)
                    reset()
                    gp0, gps0 = current()
                    rcp, outp = call(appendargs(gps0), "- prefix case" + NL,
                                     extra_env={"LANGSTON_MEMORY_READER": greader, "PYTHONPYCACHEPREFIX": gpref})
                    check("GUARD (c) condition: a hostile PYTHONPYCACHEPREFIX is neutralised by the pin -> write PROCEEDS", rcp, 0)
                    reader_pyc = [os.path.join(dp, f) for dp, _, fs in os.walk(gpref) for f in fs if "langston_memory" in f]
                    check("  ...and the READER's bytecode did NOT land under that langston-owned prefix (the loaded cache stays default)", reader_pyc, [])

                    gevil = os.path.join(groot, "elsewhere")
                    os.makedirs(gevil)
                    shutil.copy(reader, os.path.join(gevil, "langston_memory.py"))
                    os.chown(gevil, gown.pw_uid, gown.pw_gid)
                    glink = os.path.join(gbin, "via-link.py")
                    os.symlink(os.path.join(gevil, "langston_memory.py"), glink)
                    rc, out, same = guard_case(glink)
                    check("GUARD (c): a root-owned SYMLINK into an owner-owned folder -> exit", rc, 6)
                    check("  ...names the folder the link resolves into, and the target is byte-identical", ("%s is owned by %s" % (gevil, OWNER)) in out and same, True)
                finally:
                    shutil.rmtree(groot, ignore_errors=True)
        else:
            print("  N/A  GUARD (c) cases need root; the guard itself only applies to a root run")
        if os.geteuid() == 0:
            try:
                owner = pwd.getpwnam(OWNER)
            except KeyError:
                owner = None
            check("BLOCKER-3 fixture: the owner account exists", owner is not None, True)
            if owner is not None:
                home3 = tempfile.mkdtemp(prefix="lmw-owner-")
                bin3 = os.path.join(home3, "bin")
                os.makedirs(bin3)
                shutil.copy(here, os.path.join(bin3, "langston-memory-write"))
                shutil.copy(reader, os.path.join(bin3, "langston_memory.py"))
                t3 = os.path.join(home3, "MEMORY.md")
                with open(t3, "w", encoding="utf-8", newline="") as fh:
                    fh.write(base)
                for dp, dn, fn in os.walk(home3):
                    os.chown(dp, owner.pw_uid, owner.pw_gid)
                    for f in fn:
                        os.chown(os.path.join(dp, f), owner.pw_uid, owner.pw_gid)
                os.chmod(home3, 0o700)
                env3 = {"LANGSTON_HOME": home3, "LANGSTON_MEMORY_READER": os.path.join(bin3, "langston_memory.py")}
                s_a = sha(open(t3, "rb").read())
                # GUARD (c): a ROOT run may not execute the owner-owned copies in bin3 - that is the escalation path.
                #   The root leg runs this file with the root-controlled reader; the owner leg below keeps bin3.
                rc, out = call(appendargs(s_a), "- written by root" + NL, extra_env=dict(env3, LANGSTON_MEMORY_READER=reader))
                check("BLOCKER-3: a ROOT write -> exit", rc, 0)
                owned = all(os.stat(p).st_uid == owner.pw_uid for p in (
                    os.path.join(home3, ".memory-write.lock"), os.path.join(home3, ".memory-archive"),
                    os.path.join(home3, ".memory-archive", "index.jsonl"), os.path.join(home3, ".memory-archive", s_a + ".md")))
                check("  ...lock, archive dir, index and archive file all belong to the owner", owned, True)
                s_b = sha(open(t3, "rb").read())
                rc, out = call(appendargs(s_b), "- written by the owner after root" + NL, extra_env=env3,
                               as_user=OWNER, script=os.path.join(bin3, "langston-memory-write"))
                check("  ...then the OWNER's own write succeeds -> exit", rc, 0)
                check("  ...with no traceback", "Traceback" in out, False)
                shutil.rmtree(home3, ignore_errors=True)
        else:
            print("  N/A  BLOCKER-3 root-then-owner case needs root; run the self-test as root to exercise it")
        # size line, staged branches - LAST, after reset(), so their extra writes cannot move any count checked above
        reset()
        claude_p = os.path.join(top, "CLAUDE.md")
        amem = os.path.join(top, ".claude", "projects", "-home-langston", "memory")
        os.makedirs(amem, exist_ok=True)
        with open(claude_p, "w", encoding="utf-8") as fh:
            fh.write("c" * 1234)
        with open(os.path.join(amem, "MEMORY.md"), "w", encoding="utf-8") as fh:
            fh.write("i" * 567)
        with open(os.path.join(top, ".ratchet-state.json"), "w", encoding="utf-8") as fh:
            json.dump({"ceiling_bytes": 10 ** 9}, fh)
        b1, s1 = current()
        rc, out = call(appendargs(s1), "- **fourth retraction**, appended for the size-line case." + NL)
        want = "loaded set %d B vs ceiling %d B (under by %d B; row 2.8b)" % (
            1234 + 567 + len(open(target, "rb").read()), 10 ** 9, 10 ** 9 - (1234 + 567 + len(open(target, "rb").read())))
        check("  size line, REAL branch (state + both other watched files staged): the computed numbers, exactly",
              (rc, want in out), (0, True))
        with open(os.path.join(top, ".ratchet-state.json"), "w", encoding="utf-8") as fh:
            json.dump({"ceiling_bytes": True}, fh)
        b2, s2 = current()
        # the gate refuses growth on an UNKNOWN ratchet, so the override lets the write land and size_line print
        rc, out = call(appendargs(s2) + ["--allow-growth", "size-line test"],
                       "- **fifth retraction**, appended for the invalid-ceiling case." + NL)
        check("  size line: a bool ceiling is UNKNOWN in the SUCCESS line, never printed as a real ceiling",
              (rc, "loaded-set ceiling UNKNOWN - the ratchet state carries no valid ceiling_bytes" in out,
               "vs ceiling 1 B" in out), (0, True, False))
        for f_ in (claude_p, os.path.join(amem, "MEMORY.md"), os.path.join(top, ".ratchet-state.json")):
            os.remove(f_)
    finally:
        shutil.rmtree(top, ignore_errors=True)
    print("self-test %s" % ("PASSED" if ok else "FAILED"))
    return 0 if ok else 1


def main():
    if sys.argv[1:] == ["--self-test"]:          # FINDING-1: only as the sole argument, never a value elsewhere
        return self_test()
    argv = sys.argv[1:]
    # ⛔ --compose and --rename-part read NO stdin: they act on the parts, not on new content. Reading stdin here
    #    blocked a `--compose` invoked over ssh with no redirection (the channel never sends EOF) - a live hang the
    #    fixture-always-passes-stdin tests missed. A rename carries no content, so the same EOF hang would bite it.
    #    --trim is the same shape (it evicts what the part already declares) and hung the same way over ssh on its first
    #    real dry run, 2026-10-16 - the tests passed stdin, so they could not see it. Both are now in this list.
    no_stdin = ("--compose", "--rename-part", "--trim")
    stdin_bytes = b"" if any(f in argv for f in no_stdin) else sys.stdin.buffer.read()
    try:
        print(run(argv, stdin_bytes))
        return 0
    except Refused as r:
        print(str(r), file=sys.stderr)
        return r.code


def entry():
    try:
        return main()
    except SystemExit:
        raise
    except BaseException:
        traceback.print_exc()
        return 6


if __name__ == "__main__":
    sys.exit(entry())
