#!/usr/bin/env python3
"""P-8 — the PROMOTION step: move generalisable LESSONS out of Langston's private
store into the shared `MISTAKE_PATTERNS.md`, without exposing the store itself.

⛔⛔ THIS REPLACES A DIFFERENT DESIGN THAT LANGSTON BLOCKED, AND HIS THREE REASONS
    ARE THE SPEC. The original objective was "make his rulings retrievable by the
    other sessions, read-only." He rejected it:

    (a) His store contains WITHDRAWN entries — one says literally *"never
        re-assert this tally."* Retrieval that hands those to another session
        without the withdrawal attached is a machine for propagating his own
        retractions as findings: strictly worse than the tool we already have.
    (b) It contains his private CALIBRATION ON PEER SESSIONS. In his words:
        *"make that readable by CC-A and I will write it more diplomatically and
        it will be less useful to me."* That is a real loss, not a privacy nicety.
    (c) ⭐ THE ONE THAT ACTUALLY WORRIES HIM: if sessions read his prior rulings
        before writing a scope, THEY PRE-COMPLY — and his Step-4 degrades from an
        independent read into a check that they quoted him correctly. Plus the
        #452 laundering shape: a session citing his ruling back to him as
        independent confirmation.

★ SO: DEFAULT PRIVATE, SHARE BY PROMOTION. Generalising PATTERNS are impersonal
  and safe to share; *"what Langston ruled on batch X"* is not. The shared surface
  already exists and all four sessions read it. What was missing was never a
  retrieval mechanism — it was this step.

⛔⛔ IT NEVER WRITES TO `MISTAKE_PATTERNS.md`. It produces a PROPOSAL for a human
    or a session to land inside a batch. An automated writer into a shared
    governance file is the confidently-wrong-second-record shape this project
    keeps paying for, and the promotion threshold there (3+ instances across 2+
    distinct batches) is a judgement, not a string match.

⛔⛔ THE SCREEN COVERS (b). IT DOES NOT COVER (a), AND SAYING OTHERWISE WAS THE
    DEFECT — LANGSTON, STEP-4, FINDING-3.
    · For (b), SESSION NAMES: a literal match IS the leak, so the ban is a real
      mechanical control and it stands.
    · For (a), WITHDRAWN PROVENANCE: banning the WORDS catches the MARKER, not
      the SOURCE. A nomination drawn from a withdrawn entry, written impersonally
      and without those words, passes clean. ★ WORSE: the prompt used to say
      'write around it', which removed the only trace a later reader could have
      spotted. That is `matching-literal-not-shared-root` — one of the patterns
      this very tool promoted — committed inside the tool that promoted it.
    ⇒ (a) now rests on TWO things, both stated rather than implied: a REQUIRED
      per-nomination SOURCE-ENTRY STATUS field, and his compliance in filling it
      honestly. The word-ban is kept only as a WEAK TRIPWIRE, and the screen
      refuses any proposal whose nominations omit the field.

⛔⛔ FINDING-5 (Langston, r2) — AND IT IS THE SAME PRESSURE ONE LAYER DOWN.
    r2's prompt told him: *if a lesson comes from an entry you later withdrew, SAY
    SO in the status field.* And `BANNED` refused the WHOLE proposal on the word
    `withdrawn` — with a self-test case ENSHRINING that as correct behaviour.
    ⇒ AN HONEST STATUS FIELD WAS MECHANICALLY IMPOSSIBLE, so the only proposals
      that could ever pass were the ones that did NOT declare withdrawn provenance.
    ★ That is exactly the 'write around it' pressure FINDING-3 removed, reinstalled
      by the fix for FINDING-3. A rule and its enforcement disagreeing is not a
      nuisance: the enforcement always wins, silently, and the rule reads as intact.
    ⇒ THE TRIPWIRE IS NOW SCOPED TO TEXT OUTSIDE THE STATUS FIELD. Session names
      stay a hard refuse EVERYWHERE, because there a literal match IS the leak.

USAGE:  langston-promote-patterns [--dry-run | --screen-test]
"""

import json, os, re, shlex, subprocess, sys, tempfile, datetime


def model():
    """Live chat-path model, read from the bridge. The row records which source was
    used, so a fallback is never silent."""
    try:
        # ⚠️ USE THE CONSTANT. `BRIDGE` was defined and then this line duplicated the
        #    literal — twin-site drift inside the fix for the twin-site minor.
        with open(BRIDGE, encoding="utf-8", errors="replace") as fh:
            m = re.search(r"""CLAUDE_MODEL\s*=\s*["']([^"']+)["']""", fh.read())
        if m:
            return m.group(1), "bridge"
    except Exception:
        pass
    return MODEL_FALLBACK, "FALLBACK — could not read the bridge"

HOME = "/home/langston"
STORE = os.path.join(HOME, ".claude/projects/-home-langston/memory")
OUTDIR = "/opt/langston-memory/usage"
RUNLOG = os.path.join(OUTDIR, "pattern-promotion.jsonl")
# ⛔ READ THE MODEL FROM THE BRIDGE, NEVER HARDCODE IT (Langston, r2 minor). His own
#    MEMORY names TWO live sites and warns a single-site switch leaves him split;
#    hardcoding here and in the canary would have made FOUR.
BRIDGE = "/opt/discord-bridges/discord-langston-bridge.py"
MODEL_FALLBACK = "claude-opus-5[1m]"
NL = chr(10)

# ⛔ THE SCREEN. Anything here appearing in the proposal REFUSES the whole run.
#    Session names cover BLOCKER-3(b). ⚠️ The retraction words do NOT cover (a) —
#    they catch a marker, never a provenance. Never cite them as covering it.
# ⛔ TWO NAMED SETS, AND `BANNED` IS DERIVED FROM THEM. An earlier version wrote
#    `SESSION_PATTERNS = set(BANNED[:11])` — a magic index that would silently
#    reclassify a retraction word as a session name the moment anyone appended to the
#    list. A boundary you have to remember is not a boundary.
SESSION_PATTERNS = [
    r"\bCC-A\b", r"\bCC-B\b", r"\bCC-C\b", r"\bCC-INFRA\b",
    r"\bOLD Claude\b", r"\bNEW Claude\b", r"\bANALYST Claude\b", r"\bInfra Claude\b",
    r"\bClaude Old\b", r"\bClaude New\b", r"\bClaude Analyst\b",
]
RETRACTION_TRIPWIRE = [
    r"\bretract(?:ed|ion|ions)\b", r"\bwithdrawn\b", r"\bvacated\b",
]
BANNED = SESSION_PATTERNS + RETRACTION_TRIPWIRE

# ⛔ REQUIRED ON EVERY NOMINATION. This is the actual (a) control: the screen cannot
#    see provenance, so provenance must be DECLARED — in a field whose ABSENCE is
#    mechanically detectable even though its TRUTH is not.
STATUS_FIELD = "**SOURCE-ENTRY STATUS:**"

# ⛔ THE TWO SETS ARE SCOPED DIFFERENTLY AND THE DIFFERENCE IS THE POINT (FINDING-5).
#    Session names: a literal match IS the leak ⇒ hard refuse anywhere in the text.
#    Retraction words: a WEAK TRIPWIRE over the body only ⇒ the status field is the
#    one place a withdrawal is meant to be said out loud, so screening it there made
#    the honest answer impossible and the dishonest one the only passing one.

PROMPT = (
    "PATTERN PROMOTION — you are nominating LESSONS, not rulings, and nothing personal." + NL + NL
    + "Read your own memory store at " + STORE + " (37-ish entries; you may use your tools "
      "for this one, unlike the load canary)." + NL + NL
    + "⛔ WHAT I AM ASKING FOR, AND WHY THE SHAPE MATTERS. The other three sessions share a "
      "file of recurring mistake patterns that all of them read. Your store holds lessons that "
      "would help them, but handing them your store directly was blocked — by you — for three "
      "reasons I am holding to: withdrawn entries would propagate as findings; your calibration "
      "on individual sessions would stop being written honestly the moment it was readable; and "
      "sessions reading your prior rulings would PRE-COMPLY, turning your Step-4 into a check "
      "that they quoted you correctly rather than an independent read." + NL + NL
    + "⇒ SO NOMINATE ONLY WHAT SURVIVES BEING MADE IMPERSONAL:" + NL
    + "  · the lesson must generalise beyond the incident that produced it;" + NL
    + "  · it must NOT name any session, any person, or any specific batch;" + NL
    + "  · it must NOT come from an entry you have withdrawn, retracted or vacated;" + NL
    + "  · it must NOT be 'what I ruled', it must be 'what goes wrong and how to see it'." + NL + NL
    + "⚠️ A MECHANICAL SCREEN REFUSES THE WHOLE PROPOSAL if it finds a session name, or if any "
      "nomination omits the SOURCE-ENTRY STATUS field. ⛔ DO NOT WRITE AROUND THE SCREEN — an "
      "earlier version of this prompt said exactly that, and you were right that it removed the "
      "only trace a later reader could spot. If a lesson genuinely comes from an entry you later "
      "withdrew, SAY SO in the status field and argue why the lesson outlives the finding. The "
      "screen cannot see provenance; only you can, and that limit is stated in the landed "
      "section rather than papered over." + NL + NL
    + "FORMAT — return ONLY this, no preamble, no closing remarks:" + NL + NL
    + "### `<kebab-slug>` — **<THE PATTERN, STATED AS WHAT GOES WRONG, IN CAPS>**" + NL
    + "**THE SHAPE:** <two or three sentences: what it looks like from inside, why it is "
      "convincing at the time.>" + NL
    + "**HOW TO SEE IT:** <the check that would catch it — concrete, runnable where possible.>" + NL
    + "**HOW OFTEN I HAVE SEEN IT:** <your own count and rough span. Say 'once' if once — the "
      "shared file's promotion floor is 3 instances across 2 distinct batches, and I would rather "
      "carry an honest 'once' than a padded three.>" + NL
    + STATUS_FIELD + " <REQUIRED, and it is the only real control on withdrawn material. "
      "State whether the entry or entries this lesson came from are STANDING, or whether any "
      "was later withdrawn, retracted or superseded — and if so, say so, and say why the "
      "LESSON survives even though the FINDING did not. A missing field refuses the whole "
      "proposal.>" + NL + NL
    + "Nominate AT MOST FIVE, fewest that are genuinely worth another session's attention. "
      "If none qualify, return exactly: NO NOMINATIONS." + NL
)


def utc():
    return datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def _own(path):
    """Same reasoning as langston-size-watch._own — root-created files here break rotation."""
    try:
        if os.geteuid() != 0:
            return
        import pwd, grp
        os.chown(path, pwd.getpwnam("langston").pw_uid, grp.getgrnam("langston").gr_gid)
        os.chmod(path, 0o664)
    except Exception:
        pass


def _split_status(text):
    """Return (text_without_the_status_BLOCK, [status_block, ...]).
    ⛔ The retraction tripwire must not see the status field — that field is the ONE
    place a withdrawal is supposed to be declared out loud.
    ⛔⛔ FINDING-7 (Langston, r3): THIS SPLIT BY *LINE*, so a status declaration that
    WRAPPED put `withdrawn` back into the body and refused the proposal anyway —
    FINDING-5 one notch narrower. ★ And the prompt explicitly invites a multi-sentence
    answer, while the self-test's honest case was a SINGLE LINE, so it never
    exercised the shape the prompt asks for.
    ⇒ the status field now runs from its marker to the next blank line, the next
    `**FIELD:**` marker, or the next `### ` heading — whichever comes first.
    """
    kept, status, in_status, block = [], [], False, []
    for line in text.split(NL):
        s = line.lstrip()
        if s.startswith(STATUS_FIELD):
            in_status, block = True, [line]
            continue
        if in_status:
            ends = (not s) or s.startswith("### ") or (s.startswith("**") and ":**" in s)
            if not ends:
                block.append(line)
                continue
            status.append(NL.join(block))
            in_status, block = False, []
        kept.append(line)
    if block:
        status.append(NL.join(block))
    return NL.join(kept), status


def screen(text):
    """⛔ REFUSES ON ANY HIT. Returns (clean, hits). Deliberately over-broad: a false
    refusal costs one re-run; a false pass leaks his peer calibration into a file all
    four sessions read, permanently, under his name."""
    hits = []
    # ★ THE (a) CONTROL: every nomination must DECLARE its source-entry status. The
    #   presence of the field is checkable; its truth is not, and that is said out loud
    #   rather than implied. A heading/field count mismatch IS the hit.
    # ⛔ PER BLOCK, NOT A COUNT (Langston, r2 minor). Comparing totals passed a proposal
    #    where one nomination carried TWO status fields and another carried none —
    #    a count is not a set, which is the same error three levels up this batch.
    blocks = re.split(r'^(?=### )', text, flags=re.M)
    for blk in blocks:
        if not blk.lstrip().startswith('### '):
            continue
        if STATUS_FIELD not in blk:
            head = blk.split(NL, 1)[0][:70]
            hits.append({'pattern': 'missing ' + STATUS_FIELD,
                         'matched': head,
                         'context': 'this nomination declares no source-entry status'})
    body, _status_lines = _split_status(text)
    for pat in BANNED:
        # ⛔ SESSION NAMES are checked against the WHOLE text; the retraction tripwire
        #    only against the body, so an honest status field is possible (FINDING-5).
        scope = text if pat in SESSION_PATTERNS else body
        for m in re.finditer(pat, scope, re.I):
            frag = scope[max(0, m.start() - 40):m.end() + 40].replace(NL, " ")
            hits.append({"pattern": pat, "matched": m.group(0), "context": frag})
    return (not hits), hits


def screen_test():
    """★ POSITIVE CONTROL FOR THE SCREEN. A filter that has never rejected anything and a
    filter that CANNOT reject anything look identical from outside."""
    cases = [
        ("clean pattern WITH a status field",
         "### `wrong-object`" + NL + "**THE SHAPE:** the path is right and the thing is not."
         + NL + STATUS_FIELD + " STANDING.", True),
        ("names a session — status PRESENT, so ONLY the name can refuse it",
         "### `x`" + NL + STATUS_FIELD + " STANDING." + NL + "**THE SHAPE:** CC-A got the population wrong.", False),
        ("names a display name — status PRESENT",
         "### `x`" + NL + STATUS_FIELD + " STANDING." + NL + "**THE SHAPE:** NEW Claude measured the worktree.", False),
        ("retraction word — status PRESENT, so the weak tripwire is what fires",
         "### `x`" + NL + STATUS_FIELD + " STANDING." + NL + "**THE SHAPE:** this was later withdrawn.", False),
        ("retraction word, different case — status PRESENT",
         "### `x`" + NL + STATUS_FIELD + " STANDING." + NL + "**THE SHAPE:** I RETRACTED the tally.", False),
        ("⛔ FINDING-3: a nomination with NO source-entry status",
         "### `x`" + NL + "**THE SHAPE:** clean impersonal text, no status line.", False),
        ("two nominations, only one status field",
         "### `a`" + NL + STATUS_FIELD + " STANDING." + NL + "### `b`" + NL + "**THE SHAPE:** none.", False),
        ("⛔ FINDING-5: an HONEST withdrawal declared IN the status field must PASS",
         "### `x`" + NL + STATUS_FIELD + " the source entry was later withdrawn; the lesson"
         + " outlives the finding." + NL + "**THE SHAPE:** clean impersonal text.", True),
        ("⛔ FINDING-7: the SAME declaration WRAPPED over two lines must also pass",
         "### `x`" + NL + STATUS_FIELD + " the source entry was later" + NL
         + "   withdrawn, and superseded, but the lesson outlives the finding." + NL
         + NL + "**THE SHAPE:** clean impersonal text.", True),
        ("a retraction word in the BODY still refuses",
         "### `x`" + NL + STATUS_FIELD + " STANDING." + NL + "**THE SHAPE:** this was later withdrawn.", False),
        ("a session name INSIDE the status field still refuses",
         "### `x`" + NL + STATUS_FIELD + " STANDING, from the CC-A review." + NL + "**THE SHAPE:** clean.", False),
    ]
    # ⛔⛔ EVERY REFUSING CASE CARRIES A VALID STATUS FIELD ON PURPOSE. Without one
    #    the (a) check fires first, and the session-name ban is never exercised — the
    #    cases would all still PASS while proving nothing about the control they name.
    #    That is `a-guard-that-cannot-go-red`, one of the patterns this very tool
    #    promoted, reintroduced inside the test for it. The printed hit names which
    #    control actually fired, so a green run is readable rather than merely green.
    ok = True
    for name, text, want_clean in cases:
        clean, hits = screen(text)
        good = clean == want_clean
        ok = ok and good
        print("  %-4s %-38s expected %-8s got %-8s %s"
              % ("PASS" if good else "FAIL", name,
                 "clean" if want_clean else "refuse",
                 "clean" if clean else "refuse",
                 ("<- " + hits[0]["matched"]) if hits else ""))
    return ok


# ⛔⛔ AN UNRECOGNISED FLAG MUST REFUSE, NOT FALL THROUGH TO A REAL RUN (Langston, r7).
#    This file dispatches on `in sys.argv`, so ANY unknown flag was silently ignored and
#    the tool proceeded with its DEFAULT behaviour while the operator believed they had
#    asked for something else. Measured across this tool family: one wrote a real run-log
#    row, and the load canary spent THREE live `claude -p` invokes on a typo.
#    ⇒ the cost is not the wasted run — it is that the operator reads the output as the
#      answer to the question they asked.
KNOWN_FLAGS = ("--screen-test", "--dry-run",)


def _refuse_unknown_flags():
    unknown = [a for a in sys.argv[1:] if a.startswith("-") and a not in KNOWN_FLAGS]
    if unknown:
        sys.stderr.write("REFUSED: unrecognised flag(s): %s. Known: %s.%s"
                         % (", ".join(unknown), ", ".join(KNOWN_FLAGS), chr(10)))
        sys.stderr.write("  Refusing rather than ignoring — an ignored flag runs the "
                         "DEFAULT action and returns its output as though it answered "
                         "the question you asked.%s" % chr(10))
        return True
    return False


def main():
    if _refuse_unknown_flags():
        return 2
    if "--screen-test" in sys.argv:
        print("leak-screen mutation check:")
        return 0 if screen_test() else 1
    if "--dry-run" in sys.argv:
        print(PROMPT)
        print("--- screen would reject any of: " + ", ".join(BANNED))
        return 0

    fd, ppath = tempfile.mkstemp(prefix="langston-promote-", suffix=".md", dir="/tmp")
    with os.fdopen(fd, "w", encoding="utf-8") as fh:
        fh.write(PROMPT)
    os.chmod(ppath, 0o644)

    # ⛔ Token never in argv — /proc has no hidepid on this box.
    # ⚠️ Tools are ON here, unlike the load canary: he has to READ his own store.
    mdl, mdl_src = model()
    inner = ("set -a; . /etc/langston/oauth.env; set +a; "
             "exec /usr/bin/claude -p --model %s --permission-mode bypassPermissions"
             % shlex.quote(mdl))
    cmd = ["sudo", "-u", "langston", "env", "HOME=" + HOME, "sh", "-c", inner]
    try:
        with open(ppath, encoding="utf-8") as stdin_fh:
            proc = subprocess.run(cmd, cwd=HOME, stdin=stdin_fh, capture_output=True,
                                  text=True, encoding="utf-8", errors="replace", timeout=1200)
        reply, rc = (proc.stdout or ""), proc.returncode
        if rc != 0:
            reply += NL + "[stderr] " + (proc.stderr or "")[:800]
    finally:
        try:
            os.unlink(ppath)
        except OSError:
            pass

    clean, hits = screen(reply)
    nominations = len(re.findall(r"^### ", reply, re.M))
    none_offered = "NO NOMINATIONS" in reply

    out = None
    if clean and nominations and not none_offered:
        # ⛔ CREATE THE DIRECTORY BEFORE WRITING INTO IT (Langston, r3 minor 4). It was
        #    created later, at the run-log write — so a FIRST run on a fresh box would
        #    lose a 20-minute Opus invoke and leave no run row explaining why.
        os.makedirs(OUTDIR, exist_ok=True)
        out = os.path.join(OUTDIR, "pattern-promotion-proposal-%s.md"
                           % datetime.datetime.now(datetime.timezone.utc).strftime("%Y%m%dT%H%M%SZ"))
        body = []
        body.append("# Pattern promotion PROPOSAL — not yet landed anywhere")
        body.append("")
        body.append("> **GENERATED:** " + utc() + " by `langston-promote-patterns` (P-8).")
        body.append("> ⛔ **THIS IS A PROPOSAL. IT HAS NOT BEEN WRITTEN TO `MISTAKE_PATTERNS.md`**")
        body.append("> **and must not be, without a session reading it and landing it inside a**")
        body.append("> **batch.** That file's promotion floor — 3 instances across 2 distinct")
        body.append("> batches — is a judgement, not a string match, and the counts below are")
        body.append("> **his own claim, unverified by me.**")
        body.append("")
        body.append("> ✅ **SESSION-NAME SCREEN: PASSED.** No session name appears below, and that")
        body.append("> check is mechanical and covers the whole text — a literal match IS the")
        body.append("> leak, so this one is a real control.")
        body.append(">")
        body.append("> ⛔⛔ **IT DOES NOT CERTIFY PROVENANCE, AND AN EARLIER VERSION OF THIS")
        body.append("> HEADER SAID IT DID.** It read *no session name and no retraction word")
        body.append("> appears below* — which the FINDING-5 fix made **false by design**,")
        body.append("> because a withdrawal declared in the status field now passes and DOES")
        body.append("> appear below. ★ So the first time the honest path was used, the only")
        body.append("> artifact this tool emits would have told the lander that the withdrawn")
        body.append("> provenance had been screened out — defeating the one thing the status")
        body.append("> field exists to do.")
        body.append(">")
        body.append("> ⇒ **READ EVERY `SOURCE-ENTRY STATUS` DECLARATION YOURSELF BEFORE LANDING")
        body.append("> ANYTHING.** Nothing mechanical checks whether it is TRUE; the screen only")
        body.append("> checks that it is THERE.")
        body.append("")
        body.append("---")
        body.append("")
        body.append(reply.strip())
        body.append("")
        with open(out, "w", encoding="utf-8") as fh:
            fh.write(NL.join(body) + NL)
        _own(out)

    row = {"ts": utc(), "rc": rc, "model": mdl, "model_source": mdl_src,
           "screen_clean": clean, "screen_hits": hits[:10],
           "nominations": nominations, "none_offered": none_offered,
           "proposal": os.path.basename(out) if out else None,
           "measures": ("nominations Langston offered for promotion into the shared patterns file, "
                        "after a mechanical screen for session names and retraction words; it does "
                        "NOT verify his instance counts and does NOT land anything"),
           "population": "his self-memory store as it stood at this run"}
    try:
        os.makedirs(OUTDIR, exist_ok=True)
        with open(RUNLOG, "a", encoding="utf-8") as fh:
            fh.write(json.dumps(row, ensure_ascii=False) + NL)
        _own(RUNLOG)
    except Exception:
        pass

    print(json.dumps({k: row[k] for k in ("ts", "rc", "screen_clean", "nominations",
                                          "none_offered", "proposal")},
                     indent=2, ensure_ascii=False))
    if not clean:
        print("⛔ PROPOSAL REFUSED — the screen fired. Nothing was written. Hits:")
        for h in hits[:5]:
            print("   %-24s ...%s..." % (h["matched"], h["context"][:100]))
        return 1
    if none_offered or not nominations:
        print("no nominations offered — nothing written, and that is a valid outcome")
        return 0
    print("proposal written: " + str(out))
    return 0


if __name__ == "__main__":
    sys.exit(main())
