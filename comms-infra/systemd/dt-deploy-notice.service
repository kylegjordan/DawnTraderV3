[Unit]
Description=Tell observation-window owners that a staging deploy is landing in their window, and how it ended (B-DEPLOY-WINDOW-GUARD, #1249)
OnFailure=agent-unit-failure@%N.service
[Service]
Type=oneshot
User=langston
# HOME set explicitly: a scheduled run does not inherit the HOME a hand-run has (the agent-work-sync lesson).
Environment=HOME=/home/langston
# /var/lib/dt-deploy-notice, owned by langston, created by systemd: the watcher's state (lines seen, pending outcomes).
StateDirectory=dt-deploy-notice
# B-2 (Langston, gate B): /var/log is root:syslog, so langston cannot create a file there. systemd creates this dir.
LogsDirectory=dt-deploy-notice
ExecStart=/usr/bin/python3 /usr/local/bin/dt-deploy-notice
TimeoutStartSec=600
