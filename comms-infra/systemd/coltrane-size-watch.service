[Unit]
Description=Measure Coltranes auto-loaded instructions against a ceiling that may only fall
Documentation=file:///usr/local/bin/coltrane-size-watch

[Service]
Type=oneshot
ExecStart=/usr/local/bin/coltrane-size-watch
# ⛔ NO ExecStartPost heartbeat (B-SIZE-WATCH-BREACH-ALARM, rule 18). The old `--heartbeat` ran here, inside this
#    same unit straight after the measurement, so it only ever ran when the watch was alive and could never
#    report a dead one. The watch now arms a staging alert 26 h out on every run; a missed run fires it.
# ⚠️ A BREACH EXITS 1 BY DESIGN, so the unit must not treat that as a unit failure.
SuccessExitStatus=0 1
