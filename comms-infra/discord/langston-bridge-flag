#!/usr/bin/env python3
"""langston-bridge-flag — set, clear or show the two capacity flags of Langston's bridge (B-LANGSTON-TWO-WORKERS,
#1248, OBJ-5). Installed to /usr/local/sbin, root only.

  langston-bridge-flag drain on|off --by <actor>        take no new review; each running review finishes
  langston-bridge-flag one-worker on|off --by <actor>   worker 2 takes no new review (back to one at a time)
  langston-bridge-flag status

WHY ROOT. The flags live in /etc/langston (root-owned, 0755) and the bridge runs as langston, so the bridge reads
them and cannot write them: Langston cannot raise his own capacity. Every Claude session reaches the agent box as
root, so CC-INFRA (owner of the observation's quality stop) and PM Claude (the 85 % usage line) can both set them.
Each worker reads both flags before it takes a task, so a change takes effect at the next task with no restart.
Every change is appended to /var/log/langston-bridge-flags.log with the actor (--by is recorded as a claim).
Exit 0 done · 2 refused (not root, bad arguments)."""
import datetime
import json
import os
import sys

FLAGS = {"drain": "/etc/langston/bridge-drain", "one-worker": "/etc/langston/bridge-one-worker"}
LOG = "/var/log/langston-bridge-flags.log"


def is_set(path):
    """Same rule as the bridge's _flag_set: only a positively ABSENT path is clear; a path that cannot be stat'ed
    reads as set, so this tool can never report an unknown flag as off (Coltrane, Step 4 (4))."""
    try:
        os.lstat(path)
        return True
    except FileNotFoundError:
        return False
    except OSError:
        return True


def status():
    return {name: is_set(path) for name, path in FLAGS.items()}


def main(argv):
    if argv == ["status"]:
        print(json.dumps(status()))
        return 0
    if os.geteuid() != 0:
        print("REFUSED: run as root (the flags are root-owned so the bridge cannot raise its own capacity)")
        return 2
    if len(argv) != 4 or argv[0] not in FLAGS or argv[1] not in ("on", "off") or argv[2] != "--by" or not argv[3].strip():
        print(__doc__.split("WHY ROOT")[0].strip())
        return 2
    name, state, actor = argv[0], argv[1], argv[3].strip()
    path = FLAGS[name]
    before = is_set(path)
    if state == "on":
        with open(path, "w") as fh:
            fh.write("%s set by %s\n" % (datetime.datetime.now(datetime.timezone.utc).isoformat(), actor))
        os.chmod(path, 0o644)
    elif before:
        try:
            os.remove(path)
        except FileNotFoundError:
            pass
    line = {"ts": datetime.datetime.now(datetime.timezone.utc).isoformat(), "flag": name, "was": before,
            "now": state == "on", "by_claimed": actor, "via_uid": os.getuid()}
    with open(LOG, "a") as fh:
        fh.write(json.dumps(line) + "\n")
    print("%s: %s -> %s (by %s)" % (name, "on" if before else "off", state, actor))
    print(json.dumps(status()))
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
