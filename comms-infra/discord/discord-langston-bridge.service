[Unit]
Description=Langston Discord gateway bridge (Claude Code via discord.py)
After=network-online.target
Wants=network-online.target
# B-DISCORD-INBOUND-LIVENESS (#462): StartLimit=5-in-60s guards a fast crash-loop while a slow
# DROP/timeout gateway outage restarts forever under Restart=always. Honest limit: a REFUSE/DNS
# outage (~12s/cycle) still latches — made LOUD by OnFailure. Root fix scheduled (#465). See the
# CC unit for the full rationale.
OnFailure=discord-bridge-failed-notify@%n.service
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
# Type=notify + WatchdogSec backstop (see the CC bridge unit for the full rationale): the LOUD
# in-process watchdog fires first at the stale threshold; systemd SIGABRTs at WatchdogSec only if
# the whole event loop hangs so the in-process path cannot run (#462).
Type=notify
NotifyAccess=main
WatchdogSec=300
# TimeoutStartSec=infinity (Langston Step-4): default 90s Type=notify start-timeout during a
# gateway-unreachable outage would trip StartLimit → `failed`-latch → silent non-recovery. Let
# READY=1 arrive whenever discord.py reconnects. Startup-only; inert once active. (See CC unit.)
TimeoutStartSec=infinity
User=langston
Group=langston
WorkingDirectory=/home/langston
Environment="HOME=/home/langston"
Environment="PATH=/opt/discord-bridges/venv/bin:/usr/local/bin:/usr/bin:/bin"
ExecStart=/opt/discord-bridges/venv/bin/python3 /opt/discord-bridges/discord-langston-bridge.py
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
