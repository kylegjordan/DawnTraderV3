#!/usr/bin/env python3
"""langston-bridge-restart — THE way to restart Langston's Discord bridge. Root, on Helsinki.

    langston-bridge-restart [--now] [--wait-s N] [--accept-clamp] [--dry-run]

⛔ WHY THIS EXISTS (B-LANGSTON-RELIEF, measured 2026-10-17): the bridge holds its queue IN MEMORY. A
restart without a recovery floor drops every message waiting in it. At 04:35:04Z a hand-typed
`systemctl restart` - timed correctly, one second after a posted reply - still dropped seven sessions'
review requests, because the floor file was not written first. The procedure was in prose and nothing
made the floor part of the act. This helper does all of it, in order, or refuses:

  1. computes the floor: the earliest of (this process's start, the creation time of every message this
     process enqueued - text OR voice - without a DELIVERED reply), less 1 s;
  2. writes it to /home/langston/.discord-bridge/recover-since (atomic, owned by langston) - early, so a crash
     of this helper still leaves one;
  3. waits for a `responded to msg` line - a reply posted, nothing in flight - unless --now;
  4. RE-DERIVES the floor at that moment and rewrites it immediately before the restart (Langston r1
     BLOCKER-2: a floor written up to --wait-s earlier can age past the bridge's 24 h refusal). If the floor
     would be older than the bridge accepts, it REFUSES and names the messages that would fall outside -
     unless --accept-clamp, which restarts with the oldest acceptable floor and names what it gives up;
  5. restarts, then reads the bridge's own SUMMARY line, three ways (Langston r1 BLOCKER-1 - the first
     `recovery:` line is an intent line that prints before any work, so it proves nothing):
        `recovery: re-read channel since …`  -> exit 0 (and the bridge must have consumed the floor file)
        `recovery: FAILED …`                 -> exit 5
        `recovery: floor file ignored …`     -> exit 7
     no summary within 180 s -> exit 8.

"Delivered reply" is the bridge's own rule, imported, never re-implemented: alert_lane.inbox_evidence.
--dry-run prints the plan and changes nothing.

Limits, stated: (a) a post Langston answered by replying to a DIFFERENT post (a superseded revision) reads as
unanswered and is re-fed - OLD Claude's B75 r5, 2026-10-17; (b) a message dropped by an EARLIER restart that
had no floor is older than this process and is not covered - repair that by hand, once; (c) it needs the
journal to still hold this process's start (it refuses otherwise - an enqueue line it cannot see is a message
it cannot protect); (d) it trusts that systemd reports UTC (it refuses any other zone token).
"""
import argparse, datetime as dt, os, pwd, re, subprocess, sys, tempfile, time

UNIT = "discord-langston-bridge.service"
BRIDGE_DIR = os.environ.get("LBR_BRIDGE_DIR", "/opt/discord-bridges")
FLOOR_FILE = "/home/langston/.discord-bridge/recover-since"
INBOX = "/var/log/cc-discord-inbox.jsonl"
BRIDGE_MAX_AGE = dt.timedelta(hours=24)          # langston_queue.RECOVER_MAX_AGE_S
HEADROOM = dt.timedelta(seconds=60)               # a floor written just before the restart is read seconds later
DISCORD_EPOCH_MS = 1420070400000
UTC = dt.timezone.utc
START_LINE = "Discord Langston bridge starting."
PENDING_RE = re.compile(r"(?:text|voice) enqueued: msg (\d+)")


class Refusal(Exception):
    def __init__(self, code, msg):
        super().__init__(msg)
        self.code = code


# ---- pure decisions (tested offline: test_langston_bridge_restart.py) ----

def snowflake_time(mid):
    return dt.datetime.fromtimestamp(((int(mid) >> 22) + DISCORD_EPOCH_MS) / 1000, UTC)


def parse_systemd_ts(raw):
    """`Sat 2026-10-17 04:43:35 UTC` -> aware datetime. Any zone token but UTC is refused, never assumed."""
    parts = (raw or "").split()
    if len(parts) != 4:
        raise Refusal(2, "refusing: cannot parse the unit's start time %r" % raw)
    if parts[3] != "UTC":
        raise Refusal(2, "refusing: systemd reports the start time in %r, not UTC - the floor would be wrong" % parts[3])
    return dt.datetime.strptime(parts[1] + " " + parts[2], "%Y-%m-%d %H:%M:%S").replace(tzinfo=UTC)


def plan_floor(start, journal_text, answered, now):
    """(floor, pending, outside, clamped). The floor covers the process start and every enqueued message without a
    delivered reply; `outside` are the pending ids older than the oldest floor the bridge will accept."""
    if START_LINE not in journal_text:
        raise Refusal(2, "refusing: the journal no longer holds this process's start line - enqueues before it are "
                         "invisible, so the floor cannot be trusted")
    pending = sorted({int(m) for m in PENDING_RE.findall(journal_text)} - set(answered))
    floor = min([start] + [snowflake_time(m) for m in pending]) - dt.timedelta(seconds=1)
    oldest_ok = now - BRIDGE_MAX_AGE + HEADROOM
    outside = [m for m in pending if snowflake_time(m) <= oldest_ok]
    clamped = floor < oldest_ok
    return max(floor, oldest_ok).replace(microsecond=0) if clamped else floor.replace(microsecond=0), pending, outside, clamped


def classify(line):
    """A journal line after the restart -> None (keep waiting) or (exit code, label)."""
    if "recovery: re-read channel since" in line:
        return 0, "recovered"
    if "recovery: FAILED" in line:
        return 5, "recovery FAILED"
    if "recovery: floor file ignored" in line:
        return 7, "floor REFUSED by the bridge"
    return None


def first_verdict(lines):
    for l in lines:
        v = classify(l)
        if v:
            return v, l
    return None, None


# ---- effects ----

def sh(*cmd):
    return subprocess.run(cmd, capture_output=True, text=True, check=False)


def process_start():
    return parse_systemd_ts(sh("systemctl", "show", "-p", "ExecMainStartTimestamp", "--value", UNIT).stdout.strip())


def journal_since(start):
    return sh("journalctl", "-u", UNIT, "--since", start.strftime("%Y-%m-%d %H:%M:%S"), "--utc",
              "--no-pager", "-o", "cat").stdout


def delivered_replies():
    sys.path.insert(0, BRIDGE_DIR)
    import alert_lane                                  # the bridge's own predicate, not a second copy
    _routed, replied = alert_lane.inbox_evidence(INBOX, tail_bytes=1 << 30)
    return replied


def current_plan(now):
    start = process_start()
    return (start,) + plan_floor(start, journal_since(start), delivered_replies(), now)


def write_floor(floor):
    pw = pwd.getpwnam("langston")
    fd, tmp = tempfile.mkstemp(dir=os.path.dirname(FLOOR_FILE), prefix=".recover-since-")
    with os.fdopen(fd, "w", encoding="utf-8") as fh:
        fh.write(floor.strftime("%Y-%m-%dT%H:%M:%SZ"))
    os.chown(tmp, pw.pw_uid, pw.pw_gid)
    os.chmod(tmp, 0o640)
    os.replace(tmp, FLOOR_FILE)


def follow(pattern_fn, timeout_s, since=None):
    """Feed live journal lines to pattern_fn until it returns a value; None on timeout."""
    cmd = ["journalctl", "-u", UNIT, "-f", "--no-pager", "-o", "cat"]
    cmd += ["--since", since.strftime("%Y-%m-%d %H:%M:%S"), "--utc"] if since else ["-n0"]
    p = subprocess.Popen(cmd, stdout=subprocess.PIPE, text=True)
    deadline = time.time() + timeout_s
    try:
        os.set_blocking(p.stdout.fileno(), False)
        buf = ""
        while time.time() < deadline:
            chunk = p.stdout.read() or ""
            buf += chunk
            *lines, buf = buf.split("\n")
            for l in lines:
                v = pattern_fn(l)
                if v is not None:
                    return v, l
            if not chunk:
                time.sleep(0.2)
        return None, None
    finally:
        p.kill()


def show(start, floor, pending, outside, clamped):
    print("process start %sZ; %d enqueued message(s) without a delivered reply%s" % (
        start.strftime("%Y-%m-%dT%H:%M:%S"), len(pending), (": " + " ".join(map(str, pending))) if pending else ""))
    print("floor %s%s" % (floor.strftime("%Y-%m-%dT%H:%M:%SZ"),
                          ("  ⚠ CLAMPED to the oldest floor the bridge accepts; OUTSIDE it: " +
                           " ".join(map(str, outside))) if clamped else ""))


def run(a):
    if os.geteuid() != 0:
        raise Refusal(2, "refusing: run as root")
    start, floor, pending, outside, clamped = current_plan(dt.datetime.now(UTC))
    show(start, floor, pending, outside, clamped)
    if a.dry_run:
        return 0
    write_floor(floor)
    print("floor written to %s (early copy; re-derived before the restart)" % FLOOR_FILE)
    if not a.now:
        print("waiting up to %d s for a posted reply ..." % a.wait_s)
        v, line = follow(lambda l: True if re.search(r"responded to msg \d+", l) else None, a.wait_s)
        if v is None:
            print("NOT restarted: no reply posted in %d s (the floor file stays; re-run, or use --now)" % a.wait_s)
            return 2
        print("seen: " + line.strip())
    start, floor, pending, outside, clamped = current_plan(dt.datetime.now(UTC))
    show(start, floor, pending, outside, clamped)
    if clamped and not a.accept_clamp:
        print("NOT restarted: %d waiting message(s) are older than the bridge will recover; re-run with "
              "--accept-clamp to give them up, or repair by hand" % len(outside))
        return 9
    write_floor(floor)
    t0 = dt.datetime.now(UTC)
    r = sh("systemctl", "restart", UNIT)
    if r.returncode != 0:
        print("restart FAILED: " + (r.stderr or "").strip())
        return 4
    print("restarted at %sZ" % t0.strftime("%Y-%m-%dT%H:%M:%S"))
    v, line = follow(classify, 180, since=t0)
    if v is None:
        print("NO recovery summary within 180 s - check the journal")
        return 8
    code, label = v
    print("%s: %s" % (label, line.strip()))
    if code == 0 and os.path.exists(FLOOR_FILE):
        print("but the floor file is still there - remove it before the next restart")
        return 6
    return code


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--now", action="store_true", help="restart without waiting for a posted reply")
    ap.add_argument("--wait-s", type=int, default=1800, help="how long to wait for a posted reply")
    ap.add_argument("--accept-clamp", action="store_true", help="restart even if some waiting messages are too old")
    ap.add_argument("--dry-run", action="store_true")
    try:
        return run(ap.parse_args())
    except Refusal as e:
        print(str(e))
        return e.code


if __name__ == "__main__":
    sys.exit(main())
