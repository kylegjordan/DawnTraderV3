# TEMPLATE for /etc/dawntrader/discord-comms.env  (Kyle-provisioned, NOT secrets)
# Fill with the IDs from the setup checklist, then deploy. These are channel/user
# IDs, not tokens — the two bot TOKENS go in the separate per-bot env files:
#   /etc/langston/discord-cc-bot.env       ->  DISCORD_BOT_TOKEN=<CC bot token>
#   /etc/langston/discord-langston-bot.env ->  DISCORD_BOT_TOKEN=<Langston bot token>
DISCORD_CHANNEL_ID=PUT_CHANNEL_ID_HERE
KYLE_DISCORD_ID=PUT_KYLE_USER_ID_HERE
# CC_BOT_ID = the "DawnTrader CC" bot's Application ID (Dev Portal > General Information).
# Langston accepts messages from THIS exact bot id (not any bot) — loop-safety pin.
CC_BOT_ID=PUT_CC_BOT_APPLICATION_ID_HERE
# Optional (nice-to-have, not load-bearing):
LANGSTON_BOT_ID=PUT_LANGSTON_BOT_APPLICATION_ID_HERE
DISCORD_GUILD_ID=PUT_SERVER_ID_HERE
