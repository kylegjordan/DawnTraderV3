[Unit]
Description=CC Discord gateway bridge (CC inbound log + send, via discord.py)
After=network-online.target
Wants=network-online.target
# B-DISCORD-INBOUND-LIVENESS (#462). StartLimit=5-in-60s guards a FAST crash-loop while letting a
# slow DROP/timeout-mode gateway outage (~73s/cycle — discord.py crashes at client.py:787 on a
# can't-connect, so the process EXITS rather than sitting in `activating`) restart forever under
# Restart=always → survives + auto-recovers (Langston Step-8: 600→60 approved). HONEST LIMIT: a
# REFUSE/DNS-fail outage fails in <1s → ~12s/cycle → still trips 5-in-60 → latches `failed`. That
# latch is made LOUD by OnFailure below (fail-loud, not the silent latch this batch kills). The
# durable ROOT fix (wrap the initial connect so the library crash never exits the process) is
# scheduled — RUNNING_ISSUES #465 / B-DISCORD-CONNECT-RESILIENCE.
OnFailure=discord-bridge-failed-notify@%n.service
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
# Type=notify + WatchdogSec: the systemd BACKSTOP layer. The bridge sends READY=1 on gateway
# connect and WATCHDOG=1 only while the gateway is receiving; if the whole event loop hangs (so
# the in-process loud watchdog can't run), the pings stop and systemd SIGABRTs at WatchdogSec.
# WatchdogSec (300s) > the in-process stale threshold (~164s) so the LOUD in-process path fires
# first; systemd only catches the full-hang case (#462).
Type=notify
NotifyAccess=main
WatchdogSec=300
# TimeoutStartSec=infinity (Langston Step-4 CHANGES-NEEDED): with Type=notify the default 90s
# start-timeout would, during a Discord-SIDE outage where the gateway is unreachable (on_ready →
# READY=1 never fires), kill the unit at 90s each cycle → ~100s/cycle → 5 kills < StartLimitIntervalSec
# 600 → StartLimitBurst trips → unit latches `failed` and stops restarting, NOT auto-recovering when
# Discord returns = the exact silent-comms-death this batch kills. reconnect=True already sits and
# retries; let READY=1 arrive whenever it connects. Startup-only window — inert once active.
TimeoutStartSec=infinity
User=root
Group=root
Environment="PATH=/opt/discord-bridges/venv/bin:/usr/local/bin:/usr/bin:/bin"
ExecStart=/opt/discord-bridges/venv/bin/python3 /opt/discord-bridges/discord-cc-bridge.py daemon
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
