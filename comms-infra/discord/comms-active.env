# /etc/dawntrader/comms-active.env — THE SWITCH.
# Read by cc-send to decide where CC's outbound goes.
#   telegram = live (default). discord = switched over.
# Flip this one line to switch; flip it back to roll back instantly.
# (Telegram services stay running during the Discord trial, so rollback is lossless.)
COMMS_BACKEND=telegram
