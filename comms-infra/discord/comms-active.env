# /etc/dawntrader/comms-active.env — THE SWITCH.
# Read by cc-send to decide where CC's outbound goes. deploy.sh seeds it ONLY when the file is
# absent (a rebuilt host); it never overwrites a live one.
#   discord = live (since cutover #333, 2026-06-25).
#   telegram = DECOMMISSIONED (#348, 2026-07-02): cc-send fails loudly on it; restoring
#   Telegram is a restore-from-archive job, not a switch flip.
# B-CREDENTIALS-PRIVATE-REPO, 2026-09-29: this seed still said telegram, so a rebuilt host would
# have come up pointed at a path that no longer exists.
COMMS_BACKEND=discord
