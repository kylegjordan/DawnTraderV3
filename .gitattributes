# ============================================================
# DAWNTRADER — Git LFS Tracking Configuration
# Large files are stored via Git LFS to avoid GitHub size limits

# ---- Large data files (logs, aggregates, diagnostics) ----
logs/**/*.json          filter=lfs diff=lfs merge=lfs -text
logs/**/*.jsonl         filter=lfs diff=lfs merge=lfs -text
logs/**/*.log           filter=lfs diff=lfs merge=lfs -text
logs/**/*.csv           filter=lfs diff=lfs merge=lfs -text
logs/**/*.txt           filter=lfs diff=lfs merge=lfs -text
diagnostic-reports/**   filter=lfs diff=lfs merge=lfs -text
# ---- Archive / backup files ----
*.sql                   filter=lfs diff=lfs merge=lfs -text
*.tar.gz                filter=lfs diff=lfs merge=lfs -text
*.zip                   filter=lfs diff=lfs merge=lfs -text
*.bak                   filter=lfs diff=lfs merge=lfs -text
*.dump                  filter=lfs diff=lfs merge=lfs -text
*.ndjson                filter=lfs diff=lfs merge=lfs -text
backups/**              filter=lfs diff=lfs merge=lfs -text
.cache/**               filter=lfs diff=lfs merge=lfs -text
