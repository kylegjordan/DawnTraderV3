[Unit]
Description=CC Comms Bridge (CCDTCommsBot poll, replaces OpenClaw ccdt-relay)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
Environment="PATH=/usr/local/bin:/usr/bin:/bin"
ExecStart=/usr/bin/python3 /usr/local/bin/cc-comms-bridge daemon
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
