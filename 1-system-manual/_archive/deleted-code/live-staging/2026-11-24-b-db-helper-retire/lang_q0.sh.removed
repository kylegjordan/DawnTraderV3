cd /home/deploy/dawntrader
export $(grep -E '^DATABASE_URL=' .env | head -1)
psql "$DATABASE_URL" -A -F'|' -c "select table_name, string_agg(column_name,', ' order by ordinal_position) from information_schema.columns where table_name in ('closed_trades','active_open_positions') group by table_name;"
