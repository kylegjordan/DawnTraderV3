cd /home/deploy/dawntrader
export $(grep -E '^DATABASE_URL=' .env | head -1)
psql "$DATABASE_URL" -A -F'|' <<'SQL'
\echo == the trade pair ==
select id, symbol, asset_class, closed, opened_at, stop_loss, take_profit, strategy_name
from vts_open_trades where symbol='STRK/USD' order by opened_at desc limit 6;
\echo == afternoon book 16:50Z -> now, STRK ==
select count(*) snaps,
       min(bid) min_bid, max(bid) max_bid,
       count(*) filter (where bid <= 68.44530375) bid_at_or_below_stop,
       count(*) filter (where (ask-bid)/((ask+bid)/2.0) <= 0.0107) spread_within_ceiling,
       count(*) filter (where bid <= 68.44530375 and (ask-bid)/((ask+bid)/2.0) <= 0.0107) BOTH,
       count(*) filter (where bid >= ask) crossed_or_equal,
       max(captured_at) last_snap
from xstock_spot_ticker_snap
where symbol='STRK/USD' and captured_at >= '2026-11-06 16:50:00Z';
\echo == positive control SPY same window ==
select count(*) snaps, count(*) filter (where (ask-bid)/((ask+bid)/2.0) <= 0.0107) spread_ok, max(captured_at) last_snap
from xstock_spot_ticker_snap where symbol='SPY/USD' and captured_at >= '2026-11-06 16:50:00Z';
\echo == STRK latest 6 snaps ==
select captured_at, bid, ask, round((((ask-bid)/((ask+bid)/2.0))*100)::numeric,4) spread_pct
from xstock_spot_ticker_snap where symbol='STRK/USD' order by captured_at desc limit 6;
SQL
