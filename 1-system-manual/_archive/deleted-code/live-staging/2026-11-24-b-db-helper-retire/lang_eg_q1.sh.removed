cd /home/deploy/dawntrader
export $(grep -E '^DATABASE_URL=' .env | head -1)
psql "$DATABASE_URL" -A -F'|' <<'SQL'
\echo == module_constants columns ==
select ordinal_position, column_name, data_type from information_schema.columns where table_name='module_constants' order by 1;
\echo == PK columns ==
select kcu.ordinal_position, kcu.column_name from information_schema.table_constraints tc join information_schema.key_column_usage kcu on tc.constraint_name=kcu.constraint_name where tc.table_name='module_constants' and tc.constraint_type='PRIMARY KEY' order by 1;
SQL
