cd /home/deploy/dawntrader
export $(grep -E '^DATABASE_URL=' .env | head -1)
psql "$DATABASE_URL" -A -F'|' -c "set statement_timeout='280s'; select count(*) n_invalidtarget_30d, min(captured_at) first, max(captured_at) last from signal_eval_archive where captured_at >= '2026-10-15T00:00:00Z' and gate_decision::text like '%InvalidTarget%';"
