// ===== storage.updateRtbSignal =====
  async updateRtbSignal(id: string, updates: Partial<RtbSignal>): Promise<RtbSignal> {
    const [updated] = await db
      .update(rtbSignals)
      .set(updates)
      .where(eq(rtbSignals.id, id))
      .returning();
    return updated;
  }

