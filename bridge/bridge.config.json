{
  "bridge_version": "1.0",
  "current_phase": "Phase-2A",
  "bridge_mode": "awareness_only",
  "source_of_truth": "replit",
  "canonical_path": "/bridge/canonical",
  "reference_path": "/bridge/reference",
  "decisions_path": "/bridge/decisions",
  "directives_path": "/bridge/directives",
  "runtime_path": "/bridge/runtime",
  "approval_required": true,
  "execution_without_approval": false,
  "assistant_policy": "session-bootstrap-required",
  "automation_enabled": false,
  "chatgpt_role": "architect",
