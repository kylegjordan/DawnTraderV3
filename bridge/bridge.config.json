  "human_role": "final_authority",
  "rules": {
    "never_override_canonical": true,
    "never_execute_unapproved_directives": true,
    "document_all_phase_transitions": true,
    "log_all_decisions": true
  },
  "communication": {
    "directive_template": "/bridge/runtime/directive-template.md",
    "replit_response_template": "/bridge/runtime/replit-response-template.md",
    "review_checklist": "/bridge/runtime/review-checklist.md"
  }
}
