# DawnTrader Environment Variables
# Copy this file to .env and fill in the values.
# NEVER commit .env to git — it contains secrets.

# ===========================================
# REQUIRED — App will not start without these
# ===========================================

# PostgreSQL connection string (Supabase or local)
# Format: postgresql://user:password@host:port/database
DATABASE_URL=

# JWT signing secrets (generate with: openssl rand -hex 32)
JWT_SECRET=
JWT_REFRESH_SECRET=

# ===========================================
# EXCHANGE — Required for live/paper trading
# ===========================================

# Kraken API credentials
KRAKEN_API_KEY=
KRAKEN_API_SECRET=
KRAKEN_PRIVATE_KEY=

# ===========================================
# AI — Required for AI analysis features
# ===========================================

OPENAI_API_KEY=

# ===========================================
# RUNTIME CONFIGURATION
# ===========================================

# Server
NODE_ENV=production
PORT=5000

# CORS — comma-separated list of allowed origins
# Example: https://staging.dawntrader.com,https://dawntrader.com
ALLOWED_ORIGINS=

# Commit SHA — set by CI/CD pipeline during build
COMMIT_SHA=

# ===========================================
# ML SERVICE
# ===========================================

ML_SERVICE_HOST=http://localhost:5001
ML_SERVICE_AUTO_START=true
ML_SERVICE_TRAINING_ENABLED=false
INTERNAL_SERVICE_KEY=dawntrader-internal-ml-service-key-2025

# ===========================================
# FEATURE FLAGS
# ===========================================

PASSIVE_LEARNING_ENABLED=true
SINGLE_TENANT=true
WALTER_DISABLED=true
LATTI_ENABLED=true

# ===========================================
# TUNING PARAMETERS (defaults are sensible)
# ===========================================

# SQE thresholds
# SQE_NGC_MIN=0.30
# SQE_CWQI_MIN=0.20
# SQE_PROFIT_RATE_MIN=0.00
# SQE_MAX_RISK=0.95
# SQE_FINAL_SCORE_MIN=0.35
# SQE_REGIME_MIN=0.30

# Trade Criteria Limiter
# TCL_SIGNAL_THRESHOLD=15
# MAX_OPEN_TRADES=15

# Logging
# LOG_LEVEL=info
# DIAGNOSTIC_MODE=false
