# DawnTrader Environment Variables
# Copy this to .env and fill in your actual values

# Database
DATABASE_URL=

# JWT Secrets
JWT_SECRET=
JWT_REFRESH_SECRET=

# Phase 5B.HF: Test Credentials (for automated tests and internal services)
# These should be set in Replit Secrets for security
APP_TEST_USERNAME=
APP_TEST_PASSWORD=

# API Keys (set in Replit Secrets)
OPENAI_API_KEY=
KRAKEN_API_KEY=
KRAKEN_API_SECRET=
FINNHUB_API_KEY=

# Bob Metrics Configuration
BOB_ENABLED=true
BOB_METRICS_TTL_SECONDS=60
BOB_PREFETCH_ON_CHAT_OPEN=true
BOB_PREFETCH_ON_MODE_CHANGE=true

# Cache Configuration
CACHE_DEBUG=false
DEFAULT_CACHE_TTL=90000

# Logging
LOG_LEVEL=info

# Node Environment
NODE_ENV=development
