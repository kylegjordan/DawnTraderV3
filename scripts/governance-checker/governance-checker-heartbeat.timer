# B-GOV-2 OBJ-3 — dead-man heartbeat timer. Runs every 15 min; the poller ticks every 30 min
# and the dead-man window is TICK_MINUTES × HEARTBEAT_MISS_LIMIT (30 × 2 = 60 min), so a dead
# poller is flagged within ~60–75 min.
[Unit]
Description=B-GOV-2 governance-checker heartbeat timer (every 15 min)

[Timer]
OnBootSec=8min
OnUnitActiveSec=15min
Persistent=true

[Install]
WantedBy=timers.target
