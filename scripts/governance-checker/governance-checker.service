# B-GOV-2 governance-checker — systemd oneshot. Own process, NOT a while-true daemon,
# isolated from the dawntrader node event loop. Paired with governance-checker.timer.
# HOST = STAGING (188.245.193.8) (Langston B-GOV-2 Step-1: the alert queue lives here,
# reliable always-on host, single clock, local CLI = no per-alert ssh). Runs against a
# DEDICATED LOCAL clone (NOT the gdrive mount, NOT the live app checkout).
[Unit]
Description=B-GOV-2 governance-checker tick (post-batch doc-set + deadline checker)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=deploy
WorkingDirectory=/opt/governance-checker/DawnTraderV3
# Dedicated local clone (git reads). State persisted outside the repo tree.
Environment=GOV_STATE_FILE=/var/lib/governance-checker/state.json
Environment=GOV_BRANCH=origin/migration/aws-supabase
# CLI runs LOCALLY on staging against the live app dir (no ssh — GOV_REMOTE unset).
Environment=GOV_STAGING_REPO=/home/deploy/dawntrader
# OBJ-5d: SHADOW for the first batch-or-two (all alerts → info); set GOV_SHADOW=0 to go live.
Environment=GOV_SHADOW=1
ExecStart=/usr/bin/node scripts/governance-checker/poller.mjs
# Hard ceiling so a wedged git can never hang the tick (the §18 lesson).
TimeoutStartSec=120
