{
  "environment": "staging",
  "description": "Staging environment configuration for pre-production validation",
  "database": {
    "useProductionDb": false,
    "comment": "Use separate staging database instance"
  },
  "kraken": {
    "apiUrl": "https://api.kraken.com",
    "comment": "Kraken does not provide sandbox - use test API keys with minimal funding"
  },
  "trading": {
    "maxPositionSize": 50,
    "maxOpenTrades": 2,
    "minNotional": 10,
    "riskPerTrade": 5,
    "comment": "Reduced position sizes for testing (staging uses real money but small amounts)"
  },
  "resilience": {
    "enableBracketRollback": true,
    "enablePartialFillRecovery": true,
    "enableCircuitBreaker": true,
    "circuitBreakerThreshold": 3,
    "circuitBreakerTimeout": 30000,
    "enableRateLimiting": true,
    "rateLimitRequestsPerSecond": 2,
    "enableRetries": true,
    "maxRetries": 3,
    "comment": "Lower circuit breaker threshold (3 vs 5) for faster testing"
  },
  "logging": {
    "level": "debug",
    "enableFailoverLogging": true,
    "logDirectory": "./logs/staging",
    "enableConsoleOutput": true,
    "comment": "Verbose logging for debugging"
  },
  "monitoring": {
    "enableDetailedMetrics": true,
    "logAllApiCalls": true,
    "trackOrderLifecycle": true,
    "comment": "Enhanced monitoring for validation"
  },
  "safety": {
    "requireManualApproval": false,
    "enableKillSwitch": true,
    "killSwitchThreshold": 0.05,
    "comment": "5% loss limit (lower than production 7%) for safety"
  }
}
