# B-TOKEN-WATCH-BIRTH-CAP (KD-90): the birth cap's minute tick. Switches the Helius birth subscription on and off
# on a timetable fixed once per credit cycle, as tokenwatch; the ExecStartPost step mints any page it left, as root
# (the same split as token-watch-feed-watch). It acts only while /var/lib/token-watch/state/birthcap.enabled exists.
[Unit]
Description=token-watch birth cap: switch the new-coin feed on its timetable (fails closed to ON)
Documentation=file:///opt/token-watch/birthcap.py
OnFailure=token-watch-failed@%n.service

[Service]
Type=oneshot
User=tokenwatch
Group=tokenwatch
WorkingDirectory=/opt/token-watch
Environment=TOKEN_WATCH_ROOT=/var/lib/token-watch
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/python3 /opt/token-watch/birthcap.py --tick
ExecStartPost=+/usr/bin/python3 /opt/token-watch/birthcap.py --mint
TimeoutStartSec=120
CPUQuota=25%
MemoryMax=192M
# TasksMax covers the ExecStartPost mint too, which runs node (npm system-alerts): at 32 it aborts (rc 134,
# measured 2026-11-16 at switch-on); 48 is the measured minimum, 64 matches token-watch-feed-watch.
TasksMax=64
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/token-watch
