[Unit]
Description=token-watch published summary (the ONLY file the tracking page reads)
Documentation=file:///opt/token-watch/summary.py

# ⛔⛔ THIS UNIT DID NOT EXIST UNTIL 2026-09-09, AND ITS ABSENCE WAS INVISIBLE FROM EVERY
#    ANGLE EXCEPT THE PAGE ITSELF. summary.py has always had a __main__ that publishes
#    atomically; nothing ever ran it on a schedule. The file was written once by hand on
#    2026-09-08 07:01 and then sat there. `follow_up.py` imports summary and calls
#    summary.build() at :454 — but only to fold the numbers into its OWN stats, never to
#    write the published file. So every component looked healthy and the page went stale.
#    ★ Found by Coltrane and Langston independently, on their first-ever look at the page,
#      because the page's own staleness badge said so and nobody had been looking.
# B-TOKEN-WATCH-STORAGE OBJ-4 (#1132): a failure pages instead of passing silently.
OnFailure=token-watch-failed@%n.service

[Service]
Type=oneshot
User=tokenwatch
Group=tokenwatch
ExecStart=/usr/bin/python3 /opt/token-watch/summary.py
# ⚠️ Nothing here touches the trading app. It reads the study's own store and writes ONE
#    derived file into the published directory — the isolation summary.py's own docstring
#    describes ("the study publishes one derived file and the app reads that").
