[Unit]
Description=token-watch follow-up checkpoint sweep (one hour bucket)

[Service]
Type=oneshot
User=tokenwatch
Group=tokenwatch
WorkingDirectory=/opt/token-watch
ExecStart=/usr/bin/python3 /opt/token-watch/follow_up.py
CPUQuota=40%
# MEASURED, not guessed: by day 90 the tombstone set is ~376,000 mints at ~195
# bytes per set entry = ~73 MB resident, before the interpreter and the hour's
# working data. 256M would have been uncomfortably close to a ceiling that
# only bites in month three, and an OOM there looks like a crashed collector
# rather than like a limit set too low.
MemoryMax=512M
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/token-watch
ReadOnlyPaths=/etc/token-watch
