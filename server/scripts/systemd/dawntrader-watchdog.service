# B-STAGING-LIVENESS-WATCH (#512/#520) — staging out-of-process watchdog (oneshot).
# Install (staging box, as root):
#   cp dawntrader-watchdog.{service,timer} /etc/systemd/system/
#   systemctl daemon-reload && systemctl enable --now dawntrader-watchdog.timer
[Unit]
Description=DawnTrader staging liveness watchdog (detection-only)
# Self-liveness: a failed run is itself visible in the journal + unit state.
OnFailure=dawntrader-watchdog-failed-notify.service

[Service]
Type=oneshot
User=deploy
WorkingDirectory=/home/deploy/dawntrader
ExecStart=/usr/bin/node /home/deploy/dawntrader/server/scripts/staging-liveness-watchdog.mjs
Environment=PATH=/usr/local/bin:/usr/bin:/bin
TimeoutStartSec=180
