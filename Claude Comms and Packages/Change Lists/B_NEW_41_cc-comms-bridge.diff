+def is_allowed_voice(msg):
+    """Allowlist per scope §2.2: DM with bot OR topic 21 of Dawn Trader HQ group.
+
+    Returns True if this voice/audio message should be transcribed.
+    """
+    chat = msg.get("chat") or {}
+    chat_type = chat.get("type")
+    chat_id = chat.get("id")
+    thread_id = msg.get("message_thread_id")
+    sender = msg.get("from") or {}
+    # Reject bot senders (avoid loops on bot-to-bot or self-echo)
+    if sender.get("is_bot"):
+        return False
+    if chat_type == "private":
+        return True
+    if chat_type == "supergroup" and chat_id == GROUP_ID and thread_id == TOPIC_ID:
+        return True
+    return False
+
+
+def transcribe_audio(audio_path):
+    """Run whisper-cli on the audio file. Returns (text: str|None, error: str|None, duration_ms: int).
+
+    On success: text is non-empty stripped transcription, error is None.
+    On failure: text is None, error is descriptive message.
+    """
+    t0 = time.time()
+    out_prefix = f"/tmp/whisper-out-{os.getpid()}-{int(t0*1000)}"
+    args = [
+        WHISPER_CLI,
+        "-m", WHISPER_MODEL,
+        "-f", audio_path,
+        "-t", WHISPER_THREADS,
+        "-otxt",
+        "-of", out_prefix,
+        "-nt",  # no timestamps in output text
+    ]
+    try:
+        result = subprocess.run(
+            args, capture_output=True, text=True, timeout=WHISPER_TIMEOUT_S
+        )
+        elapsed_ms = int((time.time() - t0) * 1000)
+        if result.returncode != 0:
+            return None, f"whisper exit={result.returncode} stderr_tail={result.stderr[-500:]}", elapsed_ms
+        txt_path = out_prefix + ".txt"
+        if not Path(txt_path).exists():
+            return None, f"whisper produced no output file (stderr: {result.stderr[-500:]})", elapsed_ms
+        text = Path(txt_path).read_text(encoding="utf-8").strip()
+        try:
+            Path(txt_path).unlink()
+        except Exception:
+            pass
+        if not text:
+            return None, "whisper produced empty transcription", elapsed_ms
+        return text, None, elapsed_ms
+    except subprocess.TimeoutExpired:
+        return None, f"whisper timeout after {WHISPER_TIMEOUT_S}s", int((time.time() - t0) * 1000)
+    except Exception as e:
+        return None, f"whisper invoke error: {type(e).__name__}: {e}", int((time.time() - t0) * 1000)
+
+
+def voice_worker(voice_q):
+    """B-NEW-41: background worker. Single-threaded FIFO consumption of voice tasks.
+
+    Keeps the main poll loop unblocked during whisper transcription.
+    """
+    last_heartbeat = time.time()
+    while True:
+        try:
+            # Non-blocking get with timeout so heartbeat fires regularly
+            try:
+                task = voice_q.get(timeout=HEARTBEAT_INTERVAL_S)
+            except queue.Empty:
+                now = time.time()
+                if now - last_heartbeat >= HEARTBEAT_INTERVAL_S:
+                    log(f"voice worker alive, queue depth=0")
+                    last_heartbeat = now
+                continue
+            try:
+                handle_voice_task(task)
+            except Exception as e:
+                log(f"voice worker task error: {type(e).__name__}: {e}\n{traceback.format_exc()[:500]}")
+            finally:
+                voice_q.task_done()
+            if time.time() - last_heartbeat >= HEARTBEAT_INTERVAL_S:
+                log(f"voice worker alive, queue depth={voice_q.qsize()}")
+                last_heartbeat = time.time()
+        except Exception as e:
+            log(f"voice worker outer loop error (resuming): {type(e).__name__}: {e}")
+            time.sleep(1)
+
+
+def handle_voice_task(task):
+    """Process one voice/audio message: download, transcribe, write inbox, ACK chat."""
+    msg = task["msg"]
+    chat_id = task["chat_id"]
+    thread_id = task["thread_id"]
+    message_id = task["message_id"]
+    file_id = task["file_id"]
+    kind = task["voice_kind"]  # "voice" or "audio"
+
+    # Get file metadata + size cap check
+    meta = tg_request("getFile", {"file_id": file_id})
+    if not meta or not meta.get("ok"):
+        return fail_voice(task, reason="getFile_failed", details=str(meta)[:300])
+    file_size = meta["result"].get("file_size", 0)
+    if file_size > TG_FILE_SIZE_CAP:
+        return fail_voice(task, reason="oversize", details=f"{file_size}>{TG_FILE_SIZE_CAP}")
+    file_path = meta["result"].get("file_path")
+    if not file_path:
+        return fail_voice(task, reason="no_file_path", details=str(meta)[:300])
+
+    # Download to tmp + archive
+    date_str = time.strftime("%Y-%m-%d")
+    archive_dir = Path(VOICE_ARCHIVE_ROOT) / date_str
+    archive_dir.mkdir(parents=True, exist_ok=True)
+    ext = Path(file_path).suffix or ".ogg"
+    archive_path = archive_dir / f"{message_id}{ext}"
+    ok, actual_size = tg_download_file(file_path, str(archive_path))
+    if not ok:
+        return fail_voice(task, reason="download_failed", details=f"file_path={file_path}")
+    if actual_size == 0:
+        return fail_voice(task, reason="zero_byte_file", details=f"file_path={file_path}", archive_path=str(archive_path))
+
+    # Transcribe
+    log(f"voice: transcribing {archive_path} (size={actual_size}B)")
+    text, error, duration_ms = transcribe_audio(str(archive_path))
+    if text is None:
+        return fail_voice(task, reason="transcription_failed", details=error,
+                          archive_path=str(archive_path), duration_ms=duration_ms)
+
+    # Success: write inbox entry
+    entry = {
+        "schema_version": 1,
+        "ts": time.strftime("%Y-%m-%dT%H:%M:%S%z"),
+        "source": "cc-comms-bridge",
+        "kind": "voice_inbound",
+        "update_id": task.get("update_id"),
+        "message_id": message_id,
+        "chat_id": chat_id,
+        "chat_type": (msg.get("chat") or {}).get("type"),
+        "thread_id": thread_id,
+        "sender_id": (msg.get("from") or {}).get("id"),
+        "sender_username": (msg.get("from") or {}).get("username"),
+        "sender_is_bot": (msg.get("from") or {}).get("is_bot", False),
+        "voice_kind": kind,
+        "text": text,
+        "transcription_source": "whisper.cpp/ggml-small.en",
+        "transcription_duration_ms": duration_ms,
+        "audio_duration_s": (msg.get(kind) or {}).get("duration"),
+        "audio_archive_path": str(archive_path),
+        "file_id": file_id,
+        "file_size": actual_size,
+    }
+    append_inbox(entry)
+    log(f"voice_inbound: msg {message_id} transcribed in {duration_ms}ms ({len(text)} chars)")
+
+    # Post ACK to originating chat with 100-char preview
+    preview = text[:ACK_PREVIEW_CHARS] + ("..." if len(text) > ACK_PREVIEW_CHARS else "")
+    ack_text = f"✅ Voice transcribed: \"{preview}\" — Logged (msg {message_id}). CC will see at next session start."
+    post_to_chat(chat_id, thread_id, message_id, ack_text, fallback_to_topic_21=True,
+                 fallback_chat_id=chat_id, chat_type=(msg.get("chat") or {}).get("type"))
+
+
+def fail_voice(task, reason, details, archive_path=None, duration_ms=None):
+    """Write voice_inbound_failed entry to inbox + post fallback notice to chat."""
+    msg = task["msg"]
+    message_id = task["message_id"]
+    chat_id = task["chat_id"]
+    thread_id = task["thread_id"]
+    file_id = task["file_id"]
+    entry = {
+        "schema_version": 1,
+        "ts": time.strftime("%Y-%m-%dT%H:%M:%S%z"),
+        "source": "cc-comms-bridge",
+        "kind": "voice_inbound_failed",
+        "message_id": message_id,
+        "chat_id": chat_id,
+        "thread_id": thread_id,
+        "sender_id": (msg.get("from") or {}).get("id"),
+        "failure_reason": reason,
+        "details": details[:500] if details else None,
+        "file_id": file_id,
+        "audio_archive_path": archive_path,
+        "transcription_duration_ms": duration_ms,
+    }
+    append_inbox(entry)
+    log(f"voice_inbound_failed: msg {message_id} reason={reason}")
+    fallback_text = (
+        f"⚠️ Voice transcription failed (reason: {reason}). "
+        f"Please retry as text or paste the message again. (msg {message_id})"
+    )
+    chat_type = (msg.get("chat") or {}).get("type")
+    post_to_chat(chat_id, thread_id, message_id, fallback_text, fallback_to_topic_21=True,
+                 fallback_chat_id=chat_id, chat_type=chat_type)
+
