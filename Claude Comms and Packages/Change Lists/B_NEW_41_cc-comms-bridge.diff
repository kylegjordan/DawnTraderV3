+def post_to_chat(chat_id, thread_id, reply_to_id, text, fallback_to_topic_21=False, fallback_chat_id=None, chat_type=None):
+    """Post a message back to chat. Mirrors the daemon's ACK pattern."""
+    params = {"chat_id": chat_id, "text": text, "allow_sending_without_reply": True}
+    if thread_id is not None:
+        params["message_thread_id"] = thread_id
+    if chat_type != "private" and reply_to_id is not None:
+        params["reply_to_message_id"] = reply_to_id
+    r = tg_request("sendMessage", params)
+    if r and not r.get("ok") and chat_type == "supergroup" and fallback_to_topic_21:
+        log(f"primary post failed: {r.get('description')}; falling back to topic 21")
+        tg_request("sendMessage", {
+            "chat_id": fallback_chat_id,
+            "message_thread_id": TOPIC_ID,
+            "text": text,
+            "allow_sending_without_reply": True,
+        })
+
+
+def detect_voice_or_audio(msg):
+    """Return (file_id, voice_kind) if msg has voice/audio, else (None, None)."""
+    voice = msg.get("voice")
+    if voice and voice.get("file_id"):
+        return voice["file_id"], "voice"
+    audio = msg.get("audio")
+    if audio and audio.get("file_id"):
+        return audio["file_id"], "audio"
+    return None, None
+
