+            data = r.read()
+        Path(dest_path).parent.mkdir(parents=True, exist_ok=True)
+        with open(dest_path, "wb") as f:
+            f.write(data)
+        return True, len(data)
+    except Exception as e:
+        log(f"TG file download failed: {type(e).__name__}: {e}")
