#!/usr/bin/env python3
"""
cc-comms-bridge — replaces OpenClaw `ccdt-relay`.

Two responsibilities:
1. Long-poll @CCDTCommsBot for inbound messages (Kyle direct, or Langston's
   bot replies in the group), append to /var/log/cc-bridge-inbox.jsonl for
   Claude Code to tail via SSH.
2. Provide a `send` mode for outbound — post messages via @CCDTCommsBot.
   Replaces `openclaw message send --account ccdt-relay ...`.

B-NEW-41 (2026-05-17): adds voice transcription via whisper.cpp.
   Voice/audio messages from Kyle in DM or topic 21 are downloaded,
   transcribed locally via /opt/whisper.cpp/build/bin/whisper-cli, and
   written to the inbox log as if they were text. Worker-thread pattern
   keeps the main poll loop unblocked during transcription.
"""
import argparse
import json
import os
import queue
import subprocess
import sys
import threading
import time
import traceback
import urllib.request
import urllib.parse
import urllib.error
from pathlib import Path

CCDT_BOT_TOKEN_FILE = "/etc/langston/ccdt-bot.env"
INBOX_LOG = "/var/log/cc-bridge-inbox.jsonl"
STATE_FILE = "/var/lib/cc-comms-bridge/state.json"
DAEMON_LOG = "/var/log/cc-comms-bridge.log"

GROUP_ID = -1003575211453
TOPIC_ID = 21  # Batch Implementation
KYLE_USER_ID = 8734856533
LANGSTON_BOT_ID = 7953472847

POLL_TIMEOUT = 25

# ─── B-NEW-41 voice transcription config ─────────────────────────────────────
WHISPER_CLI = "/opt/whisper.cpp/build/bin/whisper-cli"
WHISPER_MODEL = "/opt/whisper.cpp/models/ggml-small.en.bin"
WHISPER_THREADS = "3"
WHISPER_TIMEOUT_S = 120
VOICE_ARCHIVE_ROOT = "/var/log/cc-bridge-voice-archive"
VOICE_DOWNLOAD_TMP = "/tmp"
TG_FILE_SIZE_CAP = 20 * 1024 * 1024  # 20MB Telegram bot API cap
ACK_PREVIEW_CHARS = 100
HEARTBEAT_INTERVAL_S = 60


def log(msg):
    line = f"{time.strftime('%Y-%m-%d %H:%M:%S')} {msg}"
    print(line, file=sys.stderr, flush=True)
    try:
        Path(DAEMON_LOG).parent.mkdir(parents=True, exist_ok=True)
        with open(DAEMON_LOG, "a") as f:
            f.write(line + "\n")
    except Exception:
        pass


def load_token():
    for line in Path(CCDT_BOT_TOKEN_FILE).read_text().splitlines():
        line = line.strip()
        if line.startswith("TELEGRAM_BOT_TOKEN="):
            return line.split("=", 1)[1].strip()
    raise RuntimeError("TELEGRAM_BOT_TOKEN not found")


def tg_request(method, params=None, timeout=30):
    tok = load_token()
    url = f"https://api.telegram.org/bot{tok}/{method}"
    if params:
        data = json.dumps(params).encode("utf-8")
        req = urllib.request.Request(url, data=data, method="POST",
                                     headers={"Content-Type": "application/json"})
    else:
        req = urllib.request.Request(url, method="GET")
    try:
        with urllib.request.urlopen(req, timeout=timeout) as r:
            return json.loads(r.read())
    except urllib.error.HTTPError as e:
        body = e.read().decode("utf-8", errors="replace")[:300]
        log(f"TG {method} HTTP {e.code}: {body}")
        return None
    except Exception as e:
        log(f"TG {method} error: {type(e).__name__}: {e}")
        return None


def tg_download_file(file_path, dest_path):
    """Download a file from Telegram. Returns (success: bool, size: int)."""
    tok = load_token()
    url = f"https://api.telegram.org/file/bot{tok}/{file_path}"
    try:
        req = urllib.request.Request(url, method="GET")
        with urllib.request.urlopen(req, timeout=60) as r:
            data = r.read()
        Path(dest_path).parent.mkdir(parents=True, exist_ok=True)
        with open(dest_path, "wb") as f:
            f.write(data)
        return True, len(data)
    except Exception as e:
        log(f"TG file download failed: {type(e).__name__}: {e}")
        return False, 0


def load_state():
    if Path(STATE_FILE).exists():
        try:
            return json.loads(Path(STATE_FILE).read_text())
        except Exception:
            log("state corrupt, starting fresh")
    return {"last_update_id": 0}


def save_state(s):
    Path(STATE_FILE).parent.mkdir(parents=True, exist_ok=True)
    Path(STATE_FILE).write_text(json.dumps(s, indent=2))


def append_inbox(entry):
    """Single-write JSONL append. POSIX atomic under PIPE_BUF (4KB) for sub-4KB entries."""
    Path(INBOX_LOG).parent.mkdir(parents=True, exist_ok=True)
    with open(INBOX_LOG, "a") as f:
        f.write(json.dumps(entry, ensure_ascii=False) + "\n")


# ─── B-NEW-41 voice handling ─────────────────────────────────────────────────

def is_allowed_voice(msg):
    """Allowlist per scope §2.2: DM with bot OR topic 21 of Dawn Trader HQ group.

    Returns True if this voice/audio message should be transcribed.
    """
    chat = msg.get("chat") or {}
    chat_type = chat.get("type")
    chat_id = chat.get("id")
    thread_id = msg.get("message_thread_id")
    sender = msg.get("from") or {}
    # Reject bot senders (avoid loops on bot-to-bot or self-echo)
    if sender.get("is_bot"):
        return False
    if chat_type == "private":
        return True
    if chat_type == "supergroup" and chat_id == GROUP_ID and thread_id == TOPIC_ID:
        return True
    return False


def transcribe_audio(audio_path):
    """Run whisper-cli on the audio file. Returns (text: str|None, error: str|None, duration_ms: int).

    On success: text is non-empty stripped transcription, error is None.
    On failure: text is None, error is descriptive message.
    """
    t0 = time.time()
    out_prefix = f"/tmp/whisper-out-{os.getpid()}-{int(t0*1000)}"
    args = [
        WHISPER_CLI,
        "-m", WHISPER_MODEL,
        "-f", audio_path,
        "-t", WHISPER_THREADS,
        "-otxt",
        "-of", out_prefix,
        "-nt",  # no timestamps in output text
    ]
    try:
        result = subprocess.run(
            args, capture_output=True, text=True, timeout=WHISPER_TIMEOUT_S
        )
        elapsed_ms = int((time.time() - t0) * 1000)
        if result.returncode != 0:
            return None, f"whisper exit={result.returncode} stderr_tail={result.stderr[-500:]}", elapsed_ms
        txt_path = out_prefix + ".txt"
        if not Path(txt_path).exists():
            return None, f"whisper produced no output file (stderr: {result.stderr[-500:]})", elapsed_ms
        text = Path(txt_path).read_text(encoding="utf-8").strip()
        try:
            Path(txt_path).unlink()
        except Exception:
            pass
        if not text:
            return None, "whisper produced empty transcription", elapsed_ms
        return text, None, elapsed_ms
    except subprocess.TimeoutExpired:
        return None, f"whisper timeout after {WHISPER_TIMEOUT_S}s", int((time.time() - t0) * 1000)
    except Exception as e:
        return None, f"whisper invoke error: {type(e).__name__}: {e}", int((time.time() - t0) * 1000)


def voice_worker(voice_q):
    """B-NEW-41: background worker. Single-threaded FIFO consumption of voice tasks.

    Keeps the main poll loop unblocked during whisper transcription.
    """
    last_heartbeat = time.time()
    while True:
        try:
            # Non-blocking get with timeout so heartbeat fires regularly
            try:
                task = voice_q.get(timeout=HEARTBEAT_INTERVAL_S)
            except queue.Empty:
                now = time.time()
                if now - last_heartbeat >= HEARTBEAT_INTERVAL_S:
                    log(f"voice worker alive, queue depth=0")
                    last_heartbeat = now
                continue
            try:
                handle_voice_task(task)
            except Exception as e:
                log(f"voice worker task error: {type(e).__name__}: {e}\n{traceback.format_exc()[:500]}")
            finally:
                voice_q.task_done()
            if time.time() - last_heartbeat >= HEARTBEAT_INTERVAL_S:
                log(f"voice worker alive, queue depth={voice_q.qsize()}")
                last_heartbeat = time.time()
        except Exception as e:
            log(f"voice worker outer loop error (resuming): {type(e).__name__}: {e}")
            time.sleep(1)


def handle_voice_task(task):
    """Process one voice/audio message: download, transcribe, write inbox, ACK chat."""
    msg = task["msg"]
    chat_id = task["chat_id"]
    thread_id = task["thread_id"]
    message_id = task["message_id"]
    file_id = task["file_id"]
    kind = task["voice_kind"]  # "voice" or "audio"

    # Get file metadata + size cap check
    meta = tg_request("getFile", {"file_id": file_id})
    if not meta or not meta.get("ok"):
        return fail_voice(task, reason="getFile_failed", details=str(meta)[:300])
    file_size = meta["result"].get("file_size", 0)
    if file_size > TG_FILE_SIZE_CAP:
        return fail_voice(task, reason="oversize", details=f"{file_size}>{TG_FILE_SIZE_CAP}")
    file_path = meta["result"].get("file_path")
    if not file_path:
        return fail_voice(task, reason="no_file_path", details=str(meta)[:300])

    # Download to tmp + archive
    date_str = time.strftime("%Y-%m-%d")
    archive_dir = Path(VOICE_ARCHIVE_ROOT) / date_str
    archive_dir.mkdir(parents=True, exist_ok=True)
    ext = Path(file_path).suffix or ".ogg"
    archive_path = archive_dir / f"{message_id}{ext}"
    ok, actual_size = tg_download_file(file_path, str(archive_path))
    if not ok:
        return fail_voice(task, reason="download_failed", details=f"file_path={file_path}")
    if actual_size == 0:
        return fail_voice(task, reason="zero_byte_file", details=f"file_path={file_path}", archive_path=str(archive_path))

    # Transcribe
    log(f"voice: transcribing {archive_path} (size={actual_size}B)")
    text, error, duration_ms = transcribe_audio(str(archive_path))
    if text is None:
        return fail_voice(task, reason="transcription_failed", details=error,
                          archive_path=str(archive_path), duration_ms=duration_ms)

    # Success: write inbox entry
    entry = {
        "schema_version": 1,
        "ts": time.strftime("%Y-%m-%dT%H:%M:%S%z"),
        "source": "cc-comms-bridge",
        "kind": "voice_inbound",
        "update_id": task.get("update_id"),
        "message_id": message_id,
        "chat_id": chat_id,
        "chat_type": (msg.get("chat") or {}).get("type"),
        "thread_id": thread_id,
        "sender_id": (msg.get("from") or {}).get("id"),
        "sender_username": (msg.get("from") or {}).get("username"),
        "sender_is_bot": (msg.get("from") or {}).get("is_bot", False),
        "voice_kind": kind,
        "text": text,
        "transcription_source": "whisper.cpp/ggml-small.en",
        "transcription_duration_ms": duration_ms,
        "audio_duration_s": (msg.get(kind) or {}).get("duration"),
        "audio_archive_path": str(archive_path),
        "file_id": file_id,
        "file_size": actual_size,
    }
    append_inbox(entry)
    log(f"voice_inbound: msg {message_id} transcribed in {duration_ms}ms ({len(text)} chars)")

    # Post ACK to originating chat with 100-char preview
    preview = text[:ACK_PREVIEW_CHARS] + ("..." if len(text) > ACK_PREVIEW_CHARS else "")
    ack_text = f"✅ Voice transcribed: \"{preview}\" — Logged (msg {message_id}). CC will see at next session start."
    post_to_chat(chat_id, thread_id, message_id, ack_text, fallback_to_topic_21=True,
                 fallback_chat_id=chat_id, chat_type=(msg.get("chat") or {}).get("type"))


def fail_voice(task, reason, details, archive_path=None, duration_ms=None):
    """Write voice_inbound_failed entry to inbox + post fallback notice to chat."""
    msg = task["msg"]
    message_id = task["message_id"]
    chat_id = task["chat_id"]
    thread_id = task["thread_id"]
    file_id = task["file_id"]
    entry = {
        "schema_version": 1,
        "ts": time.strftime("%Y-%m-%dT%H:%M:%S%z"),
        "source": "cc-comms-bridge",
        "kind": "voice_inbound_failed",
        "message_id": message_id,
        "chat_id": chat_id,
        "thread_id": thread_id,
        "sender_id": (msg.get("from") or {}).get("id"),
        "failure_reason": reason,
        "details": details[:500] if details else None,
        "file_id": file_id,
        "audio_archive_path": archive_path,
        "transcription_duration_ms": duration_ms,
    }
    append_inbox(entry)
    log(f"voice_inbound_failed: msg {message_id} reason={reason}")
    fallback_text = (
        f"⚠️ Voice transcription failed (reason: {reason}). "
        f"Please retry as text or paste the message again. (msg {message_id})"
    )
    chat_type = (msg.get("chat") or {}).get("type")
    post_to_chat(chat_id, thread_id, message_id, fallback_text, fallback_to_topic_21=True,
                 fallback_chat_id=chat_id, chat_type=chat_type)


def post_to_chat(chat_id, thread_id, reply_to_id, text, fallback_to_topic_21=False, fallback_chat_id=None, chat_type=None):
    """Post a message back to chat. Mirrors the daemon's ACK pattern."""
    params = {"chat_id": chat_id, "text": text, "allow_sending_without_reply": True}
    if thread_id is not None:
        params["message_thread_id"] = thread_id
    if chat_type != "private" and reply_to_id is not None:
        params["reply_to_message_id"] = reply_to_id
    r = tg_request("sendMessage", params)
    if r and not r.get("ok") and chat_type == "supergroup" and fallback_to_topic_21:
        log(f"primary post failed: {r.get('description')}; falling back to topic 21")
        tg_request("sendMessage", {
            "chat_id": fallback_chat_id,
            "message_thread_id": TOPIC_ID,
            "text": text,
            "allow_sending_without_reply": True,
        })


def detect_voice_or_audio(msg):
    """Return (file_id, voice_kind) if msg has voice/audio, else (None, None)."""
    voice = msg.get("voice")
    if voice and voice.get("file_id"):
        return voice["file_id"], "voice"
    audio = msg.get("audio")
    if audio and audio.get("file_id"):
        return audio["file_id"], "audio"
    return None, None


# ─── Main daemon loop ────────────────────────────────────────────────────────

def daemon():
    log("cc-comms-bridge daemon starting (B-NEW-41: voice transcription enabled)")
    state = load_state()
    save_state(state)

    # B-NEW-41: spawn voice worker thread
    voice_q = queue.Queue()
    voice_thread = threading.Thread(target=voice_worker, args=(voice_q,), daemon=True, name="voice-worker")
    voice_thread.start()
    log(f"voice worker thread started (daemon, name={voice_thread.name})")

    consecutive_errors = 0
    while True:
        try:
            updates = tg_request(
                "getUpdates",
                {"offset": state["last_update_id"] + 1,
                 "timeout": POLL_TIMEOUT,
                 "allowed_updates": ["message"]},
                timeout=POLL_TIMEOUT + 10,
            )
            if updates is None:
                consecutive_errors += 1
                wait = min(60, 2 ** min(consecutive_errors, 5))
                time.sleep(wait)
                continue
            consecutive_errors = 0
            if not updates.get("ok"):
                time.sleep(5)
                continue
            for update in updates.get("result", []):
                state["last_update_id"] = max(state["last_update_id"], update["update_id"])
                msg = update.get("message")
                if not msg:
                    continue

                # B-NEW-41: voice/audio detection — enqueue to worker, skip text path
                file_id, voice_kind = detect_voice_or_audio(msg)
                if file_id and is_allowed_voice(msg):
                    log(f"voice detected: msg {msg['message_id']} kind={voice_kind} file_id={file_id[:20]}... enqueueing")
                    voice_q.put({
                        "msg": msg,
                        "update_id": update["update_id"],
                        "message_id": msg["message_id"],
                        "chat_id": (msg.get("chat") or {}).get("id"),
                        "thread_id": msg.get("message_thread_id"),
                        "file_id": file_id,
                        "voice_kind": voice_kind,
                    })
                    continue
                if file_id and not is_allowed_voice(msg):
                    log(f"voice from disallowed chat: msg {msg['message_id']}, skipping")
                    continue

                # Standard text path (unchanged from pre-B-NEW-41)
                sender = msg.get("from") or {}
                chat = msg.get("chat") or {}
                entry = {
                    "ts": time.strftime("%Y-%m-%dT%H:%M:%S%z"),
                    "update_id": update["update_id"],
                    "message_id": msg.get("message_id"),
                    "chat_id": chat.get("id"),
                    "chat_type": chat.get("type"),
                    "thread_id": msg.get("message_thread_id"),
                    "sender_id": sender.get("id"),
                    "sender_username": sender.get("username"),
                    "sender_is_bot": sender.get("is_bot", False),
                    "text": msg.get("text") or msg.get("caption") or "",
                    "reply_to_id": (msg.get("reply_to_message") or {}).get("message_id"),
                }
                append_inbox(entry)
                log(f"inbox: msg {entry['message_id']} from {entry['sender_username']} chat={entry['chat_id']} thread={entry['thread_id']}: {entry['text'][:80]}")
                # B79.0c (2026-05-09): auto-ACK on inbound — restore OpenClaw-era UX.
                # Skip ACK on bot messages (CC own outbound + LangstonDTBot) so we
                # do not loop or clutter. ACK every human inbound (DM + group).
                if not entry["sender_is_bot"]:
                    ack_text = f"✅ Logged (msg {entry['message_id']}) — CC will see this at next session start. For real-time, use the Claude Desktop conversation."
                    primary_params = {
                        "chat_id": entry["chat_id"],
                        "text": ack_text,
                        "allow_sending_without_reply": True,
                    }
                    if entry["thread_id"] is not None:
                        primary_params["message_thread_id"] = entry["thread_id"]
                    if entry["chat_type"] != "private":
                        primary_params["reply_to_message_id"] = entry["message_id"]
                    try:
                        r = tg_request("sendMessage", primary_params)
                        if r and not r.get("ok") and entry["chat_type"] == "supergroup":
                            log(f"ack primary failed: {r.get('description')}; falling back to topic 21")
                            fallback_text = (
                                f"✅ Logged msg {entry['message_id']} from chat {entry['chat_id']} "
                                f"thread {entry['thread_id']}: '{(entry['text'] or '')[:120]}'"
                            )
                            tg_request("sendMessage", {
                                "chat_id": entry["chat_id"],
                                "message_thread_id": 21,
                                "text": fallback_text,
                                "allow_sending_without_reply": True,
                            })
                    except Exception as e:
                        log(f"ack send failed: {e}")
            save_state(state)
        except KeyboardInterrupt:
            log("KeyboardInterrupt, exit")
            break
        except Exception as e:
            log(f"main loop: {type(e).__name__}: {e}\n{traceback.format_exc()[:500]}")
            time.sleep(10)


def send(target, message, thread_id=None, reply_to=None):
    """Post a message via @CCDTCommsBot. Auto-chunks long text on \\n boundaries."""
    text = message
    LIMIT = 3800
    chunks = []
    while len(text) > LIMIT:
        cut = text.rfind("\n", 0, LIMIT)
        if cut < LIMIT // 2:
            cut = LIMIT
        chunks.append(text[:cut])
        text = text[cut:].lstrip("\n")
    chunks.append(text)
    first_id = None
    for i, c in enumerate(chunks):
        params = {"chat_id": target, "text": c}
        if thread_id:
            params["message_thread_id"] = int(thread_id)
        if i == 0 and reply_to:
            params["reply_to_message_id"] = int(reply_to)
            params["allow_sending_without_reply"] = True
        r = tg_request("sendMessage", params)
        if r is None or not r.get("ok"):
            print(f"chunk {i}: FAILED {r}", file=sys.stderr)
            return None
        if i == 0:
            first_id = r["result"]["message_id"]
        print(f"chunk {i}: id={r['result']['message_id']}")
        # Mirror outbound so Langston (and the unified log) see what main CC posted
        try:
            entry = {
                "ts": time.strftime("%Y-%m-%dT%H:%M:%S%z"),
                "source": "cc-comms-bridge",
                "kind": "cc_outbound",
                "chat_id": int(target),
                "thread_id": int(thread_id) if thread_id else None,
                "message_id": r["result"]["message_id"],
                "reply_to": int(reply_to) if reply_to else None,
                "text": c,
            }
            with open(INBOX_LOG, "a") as f:
                f.write(json.dumps(entry, ensure_ascii=False) + "\n")
        except Exception as e:
            print(f"mirror append failed: {e}", file=sys.stderr)
    return first_id


def main():
    parser = argparse.ArgumentParser()
    sub = parser.add_subparsers(dest="cmd")
    sub.add_parser("daemon")
    s = sub.add_parser("send")
    s.add_argument("--target", default=str(GROUP_ID), help="chat_id (default: DawnTrader HQ group)")
    s.add_argument("--thread-id", default="21", help="forum topic thread ID (default: 21)")
    s.add_argument("--reply-to", default=None, help="message_id to reply to (optional)")
    s.add_argument("--message", required=True)
    args = parser.parse_args()
    if args.cmd in (None, "daemon"):
        daemon()
    elif args.cmd == "send":
        send(args.target, args.message, args.thread_id, args.reply_to)


if __name__ == "__main__":
    main()
