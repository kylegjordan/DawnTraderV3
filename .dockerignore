# Dependencies (reinstalled in Docker)
node_modules/

# Build output (rebuilt in Docker)
dist/

# Git
.git/
.gitignore

# IDE / Editor
.vscode/
.idea/

# Replit-specific (not needed in Docker)
.replit
replit.md
.config/
generated-icon.png

# Claude Code worktrees
.claude/

