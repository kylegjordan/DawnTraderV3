!.env.example

# Test/diagnostic artifacts
diagnostic-reports/
reports/
logs/
audit/
*.log

# Documentation / governance (not needed in runtime image)
1-system-manual/
directives/
directives-archive/
chaplet/docs/

# OS files
.DS_Store
Thumbs.db

# Python cache
__pycache__/
*.pyc
*.pyo
