  "websocket_events": [
    {
      "event_type": "trading_state_changed",
      "description": "Broadcasted when engine starts/stops",
      "payload": "{ mode, status, isEngineActive, changedBy, timestamp }",
      "broadcast_scope": "all clients",
      "triggers": ["Engine start", "Engine stop"],
      "subscribers_ui": ["Dashboard Top Bar", "Trading Panel"]
    },
    {
      "event_type": "config_changed",
      "description": "Broadcasted when guardrails/filters/settings change",
      "payload": "{ configType, mode, userId }",
      "broadcast_scope": "all clients",
      "triggers": ["Guardrails PUT", "Screeners PUT"],
      "subscribers_ui": ["Goals Engine", "Dashboard widgets"]
    },
    {
      "event_type": "metrics_updated",
      "description": "Broadcasted when MetricsCore recalculates KPIs",
      "payload": "{ mode, timestamp }",
      "broadcast_scope": "all clients",
      "triggers": ["Metrics recomputation"],
      "subscribers_ui": ["Dashboard widgets", "Reports page"]
    },
    {
      "event_type": "watchlist_updated",
      "description": "Broadcasted when watchlist changes",
      "payload": "{ mode, action, symbol }",
      "broadcast_scope": "mode-specific clients",
      "triggers": ["Watchlist add", "Watchlist remove"],
      "subscribers_ui": ["Watchlist page", "Trading Panel"]
    }
  ],
  "mode_based_architecture_notes": [
    "All endpoints requiring mode use query parameter: ?mode=paper or ?mode=live",
    "validateMode middleware normalizes mode parameter to req.mode",
    "WebSocket broadcasts use mode field to allow client-side filtering",
    "Cache keys include mode for proper isolation (e.g., 'config:guardrails:paper')",
    "Bob services (ConfigBob, StrategyBob, TradingBob) all support mode-based caching"
  ],
  "conflicts_and_issues": [
    {
      "issue": "trading_settings table has risk parameters (dailyLossKillSwitch, maxPositionPercent)",
      "conflict": "These should be in guardrails table with mode scoping",
      "impact": "Risk parameters are per-user instead of global-per-mode",
      "resolution": "Migrate to guardrails table in Phase 2"
    },
    {
      "issue": "tuning_policy.cooldownMinutes duplicates guardrails.cooldownMinutes",
      "conflict": "Two sources of truth for same parameter",
      "impact": "Sync issues, potential conflicts",
      "resolution": "Remove from tuning_policy, read from guardrails only"
    },
    {
      "issue": "strategy_parameters table has NO mode scoping",
      "conflict": "Global parameters conflict with mode-based architecture",
      "impact": "Cannot have different strategy params for paper vs live",
      "resolution": "Deprecate table, move to strategy_settings.params or mode-scoped table"
    },
    {
      "issue": "tuning_policy is per-user instead of global-per-mode",
      "conflict": "Architecture mandates global settings per mode",
      "impact": "Each user can have different tuning policy",
      "resolution": "Migrate to global-per-mode in Phase 2"
    }
  ]
}
